3*q^2*(fnu[q^2] + rn[q^2/k^2])^3)\"\>"}],
  SequenceForm[
  "p -> 0 (d_s ", $CellContext`nuk, "): ", 
   "-1/4*(lamk^2*(2*Dk*k^2*dsCoupling[nuk]*fD[q^2]*rn[q^2/k^2] - \

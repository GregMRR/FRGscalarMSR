Cell[CellGroupData[{

Cell["2. Vertices, regulator, propagator, loops", "Section",ExpressionUUID->"836257b9-e2a4-4c52-860e-72eef718104e"],

Cell["\<\
The same stages as in DE. The propagator atoms now contain fnu[s] and fD[s]; \
the regulator shapes are functions of q^2/k^2.\
\>", "Text",ExpressionUUID->"a982ac9e-a719-462c-94ab-17d35d690aab"],

Cell[CellGroupData[{

Cell["\<\
vertices = BuildVertices[ansatz];
regulator = DefineRegulator[ansatz, {hbar, h} -> nuk q^2 rn[q^2/k^2], {hbar, \
hbar} -> -2 Dk rd[q^2/k^2], \"Shapes\" -> {rn, rd}];
prop = BuildPropagator[vertices, regulator];
loops = BuildLoopIntegrands[vertices, prop, regulator];\
\>", "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"3371420e-dfa2-4802-8158-f891a8a20997"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"---- Fourier vertices (\"\>", "\[InvisibleSpace]", "3", 
   "\[InvisibleSpace]", "\<\" nonzero field multisets) ----\"\>"}],
  SequenceForm["---- Fourier vertices (", 3, " nonzero field multisets) ----"],
  Editable->False]], "Print",
 CellChangeTimes->{4.002173243800973*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"6a488864-4cef-4dd2-9858-da15a7f3d573"],

Cell[BoxData["\<\"Fourier convention: phi(t,x) = Int dw d^dq/(2Pi)^(d+1) \
Exp[-I (q.x - w t)] phi(w,q)   =>   dt -> +I w,  grad -> -I q\"\>"], "Print",
 CellChangeTimes->{4.002173243802546*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"92e4c80c-c9d0-48f9-be6f-c96a53a1bf32"],

Cell[BoxData["\<\"Functional derivative: d phi(w,q)/d phi(w',q') = \
(2Pi)^(d+1) delta(w-w') delta(q-q')\"\>"], "Print",
 CellChangeTimes->{4.002173243806945*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"ddd58a5c-6aad-41ec-b2f4-4b2a5742ad6a"],

Cell[BoxData["\<\"d^n Gamma/d phi_a1(w1,q1)...d phi_an(wn,qn) = (2Pi)^(d+1) \
delta(sum w) delta(sum q) Gamma(n)_{a1..an}(w1,q1; ...; w(n-1),q(n-1))\"\>"], \
"Print",
 CellChangeTimes->{4.0021732438084297`*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"a6704408-5a56-439f-8fe3-8c5b564d80f4"],

Cell[BoxData["\<\"  all momenta incoming, delta stripped, LAST LEG = -(sum of \

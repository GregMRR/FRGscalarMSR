Cell[CellGroupData[{

Cell["5. Check: f = 1 gives Canet's Eq. (20)", "Section",ExpressionUUID->"954d3a2a-394e-4533-b561-5ca10b032146"],

Cell["\<\
At f_D = f_nu = 1 the eta system is the one of the DE KPZ flow (KPZ.nb). With \
the Litim cutoff r(y) = 1/y - 1 for y < 1 in both sectors, the aq integral is \
elementary (y = aq^2). Measure[\"Eta\"] = v_d aq^(d-1) and Canet's g = v_d \
alamk^2, so v_d drops out with alamk^2 = g/v_d: set the v_d of the measure to \
1 and alamk^2 = g. The difference with Canet's d_s g/g is exactly 0 at every \
d.\
\>", "Text",ExpressionUUID->"8d6e9f8f-09f2-454a-935b-71fb3e1df2df"],

Cell["\<\
litim = {fD -> Function[x, 1], fnu -> Function[x, 1], rn -> Function[y, 1/y - \
1], rd -> Function[y, 1/y - 1]};
litimAvg[f_] := Module[{e = Expand[Together[(f /. litim /. aq -> Sqrt[y] /. \
alamk -> Sqrt[g] /. Dim -> d)] y^(d/2 - 1)/2], terms},
  terms = If[Head[e] === Plus, List @@ e, {e}];
  Total[(# /. y -> 1)/(Exponent[#, y] + 1) & /@ terms]];\
\>", "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"f5debd1e-44b7-43e7-a2b2-d5cbd6d69ab1"],

Cell[CellGroupData[{

Cell["\<\
etas = Thread[adim[\"Etas\"] -> LinearSolve[IdentityMatrix[2] + Map[litimAvg, \
adim[\"EtaMatrix\"], {2}], -(litimAvg /@ adim[\"EtaVector\"])]];
bracket = Together[2 First[adim[\"BetaL\"]]/alamk /. etas /. Dim -> d]\
\>", "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"52559578-97b3-4d24-b003-46ed474918fc"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", "16"}], " ", 
    SuperscriptBox["d", "3"]}], "-", 
   RowBox[{"8", " ", 
    SuperscriptBox["d", "4"]}], "+", 
   RowBox[{"4", " ", 
    SuperscriptBox["d", "5"]}], "+", 
   RowBox[{"2", " ", 
    SuperscriptBox["d", "6"]}], "+", 
   RowBox[{"8", " ", "d", " ", "g"}], "+", 
   RowBox[{"20", " ", 
    SuperscriptBox["d", "2"], " ", "g"}], "-", 
   RowBox[{"6", " ", 
    SuperscriptBox["d", "3"], " ", "g"}], "-", 
   RowBox[{"7", " ", 
    SuperscriptBox["d", "4"], " ", "g"}], "-", 
   RowBox[{"2", " ", 
    SuperscriptBox["g", "2"]}], "-", 
   RowBox[{"d", " ", 
    SuperscriptBox["g", "2"]}], "+", 
   RowBox[{"3", " ", 
    SuperscriptBox["d", "2"], " ", 
    SuperscriptBox["g", "2"]}]}], 
  RowBox[{
   RowBox[{"8", " ", 
    SuperscriptBox["d", "3"]}], "+", 
   RowBox[{"8", " ", 
    SuperscriptBox["d", "4"]}], "+", 
   RowBox[{"2", " ", 
    SuperscriptBox["d", "5"]}], "+", 
   RowBox[{"8", " ", "d", " ", "g"}], "-", 
   RowBox[{"2", " ", 
    SuperscriptBox["d", "2"], " ", "g"}], "-", 
   RowBox[{"3", " ", 
    SuperscriptBox["d", "3"], " ", "g"}], "-", 
   SuperscriptBox["g", "2"], "+", 
   RowBox[{"d", " ", 
    SuperscriptBox["g", "2"]}]}]]], "Output",
 CellChangeTimes->{4.002173361879937*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"3417432a-194d-4db7-8b55-4e9179ed767b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
canet = (2 d^6 + 4 d^5 - d^4 (7 g + 8) - 2 d^3 (3 g + 8) + d^2 g (3 g + 20) - \
d (g - 8) g - 2 g^2)/
   (2 d^5 + 8 d^4 + d^3 (8 - 3 g) - 2 d^2 g + d g (g + 8) - g^2);
Together[bracket - canet]\
\>", "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"e1338378-9a54-41ec-bfe4-4535072450ce"],


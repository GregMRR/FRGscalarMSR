Cell[CellGroupData[{

Cell["3. Flows at generic p", "Section",ExpressionUUID->"463f316b-8b71-4882-98e8-d66c72671666"],

Cell["\<\
BuildLOEquations replaces Projection ... Assemble. For each function it takes \
the loop at external momentum p and zero external frequency, integrates the \
loop frequency by residues at the poles of both families, and divides by the \
ansatz prefactor (nuk p^2 for fnu, -2 Dk for fD: P2Divided records the p^2). \
It checks that the entries outside the ansatz vanish at every p, the Ward \
identity, that the p^0 order of the fnu row vanishes, and builds the eta rows \
as the exact p -> 0 limit. The integrand is explicit in p, q, CosTheta = \
cos(p, q), f at q^2 and at Q^2 = p^2 + q^2 + 2 p q CosTheta, the shapes and \
dsCoupling.\
\>", "Text",ExpressionUUID->"de2c92aa-202e-41ad-b5a5-b1e27da9f03f"],

Cell[CellGroupData[{

Cell["\<\
equations = BuildLOEquations[loops, symmetries];
ShowLOEquation[equations, fD]\
\>", "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"15f4be27-d55d-47c2-ab31-e10b6c2711ac"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"d_s(\"\>", "\[InvisibleSpace]", "\<\"Dk*fD[p^2]\"\>", 
   "\[InvisibleSpace]", "\<\") = Int d^dq/(2 Pi)^d of (Gamma2\"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"hbar", ",", "hbar"}], "}"}], 
   "\[InvisibleSpace]", "\<\"(0, p) = \"\>", 
   "\[InvisibleSpace]", "\<\"-2*Dk*fD[p^2]\"\>", 
   "\[InvisibleSpace]", "\<\", divided by \"\>", 
   "\[InvisibleSpace]", "\<\"-2\"\>", "\[InvisibleSpace]", "\<\"):\"\>"}],
  SequenceForm[
  "d_s(", "Dk*fD[p^2]", 
   ") = Int d^dq/(2 Pi)^d of (Gamma2", {$CellContext`hbar, $CellContext`hbar},
    "(0, p) = ", "-2*Dk*fD[p^2]", ", divided by ", "-2", "):"],
  Editable->False]], "Print",

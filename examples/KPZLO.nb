  "p -> 0 (d_s ", $CellContext`Dk, "): ", 
   "(lamk^2*(Dk*fD[q^2] + \
Dk*rd[q^2/k^2])*(2*k^2*nuk*dsCoupling[Dk]*fnu[q^2]*rd[q^2/k^2] - \
3*Dk*k^2*dsCoupling[nuk]*fD[q^2]*rn[q^2/k^2] + \
2*k^2*nuk*dsCoupling[Dk]*rd[q^2/k^2]*rn[q^2/k^2] - \
3*Dk*k^2*dsCoupling[nuk]*rd[q^2/k^2]*rn[q^2/k^2] - \
4*Dk*nuk*q^2*fnu[q^2]*Derivative[1][rd][q^2/k^2] - \
4*Dk*nuk*q^2*rn[q^2/k^2]*Derivative[1][rd][q^2/k^2] + \
6*Dk*nuk*q^2*fD[q^2]*Derivative[1][rn][q^2/k^2] + \
6*Dk*nuk*q^2*rd[q^2/k^2]*Derivative[1][rn][q^2/k^2]))/(4*k^2*nuk^4*q^2*(fnu[q^\
2] + rn[q^2/k^2])^4)"],
  Editable->False]], "Print",

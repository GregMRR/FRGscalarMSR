Cell[CellGroupData[{

Cell["1. Ansatz and symmetries", "Section",ExpressionUUID->"fda503c3-6f59-4c70-a955-15628e470704"],

Cell[CellGroupData[{

Cell["\<\
theory = DefineTheory[\"Scalars\" -> {h}, \"Dimension\" -> Dim];
ansatz = DefineAnsatz[theory, \"Density\" -> hbar (dt[h] - nuk Fnu h - lamk/2 \
grad[h].grad[h]) - Dk FD hbar^2,
  \"Couplings\" -> {nuk, lamk, Dk}, \"MomentumFunctions\" -> {Fnu, FD}];\
\>", "Input",
 CellChangeTimes->{{4.001766141616939*^9, 4.0017661503244333`*^9}, {
  4.001766182390633*^9, 
  4.001766192784123*^9}},ExpressionUUID->"13a6f769-7f37-41d6-8b94-\
d014678b9ee3"],


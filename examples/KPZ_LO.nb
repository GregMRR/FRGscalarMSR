Cell[CellGroupData[{

Cell["2. Flows at generic p", "Section",ExpressionUUID->"b244866e-6846-403f-8eee-f855cb7c2380"],

Cell["\<\
The loop is routed at the midpoint (lines q - p/2, q + p/2) and symmetrised \
under q -> -q; Fnu's equation is the loop minus its p^0 order, divided by \
p^2. Variables of the integrand: q (midpoint loop momentum), p = |p|, c = \
cos(p, q); Int d^dq/(2 Pi)^d.\
\>", "Text",ExpressionUUID->"11431fa8-8b2b-4d11-90a7-0c087dba8c88"],

Cell[CellGroupData[{

Cell["\<\
vertices = BuildVertices[ansatz];
regulator = DefineRegulator[ansatz, {hbar, h} -> nuk q^2 r[q^2/k^2], {hbar, \
hbar} -> -2 Dk r[q^2/k^2], \"Shapes\" -> {r}];
prop = BuildPropagator[vertices, regulator];\
\>", "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"0902bdf9-dd5d-4754-99b5-480118787052"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"---- Fourier vertices (\"\>", "\[InvisibleSpace]", "3", 
   "\[InvisibleSpace]", "\<\" nonzero field multisets) ----\"\>"}],
  SequenceForm["---- Fourier vertices (", 3, " nonzero field multisets) ----"],
  Editable->False]], "Print",
 CellChangeTimes->{4.001764635632337*^9},
 CellLabel->

In[5]:=",ExpressionUUID->"f33c640f-1cb5-4007-ab01-48666a6289c8"],

Cell[BoxData["\<\"Fourier convention: phi(t,x) = Int dw d^dq/(2Pi)^(d+1) \
Exp[-I (q.x - w t)] phi(w,q)   =>   dt -> +I w,  grad -> -I q\"\>"], "Print",
 CellChangeTimes->{4.0017646356338377`*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"921c33f1-8111-4444-8e4c-a29de2098874"],

Cell[BoxData["\<\"Functional derivative: d phi(w,q)/d phi(w',q') = \
(2Pi)^(d+1) delta(w-w') delta(q-q')\"\>"], "Print",
 CellChangeTimes->{4.001764635635603*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"bec7d387-4a7a-4b1f-886c-758e5ae6795f"],

Cell[BoxData["\<\"d^n Gamma/d phi_a1(w1,q1)...d phi_an(wn,qn) = (2Pi)^(d+1) \
delta(sum w) delta(sum q) Gamma(n)_{a1..an}(w1,q1; ...; w(n-1),q(n-1))\"\>"], \
"Print",
 CellChangeTimes->{4.001764635636414*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"9c12c371-709a-4f92-8336-ea9d4478acc5"],


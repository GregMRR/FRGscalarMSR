Cell[CellGroupData[{

Cell["EquationOf[equations, Fnu][\"Integrand\"] //Simplify", "Input",
 CellChangeTimes->{{4.001764787370883*^9, 4.0017648626059427`*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"0f75e56f-d802-4c7c-92fd-c0f6752d1f34"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["lamk", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["k", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["p", "2"], "-", 
           RowBox[{"4", " ", "c", " ", "p", " ", "q"}], "+", 
           RowBox[{"4", " ", 
            SuperscriptBox["q", "2"]}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Fnu", "[", 
            RowBox[{
             FractionBox[
              SuperscriptBox["p", "2"], "4"], "-", 
             RowBox[{"c", " ", "p", " ", "q"}], "+", 
             SuperscriptBox["q", "2"]}], "]"}], "+", 
           RowBox[{"r", "[", 
            FractionBox[
             RowBox[{
              FractionBox[
               SuperscriptBox["p", "2"], "4"], "-", 
              RowBox[{"c", " ", "p", " ", "q"}], "+", 
              SuperscriptBox["q", "2"]}], 
             SuperscriptBox["k", "2"]], "]"}]}], ")"}]}]], 
       RowBox[{"nuk", " ", 
        RowBox[{"(", 
         RowBox[{"p", "-", 
          RowBox[{"2", " ", "c", " ", "q"}]}], ")"}], " ", 

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"      \"\>", 
   "\[InvisibleSpace]", "\<\"-1/2*(alamk^2*(ap^3 - 4*ap*aq^2 - 2*ap^2*aq*c + \
8*aq^3*c)*(2*etanu*r[ap^2/4 + aq^2 - ap*aq*c] + 4*(ap^2/4 + aq^2 - \
ap*aq*c)*Derivative[1][r][ap^2/4 + aq^2 - ap*aq*c]))/(ap*(ap^2 + 4*aq^2 - \
4*ap*aq*c)*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 - ap*aq*c]*(ap^2*AdimAtom[h, \
hbar, 0, 0][ap^2/4 + aq^2 - ap*aq*c] + 4*aq^2*AdimAtom[h, hbar, 0, 0][ap^2/4 \
+ aq^2 - ap*aq*c] - 4*ap*aq*c*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 - \
ap*aq*c] + ap^2*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 + ap*aq*c] + \
4*aq^2*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 + ap*aq*c] + \
4*ap*aq*c*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 + ap*aq*c])) - \
(4*alamk^2*(2*ap^7*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 - \
ap*aq*c]*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 + ap*aq*c]*AdimAtom[hbar, \
hbar, 0, 0][ap^2/4 + aq^2 - ap*aq*c] + 8*ap^5*aq^2*AdimAtom[h, hbar, 0, \
0][ap^2/4 + aq^2 - ap*aq*c]*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 + \
ap*aq*c]*AdimAtom[hbar, hbar, 0, 0][ap^2/4 + aq^2 - ap*aq*c] - \
32*ap^3*aq^4*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 - ap*aq*c]*AdimAtom[h, \
hbar, 0, 0][ap^2/4 + aq^2 + ap*aq*c]*AdimAtom[hbar, hbar, 0, 0][ap^2/4 + aq^2 \
- ap*aq*c] - 128*ap*aq^6*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 - \
ap*aq*c]*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 + ap*aq*c]*AdimAtom[hbar, \
hbar, 0, 0][ap^2/4 + aq^2 - ap*aq*c] - 4*ap^6*aq*c*AdimAtom[h, hbar, 0, \
0][ap^2/4 + aq^2 - ap*aq*c]*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 + \
ap*aq*c]*AdimAtom[hbar, hbar, 0, 0][ap^2/4 + aq^2 - ap*aq*c] - \
16*ap^4*aq^3*c*AdimAtom[h, hbar, 0, 0][ap^2/4 + aq^2 - ap*aq*c]*AdimAtom[h, \
hbar, 0, 0][ap^2/4 + aq^2 + ap*aq*c]*AdimAtom[hbar, hbar, 0, 0][ap^2/4 + aq^2 \

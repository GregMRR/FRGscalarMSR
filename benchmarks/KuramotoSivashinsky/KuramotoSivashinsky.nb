                RowBox[{"Th", " ", "x"}]}], ")"}]}]}], ")"}]}], 
          RowBox[{"4", " ", "x", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"Fh", "+", 
              RowBox[{"rnu", "(", "x", ")"}], "+", 

alpha r_D\"\>"},
    {"\<\"KS.timeReversal.nu\"\>", "\<\"Eqs. (19), (32)\"\>", "\<\"PASS\"\>", \
"\<\"d = 1, r_nu = alpha r_D, nu = alpha D, tau = alpha zeta: d_s nu - alpha \
d_s D = 0 at every qh\"\>"},
    {"\<\"KS.timeReversal.tau\"\>", "\<\"Eqs. (19), (32)\"\>", \
"\<\"PASS\"\>", "\<\"same point: d_s tau - alpha d_s zeta = 0 at every qh \
(p^4 projection against p^2 projection)\"\>"},
    {"\<\"KS.timeReversal.controlD2\"\>", "\<\"control\"\>", "\<\"PASS\"\>", \
"\<\"the same two combinations are nonzero at d = 2, where time reversal is \
absent\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{4.00165375362295*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"996d7205-605f-412d-9c2f-fd8a291e01e9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["If[AllTrue[ksResults, #Pass &], \"all checks pass\", Abort[]]", "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"b1af7b5b-5dfc-4875-8448-4e53facd261f"],

Cell[BoxData["\<\"all checks pass\"\>"], "Output",
 CellChangeTimes->{4.001653753653165*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"846f86a8-8838-463b-a5ed-584a88b3888c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
nbIntegrands = ksEquations[\"Equations\"][[All, \"Integrand\"]];
Block[{ksEquations, Print}, Get[FileNameJoin[{ksDir, \"Pipeline.wl\"}]]; \
If[ksEquations[\"Equations\"][[All, \"Integrand\"]] === nbIntegrands, \"same \
equations as Pipeline.wl\", Abort[]]]\
\>", "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"2a114562-e044-4b4d-8124-e3b0ed8305aa"],

Cell[BoxData["\<\"same equations as Pipeline.wl\"\>"], "Output",
 CellChangeTimes->{4.001653770489985*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"fa9a6ef2-2022-44fd-ad21-8aaf7d2a42ba"]
}, Open  ]]

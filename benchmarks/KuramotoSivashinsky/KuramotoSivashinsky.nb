  RowBox[{"\<\"Loops: \"\>", 
   "\[InvisibleSpace]", "\<\"d_s Gamma2_ab(nu,p) = Int dw/(2Pi) [Tr(dsR G \
Gamma3_a G(w+nu,p+q) Gamma3_b G) - 1/2 Tr(dsR G Gamma4_ab G)], Int \
d^dq/(2Pi)^d left to the numerics\"\>"}],

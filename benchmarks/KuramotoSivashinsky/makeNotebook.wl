(* ::Package:: *)

(* makeNotebook.wl -- writes KuramotoSivashinsky.nb (this folder) from the cell list below.
   Run:  math -script ~/Physics/Sources/FRGscalarMSR/benchmarks/KuramotoSivashinsky/makeNotebook.wl
   Check that it runs headless:
         math -script ~/Physics/Sources/FRGscalarMSR/examples/runNotebook.wl ~/Physics/Sources/FRGscalarMSR/benchmarks/KuramotoSivashinsky/KuramotoSivashinsky.nb
   Edit the cells here, not in the .nb. The pipeline cells mirror Pipeline.wl; section 6 checks that they build the same equations. *)

dir = DirectoryName[$InputFileName];
title[s_] := Cell[s, "Title"];
section[s_] := Cell[s, "Section"];
text[s_] := Cell[s, "Text"];
input[s_] := Cell[s, "Input"];

cells = {
   title["Benchmark: Kuramoto-Sivashinsky at order p^4"],
   text["Reference: L. Gosteva, N. Wschebor, L. Canet, \"Scaling regimes of the Kuramoto-Sivashinsky equation from the functional \
renormalization group\", arXiv:2607.15784 (2026), Sec. III (simplest derivative-expansion ansatz). The paper gives the one-loop flows \
of its four running couplings for general regulators, after the frequency integral (Eqs. 34-37). This notebook derives the same flows \
with FRGscalarMSR from the ansatz alone and compares them with the paper's, exactly, at every loop momentum."],
   text["Why this benchmark: tau is the coefficient of p^4 in Gamma(1,1), so its flow tests the momentum projection at order p^4 \
(n = 2), which no other literature check reaches. Two exact identities of the paper are checked too: the cancellation of r''' in the \
tau flow, and the time-reversal symmetry of the one-dimensional flows. Limit: at d = 1 the p^4 normalisation 8d(d+2) equals \
8(d^2+2), so a d-normalisation error would not show here (Projection.normalisation and Projection.explicitVectors cover it)."],
   input["Get[\"~/Physics/Sources/FRGscalarMSR/FRGscalarMSR.wl\"];\nksDir = ExpandFileName[\"~/Physics/Sources/FRGscalarMSR/benchmarks/KuramotoSivashinsky\"];"],

   section["1. Model and ansatz (paper Eqs. 16-17)"],
   text["Gamma_k = Int h̄ { dt h - (nu - tau dx^2) dx^2 h - lam/2 (dx h)^2 - (D - zeta dx^2) h̄ }, so Gamma(1,1) = i w + p^2 (nu + tau p^2) \
and Gamma(0,2) = -2 (D + zeta p^2). The term zeta (dx h̄)^2 is zero at the KS scale and generated by the flow. lam and the 1 in front \
of dt h are not renormalised (Galilean and shift symmetries). The dimension is kept symbolic (Dim) and set to 1 in the comparisons, \
which lets the time-reversal check use d = 2 as a control."],
   input["ksTheory = DefineTheory[\"Scalars\" -> {h}, \"Dimension\" -> Dim]"],
   input["ksAnsatz = DefineAnsatz[ksTheory,\n  \"Density\" -> hbar (dt[h] - nuk lap[h] + tauk lap[lap[h]] - lamk/2 grad[h].grad[h]) - Dk hbar^2 - zetak grad[hbar].grad[hbar],\n  \"Couplings\" -> {nuk, tauk, lamk, Dk, zetak}];"],

   section["2. Symmetries, vertices, regulator"],
   text["The truncation keeps every monomial up to (i w)^2 (p^2)^2. Two of them are protected (their flow must vanish exactly), the \
four couplings get equations, and everything else is computed, reported and dropped. The regulators are those of Eq. 31, \
R^nu = D r_nu(q^2/k^2) and R^D = D r_D(q^2/k^2), with two independent shapes rn = r_nu and rd = r_D, as in the paper's Eqs. 34-37."],
   input["ksSymmetries = DeclareSymmetries[ksAnsatz,\n  Protected[{hbar, h}, \"Frequency\" -> 1, \"Momentum\" -> 0, \"Reason\" -> \"Galilean Ward identity (the 1 in front of dt h)\"],\n  Protected[{h, hbar}, \"Frequency\" -> 0, \"Momentum\" -> 0, \"Reason\" -> \"h -> h + c (shift symmetry)\"],\n  Neglected[_, \"Reason\" -> \"beyond the simplest DE ansatz\"],\n  NonRenormalised[lamk, \"Reason\" -> \"Galilean invariance\"],\n  \"TruncationOrders\" -> <|\"Frequency\" -> 2, \"Momentum\" -> 2|>];"],
   input["ksVertices = BuildVertices[ksAnsatz];"],
   input["ksRegulator = DefineRegulator[ksAnsatz, {hbar, h} -> Dk q^2 rn[q^2/k^2], {hbar, hbar} -> -2 Dk rd[q^2/k^2], \"Shapes\" -> {rn, rd}];"],

   section["3. Propagator, loops, projection, frequency integrals, closure, equations"],
   text["The projection card should show Projection.explicitVectors: the p^4 integrands are recomputed with explicit vectors and \
(Laplacian_p)^2 and compared. The closure card lists the two protected flows (exactly zero) and the four equations. The whole build \
takes about 20 s."],
   input["ksPropagator = BuildPropagator[ksVertices, ksRegulator];"],
   input["ksLoops = BuildLoopIntegrands[ksVertices, ksPropagator, ksRegulator];"],
   input["ksProjected = ProjectOnMonomials[ksLoops, ksSymmetries];"],
   input["ksIntegrated = IntegrateFrequencies[ksProjected];"],
   input["ksClosure = CheckClosure[ksIntegrated, ksSymmetries];"],
   input["ksEquations = AssembleEquations[ksClosure];"],
   input["ShowEquation[ksEquations, tauk]"],

   section["4. The paper's flows (Eqs. 34-37)"],
   text["Reference.wl transcribes Eqs. 34-37 (checked against the authors' notebook). Each is the integrand J of Int dqh/(2 Pi) over \
the real line, qh = q/k, in the paper's dimensionless variables Gh = lam^2/(k D^2), Fh = nu/D, Ch = k^2 zeta/D, Th = k^2 tau/D and \
eta = -d_s D/D, with x = qh^2, hn = Fh + Th x + rnu(x), hd = 1 + Ch x + rD(x), sn = d_s R^nu/D, sd = d_s R^D/D. Below: the four \
integrands, as functions of x."],
   input["Get[FileNameJoin[{ksDir, \"Reference.wl\"}]];\nColumn[Table[c -> TraditionalForm[ksRefTerms[x][c]], {c, {\"D\", \"nu\", \"zeta\", \"tau\"}}], Spacings -> 2]"],

   section["5. Comparison"],
   text["Checks.wl rewrites the library's integrand of each equation in the paper's variables (q = k qh, nu = D Fh, tau = D Th/k^2, \
zeta = D Ch/k^2, lam^2 = Gh k D^2, d_s D = -eta D), with s_nu and s_D written through the shapes (R = D r gives s = -(eta r + 2 x r')). \
The difference library - paper must vanish identically. ExactlyZeroQ evaluates it at random rational values of every symbol and of every \
shape atom r(x), r'(x), r''(x), r'''(x) separately, so it is a pointwise test, not a test after integration."],
   input["Get[FileNameJoin[{ksDir, \"Checks.wl\"}]];\nksLibrary[\"tau\"] // Short[#, 6] &"],
   input["Table[c -> ExactlyZeroQ[ksLibrary[c] - (ksRef[c] /. ksSRules)], {c, {\"D\", \"nu\", \"zeta\", \"tau\"}}]"],
   text["The r''' terms: the tau flow contains third derivatives of both shapes, which the paper notes cancel for r_nu = alpha r_D."],
   input["{ksThirdDerivatives[ksLibrary[\"tau\"]], ksThirdDerivatives[ksLibrary[\"tau\"] /. ksAlphaRegulator]}"],
   text["Time reversal (Eqs. 19, 32): in d = 1, with r_nu = alpha r_D, the point nu = alpha D, tau = alpha zeta is preserved by the flow, \
d_s nu = alpha d_s D and d_s tau = alpha d_s zeta. The second identity compares the p^4 projection of Gamma(1,1) with the p^2 \
projection of Gamma(0,2). Both hold at every qh in d = 1 and both fail in d = 2."],
   input["Table[d -> {ExactlyZeroQ[(ksLibrary[\"nu\", d] - al ksLibrary[\"D\", d]) /. ksAlphaRegulator /. ksTimeReversal],\n   ExactlyZeroQ[(ksLibrary[\"tau\", d] - al ksLibrary[\"zeta\", d]) /. ksAlphaRegulator /. ksTimeReversal]}, {d, {1, 2}}]"],

   section["6. Summary"],
   text["The same checks as benchmarks/KuramotoSivashinsky/run.wl and the suite hook tests/acceptance/KuramotoSivashinsky.wl. The last \
cell rebuilds the equations from Pipeline.wl (about 20 s, cards hidden) and checks that they are identical to those built above, so that this notebook \
and the scripted benchmark cannot drift apart."],
   input["ksResults = ksChecks[];\nksSummary[ksResults]"],
   input["If[AllTrue[ksResults, #Pass &], \"all checks pass\", Abort[]]"],
   input["nbIntegrands = ksEquations[\"Equations\"][[All, \"Integrand\"]];\nBlock[{ksEquations, Print}, Get[FileNameJoin[{ksDir, \"Pipeline.wl\"}]]; If[ksEquations[\"Equations\"][[All, \"Integrand\"]] === nbIntegrands, \"same equations as Pipeline.wl\", Abort[]]]"]};

Export[FileNameJoin[{dir, "KuramotoSivashinsky.nb"}], Notebook[cells, StyleDefinitions -> "Default.nb"]];

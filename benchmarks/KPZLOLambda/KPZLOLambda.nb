Notebook[{
Cell[554, 20, 116, 0, 70, "Title",ExpressionUUID->"7b933dc5-1255-44af-8183-45bd9c2bbb15"],
Cell[673, 22, 515, 7, 70, "Text",ExpressionUUID->"a8459a09-a3c2-43bd-bec6-d88d3a831208"],
Cell[1191, 31, 519, 7, 70, "Text",ExpressionUUID->"ebf1c7a7-ee61-4b7d-9b17-266e6fe1ab45"],
Cell[1713, 40, 207, 3, 70, "Input",ExpressionUUID->"acf7adbf-5a74-490a-8c66-7c1c3415a7eb"],
Cell[1923, 45, 93, 0, 70, "Section",ExpressionUUID->"402db61c-03a9-4f79-b2a4-5e1e099605d6"],
Cell[2019, 47, 579, 8, 70, "Text",ExpressionUUID->"6064209f-1f47-49a5-aa8a-92ad5434bc1d"],
Cell[2601, 57, 290, 4, 70, "Text",ExpressionUUID->"e1126843-9a1e-475d-88f3-06cd775c843d"],
Cell[2894, 63, 150, 2, 70, "Input",ExpressionUUID->"f830aa28-9895-413c-879e-72d064f5d519"],
Cell[3047, 67, 330, 6, 70, "Input",ExpressionUUID->"b068d797-4760-4cdf-acd2-9815de480816"],
Cell[3380, 75, 127, 0, 70, "Section",ExpressionUUID->"eb8ef5bc-0b56-478f-b0e1-66c76876cde8"],
Cell[3510, 77, 461, 6, 70, "Text",ExpressionUUID->"496c87b3-d5fc-4fb5-83d8-de51407538a7"],
Cell[3974, 85, 431, 7, 70, "Input",ExpressionUUID->"ba4a3fde-03b0-499a-bf7d-0b192ae874a9"],

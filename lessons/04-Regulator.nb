Cell[TextData[{
 StyleBox["symbolsNamed",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " finds no symbol called ",
 StyleBox["q",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", so ",
 StyleBox["p",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is just an unknown symbol: ",
 StyleBox["Regulator.knownSymbols",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". The loop momentum must be called ",
 StyleBox["q",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (it is a reserved name, lesson 00, section 6)."
}], "Text",ExpressionUUID->"a2f230f7-8c9a-47d0-9c19-6ff80084d7eb"]

DefineRegulator[ansatz, {hbar, h} -> nuk q^2 rn[q^2/k^2], \"Shapes\" -> {rn, \
rd}];\
\>", "Input",ExpressionUUID->"63c3c6e2-b960-47cf-ac06-daf80c44726a"],


DefineRegulator[ansatz, {hbar, h} -> nuk q^2 rn[q^2/k^2], \"Shapes\" -> {rn, \
rd}];\
\>", "Input",ExpressionUUID->"d20f4f57-ed00-4773-966d-2245a73c1af8"],


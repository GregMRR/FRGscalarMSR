Notebook[{
Cell["Lesson 04 - Regulator", "Title",ExpressionUUID->"cc9da81f-d80c-4d7c-8f6c-1d2574ff1370"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Declare the regulator R_k(q) that is added to ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2, entry by entry, with ",
 StyleBox["abstract",
  FontWeight->Bold],
 " shape functions r(y), y = q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "/k",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ", and derive its scale derivative ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s R = k ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "k R by the chain rule. The couplings depend on k, so ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s R contains ",
 StyleBox["dsCoupling[c]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " = k dc/dk, which later becomes ",
 StyleBox["\[Minus]\[Eta]",
  FontFamily->"Noto Sans"],
 " c."
}], "Text",ExpressionUUID->"cbadc22c-0246-4e9f-8966-71fc7ebbe87a"],

Cell[TextData[{
 StyleBox["Stage.",
  FontWeight->Bold],
 " Input: the Ansatz stage, rules ",
 StyleBox["{a, b} -> R_ab",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["\"Shapes\" -> {...}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Output: the ",
 StyleBox["\"Regulator\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stage. Regulator does not need the Vertices stage: the two are independent \
and meet in the Propagator (lesson 05)."
}], "Text",ExpressionUUID->"3a77e903-7316-4e72-b039-d20ecd576266"],

Cell["\<\
Get[\"~/Physics/Sources/FRGscalarMSR/FRGscalarMSR.wl\"];
Get[FileNameJoin[{$FRGRoot, \"lessons\", \"LessonSetup.wl\"}]];
ansatz = lessonUpTo[\"Ansatz\"];\
\>", "Input",ExpressionUUID->"d66a362c-59f3-4246-ae9d-be25f86b534a"],

Cell["1. Using it", "Section",ExpressionUUID->"1eb1ce6e-b734-4978-afa5-40ba63f6b56d"],

Cell[TextData[{
 "KPZ: R_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "h}(q) = ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " r_n(y) and R_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "}(q) = ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2D r_d(y)."
}], "Text",ExpressionUUID->"1778cc4d-0f56-4a16-8d85-b64b71fd7787"],

Cell["\<\
regulator = DefineRegulator[ansatz, {hbar, h} -> nuk q^2 rn[q^2/k^2], {hbar, \
hbar} -> -2 Dk rd[q^2/k^2], \"Shapes\" -> {rn, rd}];\
\>", "Input",ExpressionUUID->"1c047aba-200c-4073-a86d-0743e4f52e48"],

Cell[TextData[{
 "Each entry is a ",
 StyleBox["\[CapitalGamma]2-level",
  FontWeight->Bold],
 " entry: what is added to ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_ab, including the factor 2 of a diagonal pair (",
 StyleBox["docs/MODULES.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", convention E10), so that (",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2 + R)_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "} = ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2D(1 + r_d). The accessors give matrices in field order at q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " = s:"
}], "Text",ExpressionUUID->"60e9c895-c8e6-4c20-86e3-15cc0727c0b9"],

Cell["\<\
{RegulatorMatrix[regulator, s], DsRAbstractMatrix[regulator]}\
\>", "Input",ExpressionUUID->"086f4466-513b-4596-9984-879a860c3ea4"],

Cell["DsRRules[regulator, s]", "Input",ExpressionUUID->"2891e470-9b46-4c82-aa1f-9117693b6d1a"],

Cell[TextData[{
 StyleBox["dsR[h, hbar]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a placeholder for the entry of ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s R: the loop integrands of lesson 07 are written with it, and it is \
replaced by the derived expression only at assembly (lesson 11), so that \
intermediate expressions stay small."
}], "Text",ExpressionUUID->"77695c95-70fa-4848-9c2b-cb4719bf9368"],

Cell["2. Arguments: rules and an option", "Section",ExpressionUUID->"161d23d0-7d7a-4a87-9057-dc068d21ee37"],

Cell["\<\
(* Kernel/Regulator.wl:30-46 *)
Options[DefineRegulator] = {\"Shapes\" -> {}};

DefineRegulator[ansatz_, args___] := Block[{$FRGModule = \"Regulator\"},
  Module[{t0 = AbsoluteTime[], theory, fields, resp, cps, pairs, opts, \
shapes, qs, ks, kk, entries, checks = {}, warns = {}, allowed, bad,
    rmat, dsmat, dsAbs, pos, stage, used},
   validateStage[ansatz, \"Ansatz\"];
   theory = ansatz[\"Theory\"]; fields = theory[\"Fields\"]; resp = \
theory[\"ResponseFields\"]; cps = ansatz[\"Couplings\"];
   pairs = Cases[{args}, ({_, _} -> _) | ({_, _} :> _)];
   opts = Cases[{args}, (Rule | RuleDelayed)[_String, _]];
   FRGAssert[\"Regulator.arguments\", Length[pairs] + Length[opts] == \
Length[{args}] && MatchQ[opts, {(\"Shapes\" -> _) ...}],
    Complement[{args}, pairs, opts], \"arguments are {a, b} -> R_ab rules and \
\\\"Shapes\\\" -> {r1, ...}\"];
   shapes = Lookup[opts, \"Shapes\", {}];
   FRGAssert[\"Regulator.shapeList\", ListQ[shapes] && shapes =!= {}, shapes, \
\"\\\"Shapes\\\" -> {r1, r2, ...} is required: the shape functions stay \
abstract\"];
   assertFreshSymbols[\"Regulator.shapes\", shapes, \"shape functions\"];
   FRGAssert[\"Regulator.shapesDistinct\", Intersection[shapes, Join[fields, \
cps, {theory[\"Dimension\"]}]] === {}, Intersection[shapes, Join[fields, cps]],
    \"a shape function has the name of a field, a coupling or the dimension\"];
   FRGAssert[\"Regulator.pairs\", pairs =!= {}, {args}, \"give at least one \
pair {a, b} -> R_ab\"];\
\>", "Program",ExpressionUUID->"3c2e9ab5-be31-4d41-9651-57fc74b5d807"],

Cell[TextData[{
 StyleBox["Mathematica: Sequence patterns",
  FontWeight->Bold],
 "\n",
 StyleBox["x__",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches a sequence of one or more arguments, ",
 StyleBox["x___",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of zero or more; inside the body, ",
 StyleBox["{x}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the list of them.",
 "\n\n",
 StyleBox["DefineRegulator[ansatz_, args___]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " accepts any number of arguments after the ansatz. ",
 StyleBox["OptionsPattern[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " would not do here: the entries ",
 StyleBox["{hbar, h} -> ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are rules too, but their keys are lists, not option names. The constructor \
sorts ",
 StyleBox["{args}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " itself with ",
 StyleBox["Cases",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Cases and level specifications",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "): rules with a two-element list as key are entries, rules with a string \
key are options, and anything else is an error (",
 StyleBox["Regulator.arguments",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"6ea3f646-0385-46e0-95d5-27be413c501c"],

Cell[TextData[{
 StyleBox["Lookup[opts, \"Shapes\", {}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " works on a list of rules as well as on an association (",
 StyleBox["Association",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ")."
}], "Text",ExpressionUUID->"4810445a-8d0a-4868-a089-1fc63eb980e4"],

Cell["3. Which pairs are allowed", "Section",ExpressionUUID->"4bf3ec32-1274-458a-986a-6953bc8f59e9"],

Cell["\<\
(* Kernel/Regulator.wl:48-57 *)
   (* pairs: fields of the theory, at least one response field, each \
unordered pair once *)
   AppendTo[checks, assertCheck[\"Regulator.pairFields\", AllTrue[pairs[[All, \
1]], SubsetQ[fields, #] &], Select[pairs[[All, 1]], ! SubsetQ[fields, #] &],
     \"regulator pairs must be fields of the theory\", \"pairs are fields of \
the theory\"]];
   AppendTo[checks, assertCheck[\"Regulator.responsePair\", \
AllTrue[pairs[[All, 1]], IntersectingQ[#, resp] &], Select[pairs[[All, 1]], ! \
IntersectingQ[#, resp] &],
     \"a regulator entry between two physical fields would break causality \
(Gamma2_{phi phi} = 0): only phibar phi and phibar phibar pairs\",
     \"only phibar-phi / phibar-phibar pairs\"]];
   pos[a_] := First[FirstPosition[fields, a]];
   pairs = (SortBy[#[[1]], pos] -> #[[2]]) & /@ pairs;
   AppendTo[checks, assertCheck[\"Regulator.pairOnce\", \
DuplicateFreeQ[pairs[[All, 1]]], pairs[[All, 1]],
     \"a pair is given twice ({a, b} and {b, a} are the same entry: R is \
symmetric because it is even in q and w-independent)\", \"each pair given \
once\"]];\
\>", "Program",ExpressionUUID->"ae4d0df3-f222-4d64-a789-5ad853605999"],

Cell[TextData[{
 StyleBox["SubsetQ[fields, pair]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tests that both fields belong to the theory, and ",
 StyleBox["IntersectingQ[pair, responseFields]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " that the pair contains a response field. A ",
 StyleBox["\[CurlyPhi]\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 " entry would give ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_{",
 StyleBox["\[CurlyPhi]\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "} ",
 StyleBox["\[NotEqual]",
  FontFamily->"Noto Sans"],
 " 0 and break causality:"
}], "Text",ExpressionUUID->"9a2456a3-18b4-4380-a370-a58c6a039291"],

Cell["\<\
showFailure[DefineRegulator[ansatz, {h, h} -> nuk q^2 rn[q^2/k^2], \"Shapes\" \
-> {rn}]]\
\>", "Input",ExpressionUUID->"5b1a3a9c-3a7e-4b19-a15f-a66dd598f3b2"],

Cell[TextData[{
 "Each pair is then put in field order (",
 StyleBox["SortBy[#[[1]], pos]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["DeleteCases, SortBy and FirstPosition",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "): R is even in q and ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "-independent, hence symmetric, so ",
 StyleBox["{hbar, h}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["{h, hbar}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are the same entry and may be given only once."
}], "Text",ExpressionUUID->"6f661e7f-57c4-44b0-b71b-57815a73fbe2"],

Cell["4. Your q and your k", "Section",ExpressionUUID->"483d91cc-dbdf-496b-a9f4-1b38445a2442"],

Cell["\<\
(* Kernel/Regulator.wl:59-67 *)
   (* the user writes q (loop momentum) and k (scale): any context, matched \
by name *)
   qs = symbolsNamed[pairs[[All, 2]], \"q\"]; ks = symbolsNamed[pairs[[All, \
2]], \"k\"];
   FRGAssert[\"Regulator.momentumSymbol\", Length[qs] <= 1 && Length[ks] == \
1, {qs, ks},
    \"write the entries with one loop-momentum symbol q and one scale symbol \
k, shapes as r[q^2/k^2]\"];
   kk = First[ks];
   FRGAssert[\"Regulator.scaleFree\", AllTrue[Join[ks, qs], OwnValues[#] === \
{} && DownValues[#] === {} &], Join[ks, qs], \"k and q must have no \
values\"];
   entries = Association[(#[[1]] -> If[qs === {}, #[[2]], toS[#[[2]], \
First[qs]]]) & /@ pairs];
   AppendTo[checks, assertCheck[\"Regulator.evenInQ\", FreeQ[Values[entries], \
Alternatives @@ qs], Select[entries, ! FreeQ[#, Alternatives @@ qs] &],
     \"R_ab must depend on q through q^2 only (even powers of q)\", \"R \
depends on q^2 only\"]];\
\>", "Program",ExpressionUUID->"b5ef2ec6-97a5-43d6-b92a-c1759eccc552"],

Cell["\<\
(* Kernel/Regulator.wl:25 *)
symbolsNamed[e_, name_] := Union[Cases[e, x_Symbol /; SymbolName[x] === name, \
{0, Infinity}, Heads -> True]];\
\>", "Program",ExpressionUUID->"140fbf1e-6325-48a4-ba8b-00829c8dc796"],

Cell["\<\
(* Kernel/Regulator.wl:27-28 *)
(* q^n -> sq^(n/2), n even: R depends on q only through q^2 *)
toS[e_, qsym_] := e /. Power[qsym, n_Integer?EvenQ] :> sq^(n/2);\
\>", "Program",ExpressionUUID->"fb1d7b20-b14a-4df4-9c7b-34496335e84c"],

Cell[TextData[{
 "The entries are written with ",
 StyleBox["your",
  FontSlant->Italic],
 " symbols ",
 StyleBox["q",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["k",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". In these lessons they live in the notebook's own context (lesson 00), in \
a script in `",
 StyleBox["Global",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" : the library cannot know in advance which symbol ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "q",
 StyleBox[" is, so ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "symbolsNamed",
 StyleBox[" finds them by their short name (",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "SymbolName",
 StyleBox[", [[Symbol and SymbolName]]). ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "k",
 StyleBox[" remains the scale symbol in every later stage, and your ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "q",
 StyleBox[" is stored as ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "\"LoopMomentum\"`."
}], "Text",ExpressionUUID->"1f8cfae3-eb41-4521-80fa-a1a1a8e05261"],

Cell[TextData[{
 StyleBox["Mathematica: PatternTest",
  FontWeight->Bold],
 "\n",
 StyleBox["x_?test",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches x only if ",
 StyleBox["test[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True; ",
 StyleBox["n_Integer?EvenQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches even integers.",
 "\n\n",
 StyleBox["toS",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces ",
 StyleBox["q^n",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with n even by ",
 StyleBox["sq^(n/2)",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": from here on, R is a function of q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " only. An odd power of ",
 StyleBox["q",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " survives the replacement, and ",
 StyleBox["Regulator.evenInQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " catches it. ",
 StyleBox["p_?test",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " differs from ",
 StyleBox["p_ /; cond",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") only in form: the test is a function applied to the match."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"053dabfc-2788-4105-9504-6c5eeef0bea4"],

Cell["\<\
showFailure[DefineRegulator[ansatz, {hbar, h} -> nuk q^2 rn[q/k], \"Shapes\" \
-> {rn}]]\
\>", "Input",ExpressionUUID->"f49d5758-ec58-4a01-9697-71e0274afc27"],

Cell[TextData[{
 StyleBox["sq",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a private helper symbol standing for q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ". It is the example of the shared-private-context gotcha in CLAUDE.md: \
every module's helpers live in `",
 StyleBox["FRGscalarMSR",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "Private`",
 StyleBox[" (lesson 00, section 2), so a helper called ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "sq` in another module would be the same symbol."
}], "Text",ExpressionUUID->"91acd332-d66e-4336-83bd-b693ab2c4153"],

Cell["Context[FRGscalarMSR`Private`sq]", "Input",ExpressionUUID->"42e5c196-5b3f-46bc-9656-b140d2acbbf7"],

Cell["5. What may appear in an entry", "Section",ExpressionUUID->"d5eee32b-d840-44cc-9b2f-039919b952f0"],

Cell["\<\
(* Kernel/Regulator.wl:73-85 *)
   allowed = Join[cps, {kk, sq}];
   bad = Complement[Cases[Values[entries], x_Symbol /; Context[x] =!= \
\"System`\", {0, Infinity}, Heads -> False], allowed];
   AppendTo[checks, assertCheck[\"Regulator.knownSymbols\", bad === {}, bad,
     \"R_ab may contain the couplings of the ansatz, q, k and the declared \
shapes only (in particular no frequency: R is w-independent)\",
     \"only couplings, q, k and shapes; w-independent\"]];
   bad = Complement[Cases[Values[entries], (h_Symbol /; Context[h] =!= \
\"System`\")[___] :> h, {0, Infinity}], shapes];
   AppendTo[checks, assertCheck[\"Regulator.onlyDeclaredShapes\", bad === {}, \
bad, \"every function in R_ab must be a declared shape\", \"the declared \
shapes are the only free functions\"]];
   bad = Cases[Values[entries], (r : Alternatives @@ shapes)[x___] /; {x} =!= \
{sq/kk^2}, {0, Infinity}];
   AppendTo[checks, assertCheck[\"Regulator.shapeArgument\", bad === {} && \
FreeQ[Values[entries], Derivative[__][Alternatives @@ shapes]] && \
FreeQ[Values[entries] /. (Alternatives @@ shapes)[sq/kk^2] -> 1, Alternatives \
@@ shapes],
     bad, \"shapes appear only as r[q^2/k^2] (no derivatives, no other \
argument)\", \"shapes appear as r[q^2/k^2]\"]];
   used = Select[shapes, ! FreeQ[Values[entries], #] &];
   If[used =!= shapes, AppendTo[warns, infoCheck[\"WARN\", \
\"Regulator.unusedShapes\", \"declared but unused: \" <> \
ToString[Complement[shapes, used]]]]];
   AppendTo[checks, assertCheck[\"Regulator.nonzero\", \
AllTrue[Values[entries], # =!= 0 &], Select[entries, # === 0 &], \"drop pairs \
with R_ab = 0\", \"no zero entry\"]];\
\>", "Program",ExpressionUUID->"064696ef-433b-4ebe-b848-fda06654b37c"],

Cell[TextData[{
 "Three separate checks: only couplings, ",
 StyleBox["k",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " and shapes as symbols (no frequency, since R is ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "-independent); only the declared shapes as functions (",
 StyleBox["(h_Symbol /; ...)[___] :> h",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " collects the heads of all function calls); and every shape only in the \
form r[q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "/k",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "], with no derivative and no other argument."
}], "Text",ExpressionUUID->"efa00a77-a406-41fe-8550-cc1951e6895f"],

Cell["\<\
showFailure[DefineRegulator[ansatz, {hbar, h} -> nuk q^2 rn[q^2/k^2] w, \
\"Shapes\" -> {rn}]]\
\>", "Input",ExpressionUUID->"7c99fa80-0b74-4119-b27d-efa181f387b6"],

Cell[TextData[{
 StyleBox["Why it's built this way: Shapes stay abstract",
  FontWeight->Bold],
 "\n\n",
 "The shape functions are never given a formula. The flow equations come out \
as functionals of r(y), r",
 StyleBox["\[Prime]",
  FontFamily->"Noto Sans"],
 "(y), r",
 StyleBox["\[DoublePrime]",
  FontFamily->"Noto Sans"],
 "(y), ..., valid for every regulator, and the choice (Litim, exponential, \
...) is made in FlowRG, after the export (lesson 15). Abstract shapes also \
make the symbolic checks stronger: ",
 StyleBox["ExactlyZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives every atom r(y), r",
 StyleBox["\[Prime]",
  FontFamily->"Noto Sans"],
 "(y) its own random value (lesson 00, section 5), so an identity that passes \
holds for arbitrary shapes, not by luck for one of them. The price is that \
the shapes must appear in one fixed form, r[q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "/k",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "], which is what the checks of this section enforce."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"38412cc2-9afe-4ad9-99d4-c1ae52e787e2"],

Cell["6. The scale derivative, two ways", "Section",ExpressionUUID->"ccca2423-6641-4511-9a56-8ed38d0204a1"],

Cell["\<\
(* Kernel/Regulator.wl:87-95 *)
   (* d_s R by the chain rule: k d/dk at fixed q; couplings c(k) -> \
dsCoupling[c] *)
   rmat = Table[Lookup[entries, Key[SortBy[{a, b}, pos]], 0], {a, fields}, \
{b, fields}];
   dsmat = Map[Expand[Sum[D[#, c] dsCoupling[c], {c, cps}] + kk D[#, kk]] &, \
rmat, {2}];
   dsAbs = Table[If[rmat[[i, j]] === 0, 0, dsR @@ SortBy[{fields[[i]], \
fields[[j]]}, pos]], {i, Length[fields]}, {j, Length[fields]}];
   (* the same derivative by a second route: couplings as functions c(k), \
total k d/dk, c'(k) -> dsCoupling[c]/k *)
   AppendTo[checks, assertCheck[\"Regulator.dsRChainRule\",
     AllTrue[Flatten[dsmat - Map[(kk D[# /. Thread[cps -> (cf[#][kk] & /@ \
cps)], kk] /. Derivative[1][cf[c_]][kk] :> dsCoupling[c]/kk /. cf[c_][kk] :> \
c) &, rmat, {2}]], ExactlyZeroQ],
     dsmat, \"internal: the two computations of d_s R differ\",
     \"d_s R = sum_c dR/dc dsCoupling[c] + k dR/dk  (k d/dk r(q^2/k^2) = -2 y \
r'(y)); checked by a second route\"]];\
\>", "Program",ExpressionUUID->"7cab28a3-1b1c-4584-8b34-d243f44e2806"],

Cell[TextData[{
 StyleBox["Mathematica: D and unknown functions",
  FontWeight->Bold],
 "\n",
 StyleBox["D[e, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " differentiates; on a function with no definition it applies the chain rule \
and writes the derivative as ",
 StyleBox["Derivative[1][r][arg]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", displayed ",
 StyleBox["r'[arg]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ".",
 "\n\n",
 StyleBox["k D[rn[q^2/k^2], k]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2 q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "/k",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " r_n",
 StyleBox["\[Prime]",
  FontFamily->"Noto Sans"],
 "(q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "/k",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "), that is ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2 y r",
 StyleBox["\[Prime]",
  FontFamily->"Noto Sans"],
 "(y): Mathematica knows the chain rule without knowing r. ",
 StyleBox["Derivative[1][rn]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is itself an expression, the derivative of the function ",
 StyleBox["rn",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which is why ",
 StyleBox["ExactlyZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " treats ",
 StyleBox["Derivative[1][rn][y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " as one atom."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"80dbb78d-8603-4c9a-89bd-5e4081f349bd"],

Cell["k D[rn[q^2/k^2], k]", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"5eef23f6-b17b-40e3-b8d4-239f7ff239cc"],

Cell[TextData[{
 StyleBox["Mathematica: Map at a level",
  FontWeight->Bold],
 "\n",
 StyleBox["Map[f, matrix, {2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f to every element at depth 2, that is, to every entry of a \
matrix.",
 "\n\n",
 StyleBox["Map[f, {{1, 2}, {3, 4}}, {2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["{{f[1], f[2]}, {f[3], f[4]}}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Without the level specification, ",
 StyleBox["Map",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " would apply f to the rows."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"49991d5d-6e8e-4dc7-a768-36a3071194c8"],

Cell[TextData[{
 "The first route differentiates at fixed couplings and adds ",
 StyleBox["\[CapitalSigma]",
  FontFamily->"Noto Sans"],
 "_c ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "R/",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "c ",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["dsCoupling[c]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". The second route makes each coupling an explicit function ",
 StyleBox["cf[c][k]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", takes the total derivative k d/dk, and replaces ",
 StyleBox["cf[c]'[k]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " by ",
 StyleBox["dsCoupling[c]/k",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["Regulator.dsRChainRule",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " requires the two to agree, with ",
 StyleBox["ExactlyZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"49a3ef0c-ad65-4e8c-a0de-ba4d27d7d650"],

Cell["7. The stage stores functions", "Section",ExpressionUUID->"444a81bc-676c-4ab2-a7a0-6e9850408498"],

Cell[BoxData[
 $CellContext`regionCells[
 "Kernel/Regulator.wl", "stage = stampStage[<", "\"Stage\" -> \"Regulator\"", 
  "\"Checks\" -> checks, \"Warnings\" -> warns"]], "Input",ExpressionUUID->\
"1dcb802c-33e9-4107-a157-b57f503fabb6"],

Cell["\<\
(* Kernel/Regulator.wl:106-109 *)
RegulatorMatrix[r_Association, s_] := r[\"RMatrix\"][s];
DsRegulatorMatrix[r_Association, s_] := r[\"DsRMatrix\"][s];
DsRAbstractMatrix[r_Association] := r[\"DsRAbstract\"];
DsRRules[r_Association, s_] := \
DeleteDuplicates[DeleteCases[Flatten[MapThread[Rule, {r[\"DsRAbstract\"], \
r[\"DsRMatrix\"][s]}, 2]], 0 -> _]];\
\>", "Program",ExpressionUUID->"d9396691-b784-4103-8208-a46ac693c0cb"],

Cell[TextData[{
 StyleBox["Mathematica: Function and Evaluate",
  FontWeight->Bold],
 "\n",
 StyleBox["Function[{x}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " holds its body unevaluated; ",
 StyleBox["Function[{x}, Evaluate[body]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates it first, so the stored function contains the computed result.",
 "\n\n",
 StyleBox["\"RMatrix\" -> Function[Evaluate[{sq}], Evaluate[rmat]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stores the matrix as a function of q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ": ",
 StyleBox["regulator[\"RMatrix\"][s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " substitutes ",
 StyleBox["s",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for ",
 StyleBox["sq",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["Function",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " has the attribute ",
 StyleBox["HoldAll",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Hold attributes",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "); without ",
 StyleBox["Evaluate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the body would be the ",
 StyleBox["symbol",
  FontSlant->Italic],
 " ",
 StyleBox["rmat",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", a ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " variable that is gone after the call. The first ",
 StyleBox["Evaluate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is needed for the same reason: ",
 StyleBox["{sq}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " must be the list of the actual private symbol."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"40b0d31f-e86f-4a07-92fe-e8d7d7016dcf"],

Cell["\<\
{Function[{x}, Expand[(x + 1)^2]], Function[{x}, Evaluate[Expand[(x + \
1)^2]]], regulator[\"RMatrix\"]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"71a7abd0-d73b-490a-a81c-795dfd40872d"],

Cell[TextData[{
 StyleBox["DsRRules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " pairs each abstract ",
 StyleBox["dsR[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with its derived entry (",
 StyleBox["MapThread[Rule, {m1, m2}, 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " builds rules entry by entry) and removes the zero entries and the \
duplicates (",
 StyleBox["DeleteDuplicates",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": R is symmetric, so ",
 StyleBox["dsR[h, hbar]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " appears twice)."
}], "Text",ExpressionUUID->"1142efea-601c-47e7-b3a5-661f391738d4"],

Cell[TextData[{
 StyleBox["Why it's built this way: Matrices as functions of q\.b2",
  FontWeight->Bold],
 "\n\n",
 "The later modules need R and ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s R at the loop momentum q, and at shifted momenta such as (q + p)",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " for the momentum projection (lesson 08). Storing a function of q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " lets each caller pass whatever it needs, ",
 StyleBox["scal[q, q]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " or ",
 StyleBox["scal[q + p, q + p]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", without the regulator knowing about it. Since R depends on q only through \
q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " (section 4), one argument is enough."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"1729c9ba-e004-4ecb-8cfb-acce6a6096dc"],

Cell["Exercises", "Section",ExpressionUUID->"83e3e345-5919-464b-90a8-002327b07928"],

Cell["Exercise: \[PartialD]s R by hand", "Subsection",ExpressionUUID->"a5181f3c-a84b-41d2-8738-b4fa335de540"],

Cell[TextData[{
 "Compute k ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "k of R_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "h} = ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 "(k) q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " r_n(q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "/k",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ") by hand and compare with ",
 StyleBox["DsRRules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"5ec2ff14-e67f-4069-8cea-52c6ca821da3"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"8ce83340-8239-4209-b1e7-89e6c88226dd"],

Cell[TextData[{
 "k ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "k gives (k ",
 StyleBox["\[Nu]\[Prime]",
  FontFamily->"Noto Sans"],
 ") q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " r_n + ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " (",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2 q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "/k",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ") r_n",
 StyleBox["\[Prime]",
  FontFamily->"Noto Sans"],
 " = q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["dsCoupling[nuk]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " r_n(y) ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " 2 ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " q",
 StyleBox["\:2074",
  FontFamily->"Noto Sans"],
 "/k",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " r_n",
 StyleBox["\[Prime]",
  FontFamily->"Noto Sans"],
 "(y), the first rule of:"
}], "Text",ExpressionUUID->"8c72eb8d-fa97-4950-bed2-adb726933f81"],

Cell["DsRRules[regulator, s]", "Input",ExpressionUUID->"287301b1-4aea-4113-ae7a-34cb8e8dbc62"]
}, Closed]],

Cell["Exercise: An unused shape", "Subsection",ExpressionUUID->"33b9031f-0693-4e8b-9a29-33acb30bcee0"],

Cell[TextData[{
 "Regulate only the ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "h entry but declare both ",
 StyleBox["rn",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["rd",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". What does the card say? Is the result usable?"
}], "Text",ExpressionUUID->"91949c79-4c53-4260-91df-bcda50a3d71d"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"f07a0d74-e550-4eb4-9ff2-65a3ce6bb589"],


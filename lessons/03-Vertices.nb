Notebook[{
Cell["Lesson 03 - Vertices", "Title",ExpressionUUID->"91fba141-d19d-4310-ae52-6d8bc73b8882"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Fourier-transform the parsed density (",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "t ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " +i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", ",
 StyleBox["\[Del]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "iq, all momenta incoming) and build every vertex ",
 StyleBox["\[CapitalGamma]\:207d\:207f\:207e",
  FontFamily->"Noto Sans"],
 ", n = 2..4, as the symmetrised n-th functional derivative of ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_k with the ",
 StyleBox["\[Delta]",
  FontFamily->"Noto Sans"],
 " function stripped. ",
 StyleBox["\[CapitalGamma]\:207d\.b2\:207e",
  FontFamily->"Noto Sans"],
 " gives the matrix ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_ab(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", q); ",
 StyleBox["\[CapitalGamma]\:207d\.b3\:207e",
  FontFamily->"Noto Sans"],
 " the cubic vertices of the one-loop flow."
}], "Text",ExpressionUUID->"b72bce56-bdc5-442c-9c0d-83791cc4912f"],

Cell[TextData[{
 StyleBox["Stage.",
  FontWeight->Bold],
 " Input: the Ansatz stage. Output: the ",
 StyleBox["\"Vertices\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stage, whose ",
 StyleBox["\"VertexTable\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " maps each field multiset to its vertex."
}], "Text",ExpressionUUID->"203bd0cd-d87d-424e-bf64-3ee58349f2fe"],

Cell["\<\
Get[\"~/Physics/Sources/FRGscalarMSR/FRGscalarMSR.wl\"];
Get[FileNameJoin[{$FRGRoot, \"lessons\", \"LessonSetup.wl\"}]];
ansatz = lessonUpTo[\"Ansatz\"];\
\>", "Input",ExpressionUUID->"34189940-8c7a-4933-94be-1f0dd6199166"],

Cell["1. Using it", "Section",ExpressionUUID->"ffc45b61-54e8-40a7-9df9-b4871702be93"],

Cell["vertices = BuildVertices[ansatz];", "Input",ExpressionUUID->"2479e8d3-f2ee-4cd3-8b03-9c4fde564442"],

Cell[TextData[{
 "The table starts with the conventions (",
 StyleBox["docs/CONVENTIONS.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), then ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2 and the higher vertices. For KPZ: ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_{h ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "}(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", q) = i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " + ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ", ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "} = ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2D, and one cubic vertex ",
 StyleBox["\[CapitalGamma]\:207d\.b3\:207e",
  FontFamily->"Noto Sans"],
 "_{h h ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "}(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "1, q1; ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "2, q2) = ",
 StyleBox["\[Lambda]",
  FontFamily->"Noto Sans"],
 " q1",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "q2. Three accessors evaluate vertices in the leg convention:"
}], "Text",ExpressionUUID->"d6c4d4ef-d3b3-4e1f-b834-ad2918f25271"],

Cell["\<\
{Gamma2Matrix[vertices, w, q], VertexValue[vertices, {hbar, h, h}, {{w1, p1}, \
{w2, p2}}], Gamma3Matrix[vertices, hbar, {nu, p}, {w, q}]}\
\>", "Input",ExpressionUUID->"d6fa7c6e-2730-4443-9c75-0efdee4becd9"],

Cell[TextData[{
 StyleBox["VertexValue[v, {a1, ..., an}, {{\[Omega]1, q1}, ..., {\[Omega](n\
\[Minus]1), q(n\[Minus]1)}}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " puts leg j at (",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "j, qj) and the last leg at minus their sum. In ",
 StyleBox["{hbar, h, h}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " above, the last ",
 StyleBox["h",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " carries ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "(p1 + p2), so ",
 StyleBox["\[Lambda]",
  FontFamily->"Noto Sans"],
 " p2",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "p1 ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " p2) = ",
 StyleBox["\[Minus]\[Lambda]",
  FontFamily->"Noto Sans"],
 "(p1",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "p2 + p2",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")."
}], "Text",ExpressionUUID->"650e3cdc-45f8-4e61-abab-1541ebf664fe"],

Cell["2. What is stored", "Section",ExpressionUUID->"43794782-4f5b-4bc4-b8a1-55fd7610ec90"],

Cell["vertices[\"VertexTable\"]", "Input",ExpressionUUID->"9d7e24ed-97dc-4051-97ff-78560def0b42"],

Cell[TextData[{
 "The keys are field ",
 StyleBox["multisets",
  FontWeight->Bold],
 " sorted in field order: ",
 StyleBox["{h, h, hbar}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stands for every ordering of the legs. The values are the vertices with \
*all n* momenta independent, written with private leg symbols ",
 StyleBox["wv[l]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["qv[l]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (frequency and momentum of leg l), before the momentum conservation is \
used."
}], "Text",ExpressionUUID->"fb704c95-fe55-4445-a46b-477f29126ce8"],

Cell[TextData[{
 StyleBox["Why it's built this way: Store one vertex per multiset, evaluate \
any ordering on demand",
  FontWeight->Bold],
 "\n\n",
 StyleBox["\[CapitalGamma]\:207d\.b3\:207e",
  FontFamily->"Noto Sans"],
 "_{h h ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "}, ",
 StyleBox["\[CapitalGamma]\:207d\.b3\:207e",
  FontFamily->"Noto Sans"],
 "_{h ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " h} and ",
 StyleBox["\[CapitalGamma]\:207d\.b3\:207e",
  FontFamily->"Noto Sans"],
 "_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " h h} are the same function with the legs relabelled. Storing the fully \
symmetrised vertex once, as a function of all n momenta, and relabelling at \
evaluation time keeps the table small (a quartic vertex of two fields would \
otherwise need up to 4! entries) and makes the symmetry impossible to get \
wrong: there is only one expression. The last leg is fixed by momentum \
conservation only when a vertex is evaluated, so the stored form never \
depends on which leg was chosen as \"last\"."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"3679258c-5168-4edf-a040-c69dedf7ccc7"],

Cell["3. Fourier symbols of a monomial", "Section",ExpressionUUID->"aa297e7f-5ab7-4a83-a037-1e268ff3f99d"],

Cell["\<\
(* Kernel/Vertices.wl:26-27 *)
(* leg l carries frequency wv[l] and momentum qv[l]; a factor dt^nt d_i.. phi \
at leg l gives (I wv[l])^nt (-I qv[l]_i)... *)
factorSymbol[FieldFactor[_, nt_, ix_], l_] := {(I wv[l])^nt (-I)^Length[ix], \
Thread[ix -> qv[l]]};\
\>", "Program",ExpressionUUID->"1b1be62b-0453-4a29-bbd5-9420a6269db1"],

Cell["\<\
(* Kernel/Vertices.wl:29-33 *)
(* a SpaceIndex pair gives scal[qa, qb]; the eps pair EpsIndex[1], \
EpsIndex[2] gives wedge[q(slot 1), q(slot 2)] *)
monomialAt[m_Association, perm_List] := Module[{parts = \
MapThread[factorSymbol, {m[\"Factors\"], perm}], g},
   g = GroupBy[Flatten[parts[[All, 2]]], First -> Last];
   m[\"Coefficient\"] Times @@ parts[[All, 1]] Times @@ (scal @@ # & /@ \
Values[KeySelect[g, FreeQ[#, EpsIndex] &]]) *
    If[KeyExistsQ[g, EpsIndex[1]], wedge[First[g[EpsIndex[1]]], \
First[g[EpsIndex[2]]]], 1]];\
\>", "Program",ExpressionUUID->"24051c02-43e4-46a9-b60b-05aafb0ccc67"],

Cell[TextData[{
 StyleBox["Mathematica: Complex numbers",
  FontWeight->Bold],
 "\n",
 StyleBox["I",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the exact imaginary unit; ",
 StyleBox["Im",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Re",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Conjugate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " work on exact and symbolic expressions.",
 "\n\n",
 StyleBox["(I wv[l])^nt (-I)^Length[ix]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the symbol of ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "t^nt ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "_i... at leg l: one factor i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " per time derivative and one ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "i per spatial index (the vector itself, ",
 StyleBox["qv[l]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", is attached to each index by the rule ",
 StyleBox["Thread[ix -> qv[l]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). ",
 StyleBox["I",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is exact like a rational number, so ",
 StyleBox["(-I)^2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is exactly ",
 StyleBox["-1",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"06b26a4a-a3e3-4e16-8458-7fca714f3fd4"],

Cell[TextData[{
 StyleBox["factorSymbol",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns two things for each factor: its scalar prefactor, and rules saying \
which momentum each index carries. ",
 StyleBox["monomialAt",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " then groups the rules by index (",
 StyleBox["GroupBy[..., First -> Last]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["GroupBy and KeyValueMap",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "): each ",
 StyleBox["SpaceIndex",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " appears on two factors, so it collects two momenta, and ",
 StyleBox["scal @@ {qa, qb}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " contracts them. The ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 " pair becomes a ",
 StyleBox["wedge",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["FixedPoint",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " showed its algebra)."
}], "Text",ExpressionUUID->"0cf7a7de-f2a8-4703-a921-73828aeff2b9"],

Cell[TextData[{
 StyleBox["Mathematica: KeySelect and Values",
  FontWeight->Bold],
 "\n",
 StyleBox["KeySelect[assoc, test]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " keeps the entries whose key passes test; ",
 StyleBox["Values[assoc]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists the values.",
 "\n\n",
 StyleBox["Values[KeySelect[g, FreeQ[#, EpsIndex] &]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " takes the momentum pairs of the ordinary indices and leaves out the ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 " slots, which are handled separately."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"ef5c2b75-98d8-4a3c-84be-c06ef5d0774c"],

Cell[TextData[{
 "For the cubic KPZ monomial ",
 StyleBox["\[Minus]\[Lambda]",
  FontFamily->"Noto Sans"],
 "/2 ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Del]",
  FontFamily->"Noto Sans"],
 "h",
 StyleBox["\[CenterDot]\[Del]",
  FontFamily->"Noto Sans"],
 "h, with ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " at leg 1 and the two h at legs 2 and 3:"
}], "Text",ExpressionUUID->"341ab4f1-c991-4cd1-bb02-bd039261fa1c"],

Cell["\<\
m = ansatz[\"Monomials\"][[4]];
{FRGscalarMSR`Private`factorSymbol[m[\"Factors\"][[2]], 2], \
FRGscalarMSR`Private`monomialAt[m, {1, 2, 3}]}\
\>", "Input",ExpressionUUID->"a4c529c5-e53b-4ab6-ba0c-78bd7c2ce7bc"],

Cell[TextData[{
 "(",
 StyleBox["\[Minus]\[Lambda]",
  FontFamily->"Noto Sans"],
 "/2)(",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "i)",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " q2",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "q3 = ",
 StyleBox["\[Lambda]",
  FontFamily->"Noto Sans"],
 "/2 q2",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "q3."
}], "Text",ExpressionUUID->"71ba66e0-5fcf-4910-9958-2827afa3e131"],

Cell["4. Symmetrisation: summing over assignments of legs", "Section",ExpressionUUID->"b288eaca-8c02-4cc4-9726-627068b2b142"],

Cell["\<\
(* Kernel/Vertices.wl:35-39 *)
(* Gamma^(n) for the field multiset ms (sorted in field order), all n momenta \
independent (before delta stripping):
   sum over every assignment of the monomial's factors to the legs carrying \
the same field = full symmetrisation *)
vertexExpr[ms_List, mons_List, sortF_] := Expand[Total[Function[m,
      Total[monomialAt[m, #] & /@ Select[Permutations[Range[Length[ms]]], \
m[\"Fields\"] === ms[[#]] &]]] /@
     Select[mons, #FieldCount == Length[ms] && sortF[#Fields] === ms &]]];\
\>", "Program",ExpressionUUID->"98ca4b40-8603-4ec5-90dc-37f8e7748539"],

Cell[TextData[{
 "The functional derivative of ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Del]",
  FontFamily->"Noto Sans"],
 "h",
 StyleBox["\[CenterDot]\[Del]",
  FontFamily->"Noto Sans"],
 "h with respect to ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "(1) h(2) h(3) is the sum over the two ways of attaching the two h factors \
to legs 2 and 3. ",
 StyleBox["vertexExpr",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " does exactly this: among all ",
 StyleBox["Permutations",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of the legs (",
 StyleBox["Sort and canonical order",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") it keeps those that put each factor on a leg of the same field, and adds \
the symbols. Identical fields therefore give the multiplicity factors \
automatically (2 for ",
 StyleBox["h\:0304\.b2",
  FontFamily->"Noto Sans"],
 ", 3! for ",
 StyleBox["\[CurlyPhi]\:0304\[CurlyPhi]\.b3",
  FontFamily->"Noto Sans"],
 "). Here the two terms are equal and give ",
 StyleBox["\[Lambda]",
  FontFamily->"Noto Sans"],
 " q2",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "q3, the entry of the table."
}], "Text",ExpressionUUID->"f14081d6-bb5f-48a0-9e4b-12a06cdc3455"],

Cell["5. Building the table", "Section",ExpressionUUID->"41a89b57-3e85-425f-8e4a-42aa20d58769"],

Cell["\<\
(* Kernel/Vertices.wl:109-118 *)
BuildVertices[ansatz_] := Block[{$FRGModule = \"Vertices\"},
  Module[{t0 = AbsoluteTime[], theory, fields, phis, bars, sortF, mons, nmax, \
msets, table, checks = {}, warns = {}, stage, w, q, g2, bad,
    pw, conv, nc},
   validateStage[ansatz, \"Ansatz\"];
   theory = ansatz[\"Theory\"]; fields = theory[\"Fields\"]; phis = \
theory[\"Scalars\"]; bars = theory[\"ResponseFields\"];
   mons = ansatz[\"Monomials\"];
   sortF[l_] := SortBy[l, First[FirstPosition[fields, #]] &];
   nmax = Max[4, Max[#FieldCount & /@ mons]];
   msets = Join @@ Table[Union[sortF /@ Tuples[fields, n]], {n, 2, nmax}];
   table = Association[DeleteCases[(# -> vertexExpr[#, mons, sortF]) & /@ \
msets, _ -> 0]];\
\>", "Program",ExpressionUUID->"f3b5cfb8-60ad-4481-8af3-299cf9c8072f"],

Cell[TextData[{
 StyleBox["Mathematica: Tuples",
  FontWeight->Bold],
 "\n",
 StyleBox["Tuples[list, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives every list of n elements drawn from list, with repetition and in \
every order.",
 "\n\n",
 StyleBox["Tuples[{h, hbar}, 3]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " has 8 elements. Sorting each in field order and taking the ",
 StyleBox["Union",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " leaves the 4 multisets {h,h,h}, {h,h,",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "}, {h,",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 ",",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "}, {",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 ",",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 ",",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "}. ",
 StyleBox["Join @@ Table[..., {n, 2, nmax}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " concatenates the lists for n = 2, 3, 4 (",
 StyleBox["Apply",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " with head ",
 StyleBox["Join",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"6dd8f7f6-2434-4dab-9667-a7f310c8993a"],

Cell["{Tuples[{h, hbar}, 2], Union[Sort /@ Tuples[{h, hbar}, 3]]}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],

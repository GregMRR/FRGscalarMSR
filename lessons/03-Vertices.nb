  0.91, 0.95, 1.],ExpressionUUID->"0e7c82db-d95d-4876-894b-1cab45c4918a"],

Cell["{Ordering[{3, 1, 2}], {c, a, b}[[Ordering[{c, a, b}]]]}", "Input",

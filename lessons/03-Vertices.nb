  0.91, 0.95, 1.],ExpressionUUID->"f5a0394f-7f2d-4871-9aa7-5b8b8008c823"],

Cell["{Ordering[{3, 1, 2}], {c, a, b}[[Ordering[{c, a, b}]]]}", "Input",

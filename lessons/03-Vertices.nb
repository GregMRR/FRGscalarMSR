Cell["7. An independent check: plane waves into the raw density", "Section",ExpressionUUID->"38295d09-5f77-4546-8724-ecef4a606d89"],

Cell["\<\
The card's first line says that the vertices agree with a second derivation \
that shares no code with the first:\
\>", "Text",ExpressionUUID->"124e7758-048d-4575-aefa-2d0932e53c99"],

Cell["\<\
(* Kernel/Vertices.wl:62-73 *)
(* phi_a(t, x) = sum over the legs l of field a of eps[l] Exp[I (ww[l] t - \
kq[l].X)]  (nc = 3 components, 2 for a declared d = 2);
   the coefficient of eps[1]...eps[n] Exp[I sum(ww t - kq.X)] in the density \
is Gamma^(n)(all legs) *)
planeWaveCoefficient[dens_, fields_, ms_List, nc_] := Module[{n = Length[ms], \
X = Array[xx, nc], kq, phase, rules, e},
   kq[l_] := Table[kc[l, c], {c, nc}];
   phase = I Sum[ww[l] tt - kq[l] . X, {l, n}];
   rules = Thread[fields -> (Sum[If[ms[[l]] === #, eps[l] Exp[I (ww[l] tt - \
kq[l] . X)], 0], {l, n}] & /@ fields)];
   e = (dens /. rules) /. {dt -> (D[#, tt] &), grad -> (Grad[#, X] &), div -> \
(If[# === 0, 0, Div[#, X]] &), lap -> (Laplacian[#, X] &),
      jac -> (D[#1, xx[1]] D[#2, xx[2]] - D[#1, xx[2]] D[#2, xx[1]] &)};
   e = D[e, Sequence @@ Table[eps[l], {l, n}]] /. eps[_] -> 0;
   e = Expand[e] /. Power[E, z_] :> Exp[Expand[z - phase]];
   FRGAssert[\"Vertices.planeWavePhase\", FreeQ[e, tt | xx], e, \"internal: \
the plane-wave coefficient still depends on t or x\"];
   Expand[e]];\
\>", "Program",ExpressionUUID->"03ec8e93-de26-44be-b6ec-d15c24607b69"],

Cell["\<\
(* Kernel/Vertices.wl:75-76 *)
symbolAsPlaneWave[e_, nc_] := Module[{vec = # /. qv[l_] :> Table[kc[l, c], \
{c, nc}] &},
   Expand[e /. {scal[a_, b_] :> vec[a] . vec[b], wedge[a_, b_] :> vec[a][[1]] \
vec[b][[2]] - vec[a][[2]] vec[b][[1]]} /. wv[l_] :> ww[l]]];\
\>", "Program",ExpressionUUID->"f32f144c-daac-464f-ae27-8931d81a58a0"],

Cell[TextData[{
 "Each field is replaced by a sum of plane waves, ",
 StyleBox["\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "_a(t, x) = ",
 StyleBox["\[CapitalSigma]",
  FontFamily->"Noto Sans"],
 "_l ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 "_l e^{i(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "_l t ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " q_l",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "x)}, with explicit 3-component vectors (2 in a declared d = 2). The package \
operators are replaced by Mathematica's own derivatives, acting on explicit \
coordinates ",
 StyleBox["xx[1], xx[2], xx[3]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". The coefficient of ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 "_1",
 StyleBox["\[CenterEllipsis]\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 "_n is then the vertex, and it must equal the table entry written in \
components."
}], "Text",ExpressionUUID->"b95d218c-f012-428f-b1b4-c59ef203ea03"],

Cell[TextData[{
 StyleBox["Mathematica: Array and explicit vectors",
  FontWeight->Bold],
 "\n",
 StyleBox["Array[f, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["{f[1], ..., f[n]}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox[".",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (Dot) contracts explicit lists; ",
 StyleBox["D",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Grad",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Div",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Laplacian",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " differentiate with respect to explicit variables.",
 "\n\n",
 "With ",
 StyleBox["X = Array[xx, 3]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["kq[l] = {kc[l, 1], kc[l, 2], kc[l, 3]}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["kq[l] . X",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the explicit sum kc[l,1] xx[1] + ... . ",
 StyleBox["Grad[e, X]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the gradient with respect to those three variables. These are the \
System operators the ansatz forbids: here they are safe, because the \
coordinates are explicit symbols that the fields really depend on."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"751640d7-9664-4557-ae5f-1717aaed2ca8"],

Cell["Grad[Exp[I (w t - {k1, k2} . {x1, x2})], {x1, x2}]", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"29e2cd6d-7527-4190-935e-98ff71cd97a6"],

Cell[TextData[{
 StyleBox["Mathematica: Replacing heads by functions",
  FontWeight->Bold],
 "\n",
 "A rule ",
 StyleBox["dt -> (D[#, tt] &)",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns ",
 StyleBox["dt[e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " into ",
 StyleBox["(D[#, tt] &)[e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which evaluates to ",
 StyleBox["D[e, tt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ".",
 "\n\n",
 "Replacing the ",
 StyleBox["head",
  FontSlant->Italic],
 " of ",
 StyleBox["dt[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " by a pure function (",
 StyleBox["Pure functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") gives the inert operator its meaning in one rule. ",
 StyleBox["D[e, Sequence @@ Table[eps[l], {l, n}]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " then differentiates once with respect to each ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 "_l (",
 StyleBox["Sequence",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "); setting all ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 " to 0 afterwards keeps exactly the coefficient of ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 "_1",
 StyleBox["\[CenterEllipsis]\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 "_n."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"d0ca26f7-0447-46b2-9f66-75f9d29ea2ac"],

Cell["\<\
FRGscalarMSR`Private`planeWaveCoefficient[ansatz[\"Density\"], {h, hbar}, {h, \
h, hbar}, 3]\
\>", "Input",ExpressionUUID->"8439ec4b-272a-4bcf-a642-d14b2213686d"],

Cell[TextData[{
 "This is ",
 StyleBox["\[Lambda]",
  FontFamily->"Noto Sans"],
 " (k1",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "k2) written in components, as the table says."
}], "Text",ExpressionUUID->"2f1b98e9-feb3-4801-9f9d-4cb6fad585c3"],

Cell[TextData[{
 StyleBox["Why it's built this way: Two derivations instead of one",
  FontWeight->Bold],
 "\n\n",
 "The first derivation (sections 3",
 StyleBox["\[Dash]",
  FontFamily->"Noto Sans"],
 "4) is fast and produces the structured form the pipeline needs, but it \
depends on the parser of lesson 02 and on the Fourier rules. The second goes \
back to the density you typed, uses only Mathematica's own calculus, and \
knows nothing about ",
 StyleBox["FieldFactor",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", canonical forms or symbol rules. If both agree on every multiset \
(including those that should have no vertex: nothing may be lost), the parser \
and the transform are right. This is the library's general strategy: when a \
step can be computed in two independent ways, compute both and compare \
exactly. The second way is too slow for the later steps, but cheap enough \
here."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"04534404-2e0b-48ae-9b12-ce911fefea25"],

Cell["8. The other checks", "Section",ExpressionUUID->"f4a52122-7ced-44c5-ae85-ae0c006572fc"],

Cell[BoxData[
 $CellContext`regionCells[
 "Kernel/Vertices.wl", "stage = <", "\"Fields\" -> fields", 
  "checks = Join[checks"]], "Input",ExpressionUUID->"bc852c49-f656-4b42-b079-\
bd858a974e11"],

Cell[TextData[{
 StyleBox["Gamma2Matrix",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is first called on a provisional association that has only the keys it \
needs (",
 StyleBox["\"Fields\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["\"VertexTable\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "): the accessors are plain functions of associations (",
 StyleBox["Association",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "), not tied to a finished stage."
}], "Text",ExpressionUUID->"b6236305-fbe7-468c-a3cc-72b3cf273897"],

Cell[TextData[{
 "The three \"(implementation check)\" lines are near-tautological: by \
construction they cannot fail unless the code above is broken (review E11). \
They are labelled as such so that the card does not pretend to test more than \
it does. ",
 StyleBox["PolynomialQ[e, {w, ss}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tests whether e is a polynomial in those variables; ",
 StyleBox["ConstantArray[0, dims]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a zero matrix of the given dimensions."
}], "Text",ExpressionUUID->"aa76ba41-6842-4fd3-a9f8-fb98f0fd9811"],

Cell[TextData[{
 "The last check is physical. The free response function G_{",
 StyleBox["\[CurlyPhi]\:0304\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "}(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") = 1/",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_{",
 StyleBox["\[CurlyPhi]\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 "}(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") must have its pole in the upper half ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "-plane (causality, with the Fourier sign of ",
 StyleBox["docs/CONVENTIONS.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",ExpressionUUID->"7446d1f0-baac-4798-919a-8538a21c7a55"],

Cell[TextData[{
 StyleBox["Mathematica: Solve",
  FontWeight->Bold],
 "\n",
 StyleBox["Solve[eqn, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the solutions as lists of rules ",
 StyleBox["{{x -> s1}, ...}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["x /. Solve[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " extracts the values.",
 "\n\n",
 "The couplings get random positive rationals (",
 StyleBox["RandomRationalPoint",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", lesson 00), q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " is set to 1/2, and ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " finds the poles exactly. ",
 StyleBox["Exponent[e, w]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the degree of e in w; ",
 StyleBox["Im",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " takes the imaginary part. The result is checked with ",
 StyleBox["Which",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ": no pole (WARN), a pole below the real axis (FAIL), a pole on the axis \
(WARN, no damping), otherwise PASS."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"950450d0-c3b7-494d-a5f3-55872123d26c"],

Cell["A damping term with the wrong sign is caught:", "Text",ExpressionUUID->"f8620641-a00c-4504-901b-b81052030fde"],

Cell["\<\
badAnsatz = Block[{Print}, DefineAnsatz[lessonUpTo[\"Theory\"], \"Density\" \
-> hbar (dt[h] + nuk lap[h]) - Dk hbar^2, \"Couplings\" -> {nuk, Dk}]];
showFailure[BuildVertices[badAnsatz]]\
\>", "Input",ExpressionUUID->"99dc4f73-ea4b-4c2c-b4bd-4158fb39d652"],

Cell[TextData[{
 StyleBox["Why it's built this way: A physical convention check",
  FontWeight->Bold],
 "\n\n",
 "A sign error in the Fourier convention gives the time-mirrored theory: \
every formula is consistent, every algebraic check passes, and the flow \
equations are wrong. Only a physical requirement can catch it: the response \
function must be retarded. The check costs one ",
 StyleBox["Solve",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " per scalar and is the first place in the pipeline where a convention is \
tested against physics rather than against itself (review E1)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"ad2852b2-159f-4bb9-b73a-244609becf40"],

Cell["9. Display", "Section",ExpressionUUID->"af8e00c9-1207-4482-93c4-586a5126bdeb"],

Cell["\<\
(* Kernel/Vertices.wl:80 *)
legSymbols[n_] := Table[{Symbol[\"FRGscalarMSR`Vertices`Private`\\[Omega]\" \
<> ToString[j]], Symbol[\"FRGscalarMSR`Vertices`Private`q\" <> ToString[j]]}, \
{j, n}];\
\>", "Program",ExpressionUUID->"441004c3-58db-450f-9a67-2c6e045c78fa"],

Cell["\<\
(* Kernel/Vertices.wl:91-92 *)
ShowVertex[v_Association, tuple_List] := Module[{legs = \
legSymbols[Length[tuple] - 1]},
   Print[vertexName[tuple], legString[legs], \" = \", \
displayString[VertexValue[v, tuple, legs]]]];\
\>", "Program",ExpressionUUID->"4f8bb4f1-ba03-45e8-9634-62ac45af76bd"],

Cell["\<\
(* Kernel/Vertices.wl:94-98 *)
ShowGamma2[v_Association] := Module[{w = \
Symbol[\"FRGscalarMSR`Vertices`Private`\\[Omega]\"], q = \
Symbol[\"FRGscalarMSR`Vertices`Private`q\"], m},
   m = Gamma2Matrix[v, w, q];
   Print[\"Gamma2_ab(\", displayString[w], \",q), leg a at (\", \
displayString[w], \",q), leg b at (-\", displayString[w], \",-q), regulator \
not included:\"];
   Do[If[m[[a, b]] =!= 0, Print[\"  Gamma2[\", v[\"Fields\"][[a]], \", \", v[\
\"Fields\"][[b]], \"] = \", displayString[Collect[m[[a, b]], w]]]],
    {a, Length[m]}, {b, Length[m]}]];\
\>", "Program",ExpressionUUID->"9d24f858-967b-4139-9ce8-257ac4f8124d"],

Cell[TextData[{
 "The display uses its own symbols, created in yet another context, `",
 StyleBox["FRGscalarMSR",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "Vertices",
 StyleBox["Private",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[", with names ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "1",
 StyleBox[", ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "q1",
 StyleBox[", .... ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "displayString",
 StyleBox[" (lesson 00's ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "Core",
 StyleBox[") strips every ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox["FRGscalarMSR",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox["\[Ellipsis]",
  FontFamily->"Noto Sans"],
 "`",
 StyleBox[" context when printing, so they print as plain ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "1",
 StyleBox[", but they can never collide with a symbol of yours called ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "q1",
 StyleBox[". ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "Collect[e, w]",
 StyleBox[" groups the terms of e by powers of w. ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "Do[expr, {a, n}, {b, n}]` is a loop with two iterators, for side effects \
only."
}], "Text",ExpressionUUID->"19f32368-a6e4-4e3e-b187-419129b8da4e"],

Cell["ShowVertex[vertices, {hbar, h, h}]", "Input",ExpressionUUID->"71e03c9f-ae04-41d7-bd11-3522f553eea6"],

Cell["Exercises", "Section",ExpressionUUID->"bc1cf481-2cba-44d2-90d4-fa79fc6de6b8"],

Cell["Exercise: \[CapitalGamma]2 by hand", "Subsection",ExpressionUUID->"411ce0cc-d715-4a81-98a0-c783d90d251d"],

Cell[TextData[{
 "From the KPZ density, derive ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " h}(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", q) by hand (leg ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " at (",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", q), leg h at (",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ", ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "q)) and compare with ",
 StyleBox["Gamma2Matrix",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"c6255335-5f5f-4b4a-8db5-75301dafa636"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"e606bd72-6336-40b1-8bcf-67c0537cc443"],

Cell[TextData[{
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "t h gives i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " at the h leg, here at ",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ": ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ". ",
 StyleBox["\[Minus]\[Nu]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Del]\.b2",
  FontFamily->"Noto Sans"],
 "h gives ",
 StyleBox["\[Minus]\[Nu]",
  FontFamily->"Noto Sans"],
 " (",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "i)",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " (",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "q)",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " = +",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ". So ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " h}(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", q) = ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " + ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ":"
}], "Text",ExpressionUUID->"22898cd4-9c79-4e6a-bd52-ae79c3005cb3"],

Cell["Gamma2Matrix[vertices, w, q][[2, 1]]", "Input",ExpressionUUID->"88683909-c9a0-4da5-b196-8de5ac372748"]
}, Closed]],

Cell["Exercise: The symmetry of identical legs", "Subsection",ExpressionUUID->"9e252851-ac2f-4b0b-a9ab-c9d99d06928c"],

Cell[TextData[{
 "Check with ",
 StyleBox["VertexValue",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " that ",
 StyleBox["\[CapitalGamma]\:207d\.b3\:207e",
  FontFamily->"Noto Sans"],
 "_{h h ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "} does not change when the two h legs exchange their momenta, and that ",
 StyleBox["\[CapitalGamma]\:207d\.b3\:207e",
  FontFamily->"Noto Sans"],
 "_{h ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " h} at legs (p1, p2) is a relabelling of ",
 StyleBox["\[CapitalGamma]\:207d\.b3\:207e",
  FontFamily->"Noto Sans"],
 "_{h h ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "}."
}], "Text",ExpressionUUID->"1267af86-e9d4-4cfd-b546-bc03422c3b3a"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"1693f569-eb8e-4ce3-80fe-c18b0f30cd91"],

Cell["\<\
{Expand[VertexValue[vertices, {h, h, hbar}, {{w1, p1}, {w2, p2}}] - \
VertexValue[vertices, {h, h, hbar}, {{w2, p2}, {w1, p1}}]],
 Expand[VertexValue[vertices, {h, hbar, h}, {{w1, p1}, {w2, p2}}] - \
VertexValue[vertices, {h, h, hbar}, {{w1, p1}, {-w1 - w2, -p1 - p2}}]]}\
\>", "Input",ExpressionUUID->"07464974-4c96-451c-9859-29e706fcd259"],

Cell[TextData[{
 "In the second, leg 3 of ",
 StyleBox["{h, hbar, h}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (an h at ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "(p1+p2)) moves to slot 2, and ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " moves to the last slot, where it automatically sits at ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "(p1 + (",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "p1 ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " p2)) = p2."
}], "Text",ExpressionUUID->"2d0da379-31bf-4ac7-ae00-c67bc40dd401"]
}, Closed]],

Cell["Exercise: A new vertex, and a check that cannot run", "Subsection",ExpressionUUID->"f058cafc-c042-4900-97ba-b31c6e5f5860"],

Cell[TextData[{
 "Add the term ",
 StyleBox["g hbar grad[h].grad[hbar]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " to the KPZ density (with a new coupling ",
 StyleBox["g",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") and look at the new entry of the vertex table. Then remove ",
 StyleBox["hbar dt[h]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " too: what does the card say?"
}], "Text",ExpressionUUID->"2cb525d9-f695-4143-8153-000d7e46681f"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"6a943e6d-1a35-44ad-85d3-aeba8a1f68cc"],

Cell["\<\
a2 = Block[{Print}, DefineAnsatz[lessonUpTo[\"Theory\"], \"Density\" -> hbar \
(dt[h] - nuk lap[h]) - Dk hbar^2 + g hbar grad[h].grad[hbar], \"Couplings\" \
-> {nuk, Dk, g}]];
Block[{Print}, BuildVertices[a2]][\"VertexTable\"]\
\>", "Input",ExpressionUUID->"7f06840d-a58c-4637-a7f9-1b7c3b666103"],

Cell["\<\
a3 = Block[{Print}, DefineAnsatz[lessonUpTo[\"Theory\"], \"Density\" -> - nuk \
hbar lap[h] - Dk hbar^2, \"Couplings\" -> {nuk, Dk}]];
BuildVertices[a3];\
\>", "Input",ExpressionUUID->"da571e99-6e05-4a34-bc4e-604e6563471b"],

Cell[TextData[{
 "The new cubic vertex is ",
 StyleBox["{h, hbar, hbar}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Without the ",
 StyleBox["dt",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " term, ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_{h ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "} has no ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", the pole check has nothing to test, and the card shows the WARN ",
 StyleBox["Vertices.retardedPole[h]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"51470903-f935-44af-a7bf-12e86377d7f0"]
}, Closed]]
},

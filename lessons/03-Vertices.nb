Cell[TextData[{
 StyleBox["sortF",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a local function (",
 StyleBox["Local functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") sorting by position in the field order (",
 StyleBox["DeleteCases, SortBy and FirstPosition",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "); ",
 StyleBox["Sort",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " alone would sort alphabetically, which is not the field order in general. ",
 StyleBox["Association[DeleteCases[{key -> vertex, ...}, _ -> 0]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " drops the multisets with no vertex: the pattern ",
 StyleBox["_ -> 0",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches any rule whose right-hand side is 0."
}], "Text",ExpressionUUID->"5a8ca1e6-83f3-4071-9cac-bff0684c9d0d"],

Cell["6. Evaluating in the leg convention", "Section",ExpressionUUID->"da89c33d-35b1-49a7-81f2-e8ab01af6b91"],

Cell["\<\
(* Kernel/Vertices.wl:45 *)
fieldPos[v_, a_] := First[FirstPosition[v[\"Fields\"], a, {0}]];\
\>", "Program",ExpressionUUID->"10e6b76f-9985-41ad-8ac1-835ed25d8f9a"],

Cell["\<\
(* Kernel/Vertices.wl:47-55 *)
VertexValue[v_Association, tuple_List, legs_List] := Module[{full, ord, ms, e},
   FRGAssert[\"Vertices.legCount\", Length[legs] == Length[tuple] - 1 && \
AllTrue[legs, Length[#] == 2 &], {tuple, legs},
    \"give n - 1 pairs {w, q} for an n-point vertex (the last leg carries \
minus their sum)\"];
   FRGAssert[\"Vertices.knownFields\", AllTrue[tuple, fieldPos[v, #] > 0 &], \
tuple, \"unknown field\"];
   full = Append[legs, -Total[legs]];
   ord = Ordering[fieldPos[v, #] & /@ tuple];   (* canonical leg j is \
original leg ord[[j]]; ties are identical fields *)
   ms = tuple[[ord]];
   e = Lookup[v[\"VertexTable\"], Key[ms], 0];
   Expand[e /. {wv[j_] :> full[[ord[[j]], 1]], qv[j_] :> full[[ord[[j]], \
2]]}]];\
\>", "Program",ExpressionUUID->"399d18be-c8cd-4744-a3e4-ac9cf64dc59f"],

Cell["\<\
(* Kernel/Vertices.wl:57 *)
Gamma2Matrix[v_Association, w_, q_] := Table[VertexValue[v, {a, b}, {{w, \
q}}], {a, v[\"Fields\"]}, {b, v[\"Fields\"]}];\
\>", "Program",ExpressionUUID->"4e8e8208-f68d-405e-9073-fa3b9e04cdc7"],

Cell["\<\
(* Kernel/Vertices.wl:59-60 *)
Gamma3Matrix[v_Association, i0_, {nu_, p_}, {w_, q_}] := Module[{i = \
If[IntegerQ[i0], v[\"Fields\"][[i0]], i0]},
   Table[VertexValue[v, {i, a, b}, {{nu, p}, {w, q}}], {a, v[\"Fields\"]}, \
{b, v[\"Fields\"]}]];\
\>", "Program",ExpressionUUID->"ebd9724e-121c-4acd-a0df-2dc30c4d632c"],

Cell[TextData[{
 StyleBox["Mathematica: Ordering",
  FontWeight->Bold],

Notebook[{
Cell["Lesson 03 - Vertices", "Title",ExpressionUUID->"8473de8c-3160-4d13-9aec-06f89040e9a3"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Fourier-transform the parsed density (",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "t ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " +i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", ",
 StyleBox["\[Del]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "iq, all momenta incoming) and build every vertex ",
 StyleBox["\[CapitalGamma]\:207d\:207f\:207e",
  FontFamily->"Noto Sans"],
 ", n = 2..4, as the symmetrised n-th functional derivative of ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_k with the ",
 StyleBox["\[Delta]",
  FontFamily->"Noto Sans"],
 " function stripped. ",
 StyleBox["\[CapitalGamma]\:207d\.b2\:207e",
  FontFamily->"Noto Sans"],
 " gives the matrix ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_ab(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", q); ",
 StyleBox["\[CapitalGamma]\:207d\.b3\:207e",
  FontFamily->"Noto Sans"],
 " the cubic vertices of the one-loop flow."
}], "Text",ExpressionUUID->"1a768c60-8fdc-4798-a48d-6fd843ddf2fa"],

Cell[TextData[{
 StyleBox["Stage.",
  FontWeight->Bold],
 " Input: the Ansatz stage. Output: the ",
 StyleBox["\"Vertices\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stage, whose ",
 StyleBox["\"VertexTable\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " maps each field multiset to its vertex."
}], "Text",ExpressionUUID->"7fb8ffd5-e868-40cf-9336-ee0a1741e4b2"],


Notebook[{
Cell["Lesson 06 - Symmetries", "Title",ExpressionUUID->"75ddcc9c-3754-4718-a702-0796b94f0938"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Decide, ",
 StyleBox["before",
  FontSlant->Italic],
 " computing any loop, what happens to every monomial (i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")^m (q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")^n of every ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2 entry up to the truncation orders: it is a coupling of the ansatz (its \
flow is an equation), protected by a symmetry (its flow must vanish), \
neglected (its flow is computed, reported and dropped), or zero by structure. \
Ward identities are declared by you, not derived: the card says so."
}], "Text",ExpressionUUID->"22f3f6d5-6b9b-4036-a255-27020acc39ce"],

Cell[TextData[{
 StyleBox["Stage.",
  FontWeight->Bold],
 " Input: the Ansatz stage, tags ",
 StyleBox["Protected[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Neglected[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["NonRenormalised[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and ",
 StyleBox["\"TruncationOrders\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Output: the ",
 StyleBox["\"Symmetries\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stage, with one record per monomial. It is used by the projection (lesson \
08) and the closure check (lesson 10)."
}], "Text",ExpressionUUID->"4b2f082d-2b2c-415b-abf5-5d5409ae5e3d"],

Cell["\<\
Get[\"~/Physics/Sources/FRGscalarMSR/FRGscalarMSR.wl\"];
Get[FileNameJoin[{$FRGRoot, \"lessons\", \"LessonSetup.wl\"}]];
ansatz = lessonUpTo[\"Ansatz\"];\
\>", "Input",ExpressionUUID->"df069ad1-610b-4270-bd92-752827020ef5"],

Cell["1. Using it", "Section",ExpressionUUID->"c375901a-02c4-473e-bfab-2554821c12a5"],

Cell[TextData[{
 "For KPZ: the coefficient of i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " in ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "h} is protected by the Galilean Ward identity, the mass term by the shift \
symmetry h ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " h + c, ",
 StyleBox["\[Lambda]",
  FontFamily->"Noto Sans"],
 " is not renormalised (Galilean invariance), and every other monomial up to \
(i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " (q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\.b9",
  FontFamily->"Noto Sans"],
 " is neglected."
}], "Text",ExpressionUUID->"e7b1d806-1318-4947-9215-f65214149835"],

Cell["\<\
symmetries = DeclareSymmetries[ansatz,
   Protected[{hbar, h}, \"Frequency\" -> 1, \"Momentum\" -> 0, \"Reason\" -> \
\"Galilean Ward identity\"],
   Protected[{h, hbar}, \"Frequency\" -> 0, \"Momentum\" -> 0, \"Reason\" -> \
\"h -> h + c (shift symmetry)\"],
   Neglected[_, \"Reason\" -> \"beyond the ansatz\"], NonRenormalised[lamk, \
\"Reason\" -> \"Galilean invariance\"],
   \"TruncationOrders\" -> <|\"Frequency\" -> 2, \"Momentum\" -> 1|>];\
\>", "Input",ExpressionUUID->"a3b8ebb2-2615-4d1e-91f8-f042cef1d107"],

Cell[TextData[{
 "The table has 18 rows: 3 pairs ",
 StyleBox["\[Times]",
  FontFamily->"Noto Sans"],
 " 3 frequency powers ",
 StyleBox["\[Times]",
  FontFamily->"Noto Sans"],
 " 2 momentum powers. Each row is a record:"
}], "Text",ExpressionUUID->"2cee2bfa-9c01-4c03-9f97-8fc96cd4a6ec"],

Cell["\<\
Select[symmetries[\"Classification\"], #Class === \"Declared\" &]\
\>", "Input",ExpressionUUID->"a3fffd24-d3d7-4848-881a-7e54633ae3f0"],

Cell["2. Tags are expressions", "Section",ExpressionUUID->"4a13fb09-98de-4713-b695-aef2f24af60a"],

Cell["\<\
(* Kernel/Symmetries.wl:13-15 *)
Neglected::usage = \"Neglected[pairPattern, \\\"Frequency\\\" -> m | {m..} | \
All, \\\"Momentum\\\" -> n | {n..} | All, \\\"Reason\\\" -> text]: \\
the flow of these monomials is computed and reported as a warning, then \
dropped.\";
NonRenormalised::usage = \"NonRenormalised[coupling, \\\"Reason\\\" -> text]: \
a vertex coupling assumed not to flow (not checkable in v1: needs d_s \
Gamma3).\";\
\>", "Program",ExpressionUUID->"927044eb-4f94-4ef3-83b4-26d73fb4b7c1"],

Cell["\<\
(* Kernel/Symmetries.wl:23-24 *)
(* Protected is a System symbol (attribute); the tag is used in the \
unambiguous form Protected[pattern, opts] *)
SetAttributes[{Neglected, NonRenormalised}, Protected];\
\>", "Program",ExpressionUUID->"428f7735-7fc2-4b40-b279-85a5a1b5e15b"],

Cell[TextData[{
 StyleBox["Neglected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["NonRenormalised",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are ",
 StyleBox["Inert heads",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ". ",
 StyleBox["Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is more unusual: it is the System symbol of the attribute (",
 StyleBox["Attributes and Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "). As a ",
 StyleBox["function",
  FontSlant->Italic],
 " it has no definitions, so ",
 StyleBox["Protected[{hbar, h}, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stays unevaluated, and the library reuses it as a tag."
}], "Text",ExpressionUUID->"ce795d79-bb9e-4e23-a07a-c4e9ec4a63d5"],

Cell["{Attributes[Protected], Protected[{a, b}, \"x\" -> 1]}", "Input",ExpressionUUID->"3345ec86-8406-4dbf-b3eb-664251e57a88"],

Cell[TextData[{
 StyleBox["Why it's built this way: Declarations as data",
  FontWeight->Bold],
 "\n\n",
 "A tag like ",
 StyleBox["Protected[{hbar, h}, \"Frequency\" -> 1, \"Momentum\" -> 0, \
\"Reason\" -> \"...\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is an inert expression: the library can read it, match it, print it on the \
card, and store it in the stage. Requiring a ",
 StyleBox["\"Reason\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes every assumption about the physics explicit and readable later on \
the card, next to the PASS lines. The alternative, a set of options or flags, \
would carry the same information without the explanation, and would be easy \
to forget."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"e355e7fa-c98d-4445-9009-b43568e18013"],

Cell["3. Reading the tags", "Section",ExpressionUUID->"e0cc6605-b201-41ba-8943-bffffe6644f2"],

Cell["\<\
(* Kernel/Symmetries.wl:26-29 *)
specMatchQ[All, _] := True;
specMatchQ[l_List, x_] := MemberQ[l, x];
specMatchQ[i_Integer, x_] := i === x;
specMatchQ[_, _] := False;\
\>", "Program",ExpressionUUID->"99e6e183-b212-4b2c-bbec-484b8ec8ca53"],

Cell["\<\
(* Kernel/Symmetries.wl:31 *)
pairMatchQ[pat_, {a_, b_}] := MatchQ[{a, b}, pat] || MatchQ[{b, a}, pat];\
\>", "Program",ExpressionUUID->"8d990af8-d6aa-4ad3-927c-9cb287d3e738"],

Cell["\<\
(* Kernel/Symmetries.wl:33-38 *)
tagRecord[tag_, kind_] := Module[{pat = First[tag], o = Association[Rest[List \
@@ tag]]},
   FRGAssert[\"Symmetries.tagOptions\", SubsetQ[{\"Frequency\", \"Momentum\", \
\"Reason\"}, Keys[o]], tag,
    kind <> \"[pairPattern, \\\"Frequency\\\" -> .., \\\"Momentum\\\" -> .., \
\\\"Reason\\\" -> \\\"..\\\"]\"];
   FRGAssert[\"Symmetries.reason\", StringQ[Lookup[o, \"Reason\", None]] && \
Lookup[o, \"Reason\"] =!= \"\", tag, \"every tag needs a \\\"Reason\\\" -> \\\
\"...\\\"\"];
   <|\"Kind\" -> kind, \"Pattern\" -> pat, \"Frequency\" -> Lookup[o, \
\"Frequency\", All], \"Momentum\" -> Lookup[o, \"Momentum\", All],
    \"Reason\" -> o[\"Reason\"], \"Tag\" -> tag|>];\
\>", "Program",ExpressionUUID->"9d131b56-b21e-43f1-afb7-2da55c8e3ae7"],

Cell["\<\
(* Kernel/Symmetries.wl:40 *)
tagMatchQ[t_, {a_, b_}, m_, n_] := pairMatchQ[t[\"Pattern\"], {a, b}] && \
specMatchQ[t[\"Frequency\"], m] && specMatchQ[t[\"Momentum\"], n];\
\>", "Program",ExpressionUUID->"98d8ce61-47ea-484b-bf3c-d3733caffe05"],

Cell[TextData[{
 StyleBox["specMatchQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " dispatches on the form of the spec (",
 StyleBox["Several definitions of one function",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "): ",
 StyleBox["All",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", a list of orders, or one integer. ",
 StyleBox["pairMatchQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches a pair pattern against the unordered pair, so ",
 StyleBox["{hbar, _}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches ",
 StyleBox["{h, hbar}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " too. In ",
 StyleBox["tagRecord",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Association[Rest[List @@ tag]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns the options of a tag into an association: ",
 StyleBox["List @@ tag",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Apply",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") gives ",
 StyleBox["{pattern, opt1, opt2, ...}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Rest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " drops the pattern."
}], "Text",ExpressionUUID->"b8fadb68-2578-4b45-aff3-be48b0fe060a"],

Cell["\<\
(* Kernel/Symmetries.wl:45-66 *)
DeclareSymmetries[ansatz_, args___] := Block[{$FRGModule = \"Symmetries\"},
  Module[{t0 = AbsoluteTime[], theory, fields, phis, pos, opts, trunc, mf, \
mp, tags, prot, negl, nonren, v, g2, pairs, cls, checks = {}, warns = {},
    used = {}, stage, cps, bad, declOutside},
   validateStage[ansatz, \"Ansatz\"];
   theory = ansatz[\"Theory\"]; fields = theory[\"Fields\"]; phis = \
theory[\"Scalars\"]; cps = ansatz[\"Couplings\"];
   pos[a_] := First[FirstPosition[fields, a]];
   opts = Cases[{args}, (Rule | RuleDelayed)[_String, _]];
   tags = Complement[{args}, opts];
   If[ansatz[\"Pipeline\"] === \"LO\", Return[declareSymmetriesLO[ansatz, \
tags, opts, t0], Module]];
   FRGAssert[\"Symmetries.arguments\", AllTrue[tags, MatchQ[#, _Protected | \
_Neglected | _NonRenormalised] &] && MatchQ[opts, {\"TruncationOrders\" -> _}],
    Select[{args}, ! MatchQ[#, _Protected | _Neglected | _NonRenormalised | (\
\"TruncationOrders\" -> _)] &],
    \"arguments: Protected[...], Neglected[...], NonRenormalised[...] and \
\\\"TruncationOrders\\\" -> <|\\\"Frequency\\\" -> mf, \\\"Momentum\\\" -> \
mp|> (required)\"];
   trunc = Lookup[opts, \"TruncationOrders\"];
   FRGAssert[\"Symmetries.truncationOrders\", AssociationQ[trunc] && \
Sort[Keys[trunc]] === {\"Frequency\", \"Momentum\"} && AllTrue[Values[trunc], \
IntegerQ[#] && # >= 0 &],
    trunc, \"\\\"TruncationOrders\\\" -> <|\\\"Frequency\\\" -> 2, \
\\\"Momentum\\\" -> 1|> (non-negative integers)\"];
   {mf, mp} = {trunc[\"Frequency\"], trunc[\"Momentum\"]};
   AppendTo[checks, assertCheck[\"Symmetries.truncation\", True, mp, \"\",
     \"truncation: (I w)^\" <> ToString[mf] <> \", (q^2)^\" <> ToString[mp]]];

   prot = tagRecord[#, \"Protected\"] & /@ Cases[tags, _Protected];
   negl = tagRecord[#, \"Neglected\"] & /@ Cases[tags, _Neglected];
   nonren = Cases[tags, _NonRenormalised];\
\>", "Program",ExpressionUUID->"fa6cc5e4-ac09-4b17-83fd-5adea0e84acc"],

Cell[TextData[{
 StyleBox["Mathematica: Multiple assignment",
  FontWeight->Bold],
 "\n",
 StyleBox["{a, b} = {1, 2}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " assigns element by element.",
 "\n\n",
 StyleBox["{mf, mp} = {trunc[\"Frequency\"], trunc[\"Momentum\"]}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads both truncation orders at once. Later, ",
 StyleBox["{cl, reason} = Which[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gets a class and its reason from one ",
 StyleBox["Which",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"7337cc65-27db-44ed-95b3-9981108335da"],

Cell["4. Classifying every monomial", "Section",ExpressionUUID->"41903737-d814-4662-8fb9-4488590284e6"],

Cell["\<\
(* Kernel/Symmetries.wl:70-91 *)
   (* Gamma_k coefficients (regulator off) from the vertices; silent: \
BuildVertices prints its own table *)
   v = Block[{Print}, BuildVertices[ansatz]];
   pairs = Select[Tuples[fields, 2], pos[#[[1]]] <= pos[#[[2]]] &];
   cls = Flatten[Table[Module[{a = pr[[1]], b = pr[[2]], e, coef, cl, reason, \
pt, nt},
       e = VertexValue[v, {a, b}, {{nu, p}}];
       coef = gammaCoefficient[e, nu, p, m, n];
       pt = Select[prot, tagMatchQ[#, {a, b}, m, n] &]; nt = Select[negl, \
tagMatchQ[#, {a, b}, m, n] &];
       {cl, reason} = Which[
         ! IntersectingQ[{a, b}, theory[\"ResponseFields\"]], {\"Causality\", \
\"Gamma_{phi phi} = 0 (causality); its flow is checked to vanish\"},
         a === b && OddQ[m], {\"Structure\", \"Gamma2_aa(w) = Gamma2_aa(-w): \
odd powers of w vanish identically\"},
         coef =!= 0 && ! NumericQ[coef] && pt =!= {}, \
FRGAssert[\"Symmetries.contradiction\", False, {{a, b}, m, n, coef, pt[[All, \
\"Tag\"]]},
           \"this monomial carries a coupling of the ansatz and is also \
Protected (its flow would have to vanish): drop the tag or the coupling\"],
         pt =!= {}, (used = Join[used, pt[[All, \"Tag\"]]]; {\"Protected\", \
First[pt][\"Reason\"]}),
         coef =!= 0 && NumericQ[coef], {\"DeclaredNumeric\", \"numeric \
coefficient \" <> ToString[coef] <> \" in the ansatz: its flow must \
vanish\"},
         coef =!= 0, {\"Declared\", \"flow equation for \" <> inputForm[coef]},
         nt =!= {}, (used = Join[used, nt[[All, \"Tag\"]]]; {\"Neglected\", \
First[nt][\"Reason\"]}),
         True, {\"Untagged\", \"\"}];
       <|\"Pair\" -> {a, b}, \"Frequency\" -> m, \"Momentum\" -> n, \"Class\" \
-> cl, \"GammaK\" -> coef, \"Reason\" -> reason|>],
      {pr, pairs}, {m, 0, mf}, {n, 0, mp}], 2];
   bad = Select[cls, #Class === \"Untagged\" &];
   AppendTo[checks, assertCheck[\"Symmetries.allTagged\", bad === {}, {#Pair, \
\"(I w)^\" <> ToString[#Frequency], \"(q^2)^\" <> ToString[#Momentum]} & /@ \
bad,
     \"every monomial up to the truncation orders must be declared in the \
ansatz, Protected or Neglected\", ToString[Length[cls]] <> \" monomials \
classified\"]];\
\>", "Program",ExpressionUUID->"d090e9f7-449c-4a24-9c95-df3660df8aa5"],

Cell["\<\
(* Kernel/Symmetries.wl:42-43 *)
(* coefficient of (I nu)^m (p^2)^n in a Gamma2 entry written with scal[p, p] *)
gammaCoefficient[e_, nu_, p_, m_, n_] := \
Expand[Coefficient[Coefficient[Expand[e /. scal[p, p] -> pp2], pp2, n], nu, \
m]/I^m];\
\>", "Program",ExpressionUUID->"e37e9a64-4a4d-467d-b559-1c69b4fb7d72"],

Cell[TextData[{
 "The module rebuilds the vertices itself, silently (",
 StyleBox["Block[{Print}, BuildVertices[ansatz]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "): it needs the coefficients of ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_k (without regulator), and taking them from its own ansatz input avoids a \
second stage argument that could come from a different ansatz. ",
 StyleBox["gammaCoefficient",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " extracts the coefficient of (i",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ")^m (p",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")^n with two nested ",
 StyleBox["Coefficient and Exponent",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 05)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "."
}], "Text",ExpressionUUID->"bd3a609a-34bf-4957-8310-0d00808ee582"],

Cell[TextData[{
 StyleBox["Mathematica: Iterators that depend on each other",
  FontWeight->Bold],
 "\n",
 StyleBox["Table[expr, {pr, pairs}, {m, 0, mf}, {n, 0, mp}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs over every combination; ",
 StyleBox["Flatten[t, 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes two levels of nesting.",
 "\n\n",
 "The result of a three-iterator ",
 StyleBox["Table",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a list of lists of lists. ",
 StyleBox["Flatten[..., 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " flattens the first two levels only, leaving a flat list of records (each \
record is an association and must not be flattened further). ",
 StyleBox["Flatten[l, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with a level is the safe form whenever the elements themselves are lists \
or associations."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"d59d9fa5-e71f-4c48-b4c0-7c492bfcd2d8"],

Cell["\<\
{Table[{i, j}, {i, 2}, {j, 2}], Flatten[Table[{i, j}, {i, 2}, {j, 2}], 1]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"f8e7086c-e9b3-49a1-9097-b3cfd3669a5f"],

Cell[TextData[{
 "The order of the ",
 StyleBox["Which",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " is the precedence of the classes:"
}], "Text",ExpressionUUID->"6f83d923-ee5d-4fa5-9098-78df5ca23693"],

Cell[TextData[{
 StyleBox["Causality",
  FontWeight->Bold],
 ": an entry between two physical fields; ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_",
 StyleBox["\[CurlyPhi]\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 " = 0, and its flow will be checked to vanish."
}], "Item",ExpressionUUID->"cd36bdf0-816c-4abc-b7da-912c9c91aeba"],

Cell[TextData[{
 StyleBox["Structure",
  FontWeight->Bold],
 ": an odd frequency power in a diagonal entry; ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_aa(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") = ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_aa(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 "), so it vanishes identically and is not computed."
}], "Item",ExpressionUUID->"9d5dc60c-8856-4655-9d27-88debad7917e"],

Cell[TextData[{
 StyleBox["Protected",
  FontWeight->Bold],
 " wins over everything else, but a Protected monomial that carries a \
coupling is a contradiction, and aborts."
}], "Item",ExpressionUUID->"108ca171-1b68-424b-9121-d9c051ce5b51"],

Cell[TextData[{
 StyleBox["DeclaredNumeric",
  FontWeight->Bold],
 ": a number in the ansatz, like the 1 in front of i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "; its flow must vanish."
}], "Item",ExpressionUUID->"1c4e603f-5c2a-48cd-a360-758bd8486955"],

Cell[TextData[{
 StyleBox["Declared",
  FontWeight->Bold],
 ": a coefficient with couplings; it gets a flow equation."
}], "Item",ExpressionUUID->"d2e73f48-895d-43c1-b324-5c7af74027cf"],

Cell[TextData[{
 StyleBox["Neglected",
  FontWeight->Bold],
 "; anything left is ",
 StyleBox["Untagged",
  FontWeight->Bold],
 ", and ",
 StyleBox["Symmetries.allTagged",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " aborts."
}], "Item",ExpressionUUID->"9316232b-16e7-40e6-8838-e30c6fccf546"],

Cell["\<\
showFailure[DeclareSymmetries[ansatz, Protected[{hbar, h}, \"Frequency\" -> \
0, \"Momentum\" -> 1, \"Reason\" -> \"a mistake\"], Neglected[_, \"Reason\" \
-> \"rest\"],
  \"TruncationOrders\" -> <|\"Frequency\" -> 2, \"Momentum\" -> 1|>]]\
\>", "Input",ExpressionUUID->"d28c05a2-714c-41dd-b5db-ec7516c45e0a"],

Cell[TextData[{
 StyleBox["Why it's built this way: Classify before computing",
  FontWeight->Bold],
 "\n\n",
 "The loops of lessons 07",
 StyleBox["\[Dash]",
  FontFamily->"Noto Sans"],
 "10 are the expensive part of the pipeline. A forgotten monomial, a \
contradictory tag or a truncation that misses a term of the ansatz are \
mistakes in the ",
 StyleBox["declaration",
  FontSlant->Italic],
 ", which can be found by looking only at ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_k. Doing it here means they abort in a fraction of a second, with a table \
that names the monomial, instead of after minutes of loop computation, or not \
at all (",
 StyleBox["docs/MODULES.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": \"the classification needs no flow, so it can fail early\"). Aborting on \
an untagged monomial forces every truncation decision to be written down."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"d609c120-11cf-42ca-8332-86e0245e6a15"],

Cell["5. Checks on the declaration as a whole", "Section",ExpressionUUID->"b2866233-503e-4806-95f9-958fe6af67ad"],

Cell["\<\
(* Kernel/Symmetries.wl:93-101 *)
   (* declared monomials of the ansatz beyond the truncation orders would be \
silently ignored *)
   declOutside = Select[Flatten[Table[{pr, m, n}, {pr, pairs}, {m, 0, 2 mf + \
4}, {n, 0, Max[2, Max[ansatz[\"Monomials\"][[All, \"MomentumOrder\"]]]/2]}], \
2],
     (#[[2]] > mf || #[[3]] > mp) && gammaCoefficient[VertexValue[v, #[[1]], \
{{nu, p}}], nu, p, #[[2]], #[[3]]] =!= 0 &];
   AppendTo[checks, assertCheck[\"Symmetries.truncationCoversAnsatz\", \
declOutside === {}, declOutside,
     \"the ansatz contains Gamma2 monomials beyond \\\"TruncationOrders\\\": \
raise the orders\", \"the truncation contains every monomial of the ansatz\"]];

   Scan[If[! MemberQ[used, #Tag], AppendTo[warns, infoCheck[\"WARN\", \
\"Symmetries.unusedTag\", inputForm[#Tag] <> \" matches no monomial \
(precedence)\"]]] &, Join[prot, negl]];
   warns = Join[warns, infoCheck[\"ASSUMPTION\", \"NonRenormalised[\" <> \
ToString[#[[1]]] <> \"]\", #[[2, 2]] <> \" (not checkable in v1: needs d_s \
Gamma3)\"] & /@ nonren];
   AppendTo[warns, infoCheck[\"ASSUMPTION\", \"Symmetries.wardIdentities\", \
\"Protected tags are user-declared Ward identities, not derived\"]];\
\>", "Program",ExpressionUUID->"00a7d300-dc60-40ae-86e0-fd0b3a8274e7"],

Cell["\<\
A truncation lower than the ansatz would silently drop a coupling's equation:\
\
\>", "Text",ExpressionUUID->"0b5c244d-e1bd-4b02-b503-f49a27b426fb"],

Cell["\<\
showFailure[DeclareSymmetries[ansatz, Neglected[_, \"Reason\" -> \"rest\"], \
\"TruncationOrders\" -> <|\"Frequency\" -> 2, \"Momentum\" -> 0|>]]\
\>", "Input",ExpressionUUID->"7c527d75-495d-435b-96d2-b99cd16cdd96"],

Cell[TextData[{
 "A tag that matches no monomial, because a tag of higher precedence took \
them all, gets a WARN. ",
 StyleBox["NonRenormalised",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " produces an ASSUMPTION line: in v1 it cannot be checked, because that \
would need the flow of ",
 StyleBox["\[CapitalGamma]\:207d\.b3\:207e",
  FontFamily->"Noto Sans"],
 ". And one ASSUMPTION line always reminds that the Protected tags are \
declared Ward identities."
}], "Text",ExpressionUUID->"3199dfc9-793a-45e6-abdc-c4aaf774aec2"],

Cell["6. The table", "Section",ExpressionUUID->"ac02760b-fb0d-4687-9097-2ab03dca4b65"],

Cell["\<\
(* Kernel/Symmetries.wl:136-142 *)
ShowClassification[s_Association] := Module[{rows},
   rows = {ToString[#Pair], \"(I w)^\" <> ToString[#Frequency] <> \" (q^2)^\" \
<> ToString[#Momentum], #Class,
       If[#GammaK === 0, \"\", inputForm[#GammaK]], #Reason} & /@ \
s[\"Classification\"];
   Print[\"Monomial classification (Gamma2_ab, a before b in field order; \
precedence Protected > declared > Neglected):\"];
   Print[If[$FrontEnd === Null,
     StringRiffle[StringRiffle[MapThread[StringPadRight, {#, {18, 16, 16, 18, \
1}}], \" | \"] & /@ Prepend[rows, {\"pair\", \"monomial\", \"class\", \
\"Gamma_k coeff.\", \"reason\"}], \"\\n\"],
     Grid[Prepend[rows, {\"pair\", \"monomial\", \"class\", \"Gamma_k \
coeff.\", \"reason\"}], Frame -> All, Alignment -> Left]]]];\
\>", "Program",ExpressionUUID->"a340a3c7-7a3a-4522-9423-a32925475db7"],

Cell[TextData[{
 "The same structure as ",
 StyleBox["ShowMonomials",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 02): a ",
 StyleBox["Grid",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " in a notebook, padded text in a script."
}], "Text",ExpressionUUID->"8b7e0ce6-d72d-4a2a-95d3-b76b6afd94fd"],

Cell["Exercises", "Section",ExpressionUUID->"0e9e23a1-8460-4e10-a47d-4de07cdb1a19"],

Cell["Exercise: A forgotten Neglected", "Subsection",ExpressionUUID->"f2be1f39-3de5-44fd-9d70-988d0861616c"],

Cell[TextData[{
 "Declare only the two Protected tags, without ",
 StyleBox["Neglected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Read the FAIL block: which monomials are untagged, and why are those of \
",
 StyleBox["{h, h}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " not among them?"
}], "Text",ExpressionUUID->"4436433b-59d5-4054-b334-87e3438756a1"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"bb291e11-8a84-4433-bdbc-06e969ed6a2a"],

Cell["\<\
showFailure[DeclareSymmetries[ansatz, Protected[{hbar, h}, \"Frequency\" -> \
1, \"Momentum\" -> 0, \"Reason\" -> \"Galilean\"],
  Protected[{h, hbar}, \"Frequency\" -> 0, \"Momentum\" -> 0, \"Reason\" -> \
\"shift\"], \"TruncationOrders\" -> <|\"Frequency\" -> 2, \"Momentum\" -> \
1|>]]\
\>", "Input",ExpressionUUID->"265931ba-3609-41be-8dc8-9e49d5b6e6cf"],

Cell[TextData[{
 "The six (i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")^m (q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")^n of ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "h and ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " that are neither declared nor protected. The ",
 StyleBox["{h, h}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " entries are classified as Causality before any tag is looked at, and the \
odd powers of ",
 StyleBox["{hbar, hbar}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " as Structure."
}], "Text",ExpressionUUID->"16eea0ae-8bcf-4f56-98bd-072215a3d0e5"]
}, Closed]],

Cell["Exercise: Precedence", "Subsection",ExpressionUUID->"ee6dbf77-95ba-4508-87ca-c8565a46afe6"],

Cell[TextData[{
 "Add ",
 StyleBox["Neglected[{hbar, h}, \"Frequency\" -> 1, \"Momentum\" -> 0, \
\"Reason\" -> \"test\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " to the KPZ declaration, before the general ",
 StyleBox["Neglected[_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". What does the card say about it, and why?"
}], "Text",ExpressionUUID->"ee914108-d282-485a-bd0f-0349dfcab762"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"7db3c6b6-bceb-404e-83a9-95282e0fa394"],

Cell["\<\
DeclareSymmetries[ansatz,
   Protected[{hbar, h}, \"Frequency\" -> 1, \"Momentum\" -> 0, \"Reason\" -> \
\"Galilean Ward identity\"],
   Protected[{h, hbar}, \"Frequency\" -> 0, \"Momentum\" -> 0, \"Reason\" -> \
\"h -> h + c (shift symmetry)\"],
   Neglected[{hbar, h}, \"Frequency\" -> 1, \"Momentum\" -> 0, \"Reason\" -> \
\"test\"],
   Neglected[_, \"Reason\" -> \"beyond the ansatz\"], NonRenormalised[lamk, \
\"Reason\" -> \"Galilean invariance\"],
   \"TruncationOrders\" -> <|\"Frequency\" -> 2, \"Momentum\" -> 1|>];\
\>", "Input",ExpressionUUID->"3109f968-bdc5-4bbf-8438-dfa757c498c3"],

Cell[TextData[{
 "A WARN ",
 StyleBox["Symmetries.unusedTag",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": the monomial (i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\.b9",
  FontFamily->"Noto Sans"],
 "(q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\:2070",
  FontFamily->"Noto Sans"],
 " of ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "h is already Protected, and Protected takes precedence over Neglected, so \
the new tag matches nothing."
}], "Text",ExpressionUUID->"07e07d7c-c81f-4ceb-a811-e8bfc4f3727b"]
}, Closed]],

Cell["Exercise: Query the classification", "Subsection",ExpressionUUID->"8f7c00d6-61a2-4504-98ff-811a5744ee9f"],

Cell[TextData[{
 "List, as ",
 StyleBox["{pair, m, n}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the monomials whose flow must vanish exactly (Protected, DeclaredNumeric \
or Causality)."
}], "Text",ExpressionUUID->"cef321df-9aa3-420a-a63e-27ae108f0679"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"ab360836-ef4a-4448-be1b-6d3846648d1e"],

Cell["\<\
{#Pair, #Frequency, #Momentum} & /@ Select[symmetries[\"Classification\"], \
MemberQ[{\"Protected\", \"DeclaredNumeric\", \"Causality\"}, #Class] &]\
\>", "Input",ExpressionUUID->"d8064f66-45d9-464b-97ce-54c04e67432b"]
}, Closed]]
},

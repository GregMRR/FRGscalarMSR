Notebook[{
Cell["Lesson 06 - Symmetries", "Title",ExpressionUUID->"13ca939e-e225-44c4-b93a-450f201ec10b"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Decide, ",
 StyleBox["before",
  FontSlant->Italic],
 " computing any loop, what happens to every monomial (i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")^m (q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")^n of every ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2 entry up to the truncation orders: it is a coupling of the ansatz (its \
flow is an equation), protected by a symmetry (its flow must vanish), \
neglected (its flow is computed, reported and dropped), or zero by structure. \
Ward identities are declared by you, not derived: the card says so."
}], "Text",ExpressionUUID->"5d82de71-ff1c-4499-8571-a21e83f0e7b4"],

Cell[TextData[{
 StyleBox["Stage.",
  FontWeight->Bold],
 " Input: the Ansatz stage, tags ",
 StyleBox["Protected[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Neglected[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["NonRenormalised[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and ",
 StyleBox["\"TruncationOrders\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Output: the ",
 StyleBox["\"Symmetries\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stage, with one record per monomial. It is used by the projection (lesson \
08) and the closure check (lesson 10)."
}], "Text",ExpressionUUID->"be17f09c-2b92-4295-b45c-bdca4629807d"],

Cell["\<\
Get[\"~/Physics/Sources/FRGscalarMSR/FRGscalarMSR.wl\"];
Get[FileNameJoin[{$FRGRoot, \"lessons\", \"LessonSetup.wl\"}]];
ansatz = lessonUpTo[\"Ansatz\"];\
\>", "Input",ExpressionUUID->"25f7ebee-fa10-4490-91ff-60613a48254b"],

Cell["1. Using it", "Section",ExpressionUUID->"c5795f57-eae6-429e-b84a-cf6b1e6e32f4"],

Cell[TextData[{
 "For KPZ: the coefficient of i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " in ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "h} is protected by the Galilean Ward identity, the mass term by the shift \
symmetry h ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " h + c, ",
 StyleBox["\[Lambda]",
  FontFamily->"Noto Sans"],
 " is not renormalised (Galilean invariance), and every other monomial up to \
(i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " (q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\.b9",
  FontFamily->"Noto Sans"],
 " is neglected."
}], "Text",ExpressionUUID->"a3129f05-9b05-4f50-9386-60c3c7345a1d"],

Cell["\<\
symmetries = DeclareSymmetries[ansatz,
   Protected[{hbar, h}, \"Frequency\" -> 1, \"Momentum\" -> 0, \"Reason\" -> \
\"Galilean Ward identity\"],
   Protected[{h, hbar}, \"Frequency\" -> 0, \"Momentum\" -> 0, \"Reason\" -> \
\"h -> h + c (shift symmetry)\"],
   Neglected[_, \"Reason\" -> \"beyond the ansatz\"], NonRenormalised[lamk, \
\"Reason\" -> \"Galilean invariance\"],
   \"TruncationOrders\" -> <|\"Frequency\" -> 2, \"Momentum\" -> 1|>];\
\>", "Input",ExpressionUUID->"cb8c84a4-d85f-4937-9e5b-4bacab5f6b0c"],

Cell[TextData[{
 "The table has 18 rows: 3 pairs ",
 StyleBox["\[Times]",
  FontFamily->"Noto Sans"],
 " 3 frequency powers ",
 StyleBox["\[Times]",
  FontFamily->"Noto Sans"],
 " 2 momentum powers. Each row is a record:"
}], "Text",ExpressionUUID->"0a4bd994-742f-4746-bd57-b2fe9c4e418a"],

Cell["\<\
Select[symmetries[\"Classification\"], #Class === \"Declared\" &]\
\>", "Input",ExpressionUUID->"56840330-3bcb-4e43-8b29-931e28c8f438"],

Cell["2. Tags are expressions", "Section",ExpressionUUID->"8ce398ab-c7d1-43e2-988f-0a742e3fadb2"],

Cell["\<\
(* Kernel/Symmetries.wl:13-15 *)
Neglected::usage = \"Neglected[pairPattern, \\\"Frequency\\\" -> m | {m..} | \
All, \\\"Momentum\\\" -> n | {n..} | All, \\\"Reason\\\" -> text]: \\
the flow of these monomials is computed and reported as a warning, then \
dropped.\";
NonRenormalised::usage = \"NonRenormalised[coupling, \\\"Reason\\\" -> text]: \
a vertex coupling assumed not to flow (not checkable in v1: needs d_s \
Gamma3).\";\
\>", "Program",ExpressionUUID->"6f465cfb-2c67-4389-87e3-de2c361955a1"],

Cell["\<\
(* Kernel/Symmetries.wl:23-24 *)
(* Protected is a System symbol (attribute); the tag is used in the \
unambiguous form Protected[pattern, opts] *)
SetAttributes[{Neglected, NonRenormalised}, Protected];\
\>", "Program",ExpressionUUID->"5250756e-b360-45c2-ae3a-576c588d0389"],

Cell[TextData[{
 StyleBox["Neglected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["NonRenormalised",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are ",
 StyleBox["Inert heads",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ". ",
 StyleBox["Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is more unusual: it is the System symbol of the attribute (",
 StyleBox["Attributes and Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "). As a ",
 StyleBox["function",
  FontSlant->Italic],
 " it has no definitions, so ",
 StyleBox["Protected[{hbar, h}, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stays unevaluated, and the library reuses it as a tag."
}], "Text",ExpressionUUID->"4a6b3962-0b7f-4d20-a0ba-b170d2220b71"],

Cell["{Attributes[Protected], Protected[{a, b}, \"x\" -> 1]}", "Input",ExpressionUUID->"0a5fd2e4-6d3c-40a9-9177-556320f4c440"],

Cell[TextData[{
 StyleBox["Why it's built this way: Declarations as data",
  FontWeight->Bold],
 "\n\n",
 "A tag like ",
 StyleBox["Protected[{hbar, h}, \"Frequency\" -> 1, \"Momentum\" -> 0, \
\"Reason\" -> \"...\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is an inert expression: the library can read it, match it, print it on the \
card, and store it in the stage. Requiring a ",
 StyleBox["\"Reason\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes every assumption about the physics explicit and readable later on \
the card, next to the PASS lines. The alternative, a set of options or flags, \
would carry the same information without the explanation, and would be easy \
to forget."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"3eab5536-c6e3-4f34-8341-221dfecccbfb"],

Cell["3. Reading the tags", "Section",ExpressionUUID->"ae37c26d-facc-4335-a88c-c84e4b89d465"],

Cell["\<\
(* Kernel/Symmetries.wl:26-29 *)
specMatchQ[All, _Integer] := True;
specMatchQ[l_List, x_] := MemberQ[l, x];
specMatchQ[i_Integer, x_] := i === x;
specMatchQ[_, _] := False;\
\>", "Program",ExpressionUUID->"e842360d-cf3d-4f3f-9f7c-fb3d02a9d29e"],

Cell["\<\
(* Kernel/Symmetries.wl:31 *)
pairMatchQ[pat_, {a_, b_}] := MatchQ[{a, b}, pat] || MatchQ[{b, a}, pat];\
\>", "Program",ExpressionUUID->"e926af0c-2659-4732-a7f1-50dc89399fb0"],

Cell["\<\
(* Kernel/Symmetries.wl:33-40 *)
tagRecord[tag_, kind_] := Module[{pat = First[tag], o = Association[Rest[List \
@@ tag]]},
   FRGAssert[\"Symmetries.tagOptions\", SubsetQ[{\"Frequency\", \"Momentum\", \
\"Reason\"}, Keys[o]], tag,
    kind <> \"[pairPattern, \\\"Frequency\\\" -> .., \\\"Momentum\\\" -> .., \
\\\"Reason\\\" -> \\\"..\\\"]\"];
   FRGAssert[\"Symmetries.tagMomentum\", MatchQ[Lookup[o, \"Momentum\", All], \
All | \"AllMomenta\" | _Integer?NonNegative | {__Integer?NonNegative}], tag,
    \"\\\"Momentum\\\" -> n, {n, ...}, All (every order up to the truncation, \
at p -> 0) or \\\"AllMomenta\\\" (the whole slot at generic p)\"];
   FRGAssert[\"Symmetries.reason\", StringQ[Lookup[o, \"Reason\", None]] && \
Lookup[o, \"Reason\"] =!= \"\", tag, \"every tag needs a \\\"Reason\\\" -> \\\
\"...\\\"\"];
   <|\"Kind\" -> kind, \"Pattern\" -> pat, \"Frequency\" -> Lookup[o, \
\"Frequency\", All], \"Momentum\" -> Lookup[o, \"Momentum\", All],
    \"Reason\" -> o[\"Reason\"], \"Tag\" -> tag|>];\
\>", "Program",ExpressionUUID->"46f8ffcf-698a-48b2-82c6-5acbd117af4a"],

Cell["\<\
(* Kernel/Symmetries.wl:42 *)
tagMatchQ[t_, {a_, b_}, m_, n_] := pairMatchQ[t[\"Pattern\"], {a, b}] && \
specMatchQ[t[\"Frequency\"], m] && specMatchQ[t[\"Momentum\"], n];\
\>", "Program",ExpressionUUID->"815527fd-a7fc-4bc4-a248-03ad920ea085"],

Cell[TextData[{
 StyleBox["specMatchQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " dispatches on the form of the spec (",
 StyleBox["Several definitions of one function",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "): ",
 StyleBox["All",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", a list of orders, or one integer. ",
 StyleBox["pairMatchQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches a pair pattern against the unordered pair, so ",
 StyleBox["{hbar, _}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches ",
 StyleBox["{h, hbar}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " too. In ",
 StyleBox["tagRecord",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Association[Rest[List @@ tag]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns the options of a tag into an association: ",
 StyleBox["List @@ tag",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Apply",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") gives ",
 StyleBox["{pattern, opt1, opt2, ...}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Rest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " drops the pattern."
}], "Text",ExpressionUUID->"ced0155d-1035-4c5a-8e06-5b6a0726d6a7"],

Cell["\<\
(* Kernel/Symmetries.wl:51-72 *)
DeclareSymmetries[ansatz_, args___] := Block[{$FRGModule = \"Symmetries\"},
  Module[{t0 = AbsoluteTime[], theory, fields, phis, pos, opts, trunc, mf, \
mp, tags, prot, negl, nonren, v, g2, pairs, cls, checks = {}, warns = {},
    used = {}, stage, cps, bad, declOutside, fns, fnPat, slotRows, classify, \
fnSlots, siblings, nAll},
   validateStage[ansatz, \"Ansatz\"];
   theory = ansatz[\"Theory\"]; fields = theory[\"Fields\"]; phis = \
theory[\"Scalars\"]; cps = ansatz[\"Couplings\"];
   fns = Lookup[ansatz, \"MomentumFunctions\", {}]; fnPat = Alternatives @@ \
fns;
   pos[a_] := First[FirstPosition[fields, a]];
   opts = Cases[{args}, (Rule | RuleDelayed)[_String, _]];
   tags = Complement[{args}, opts];
   FRGAssert[\"Symmetries.arguments\", AllTrue[tags, MatchQ[#, _Protected | \
_Neglected | _NonRenormalised] &] && MatchQ[opts, {\"TruncationOrders\" -> _}],
    Select[{args}, ! MatchQ[#, _Protected | _Neglected | _NonRenormalised | (\
\"TruncationOrders\" -> _)] &],
    \"arguments: Protected[...], Neglected[...], NonRenormalised[...] and \
\\\"TruncationOrders\\\" -> <|\\\"Frequency\\\" -> mf, \\\"Momentum\\\" -> \
mp|> (required)\"];
   trunc = Lookup[opts, \"TruncationOrders\"];
   FRGAssert[\"Symmetries.truncationOrders\", AssociationQ[trunc] && \
Sort[Keys[trunc]] === {\"Frequency\", \"Momentum\"} && AllTrue[Values[trunc], \
IntegerQ[#] && # >= 0 &],
    trunc, \"\\\"TruncationOrders\\\" -> <|\\\"Frequency\\\" -> 2, \
\\\"Momentum\\\" -> 1|> (non-negative integers)\"];
   {mf, mp} = {trunc[\"Frequency\"], trunc[\"Momentum\"]};
   AppendTo[checks, assertCheck[\"Symmetries.truncation\", True, mp, \"\",
     \"truncation: (I w)^\" <> ToString[mf] <> \", (q^2)^\" <> ToString[mp]]];

   prot = tagRecord[#, \"Protected\"] & /@ Cases[tags, _Protected];
   negl = tagRecord[#, \"Neglected\"] & /@ Cases[tags, _Neglected];
   nonren = Cases[tags, _NonRenormalised];\
\>", "Program",ExpressionUUID->"8f7459b4-81e7-442a-bd35-f67f97423666"],

Cell[TextData[{
 StyleBox["Mathematica: Multiple assignment",
  FontWeight->Bold],
 "\n",
 StyleBox["{a, b} = {1, 2}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " assigns element by element.",
 "\n\n",
 StyleBox["{mf, mp} = {trunc[\"Frequency\"], trunc[\"Momentum\"]}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads both truncation orders at once. Later, ",
 StyleBox["{cl, reason} = Which[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gets a class and its reason from one ",
 StyleBox["Which",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"2c250ba9-fa33-4050-986d-dd034186c0b8"],

Cell["4. Classifying every monomial", "Section",ExpressionUUID->"5824e79e-5138-4796-bbec-549da6ad5961"],

Cell["\<\
(* Kernel/Symmetries.wl:78-153 *)
   (* Gamma_k coefficients (regulator off) from the vertices; silent: \
BuildVertices prints its own table *)
   v = Block[{Print}, BuildVertices[ansatz]];
   pairs = Select[Tuples[fields, 2], pos[#[[1]]] <= pos[#[[2]]] &];
   classify[a_, b_, m_, n_, coef_] := Module[{cl, reason, pt, nt},
       pt = Select[prot, tagMatchQ[#, {a, b}, m, n] &]; nt = Select[negl, \
tagMatchQ[#, {a, b}, m, n] &];
       {cl, reason} = Which[
         ! IntersectingQ[{a, b}, theory[\"ResponseFields\"]], {\"Causality\", \
\"Gamma_{phi phi} = 0 (causality); its flow is checked to vanish\"},
         a === b && OddQ[m], {\"Structure\", \"Gamma2_aa(w) = Gamma2_aa(-w): \
odd powers of w vanish identically\"},
         coef =!= 0 && ! NumericQ[coef] && pt =!= {}, \
FRGAssert[\"Symmetries.contradiction\", False, {{a, b}, m, n, coef, pt[[All, \
\"Tag\"]]},
           \"this monomial carries a coupling of the ansatz and is also \
Protected (its flow would have to vanish): drop the tag or the coupling\"],
         pt =!= {}, (used = Join[used, pt[[All, \"Tag\"]]]; {\"Protected\", \
First[pt][\"Reason\"]}),
         coef =!= 0 && NumericQ[coef], {\"DeclaredNumeric\", \"numeric \
coefficient \" <> ToString[coef] <> \" in the ansatz: its flow must \
vanish\"},
         coef =!= 0, {\"Declared\", \"flow equation for \" <> inputForm[coef]},
         nt =!= {}, (used = Join[used, nt[[All, \"Tag\"]]]; {\"Neglected\", \
First[nt][\"Reason\"]}),
         True, {\"Untagged\", \"\"}];
       <|\"Pair\" -> {a, b}, \"Frequency\" -> m, \"Momentum\" -> n, \"Class\" \
-> cl, \"GammaK\" -> coef, \"Reason\" -> reason|>];

   (* one slot (pair, m): ordinary rows (I w)^m (q^2)^n, n <= mp; a slot \
carrying a momentum function F (design/MOMENTUMFUNCTIONS.md A4,
      B1, B2): its orders below n0 are ordinary rows, the orders >= n0 are \
one row of class Functional; a function-free slot with an
      \"AllMomenta\" tag also gets one row at generic p (B3) *)
   slotRows[a_, b_, m_] := Module[{e = VertexValue[v, {a, b}, {{nu, p}}], cm, \
fa, f, t, n0, pref, rest, hi, ft, atZero, am},
      cm = Expand[Coefficient[Expand[e /. scal[p, p] -> pp2], nu, m]/I^m];
      fa = Union[Cases[cm, fnPat[_], {0, Infinity}][[All, 0]]];
      am = Select[Join[prot, negl], allMomentaQ[#, {a, b}, m] &];
      If[fa === {},
       Join[Table[classify[a, b, m, n, Coefficient[cm, pp2, n]], {n, 0, mp}],
        If[am === {} || ! IntersectingQ[{a, b}, theory[\"ResponseFields\"]] \
|| (a === b && OddQ[m]), {},
         FRGAssert[\"Symmetries.contradiction\", First[am][\"Kind\"] === \
\"Neglected\" || FreeQ[cm, Alternatives @@ cps], {{a, b}, m, cm, \
First[am][\"Tag\"]},
          \"this slot carries a coupling of the ansatz and is also Protected \
at every momentum (its flow would have to vanish): drop the tag or the \
coupling\"];
         used = Join[used, {First[am][\"Tag\"]}];
         {<|\"Pair\" -> {a, b}, \"Frequency\" -> m, \"Momentum\" -> \
\"AllMomenta\", \"Class\" -> First[am][\"Kind\"], \"GammaK\" -> cm, \
\"Reason\" -> First[am][\"Reason\"]|>}]],
       FRGAssert[\"Symmetries.functionalSlot\", Length[fa] == 1, {{a, b}, m, \
fa}, \"one function per slot: two functions in one slot are one function, \
keep one\"];
       f = First[fa];
       t = Expand[D[cm /. f[pp2] -> fz, fz]];
       n0 = Exponent[t, pp2]; pref = Expand[t/pp2^n0];
       rest = Expand[cm /. f[pp2] -> 0];
       hi = Select[Range[n0, Max[n0, Exponent[rest, pp2]]], Coefficient[rest, \
pp2, #] =!= 0 &];
       FRGAssert[\"Symmetries.functionalSlot\", hi === {}, {{a, b}, m, f, \
\"orders \" -> hi},
        \"a constant term at an order >= n0 of the function's slot is F's job \
(e.g. -nk hbar lap[h] next to -nk Fnu hbar lap[h]): drop it\"];
       FRGAssert[\"Symmetries.contradiction\", am === {}, {{a, b}, m, f, \
am[[All, \"Tag\"]]},
        \"an \\\"AllMomenta\\\" tag on a slot that carries the momentum \
function \" <> ToString[f] <> \": use \\\"Momentum\\\" -> \" <> ToString[n0] \
<> \" (Protected) for F(0), or Related\"];
       (* tags naming explicit orders >= n0: only Protected at exactly n0 \
(the loop part of the flow at p = 0 vanishes) *)
       ft = Select[Join[prot, negl], pairMatchQ[#Pattern, {a, b}] && \
specMatchQ[#Frequency, m] && AnyTrue[explicitOrders[#], # >= n0 &] &];
       FRGAssert[\"Symmetries.functionalTag\", AllTrue[ft, #Kind === \
\"Protected\" && explicitOrders[#] === {n0} &], {{a, b}, m, f, ft[[All, \"Tag\
\"]]},
        \"only Protected[pair, \\\"Frequency\\\" -> \" <> ToString[m] <> \", \
\\\"Momentum\\\" -> \" <> ToString[n0] <>
         \", ...] is allowed on a functional slot (F(0) does not flow); \
Neglected or higher orders have no meaning there\"];
       used = Join[used, ft[[All, \"Tag\"]]];
       atZero = If[ft === {}, None, First[ft][\"Reason\"]];
       Append[Table[classify[a, b, m, n, Coefficient[rest, pp2, n]], {n, 0, \
Min[mp, n0 - 1]}],
        <|\"Pair\" -> {a, b}, \"Frequency\" -> m, \"Momentum\" -> n0, \"Class\
\" -> \"Functional\", \"GammaK\" -> pref f, \"Function\" -> f,
         \"ProtectedAtZero\" -> atZero,
         \"Reason\" -> \"flow equation for the function \" <> ToString[f] <> \
\"(p^2) at generic p\" <> If[atZero === None, \"\", \"; F(0) does not flow \
(\" <> atZero <> \")\"]|>]]];
   cls = Flatten[Table[slotRows[pr[[1]], pr[[2]], m], {pr, pairs}, {m, 0, \
mf}], 2];

   (* design/MOMENTUMFUNCTIONS.md A4: every declared function sits in exactly \
one slot with a nonzero Gamma2 *)
   fnSlots = AssociationMap[Function[f, Select[cls, Lookup[#, \"Function\", \
None] === f &][[All, {\"Pair\", \"Frequency\"}]]], fns];
   If[fns =!= {},
    bad = Select[fns, Length[fnSlots[#]] =!= 1 &];
    FRGAssert[\"Symmetries.functionSlot\", bad === {}, <|# -> fnSlots[#] & /@ \
bad|>,
     \"every momentum function sits in exactly one Gamma2 slot: a function \
whose term vanishes in Gamma2 (total derivative, odd w on a diagonal \\
entry, e.g. Fnu div[hbar grad[h]]) must be dropped; a function in two slots \
must become two functions related by Related[...]\"];
    AppendTo[checks, assertCheck[\"Symmetries.functionSlot\", True, Null, \"\",
      \"one slot per momentum function: \" <> StringRiffle[(ToString[#] <> \" \
in \" <> ToString[fnSlots[#][[1, \"Pair\"]]] <> \" (I w)^\" <> \
ToString[fnSlots[#][[1, \"Frequency\"]]]) & /@ fns, \", \"]]];
    AppendTo[warns, infoCheck[\"INFO\", \"Symmetries.functionalTruncation\", \
\"\\\"TruncationOrders\\\" \\\"Momentum\\\" applies to function-free slots \
and to the orders below n0 of functional slots\"]];
    (* B4: siblings of a functional slot that are computed at p -> 0 only \
(e.g. the I w slot of LO KPZ, f^lambda = 1) *)
    siblings = Select[cls, Function[r, MemberQ[{\"Declared\", \
\"DeclaredNumeric\", \"Protected\", \"Neglected\"}, r[\"Class\"]] && \
IntegerQ[r[\"Momentum\"]] &&
          AnyTrue[Values[fnSlots], Function[sl, sl[[1, \"Pair\"]] === \
r[\"Pair\"] && sl[[1, \"Frequency\"]] =!= r[\"Frequency\"]]] &&
          ! MemberQ[cls, KeyValuePattern[{\"Pair\" -> r[\"Pair\"], \
\"Frequency\" -> r[\"Frequency\"], \"Momentum\" -> \"AllMomenta\"}]]]];
    siblings = DeleteDuplicates[siblings[[All, {\"Pair\", \"Frequency\"}]]];
    warns = Join[warns, infoCheck[\"ASSUMPTION\", \
\"Symmetries.siblingAtZeroMomentum\", ToString[#Pair] <> \" (I w)^\" <> \
ToString[#Frequency] <>
         \" computed at p -> 0 only (add Neglected[\" <> ToString[#Pair] <> \
\", \\\"Frequency\\\" -> \" <> ToString[#Frequency] <> \", \\\"Momentum\\\" \
-> \\\"AllMomenta\\\", ...] to see its size)\"] & /@ siblings]];
   nAll = Count[cls, KeyValuePattern[\"Momentum\" -> \"AllMomenta\"]];
   If[nAll > 0, AppendTo[checks, assertCheck[\"Symmetries.allMomenta\", True, \
Null, \"\", ToString[nAll] <> \" slot(s) tagged \\\"AllMomenta\\\": computed \
at generic p\"]]];
   bad = Select[cls, #Class === \"Untagged\" &];
   AppendTo[checks, assertCheck[\"Symmetries.allTagged\", bad === {}, {#Pair, \
\"(I w)^\" <> ToString[#Frequency], \"(q^2)^\" <> ToString[#Momentum]} & /@ \
bad,
     \"every monomial up to the truncation orders must be declared in the \
ansatz, Protected or Neglected\", ToString[Length[cls]] <> \" monomials \
classified\"]];\
\>", "Program",ExpressionUUID->"de3ca756-2fba-42a7-a3d4-084e6f59e5d2"],

Cell["\<\
(* Kernel/Symmetries.wl:48-49 *)
(* coefficient of (I nu)^m (p^2)^n in a Gamma2 entry written with scal[p, p] *)
gammaCoefficient[e_, nu_, p_, m_, n_] := \
Expand[Coefficient[Coefficient[Expand[e /. scal[p, p] -> pp2], pp2, n], nu, \
m]/I^m];\
\>", "Program",ExpressionUUID->"d2f94b00-e459-4b45-a81d-e78068d0609f"],

Cell[TextData[{
 "The module rebuilds the vertices itself, silently (",
 StyleBox["Block[{Print}, BuildVertices[ansatz]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "): it needs the coefficients of ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_k (without regulator), and taking them from its own ansatz input avoids a \
second stage argument that could come from a different ansatz. ",
 StyleBox["gammaCoefficient",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " extracts the coefficient of (i",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ")^m (p",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")^n with two nested ",
 StyleBox["Coefficient and Exponent",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 05)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "."
}], "Text",ExpressionUUID->"7ae624ed-06fc-43af-9d4b-ea915b56a913"],

Cell[TextData[{
 StyleBox["Mathematica: Iterators that depend on each other",
  FontWeight->Bold],
 "\n",
 StyleBox["Table[expr, {pr, pairs}, {m, 0, mf}, {n, 0, mp}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs over every combination; ",
 StyleBox["Flatten[t, 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes two levels of nesting.",
 "\n\n",
 "The result of a three-iterator ",
 StyleBox["Table",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a list of lists of lists. ",
 StyleBox["Flatten[..., 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " flattens the first two levels only, leaving a flat list of records (each \
record is an association and must not be flattened further). ",
 StyleBox["Flatten[l, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with a level is the safe form whenever the elements themselves are lists \
or associations."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"5b2a70f8-5242-46f0-ab0e-5bd163737577"],

Cell["\<\
{Table[{i, j}, {i, 2}, {j, 2}], Flatten[Table[{i, j}, {i, 2}, {j, 2}], 1]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"787a00ca-38ce-481f-9b3a-1bec52afa9be"],

Cell[TextData[{
 "The order of the ",
 StyleBox["Which",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " is the precedence of the classes:"
}], "Text",ExpressionUUID->"c8f698ca-e900-417f-b152-626a0b12a643"],

Cell[TextData[{
 StyleBox["Causality",
  FontWeight->Bold],
 ": an entry between two physical fields; ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_",
 StyleBox["\[CurlyPhi]\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 " = 0, and its flow will be checked to vanish."
}], "Item",ExpressionUUID->"c74a88c9-5d6d-49e1-b9ab-9ed81a2cb976"],

Cell[TextData[{
 StyleBox["Structure",
  FontWeight->Bold],
 ": an odd frequency power in a diagonal entry; ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_aa(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") = ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_aa(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 "), so it vanishes identically and is not computed."
}], "Item",ExpressionUUID->"e6e9364f-d523-4c58-97a5-3996d5e9129a"],

Cell[TextData[{
 StyleBox["Protected",
  FontWeight->Bold],
 " wins over everything else, but a Protected monomial that carries a \
coupling is a contradiction, and aborts."
}], "Item",ExpressionUUID->"43f0ed44-245c-4560-b788-4ee27dfd8781"],

Cell[TextData[{
 StyleBox["DeclaredNumeric",
  FontWeight->Bold],
 ": a number in the ansatz, like the 1 in front of i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "; its flow must vanish."
}], "Item",ExpressionUUID->"df249a8f-87fd-4e9e-a2b0-cfd644c33a0d"],

Cell[TextData[{
 StyleBox["Declared",
  FontWeight->Bold],
 ": a coefficient with couplings; it gets a flow equation."
}], "Item",ExpressionUUID->"57e75af4-1fdd-43b7-8b2c-6e7c1e2f866e"],

Cell[TextData[{
 StyleBox["Neglected",
  FontWeight->Bold],
 "; anything left is ",
 StyleBox["Untagged",
  FontWeight->Bold],
 ", and ",
 StyleBox["Symmetries.allTagged",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " aborts."
}], "Item",ExpressionUUID->"38999bf2-a307-493b-a028-06de9404b484"],

Cell["\<\
showFailure[DeclareSymmetries[ansatz, Protected[{hbar, h}, \"Frequency\" -> \
0, \"Momentum\" -> 1, \"Reason\" -> \"a mistake\"], Neglected[_, \"Reason\" \
-> \"rest\"],
  \"TruncationOrders\" -> <|\"Frequency\" -> 2, \"Momentum\" -> 1|>]]\
\>", "Input",ExpressionUUID->"33ae7bbd-7532-4541-be20-7152e4e5c640"],

Cell[TextData[{
 StyleBox["Why it's built this way: Classify before computing",
  FontWeight->Bold],
 "\n\n",
 "The loops of lessons 07",
 StyleBox["\[Dash]",
  FontFamily->"Noto Sans"],
 "10 are the expensive part of the pipeline. A forgotten monomial, a \
contradictory tag or a truncation that misses a term of the ansatz are \
mistakes in the ",
 StyleBox["declaration",
  FontSlant->Italic],
 ", which can be found by looking only at ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_k. Doing it here means they abort in a fraction of a second, with a table \
that names the monomial, instead of after minutes of loop computation, or not \
at all (",
 StyleBox["docs/MODULES.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": \"the classification needs no flow, so it can fail early\"). Aborting on \
an untagged monomial forces every truncation decision to be written down."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"07c9e551-89ad-4400-a9c3-53c1a01222f0"],

Cell["5. Checks on the declaration as a whole", "Section",ExpressionUUID->"f1dbf90e-7918-45a4-8b28-4dc4b4e02a05"],

Cell["\<\
(* Kernel/Symmetries.wl:155-167 *)
   (* declared monomials of the ansatz beyond the truncation orders would be \
silently ignored *)
   (* functional slots: only their orders below n0 (the function is a single \
row at any order) *)
   declOutside = Select[Flatten[Table[{pr, m, n}, {pr, pairs}, {m, 0, 2 mf + \
4}, {n, 0, Max[2, Max[ansatz[\"Monomials\"][[All, \"MomentumOrder\"]]]/2]}], \
2],
     (#[[2]] > mf || #[[3]] > mp) && With[{fr = SelectFirst[cls, Function[r, \
r[\"Class\"] === \"Functional\" && r[\"Pair\"] === #[[1]] && r[\"Frequency\"] \
=== #[[2]]]]},
        If[MissingQ[fr], gammaCoefficient[VertexValue[v, #[[1]], {{nu, p}}] \
/. fnPat[_] -> 0, nu, p, #[[2]], #[[3]]] =!= 0 ||
          (#[[2]] > mf && ! FreeQ[Coefficient[Expand[VertexValue[v, #[[1]], \
{{nu, p}}]], nu, #[[2]]], fnPat]),
         #[[3]] < fr[\"Momentum\"] && gammaCoefficient[VertexValue[v, #[[1]], \
{{nu, p}}] /. fnPat[_] -> 0, nu, p, #[[2]], #[[3]]] =!= 0]] &];
   AppendTo[checks, assertCheck[\"Symmetries.truncationCoversAnsatz\", \
declOutside === {}, declOutside,
     \"the ansatz contains Gamma2 monomials beyond \\\"TruncationOrders\\\": \
raise the orders\", \"the truncation contains every monomial of the ansatz\"]];

   Scan[If[! MemberQ[used, #Tag], AppendTo[warns, infoCheck[\"WARN\", \
\"Symmetries.unusedTag\", inputForm[#Tag] <> \" matches no monomial \
(precedence)\"]]] &, Join[prot, negl]];
   warns = Join[warns, infoCheck[\"ASSUMPTION\", \"NonRenormalised[\" <> \
ToString[#[[1]]] <> \"]\", #[[2, 2]] <> \" (not checkable in v1: needs d_s \
Gamma3)\"] & /@ nonren];
   AppendTo[warns, infoCheck[\"ASSUMPTION\", \"Symmetries.wardIdentities\", \
\"Protected tags are user-declared Ward identities, not derived\"]];\
\>", "Program",ExpressionUUID->"b1496097-4854-43ee-9f97-416813b87c97"],

Cell["\<\
A truncation lower than the ansatz would silently drop a coupling's equation:\
\
\>", "Text",ExpressionUUID->"01bc22c7-a642-4696-b536-8e69845fa9cd"],

Cell["\<\
showFailure[DeclareSymmetries[ansatz, Neglected[_, \"Reason\" -> \"rest\"], \
\"TruncationOrders\" -> <|\"Frequency\" -> 2, \"Momentum\" -> 0|>]]\
\>", "Input",ExpressionUUID->"0dfecb23-4348-41d9-886f-1419a3e1731e"],

Cell[TextData[{
 "A tag that matches no monomial, because a tag of higher precedence took \
them all, gets a WARN. ",
 StyleBox["NonRenormalised",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " produces an ASSUMPTION line: in v1 it cannot be checked, because that \
would need the flow of ",
 StyleBox["\[CapitalGamma]\:207d\.b3\:207e",
  FontFamily->"Noto Sans"],
 ". And one ASSUMPTION line always reminds that the Protected tags are \
declared Ward identities."
}], "Text",ExpressionUUID->"49cebf85-fa22-4cda-913e-2603d59d8d17"],

Cell["6. The table", "Section",ExpressionUUID->"dfcea23e-8474-40ff-a806-42059061bd02"],

Cell["\<\
(* Kernel/Symmetries.wl:177-184 *)
ShowClassification[s_Association] := Module[{rows},
   rows = {ToString[#Pair], \"(I w)^\" <> ToString[#Frequency] <> \
Switch[#Momentum, \"AllMomenta\", \" all p\", _, If[#Class === \
\"Functional\",
          \" (q^2)^{>=\" <> ToString[#Momentum] <> \"}\", \" (q^2)^\" <> \
ToString[#Momentum]]], #Class,
       If[#GammaK === 0, \"\", If[#Class === \"Functional\", With[{f = \
Lookup[#, \"Function\", None]}, displayString[#GammaK /. f -> \
f[Symbol[\"FRGscalarMSR`Symmetries`Private`p\"]^2]]] , inputForm[#GammaK]]], \
#Reason} & /@ s[\"Classification\"];
   Print[\"Monomial classification (Gamma2_ab, a before b in field order; \
precedence Protected > declared > Neglected):\"];
   Print[If[$FrontEnd === Null,
     StringRiffle[StringRiffle[MapThread[StringPadRight, {#, {18, 16, 16, 18, \
1}}], \" | \"] & /@ Prepend[rows, {\"pair\", \"monomial\", \"class\", \
\"Gamma_k coeff.\", \"reason\"}], \"\\n\"],
     Grid[Prepend[rows, {\"pair\", \"monomial\", \"class\", \"Gamma_k \
coeff.\", \"reason\"}], Frame -> All, Alignment -> Left]]]];\
\>", "Program",ExpressionUUID->"149c6a74-1cfc-48d7-84b6-ccc0080f90eb"],


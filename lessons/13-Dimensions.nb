Cell["2. One linear equation per monomial term", "Section",ExpressionUUID->"03b73ec7-216c-46fc-922b-11c2cf17162a"],

Cell["\<\
(* Kernel/Dimensions.wl:37-38 *)
basisForm[v_List, basis_List] := Times @@ MapThread[Power, {basis, v}];
linearPart[v_List, etas_List] := -First[v] + Rest[v].etas;\
\>", "Program",ExpressionUUID->"b9d24e27-40a9-4732-8b4b-0a7f8f35f70f"],

Cell["\<\
(* Kernel/Dimensions.wl:40-45 *)
(* the power of each coupling in one term of a coefficient: n_c = c dterm/dc \
/ term, a number for a monomial *)
couplingPowers[term_, cps_List] := Module[{n = Together[# D[term, #]/term] & \
/@ cps},
   FRGAssert[\"Dimensions.monomialCoefficient\", AllTrue[n, NumberQ], term,
    \"each term of a coefficient must be a number times a product of powers \
of couplings\"];
   n];
termsOf[c_] := With[{e = Expand[c]}, If[Head[e] === Plus, List @@ e, {e}]];\
\>", "Program",ExpressionUUID->"88dc583b-c42a-4416-978d-0cd4a600f61a"],

Cell["\<\
(* Kernel/Dimensions.wl:47-51 *)
(* one equation per monomial term: [term] + Sum[fields] - nt [t] + n_x e_k + \
[t] - Dim e_k = 0 (Gamma has no dimension) *)
monomialEquations[mons_, cps_, fields_] := Flatten[Function[m, Function[t,
      <|\"Monomial\" -> MonomialString[m], \"Term\" -> t, \"CouplingPowers\" \
-> couplingPowers[t, cps],
       \"FieldCounts\" -> (Count[m[\"Fields\"], #] & /@ fields), \
\"TimeOrder\" -> m[\"TimeOrder\"], \"MomentumOrder\" -> \
m[\"MomentumOrder\"]|>] /@
     termsOf[m[\"Coefficient\"]]] /@ mons, 1];\
\>", "Program",ExpressionUUID->"a6fdb3a1-e105-4567-8249-3f9d944e8ede"],

Cell["\<\
(* Kernel/Dimensions.wl:53-54 *)
(* unknown columns: time, fields, couplings; each equation is  row . u + \
const = 0, one copy per basis component *)
equationRow[eq_, cols_, cps_, fields_] := Join[{1 - eq[\"TimeOrder\"]}, \
eq[\"FieldCounts\"], eq[\"CouplingPowers\"]][[cols]];\
\>", "Program",ExpressionUUID->"454f89a9-ba75-4014-9262-6b9f131ae2c1"],

Cell[TextData[{
 "A dimension is an ",
 StyleBox["exponent vector",
  FontWeight->Bold],
 " over the basis (k, ref",
 StyleBox["\:2081",
  FontFamily->"Noto Sans"],
 ", ..., ref_{N+1}): k^x ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 "^{y",
 StyleBox["\:2081",
  FontFamily->"Noto Sans"],
 "} D^{y",
 StyleBox["\:2082",
  FontFamily->"Noto Sans"],
 "} is the vector {x, y",
 StyleBox["\:2081",
  FontFamily->"Noto Sans"],
 ", y",
 StyleBox["\:2082",
  FontFamily->"Noto Sans"],
 "}. For a monomial term c ",
 StyleBox["\[Times]",
  FontFamily->"Noto Sans"],
 " fields ",
 StyleBox["\[Times]",
  FontFamily->"Noto Sans"],
 " derivatives, \"",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 " dimensionless\" is the linear equation"
}], "Text",ExpressionUUID->"7e9f1e5b-01e2-44c8-9360-c9837b5dd2ae"],

Cell[TextData[{
 "[c] + ",
 StyleBox["\[CapitalSigma]",
  FontFamily->"Noto Sans"],
 "[fields] ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " (number of ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "t)",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "[t] + (number of spatial indices)",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "e_k + [t] ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " d",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "e_k = 0,"
}], "Text",ExpressionUUID->"b9c33f40-9c89-4f38-928a-53589f014491"],

Cell[TextData[{
 "where the last two terms are the measure dt d",
 StyleBox["\:1d48",
  FontFamily->"Noto Sans"],
 "x. ",
 StyleBox["couplingPowers",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads the power of each coupling in a term as c ",
 StyleBox["\[PartialD]",

Cell["6. Inspection", "Section",ExpressionUUID->"6dd56710-4f78-4995-b206-3c78a61a3f6a"],

Cell["\<\
(* Kernel/Dimensions.wl:227-235 *)
DimensionOf[dims_Association, x_] := Block[{$FRGModule = \"Dimensions\"},
   validateStage[dims, \"Dimensions\"];
   Which[x === \"Frequency\" || x === \"Time\", dimForm[dims, dims[x]],
    KeyExistsQ[dims[\"Vectors\"], x], dimForm[dims, dims[\"Vectors\"][x]],
    True, FRGAssert[\"Dimensions.unknownSymbol\", False, x, \"not a coupling \
or field of this ansatz (or \\\"Frequency\\\", \\\"Time\\\")\"]]];
LinearPart[dims_Association, c_] := Block[{$FRGModule = \"Dimensions\"},
   validateStage[dims, \"Dimensions\"];
   FRGAssert[\"Dimensions.unknownCoupling\", \
MemberQ[Join[dims[\"Ansatz\"][\"Couplings\"], Lookup[dims, \
\"MomentumFunctions\", {}]], c], c, \"not a coupling of this ansatz\"];
   Expand[linearPart[dims[\"Vectors\"][c], Values[dims[\"Etas\"]]]]];\
\>", "Program",ExpressionUUID->"9b453dbf-98de-4c26-97c6-0bbb62b0fb9c"],

Cell["\<\
(* Kernel/Dimensions.wl:257-273 *)
CheckDimensions[dims_Association, hand_Association] := Block[{$FRGModule = \
\"Dimensions\"},
  Module[{basis, toVec, derived, keys, mism},
   validateStage[dims, \"Dimensions\"]; basis = dims[\"Basis\"];
   (* exponent vector of a product of powers of the basis symbols *)
   toVec[e_] := Module[{lg = Expand[PowerExpand[Log[e]]]},
     FRGAssert[\"Dimensions.handForm\", FreeQ[lg /. Thread[Log /@ basis -> \
0], Alternatives @@ basis] && FreeQ[lg /. Thread[Log /@ basis -> 0], Log], e,
      \"a hand value must be a product of powers of \" <> \
displayString[basis]];
     Coefficient[lg, Log[#]] & /@ basis];
   keys = Keys[hand];
   derived[x_] := Which[x === \"Frequency\" || x === \"Time\", dims[x], \
KeyExistsQ[dims[\"Vectors\"], x], dims[\"Vectors\"][x],
     True, FRGAssert[\"Dimensions.unknownSymbol\", False, x, \"not a coupling \
or field of this ansatz (or \\\"Frequency\\\", \\\"Time\\\")\"]];
   mism = Select[keys, ! AllTrue[Expand[toVec[hand[#]] - derived[#]], # === 0 \
&] &];
   FRGAssert[\"Dimensions.handCheck\", mism === {},
    <|# -> <|\"hand\" -> hand[#], \"derived\" -> dimForm[dims, derived[#]]|> \
& /@ mism|>,
    \"hand-derived and derived dimensions differ (shown above)\"];
   Print[\"CheckDimensions: \", Length[keys], \" hand values agree exactly: \
\", StringRiffle[ToString /@ keys, \", \"]];
   keys]];\
\>", "Program",ExpressionUUID->"21b803b2-9038-4b77-afe7-ce98dcb08f2d"],

Cell[TextData[{
 StyleBox["CheckDimensions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " compares hand-derived dimensions with the derived ones. To turn a product \
of powers back into an exponent vector, it takes ",
 StyleBox["PowerExpand[Log[e]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and reads the coefficient of each ",
 StyleBox["Log[basis element]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"cace8603-8bd9-4820-b3c2-97bfd6e2015f"],

Cell[TextData[{
 StyleBox["Mathematica: PowerExpand and Log",
  FontWeight->Bold],
 "\n",
 StyleBox["PowerExpand[Log[x^a y^b]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives ",
 StyleBox["a Log[x] + b Log[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", assuming positive quantities.",
 "\n\n",
 StyleBox["Log",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns products of powers into sums, which ",
 StyleBox["Coefficient",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Coefficient and Exponent",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 05)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") can read. ",
 StyleBox["PowerExpand",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes the expansion unconditional, valid here because dimensions are \
positive scales."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"8457bf4c-695c-4d0e-b079-9cefed2e3e43"],


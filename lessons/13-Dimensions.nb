Cell["\<\
DimensionOf[dims, lamk]^2 DimensionOf[dims, Dk]/DimensionOf[dims, nuk]^3\
\>", "Input",ExpressionUUID->"3c89b250-a5b7-491f-bd8e-173c61a3b866"],

Cell[TextData[{
 "The dimensions multiply like the quantities. So k^{d",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2} g is dimensionless, the combination used in Canet's flow."
}], "Text",ExpressionUUID->"f290d3a8-2cbb-404d-a735-b2ae3086f3e7"]
}, Closed]],


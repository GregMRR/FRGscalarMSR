}], "Text",ExpressionUUID->"a092baf1-d35a-4d22-9116-766115493822"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"d3e33108-9ddb-467d-9578-56f42f4fc8fc"],

Cell["\<\
DimensionOf[dims, lamk]^2 DimensionOf[dims, Dk]/DimensionOf[dims, nuk]^3\
\>", "Input",ExpressionUUID->"ea559098-a564-44fd-8d56-dba3a8275985"],

Cell[TextData[{
 "The dimensions multiply like the quantities. So k^{d",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2} g is dimensionless, the combination used in Canet's flow."
}], "Text",ExpressionUUID->"a5d109e0-1d18-4cb3-868f-c0d10b4953da"]
}, Closed]],


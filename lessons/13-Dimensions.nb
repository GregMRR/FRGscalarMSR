Cell["dims[\"Equations\"][[1]]", "Input",ExpressionUUID->"e6329165-123d-4184-9de7-1a314d23c612"],

Cell["3. Solving the system", "Section",ExpressionUUID->"e4b49a5e-4f50-4d2f-9f55-8aa028822054"],

Cell["\<\
(* Kernel/Dimensions.wl:144-167 *)
   basis = Prepend[refs, kk]; nb = Length[basis];
   eqs = monomialEquations[mons, cps, fields];
   unknownCps = Complement[cps, refs, dl];
   cols = Join[{1}, 1 + Range[Length[fields]], 1 + Length[fields] + \
Flatten[Position[cps, #] & /@ unknownCps]];
   colNames = Join[{\"time\"}, fields, unknownCps];
   nUnk = Length[cols];

   (* freedoms: the homogeneous system with the references as unknowns too; \
its solutions are the changes of units that leave
      Gamma invariant besides k; there must be exactly N+1 of them, fixed by \
the references *)
   mFull = equationRow[#, Join[cols, 1 + Length[fields] + \
Flatten[Position[cps, #] & /@ refs]], cps, fields] & /@ eqs;
   nsFull = NullSpace[mFull];
   mU = equationRow[#, cols, cps, fields] & /@ eqs;
   If[Length[nsFull] =!= nS + 1,
    (* with the references fixed, the unknowns that still move in the null \
space are undetermined *)
    undet = If[Length[nsFull] > nS + 1, Pick[colNames, Map[AnyTrue[#, # =!= 0 \
&] &, Transpose[Join[NullSpace[mU], {ConstantArray[0, nUnk]}]]], True], {}];
    FRGAssert[\"Dimensions.freedoms\", False, <|\"freedoms\" -> \
Length[nsFull], \"expected\" -> nS + 1, \"undetermined\" -> undet|>,
     If[Length[nsFull] > nS + 1,
      \"the ansatz leaves more than N+1 units free: declare the amplitudes in \
\\\"Dimensionless\\\" (e.g. Ak in nk Ak, or a MomentumFunction that is a pure \
number), or check the undetermined ones\",
      \"the ansatz fixes more units than expected: is each phibar dt[phi] \
written with coefficient 1? Is a \\\"Dimensionless\\\" coupling really \
dimensionless?\"]]];
   AppendTo[checks, assertCheck[\"Dimensions.freedoms\", True, Null, \"\", \
ToString[nS + 1] <> \" free units besides k (Gamma dimensionless fixes the \
rest)\"]];
   refRows = nsFull[[All, nUnk + Range[nS + 1]]];
   AppendTo[checks, assertCheck[\"Dimensions.referencesIndependent\", \
MatrixRank[refRows] == nS + 1, refs,
     \"the references are not independent: their dimensions are related by \
the ansatz, choose another set (e.g. one per field pair and one for time)\",
     \"references independent\"]];\
\>", "Program",ExpressionUUID->"3be7bd68-dd69-499b-a238-6cdb04ac6725"],

Cell[TextData[{
 StyleBox["Mathematica: Linear algebra",
  FontWeight->Bold],
 "\n",
 StyleBox["NullSpace[m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a basis of the solutions of m.x = 0; ",
 StyleBox["MatrixRank[m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the rank; ",
 StyleBox["LinearSolve[m, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " solves m.x = b.",
 "\n\n",
 "The unknowns are [t], the field dimensions and the non-reference couplings. \
Before solving, the module counts the ",
 StyleBox["freedoms",
  FontWeight->Bold],
 ": with the references treated as unknowns too, the null space of the \
homogeneous system must have exactly N + 1 vectors, the changes of units that \
leave ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 " invariant besides k. The references must then fix all of them (",
 StyleBox["MatrixRank",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of their rows is N + 1)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"e23b0b38-eed8-4220-85a6-4ec377a93add"],

Cell["\<\
{NullSpace[{{1, 1, 0}, {0, 1, 1}}], MatrixRank[{{1, 2}, {2, 4}}], \
LinearSolve[{{2, 0}, {0, 4}}, {2, 8}]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"310ca21b-9036-4fee-a080-4ecf73b6bf1c"],

Cell[TextData[{
 "An amplitude written as a product, ",
 StyleBox["nuk Ak lap[h]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", leaves one unit free too many:"
}], "Text",ExpressionUUID->"ceb46a5d-f7bd-4485-8b02-e5f908c93b7e"],

Cell["\<\
ansatzA = Block[{Print}, DefineAnsatz[kpzTheory, \"Density\" -> hbar (dt[h] - \
nuk Ak lap[h]) - Dk hbar^2, \"Couplings\" -> {nuk, Ak, Dk}]];
showFailure[DeriveDimensions[ansatzA, \"References\" -> {nuk -> \"nu\", Dk -> \
\"D\"}, \"Scale\" -> k]]\
\>", "Input",ExpressionUUID->"9381ad92-b289-4d10-84a6-9871010f8047"],

Cell[TextData[{
 "The hint suggests the fix: ",
 StyleBox["\"Dimensionless\" -> {Ak}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"e4b87e48-83c2-4706-b9d5-f9492e7d2a69"],

Cell["\<\
(* Kernel/Dimensions.wl:169-178 *)
   (* solve each basis component: M u = -(const), const = (n_x - Dim, powers \
of the references); M has full column rank here
      (N+1 freedoms, all fixed by the references), so the normal equations \
give the unique solution if one exists *)
   consts = Join[{#MomentumOrder - dimSym}, \
#CouplingPowers[[Flatten[Position[cps, #] & /@ refs]]]] & /@ eqs;
   sol = LinearSolve[Transpose[mU] . mU, -Transpose[mU] . consts];
   residual = Expand[mU . sol + consts];
   If[! AllTrue[Flatten[residual], # === 0 &],
    conflicts = MapThread[If[AllTrue[#2, # === 0 &], Nothing, \
#1[\"Monomial\"] <> \" (\" <> inputForm[#1[\"Term\"]] <> \")\"] &, {eqs, \
residual}];
    FRGAssert[\"Dimensions.consistent\", False, conflicts,
     \"these monomials give incompatible dimensions (a coupling appears in \
several monomials with different field or derivative content); check the \
ansatz\"]];
   AppendTo[checks, assertCheck[\"Dimensions.consistent\", True, Null, \"\", \
ToString[Length[eqs]] <> \" monomial equations solved exactly (overdetermined \
system consistent)\"]];\
\>", "Program",ExpressionUUID->"9d19e0de-fdf6-4b10-adb4-72b9d34be689"],

Cell[TextData[{
 "The system is overdetermined (a coupling may appear in several monomials), \
so it is solved through the normal equations m",
 StyleBox["\:1d40",
  FontFamily->"Noto Sans"],
 "m u = ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "m",
 StyleBox["\:1d40",
  FontFamily->"Noto Sans"],
 " c, and then the residual is checked to vanish exactly. A nonzero residual \
lists the monomials that disagree; ",
 StyleBox["Nothing",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is an element that removes itself from a list, so ",
 StyleBox["If[ok, Nothing, label]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " keeps only the conflicts."
}], "Text",ExpressionUUID->"31f3e1c3-e0f9-4e32-b0ed-a6223d97e77f"],

Cell["{{1, Nothing, 2}, UnitVector[3, 2]}", "Input",ExpressionUUID->"4e3c5c16-09a5-4b4b-9912-0fa029b529cb"],

Cell[TextData[{
 StyleBox["UnitVector[n, i]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the dimension of the i-th basis element, used for the references."
}], "Text",ExpressionUUID->"7ec5e82c-7592-49f5-a03f-d77913e5f735"],

Cell["4. An independent check: rescale the action", "Section",ExpressionUUID->"574df496-0daf-4de8-8b0e-d10a9831a809"],

Cell["\<\
(* Kernel/Dimensions.wl:56-73 *)
(* ---------- independent check: rescale the raw density ----------
   New units: every quantity of dimension v is multiplied by s(v) = Prod_j \
lambda_j^v_j. With t_new = s([t]) t, x_new = x/lambda_k,
   phi_new(t, x) = s([phi]) phi(t/s([t]), lambda_k x), c_new = s([c]) c, the \
density must obey
   L_new(t, x) = s(Dim e_k - [t]) L(t/s([t]), lambda_k x), i.e. the action \
Integral dt d^dx L is unchanged. Evaluated on explicit
   polynomial test fields with exact rationals, from the density as written \
(not from the parsed monomial table). *)
evalDensity[e_, fieldVals_, tt_, xs_] := Module[{ev},
   ev[s_Symbol] := Lookup[fieldVals, s, s];
   ev[dt[a_]] := D[ev[a], tt];
   ev[grad[a_]] := D[ev[a], #] & /@ xs;
   ev[div[a_]] := Total[MapThread[D, {ev[a], xs}]];
   ev[lap[a_]] := Total[D[ev[a], {#, 2}] & /@ xs];
   ev[jac[a_, b_]] := With[{A = ev[a], B = ev[b]}, D[A, xs[[1]]] D[B, \
xs[[2]]] - D[A, xs[[2]]] D[B, xs[[1]]]];
   ev[Dot[a_, b_]] := ev[a] . ev[b];
   ev[x_Plus] := Plus @@ (ev /@ List @@ x);
   ev[x_Times] := Times @@ (ev /@ List @@ x);
   ev[Power[a_, n_]] := ev[a]^n;
   ev[x_] := x;
   ev[e]];\
\>", "Program",ExpressionUUID->"a477cad0-9c4c-4a0a-8f1b-0025418d23a0"],

Cell["\<\
(* Kernel/Dimensions.wl:75-90 *)
rescalingCheckQ[dens_, fields_, cps_, dimOf_, timeDim_, dimSym_, d_, seed_] \
:= Module[{tt, xs, vec, den, lam, s, cv, fv, fvNew, cvNew, pt, lhs, rhs, deg \
= 3},
   xs = Array[Unique[\"x\"] &, d]; tt = Unique[\"t\"];
   vec[v_] := v /. dimSym -> d;
   den = LCM @@ Denominator[Flatten[vec /@ Join[Values[dimOf], {timeDim}]]];
   SeedRandom[seed];
   lam = (RandomInteger[{2, 9}, Length[timeDim]]/RandomInteger[{2, 9}, \
Length[timeDim]])^den;
   s[v_] := Times @@ (lam^vec[v]);
   cv = AssociationThread[cps -> RandomInteger[{1, 30}, \
Length[cps]]/RandomInteger[{1, 30}, Length[cps]]];
   fv = AssociationThread[fields -> Table[Sum[RandomInteger[{-5, \
5}]/RandomInteger[{1, 7}] tt^a Times @@ (xs^RandomInteger[{0, deg}, d]), {a, \
0, deg}, {3}],
       Length[fields]]];
   fvNew = AssociationThread[fields -> (s[dimOf[#]] (fv[#] /. \
Prepend[Thread[xs -> First[lam] xs], tt -> tt/s[timeDim]]) & /@ fields)];
   cvNew = AssociationThread[cps -> (s[dimOf[#]] cv[#] & /@ cps)];
   pt = Thread[Prepend[xs, tt] -> RandomInteger[{1, 9}, d + \
1]/RandomInteger[{1, 9}, d + 1]];
   lhs = evalDensity[dens /. Normal[cvNew], fvNew, tt, xs] /. pt;
   rhs = s[UnitVector[Length[timeDim], 1] dimSym - timeDim] (evalDensity[dens \
/. Normal[cv], fv, tt, xs] /. Prepend[Thread[xs -> First[lam] xs], tt -> \
tt/s[timeDim]] /. pt);
   Together[lhs - rhs] === 0];\
\>", "Program",ExpressionUUID->"a2c83883-e9b9-4512-91b4-34395f1ce6e7"],

Cell[TextData[{
 "The derived dimensions say how every quantity changes when the units \
change. The check makes such a change, with random factors ",
 StyleBox["\[Lambda]",
  FontFamily->"Noto Sans"],
 "_j, and verifies that the action is invariant: explicit polynomial test \
fields are put into the ",
 StyleBox["density as you wrote it",
  FontWeight->Bold],
 ", evaluated with a small interpreter ",
 StyleBox["ev",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of the operators (",
 StyleBox["dt",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "t, ",
 StyleBox["grad",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " list of ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "_i, ...), before and after the rescaling."
}], "Text",ExpressionUUID->"4fdde61b-037f-423b-96b9-eaa3a7957e61"],

Cell[TextData[{
 StyleBox["Mathematica: Unique and LCM",
  FontWeight->Bold],
 "\n",
 StyleBox["Unique[\"x\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " creates a new symbol never used before (x1, x2, ...); ",
 StyleBox["LCM",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the least common multiple.",
 "\n\n",
 "The test coordinates are fresh symbols, so they cannot collide with \
anything in the density. The random factors are raised to the least common \
denominator of the exponents, so that fractional dimensions like k^{1",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "d/2} still give rational numbers."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"ebdcb80b-d3c5-4ecc-b67a-e3412e09d2fd"],

Cell["{Unique[\"x\"], Unique[\"x\"], LCM[4, 6]}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"fd6dbf27-1d9a-494a-a424-5f7b6fc8a604"],

Cell[TextData[{
 StyleBox["Why it's built this way: Linear algebra on the parse, and a check \
on the raw density",
  FontWeight->Bold],
 "\n\n",
 "The linear system uses the monomial table of lesson 02, so a parser error \
would give consistent but wrong dimensions. The rescaling check does not use \
the table at all: it reads the density through its own interpreter. This is \
the strategy of lesson 03 (plane waves against the parse) applied to \
dimensions. Checking at two values of d (2 and 3) and two random seeds makes \
an accidental agreement negligible."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"1d61ca41-cfe5-482f-9a33-838801f2b0fc"],

Cell["5. Names, \[Eta] symbols, the stage", "Section",ExpressionUUID->"bedb7960-07b0-4ac8-90db-3aa8a954a156"],

Cell["\<\
(* Kernel/Dimensions.wl:192-218 *)
   (* names of the dimensionless couplings and of the etas *)
   (* a momentum function always gets a new name a<>F \
(design/MOMENTUMFUNCTIONS.md R8): F(p^2) and Fhat(p^2/k^2) differ *)
   names = Association[# -> Lookup[nameOverride, #, If[AllTrue[dimOf[#], # \
=== 0 &] && ! MemberQ[fns, #], #, Symbol[Context[#] <> \"a\" <> \
SymbolName[#]]]] & /@
      Select[cps, ! MemberQ[refs, #] &]];
   etaSyms = With[{ctx = Context @@ {First[refs]}}, Symbol[ctx <> \"eta\" <> \
#] & /@ refNames];
   aq = Symbol[\"Global`aq\"]; ap = Symbol[\"Global`ap\"];
   generated = Join[Cases[KeyValueMap[List, names], {c_, n_} /; c =!= n :> \
n], etaSyms];
   bad = Union[Select[generated, MemberQ[Join[cps, fields, {kk, aq, ap, \
dimSym}], #] || OwnValues[#] =!= {} || DownValues[#] =!= {} &],
     Select[generated, Count[Join[Values[names], etaSyms], #] > 1 &]];
   FRGAssert[\"Dimensions.names\", bad === {}, bad,
    \"a generated name collides with a coupling, a field, k, aq or another \
generated name, or has a value: rename with \\\"Names\\\" -> <|c -> newName|>\
\"];
   AppendTo[checks, assertCheck[\"Dimensions.names\", True, Null, \"\", \
\"dimensionless names and eta symbols collision-free\"]];
   With[{undeclared = Select[Complement[unknownCps, Keys[nameOverride]], \
AllTrue[dimOf[#], # === 0 &] &]},
    If[undeclared =!= {}, AppendTo[warns, infoCheck[\"INFO\", \
\"Dimensions.derivedDimensionless\",
       \"dimensionless without being declared (name kept): \" <> \
StringRiffle[ToString /@ undeclared, \", \"]]]]];
   If[dlInferred =!= {}, AppendTo[warns, infoCheck[\"INFO\", \
\"Dimensions.functionDimensionless\",
      \"dimensionless because they multiply a reference: \" <> \
StringRiffle[(ToString[#] <> \" (times \" <> ToString[First[fnPrefactors[#]]] \
<> \")\") & /@ dlInferred, \", \"]]]];

   stage = stampStage[<|\"Stage\" -> \"Dimensions\", \"Pipeline\" -> \
\"DerivativeExpansion\", \"Upstream\" -> {ansatz[\"Fingerprint\"]},
      \"Ansatz\" -> ansatz, \"Basis\" -> basis, \"Scale\" -> kk, \
\"Dimension\" -> dimSym,
      \"References\" -> refs, \"EtaNames\" -> AssociationThread[refs -> \
refNames], \"Etas\" -> AssociationThread[refs -> etaSyms],
      \"ReferenceModes\" -> AssociationThread[refs -> refModes], \
\"ReferenceEquations\" -> AssociationThread[refs -> refEqs], \
\"Dimensionless\" -> dl,
      Sequence @@ If[fns === {}, {}, {\"MomentumFunctions\" -> fns}],
      \"Vectors\" -> dimOf, \"Time\" -> timeDim, \"Frequency\" -> -timeDim, \
\"Names\" -> names, \"Equations\" -> eqs,
      \"Checks\" -> checks, \"Warnings\" -> warns, \"Timing\" -> \
AbsoluteTime[] - t0|>];
   ShowDimensions[stage];
   PrintCard[stage];\
\>", "Program",ExpressionUUID->"f3a12859-5757-4241-8e75-879200c20537"],

Cell[TextData[{
 "A dimensionful coupling c gets the dimensionless name ",
 StyleBox["a<>c",

Cell["\<\
(* Kernel/Dimensions.wl:28-31 *)
EmbeddedStage[s_Association, name_String] := If[Lookup[s, \"Stage\", None] \
=== name, s,
   FirstCase[EmbeddedStage[#, name] & /@ Select[Values[s], AssociationQ[#] && \
KeyExistsQ[#, \"Stage\"] &], _Association, Missing[\"NotEmbedded\", name]]];
AnsatzOf[s_Association] := Block[{$FRGModule = \"Dimensions\"}, Module[{a = \
EmbeddedStage[s, \"Ansatz\"]},
    FRGAssert[\"Dimensions.ansatzOf\", ! MissingQ[a], Lookup[s, \"Stage\", \
s], \"this stage does not embed an Ansatz stage\"]; a]];\
\>", "Program",ExpressionUUID->"d8754122-dd38-439b-a9fc-06a848a4ed7f"],

Cell[TextData[{
 StyleBox["FirstCase[list, patt, default]",

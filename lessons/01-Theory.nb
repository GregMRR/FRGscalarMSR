Cell[TextData[{
 "Without this check, ",
 StyleBox["\"Scalar\" -> {h}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (a typo) would be silently ignored: ",
 StyleBox["OptionValue[\"Scalars\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " would return the default ",
 StyleBox["{}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and the error would surface later with a message about an empty list. The \
check names the real problem:"
}], "Text",ExpressionUUID->"e5444477-660e-4fda-8256-c1a9ef37e400"],

Cell["\<\
showFailure[DefineTheory[\"Scalar\" -> {h}, \"Dimension\" -> Dim]]\
\>", "Input",ExpressionUUID->"46519ae1-5846-4a56-a18f-ffc4a31ffa3b"],

Cell["Checks as a list of records", "Subsection",ExpressionUUID->"ba66f393-d1d4-4b09-b0f4-218e12f4a036"],

Cell[TextData[{
 StyleBox["checks = {assertCheck[...]}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " starts the list of card lines and ",
 StyleBox["AppendTo[checks, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " extends it. Some checks are plain ",
 StyleBox["FRGAssert",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " calls instead: they abort on failure like the others, but do not add a \
PASS line to the card. The rule in the library is that a check worth reading \
on the card is an ",
 StyleBox["assertCheck",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; a precondition whose success is obvious is an ",
 StyleBox["FRGAssert",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"c9f51a99-320b-4c0a-8c4a-42e911ff4eb2"],

Cell[TextData[{
 StyleBox["Mathematica: AppendTo",
  FontWeight->Bold],
 "\n",
 StyleBox["AppendTo[x, e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["x = Append[x, e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": it rebinds the variable x to a longer list.",
 "\n\n",
 "Lists, like associations, are values: ",
 StyleBox["Append",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns a new list. ",
 StyleBox["AppendTo",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " assigns it back to the variable, which works only on a variable (here a ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " local)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"8220a5bc-d67e-47f1-bcea-874531d82017"],

Cell[TextData[{
 StyleBox["Theory.N",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " allows one or two scalars. With two, the propagator denominator ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") is a polynomial of degree 2 in ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", the largest degree v1 integrates in closed form (lesson 09)."
}], "Text",ExpressionUUID->"70220170-b863-44de-a97f-85dcc25114ef"],

Cell["\<\
showFailure[DefineTheory[\"Scalars\" -> {u1, u2, u3}, \"Dimension\" -> Dim]]\
\>", "Input",ExpressionUUID->"d84ee93b-31bc-40dd-b04d-bb6cd194d883"],

Cell["The symbols must be fresh", "Subsection",ExpressionUUID->"6412d283-c983-4950-8ae1-8c1702db7a03"],

Cell[TextData[{
 StyleBox["assertFreshSymbols",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 00, section 6) runs on the scalars, then on the generated response \
fields, then on the dimension symbol. Note what happens with a symbol that \
has a value:"
}], "Text",ExpressionUUID->"2a0998aa-2a86-4c43-a439-0a1ac4a6b3fb"],

Cell["\<\
uu = 1;
showFailure[DefineTheory[\"Scalars\" -> {uu}, \"Dimension\" -> Dim]]\
\>", "Input",ExpressionUUID->"8d8dfe3b-e06f-46b7-86a9-ea596c96ce78"],

Cell["Clear[uu]", "Input",ExpressionUUID->"d3f5ef0a-e706-4aec-bc3e-70db06008b91"],

Cell[TextData[{
 "The offending expression is ",
 StyleBox["{1}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", not ",
 StyleBox["{uu}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": Mathematica evaluated the arguments before ",
 StyleBox["DefineTheory",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " saw them, so the library never knew the name ",
 StyleBox["uu",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". That is why ",
 StyleBox["assertFreshSymbols",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " first checks that every element is still a ",
 StyleBox["Symbol",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (the ",
 StyleBox[".symbols",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " check), and only then looks at definitions (",
 StyleBox[".values",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), which catch symbols that are functions (",
 StyleBox["uu[x_] := ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") and therefore do not evaluate away."
}], "Text",ExpressionUUID->"27d44e7c-d9ec-44cc-be02-61d5e6afc427"],

Cell["Making the response fields", "Subsection",ExpressionUUID->"3f39df00-7cfa-42f0-80d3-7dd6e67324b9"],

Cell[TextData[{
 StyleBox["Mathematica: Symbol and SymbolName",
  FontWeight->Bold],
 "\n",
 StyleBox["Symbol[\"name\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the symbol with that name, creating it if needed; ",
 StyleBox["SymbolName[s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Context[s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " give its short name and its context.",
 "\n\n",
 StyleBox["Symbol[Context[#] <> SymbolName[#] <> \"bar\"] & /@ phis",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns ",
 StyleBox["{h}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " into ",
 StyleBox["{hbar}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Passing the full name ",
 StyleBox["\"Global`hbar\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " puts the new symbol in the same context as ",
 StyleBox["h",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", whatever ",
 StyleBox["$Context",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is when the library runs. ",
 StyleBox["Context",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " has the attribute ",
 StyleBox["HoldFirst",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Hold attributes",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "): it looks at the expression as written. ",
 StyleBox["Context[#] &",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " works because the pure function puts ",
 StyleBox["h",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " itself in place of ",
 StyleBox["#",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " before ",
 StyleBox["Context",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs; on a computed expression, write ",
 StyleBox["Context @@ {expr}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (CLAUDE.md, Gotchas)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"64caf050-f394-4ada-bd89-6ca5f996866a"],

Cell["\<\
{Attributes[Context], Context @@ {First[{h}]}, \
Quiet[Check[Context[First[{h}]], \"error: Context saw First[{h}], not h\"]]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"cd62fba4-409a-4bae-a2b7-65858d7b50f2"],

Cell[TextData[{
 StyleBox["Mathematica: Apply",
  FontWeight->Bold],
 "\n",
 StyleBox["f @@ expr",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces the head of expr by f: ",
 StyleBox["f @@ {a, b}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["f[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ".",
 "\n\n",
 StyleBox["Context @@ {First[{h}]}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " first evaluates the list to ",
 StyleBox["{h}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", then turns it into ",
 StyleBox["Context[h]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["Apply",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is used throughout the library to change heads: ",
 StyleBox["List @@ (a + b)",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["{a, b}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Plus @@ {a, b}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["a + b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"4969784f-154c-44ab-8450-b6c4c9f425bc"],

Cell[TextData[{
 StyleBox["Mathematica: Transpose and Flatten",
  FontWeight->Bold],
 "\n",
 StyleBox["Transpose[{l1, l2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " pairs up two lists element by element; ",
 StyleBox["Flatten",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes the inner brackets.",
 "\n\n",
 StyleBox["Flatten[Transpose[{{H, Psi}, {Hbar, Psibar}}]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives ",
 StyleBox["{{H, Hbar}, {Psi, Psibar}}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and then ",
 StyleBox["{H, Hbar, Psi, Psibar}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": the field order."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"e97011c1-a261-4ce6-bc0f-1b75c23a4d17"],

Cell[TextData[{
 StyleBox["Why it's built this way: Response fields are created, not declared",
  FontWeight->Bold],
 "\n\n",
 "You declare ",
 StyleBox["h",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and the library makes ",
 StyleBox["hbar",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". You cannot forget a response field, give it an unexpected name, or pair \
it with the wrong scalar, and every later module can find the partner of a \
field through ",
 StyleBox["\"ResponseOf\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". The naming rule ",
 StyleBox["<name>bar",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is part of the interface: you write ",
 StyleBox["hbar",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " in the ansatz, which is why ",
 StyleBox["assertFreshSymbols",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " also checks the generated names (a coupling you already called ",
 StyleBox["hbar",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " would be caught here, not later)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"7cab9fe6-aa13-4dd0-a8f7-2b8f6e5d8b2a"],

Cell[TextData[{
 StyleBox["Why it's built this way: The field order is fixed once, here",
  FontWeight->Bold],
 "\n\n",
 "Every matrix of the pipeline (",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2, the regulator R, the propagator G) is indexed by the field order. Fixing \
it in the root stage, and passing the stage along, means no module can choose \
a different order. The order interleaves each field with its response field \
because the MSR structure is then visible as a block structure (causality \
forces ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_{",
 StyleBox["\[CurlyPhi]\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "} = 0, ",
 StyleBox["docs/CONVENTIONS.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"c02f6742-80ef-489d-bd5d-930909d04e9f"],

Cell["The dimension", "Subsection",ExpressionUUID->"9e2b7360-8170-4bc1-8cdc-ba5aa6b3e697"],

Cell[TextData[{
 "The dimension must be either a fresh symbol or ",
 StyleBox["FixedDimension[2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"80da9061-f1ae-4339-bac6-79ee643988d9"],

Cell[TextData[{
 StyleBox["Mathematica: SameQ and Equal",
  FontWeight->Bold],
 "\n",
 StyleBox["a === b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (SameQ) asks whether two expressions are identical and is always True or \
False; ",
 StyleBox["a == b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (Equal) asks for mathematical equality and may stay undecided.",
 "\n\n",
 StyleBox["dim === FixedDimension[2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " compares the structure of the expressions. ",
 StyleBox["==",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " would be wrong for this: it answers questions about numbers, and on \
symbols it often returns itself unevaluated. ",
 StyleBox["2 == 2.",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True (equal numbers), ",
 StyleBox["2 === 2.",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is False (an integer and a machine real are different expressions)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"c93ce28c-6879-4e2b-b464-c8f629eaa600"],

Cell["{2 == 2., 2 === 2., nuk == 2, nuk === 2}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"4a554c0e-ae50-483a-b427-7b0067e631ee"],

Cell[TextData[{
 StyleBox["Mathematica: Inert heads",
  FontWeight->Bold],
 "\n",
 "A symbol with no definitions, used as a head, is just a label: ",
 StyleBox["FixedDimension[2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates to itself and carries its meaning as data.",
 "\n\n",
 StyleBox["FixedDimension",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " has no rules at all; ",
 StyleBox["DefineTheory",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " recognises it with ",
 StyleBox["===",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". The attribute ",
 StyleBox["Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Attributes and Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") only stops anyone from giving it rules. The library uses inert heads \
everywhere to represent things that are not to be computed by Mathematica: ",
 StyleBox["dt",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["grad",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["FieldFactor",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["scal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " before its rules (lesson 02)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"853a8399-e628-4078-b3d4-1485b5270e0f"],

Cell["\<\
theory2D = DefineTheory[\"Scalars\" -> {A1, A2}, \"Dimension\" -> \
FixedDimension[2]];
theory2D[\"Dimension\"]\
\>", "Input",ExpressionUUID->"b0dc8dc2-5fa9-47d1-8184-d3ab6ba50f7d"],

Cell[TextData[{
 "A plain ",
 StyleBox["2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is refused:"
}], "Text",ExpressionUUID->"073708dd-3244-4534-9a74-184ae65132fd"],

Cell["\<\
showFailure[DefineTheory[\"Scalars\" -> {h}, \"Dimension\" -> 2]]\
\>", "Input",ExpressionUUID->"da1c1240-f7a7-4ec4-9a2b-4f2dc9064f02"],

Cell[TextData[{
 StyleBox["Why it's built this way: The dimension stays a symbol",
  FontWeight->Bold],
 "\n\n",
 "The flow equations are derived for arbitrary d, as rational functions of \
the symbol ",
 StyleBox["Dim",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and exported to FlowRG with d as a parameter. Fixing d early would lose \
that generality without anyone noticing, so a plain number is refused: ",
 StyleBox["\"Dimension\" -> 2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and a ",
 StyleBox["Dim",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " that got the value 2 are indistinguishable once evaluated, and both abort. \
The only exception is the Levi-Civita operator ",
 StyleBox["jac",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which exists only in d = 2; there you declare it explicitly with the \
inert head ",
 StyleBox["FixedDimension[2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and the card says \"2 (declared)\"."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"2e812389-9bbe-49a9-8bc8-486d6cb78f46"],

Cell["The stage", "Subsection",ExpressionUUID->"300bd836-00d6-4d33-bb5e-23ef4c7ae9c8"],

Cell[TextData[{
 "The stage is assembled with ",
 StyleBox["stampStage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Hash",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "). ",
 StyleBox["AssociationThread[phis -> bars]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " builds the map ",
 StyleBox["<|h -> hbar|>",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["\"Pipeline\" -> \"DerivativeExpansion\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " names the only pipeline v1 implements (",
 StyleBox["docs/FUTURE.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists others)."
}], "Text",ExpressionUUID->"c7256e1c-53af-4a4a-bf19-ab73f8a33ec7"],

Cell["3. ResponseField", "Section",ExpressionUUID->"d650c071-c57f-4a7e-8366-77acd1d12536"],

Cell["\<\
(* Kernel/Theory.wl:46-48 *)
ResponseField[theory_Association, phi_Symbol] := Block[{$FRGModule = \"Theory\
\"},
   FRGAssert[\"Theory.isScalar\", MemberQ[theory[\"Scalars\"], phi], phi, \
\"not a declared physical scalar\"];
   theory[\"ResponseOf\"][phi]];\
\>", "Program",ExpressionUUID->"f09677a7-87f7-4321-a93d-b0a9d9453128"],

Cell["\<\
A small accessor with its own check: asking for the response field of \
something that is not a physical scalar aborts.\
\>", "Text",ExpressionUUID->"e3902357-6b73-49d1-9161-3c9c14074f46"],

Cell["\<\
{ResponseField[theory, h], showFailure[ResponseField[theory, hbar]]}\
\>", "Input",ExpressionUUID->"fe30759e-4c17-4488-bc16-6e56aa6017d1"],

Cell["4. The running example from now on", "Section",ExpressionUUID->"78222a35-18e2-42dd-acdc-cb618a90bcf7"],

Cell["\<\
From the next lesson on, each lesson starts by rebuilding the KPZ example up \
to the stage it needs, with the cards hidden:\
\>", "Text",ExpressionUUID->"e317b138-ad46-4d78-8a97-dcf174c7e20b"],

Cell["\<\
(* lessons/LessonSetup.wl:8-11 *)
(* the KPZ chain of tests/reference/KPZSetup.wl, in the load order of the \
modules (Symmetries is independent of
   Vertices..Propagator, so its place in the chain does not matter) *)
$lessonStages = {\"Theory\", \"Ansatz\", \"Vertices\", \"Regulator\", \
\"Propagator\", \"Symmetries\", \"Loops\", \"Projection\",
   \"FrequencyIntegration\", \"Closure\", \"Equations\"};\
\>", "Program",ExpressionUUID->"32405dfe-3696-4c70-ad05-a420721c403b"],

Cell["\<\
(* lessons/LessonSetup.wl:13-30 *)
$lessonSteps = {
   Hold[kpzTheory = DefineTheory[\"Scalars\" -> {h}, \"Dimension\" -> Dim]],
   Hold[kpzAnsatz = DefineAnsatz[kpzTheory, \"Density\" -> hbar (dt[h] - nuk \
lap[h] - lamk/2 grad[h].grad[h]) - Dk hbar^2,
      \"Couplings\" -> {nuk, lamk, Dk}]],
   Hold[kpzVertices = BuildVertices[kpzAnsatz]],
   Hold[kpzRegulator = DefineRegulator[kpzAnsatz, {hbar, h} -> nuk q^2 \
rn[q^2/k^2], {hbar, hbar} -> -2 Dk rd[q^2/k^2],
      \"Shapes\" -> {rn, rd}]],
   Hold[kpzPropagator = BuildPropagator[kpzVertices, kpzRegulator]],
   Hold[kpzSymmetries = DeclareSymmetries[kpzAnsatz,
      Protected[{hbar, h}, \"Frequency\" -> 1, \"Momentum\" -> 0, \"Reason\" \
-> \"Galilean Ward identity\"],
      Protected[{h, hbar}, \"Frequency\" -> 0, \"Momentum\" -> 0, \"Reason\" \
-> \"h -> h + c (shift symmetry)\"],
      Neglected[_, \"Reason\" -> \"beyond the ansatz\"], \
NonRenormalised[lamk, \"Reason\" -> \"Galilean invariance\"],
      \"TruncationOrders\" -> <|\"Frequency\" -> 2, \"Momentum\" -> 1|>]],
   Hold[kpzLoops = BuildLoopIntegrands[kpzVertices, kpzPropagator, \
kpzRegulator]],
   Hold[kpzProjected = ProjectOnMonomials[kpzLoops, kpzSymmetries]],
   Hold[kpzIntegrated = IntegrateFrequencies[kpzProjected]],
   Hold[kpzClosure = CheckClosure[kpzIntegrated, kpzSymmetries]],
   Hold[kpzEquations = AssembleEquations[kpzClosure]]};\
\>", "Program",ExpressionUUID->"1f96b270-7b6e-4a2d-957f-c6f54483f1fd"],

Cell["\<\
(* lessons/LessonSetup.wl:32-44 *)
Options[lessonUpTo] = {\"Verbose\" -> False};
lessonUpTo[stage_String, OptionsPattern[]] := Module[{n = \
First[FirstPosition[$lessonStages, stage, {0}]], r},
   If[n == 0, Print[\"lessonUpTo: unknown stage \", stage, \"; use one of \", \
$lessonStages]; Return[$Failed, Module]];
   r = CheckAbort[
     If[TrueQ[OptionValue[\"Verbose\"]], Scan[ReleaseHold, Take[$lessonSteps, \
n]], Block[{Print}, Scan[ReleaseHold, Take[$lessonSteps, n]]]];
     \"done\", $Aborted];
   If[r === $Aborted,
    Print[\"lessonUpTo: the KPZ chain stopped (check \", $FRGLastFailure, \
\"); rerun lessonUpTo[\\\"\", stage, \"\\\", \\\"Verbose\\\" -> True] to see \
the FAIL block\"];
    Return[$Failed, Module]];
   (* Extract[Hold[x = rhs], {1, 1}, Hold] is Hold[x]: the assigned variable, \
kept unevaluated *)
   Print[\"KPZ rebuilt up to \", stage, \": \", \
StringRiffle[ToString[Extract[#, {1, 1}, HoldForm]] & /@ Take[$lessonSteps, \
n], \", \"],
    \" (cards hidden)\"];
   ReleaseHold[Extract[$lessonSteps[[n]], {1, 1}, Hold]]];\
\>", "Program",ExpressionUUID->"c774a62c-4411-49b7-852d-c87d524dfb6a"],

Cell[TextData[{
 StyleBox["Hold[expr]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " keeps an expression unevaluated (",
 StyleBox["Hold attributes",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "); ",
 StyleBox["ReleaseHold",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates it. The chain is stored as a list of held assignments, and ",
 StyleBox["lessonUpTo",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates the first n of them. ",
 StyleBox["Block[{Print}, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives ",
 StyleBox["Print",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " no definitions for the duration, so it prints nothing: the cards are \
hidden, but a failing check still aborts."
}], "Text",ExpressionUUID->"a3dd5d9a-9b87-4c2f-bd58-f0b175f83000"],

Cell["\<\
kpz = lessonUpTo[\"Theory\"];
kpz[\"Fields\"]\
\>", "Input",ExpressionUUID->"79dba954-ce18-43c7-9e5e-def0d4f976ce"],

Cell["Exercises", "Section",ExpressionUUID->"d1716e2d-badb-4412-855e-b7a71ffc2472"],

Cell["Exercise: A reserved name", "Subsection",ExpressionUUID->"2a20f0f4-71e8-4612-904b-64034becb8e4"],

Cell[TextData[{
 "Try to declare a scalar called ",
 StyleBox["k",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Which check fails, and why is ",
 StyleBox["k",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reserved?"
}], "Text",ExpressionUUID->"8efa6abb-b85a-4357-85db-f27308ccf88e"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"52f1752b-a0dd-418c-ad34-65916247f311"],

Cell["\<\
showFailure[DefineTheory[\"Scalars\" -> {k}, \"Dimension\" -> Dim]]\
\>", "Input",ExpressionUUID->"b42f95fc-c239-4faa-b6c0-bbf4c7c32e19"],

Cell[TextData[{
 StyleBox["k",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the RG scale; the library writes it into every flow equation (lesson \
00, section 6)."
}], "Text",ExpressionUUID->"7a38908a-61a6-4817-acf1-2aff5de2a313"]
}, Closed]],

Cell["Exercise: A response field that already exists", "Subsection",ExpressionUUID->"2e548635-88bc-4629-b847-61a21b31c55d"],

Cell[TextData[{
 "Give ",
 StyleBox["Phibar",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " a value, then declare the scalar ",
 StyleBox["Phi",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Which check fails? Clean up afterwards."
}], "Text",ExpressionUUID->"579437c1-1149-4752-a658-c16ebbaf5b4a"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"04d48e53-a3f7-4b59-93b9-e87281e52f62"],

Cell["\<\
Phibar = 0;
showFailure[DefineTheory[\"Scalars\" -> {Phi}, \"Dimension\" -> Dim]]\
\>", "Input",ExpressionUUID->"c1c3c578-b48c-43d5-962c-af68c15986f8"],

Cell["Clear[Phibar]", "Input",ExpressionUUID->"d5b4cc71-6329-45d0-b864-5ec67f5df55f"],

Cell[TextData[{
 StyleBox["Theory.responseFields.symbols",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", with offending value ",
 StyleBox["{0}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": the generated name is checked like a user symbol. ",
 StyleBox["Symbol[\"...Phibar\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the existing symbol ",
 StyleBox["Phibar",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which then evaluates to its value 0, exactly as ",
 StyleBox["uu",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " did in section 2."
}], "Text",ExpressionUUID->"f2713c3a-4b5b-4bc7-8df0-f335e8ed0c46"]
}, Closed]],

Cell["Exercise: Read the stage", "Subsection",ExpressionUUID->"f621a2e2-1fbf-449b-8525-6def3c1465fa"],

Cell[TextData[{
 "Using only ",
 StyleBox["theory2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and the functions of this lesson, build the list of pairs ",
 StyleBox["{{H, Hbar}, {Psi, Psibar}}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " in at least two different ways."
}], "Text",ExpressionUUID->"5db47a1f-e12f-4d75-8b0e-fa7caa4f1568"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"101f0d15-ac47-43ae-8db1-dfbde28e43ab"],

Cell["\<\
{Transpose[{theory2[\"Scalars\"], theory2[\"ResponseFields\"]}], \
Normal[theory2[\"ResponseOf\"]] /. Rule -> List, {#, ResponseField[theory2, \
#]} & /@ theory2[\"Scalars\"]}\
\>", "Input",ExpressionUUID->"7b873329-c38c-43b5-b87c-90d75226aa91"],

Cell[TextData[{
 "The second way uses ",
 StyleBox["Normal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which turns an association into a list of rules, then replaces the head \
",
 StyleBox["Rule",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " by ",
 StyleBox["List",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["a -> b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["Rule[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",ExpressionUUID->"ea692836-a621-40fe-a4ee-2b7fe31839b5"]
}, Closed]]
},

Notebook[{
Cell["Lesson 01 - Theory", "Title",ExpressionUUID->"546d5e18-ba92-4ed1-a384-18a5a359eaf1"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Declare the N physical scalars ",
 StyleBox["\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "_a, create their MSR response fields ",
 StyleBox["\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 "_a, fix the field order (",
 StyleBox["\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "1, ",
 StyleBox["\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 "1, ",
 StyleBox["\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "2, ",
 StyleBox["\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 "2, ...) that indexes every matrix downstream (",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2, R, G), and fix the space dimension d, which stays a symbol."
}], "Text",ExpressionUUID->"e9682b09-a60b-41e2-9d06-75e6722849d3"],

Cell[TextData[{
 StyleBox["Stage.",
  FontWeight->Bold],
 " Input: two options. Output: the ",
 StyleBox["\"Theory\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stage. It is the root of the pipeline: its ",
 StyleBox["\"Upstream\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " list is empty."
}], "Text",ExpressionUUID->"c9466d5c-60af-442f-b373-49fda63322ed"],


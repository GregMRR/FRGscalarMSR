Cell["\<\
theory2 = DefineTheory[\"Scalars\" -> {H, Psi}, \"Dimension\" -> Dim];
theory2[\"Fields\"]\
\>", "Input",ExpressionUUID->"59cee030-572f-4607-9fe4-5ebb32ecff53"],

Cell["2. The constructor, line by line", "Section",ExpressionUUID->"9ba2495c-57a5-4c86-b253-f6c1b788efef"],

Cell["\<\
(* Kernel/Theory.wl:19 *)
Options[DefineTheory] = {\"Scalars\" -> {}, \"Dimension\" -> None};\
\>", "Program",ExpressionUUID->"045532ae-a6c1-4abd-900c-cdb2d61137a3"],

Cell["\<\
(* Kernel/Theory.wl:21-44 *)
DefineTheory[opts : OptionsPattern[]] := Block[{$FRGModule = \"Theory\"}, \
Module[{t0 = AbsoluteTime[], phis, bars, dim, checks, stage},
    FRGAssert[\"Theory.options\", MatchQ[{opts}, {(Rule | \
RuleDelayed)[\"Scalars\" | \"Dimension\", _] ...}], {opts},
     \"only the options \\\"Scalars\\\" and \\\"Dimension\\\" are \
accepted\"];
    phis = OptionValue[\"Scalars\"]; dim = OptionValue[\"Dimension\"];
    FRGAssert[\"Theory.scalarList\", ListQ[phis] && phis =!= {}, phis, \
\"\\\"Scalars\\\" -> {H, Psi, ...} is required\"];
    checks = {assertCheck[\"Theory.N\", 1 <= Length[phis] <= 2, Length[phis],
       \"v1 supports N = 1 or 2 scalars: the propagator denominator must have \
degree <= 2 in w (see docs/FUTURE.md)\",
       \"N = \" <> ToString[Length[phis]] <> \" (supported: 1, 2)\"]};
    assertFreshSymbols[\"Theory.scalars\", phis, \"scalars\"];
    bars = Symbol[Context[#] <> SymbolName[#] <> \"bar\"] & /@ phis;
    assertFreshSymbols[\"Theory.responseFields\", bars, \"response fields \
(auto-generated <name>bar)\"];
    FRGAssert[\"Theory.dimension\", (Head[dim] === Symbol && dim =!= None) || \
dim === FixedDimension[2], dim,
     \"\\\"Dimension\\\" -> Dim is required: a symbol, or FixedDimension[2] \
(needed by jac)\"];
    If[dim === FixedDimension[2], dim = 2,
     assertFreshSymbols[\"Theory.dimension\", {dim}, \"the dimension symbol\"];
     FRGAssert[\"Theory.dimensionDistinct\", ! MemberQ[Join[phis, bars], \
dim], dim, \"the dimension symbol must not be a field\"]];
    AppendTo[checks, assertCheck[\"Theory.symbols\", True, Null, \"\", \
\"fields and Dim are fresh and collision-free\"]];
    stage = stampStage[<|\"Stage\" -> \"Theory\", \"Pipeline\" -> \
\"DerivativeExpansion\", \"Upstream\" -> {},
       \"Scalars\" -> phis, \"ResponseFields\" -> bars, \"Fields\" -> \
Flatten[Transpose[{phis, bars}]],
       \"ResponseOf\" -> AssociationThread[phis -> bars], \"Dimension\" -> dim,
       \"Checks\" -> checks, \"Timing\" -> AbsoluteTime[] - t0|>];
    Print[\"Theory: fields in order \", stage[\"Fields\"], \", dimension \", \
If[dim === 2, \"2 (declared)\", dim], \" (response fields are created \
automatically)\"];
    PrintCard[stage];
    stage]];\
\>", "Program",ExpressionUUID->"24cf3426-4b88-48bf-befb-924899638f1f"],

Cell[TextData[{
 "Every constructor in the library has this skeleton: ",
 StyleBox["Block[{$FRGModule = \"...\"}, Module[{t0 = AbsoluteTime[], ...}, \
checks...; stage = stampStage[<|...|>]; Print...; PrintCard[stage]; stage]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". The ",
 StyleBox["Block",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " names the module in FAIL blocks (see ",
 StyleBox["Block and Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "), the ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " holds the local variables, ",
 StyleBox["AbsoluteTime[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (the current time in seconds) measures the ",
 StyleBox["\"Timing\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " shown on the card, and the stage is the value of the last expression."
}], "Text",ExpressionUUID->"9bc86289-b488-4461-8fc7-d80b4e3fa78e"],

Cell["Options, and why they are checked", "Subsection",ExpressionUUID->"bec14f10-e93d-4459-b802-2e485618967d"],

Cell[TextData[{
 "The function takes only options: ",
 StyleBox["opts : OptionsPattern[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " names the whole sequence of options ",
 StyleBox["opts",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", so that ",
 StyleBox["{opts}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the list of rules that were passed (see ",
 StyleBox["Options",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " and ",
 StyleBox["Alternatives and named patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ")."
}], "Text",ExpressionUUID->"3ad528a4-56f1-4700-a040-977629cbc88a"],

Cell[TextData[{
 StyleBox["Mathematica: MatchQ and repeated patterns",
  FontWeight->Bold],
 "\n",
 StyleBox["MatchQ[e, patt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True if e matches patt; ",
 StyleBox["p ..",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches one or more repetitions of p, ",
 StyleBox["p ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " zero or more.",
 "\n\n",
 StyleBox["MatchQ[{opts}, {(Rule | RuleDelayed)[\"Scalars\" | \"Dimension\", \
_] ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads: a list of zero or more rules (written with ",
 StyleBox["->",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " or ",
 StyleBox[":>",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") whose key is ",
 StyleBox["\"Scalars\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " or ",
 StyleBox["\"Dimension\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["Rule[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the full form of ",
 StyleBox["a -> b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": a pattern can match on any head, including ",
 StyleBox["Rule",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"94734fc2-8854-4e8f-bc52-3dfa72808b0a"],

Cell["\<\
{MatchQ[{1, 2, 3}, {_Integer ..}], MatchQ[{}, {_Integer ..}], MatchQ[{}, \
{_Integer ...}], FullForm[\"a\" -> 1]}\

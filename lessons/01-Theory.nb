Notebook[{
Cell["Lesson 01 - Theory", "Title",ExpressionUUID->"27a2a55d-8cff-498a-b9b0-ce8a1cf183be"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Declare the N physical scalars ",
 StyleBox["\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "_a, create their MSR response fields ",
 StyleBox["\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 "_a, fix the field order (",
 StyleBox["\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "1, ",
 StyleBox["\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 "1, ",
 StyleBox["\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "2, ",
 StyleBox["\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 "2, ...) that indexes every matrix downstream (",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2, R, G), and fix the space dimension d, which stays a symbol."
}], "Text",ExpressionUUID->"3beeab52-b25a-464d-a4c6-d27455fc7337"],

Cell[TextData[{
 StyleBox["Stage.",
  FontWeight->Bold],
 " Input: two options. Output: the ",
 StyleBox["\"Theory\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stage. It is the root of the pipeline: its ",
 StyleBox["\"Upstream\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " list is empty."
}], "Text",ExpressionUUID->"c73108fd-b0b9-43a8-8cc4-a21b13934503"],


Notebook[{
Cell["Lesson 01 - Theory", "Title",ExpressionUUID->"27c2882b-6d6e-4a36-9067-e75b3cbfacf2"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Declare the N physical scalars ",
 StyleBox["\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "_a, create their MSR response fields ",
 StyleBox["\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 "_a, fix the field order (",
 StyleBox["\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "1, ",
 StyleBox["\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 "1, ",
 StyleBox["\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 "2, ",
 StyleBox["\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 "2, ...) that indexes every matrix downstream (",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2, R, G), and fix the space dimension d, which stays a symbol."
}], "Text",ExpressionUUID->"cee587be-1bc6-4b66-bed5-d31446bc58c7"],

Cell[TextData[{
 StyleBox["Stage.",
  FontWeight->Bold],
 " Input: two options. Output: the ",
 StyleBox["\"Theory\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stage. It is the root of the pipeline: its ",
 StyleBox["\"Upstream\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " list is empty."
}], "Text",ExpressionUUID->"a46e1bb3-73d1-4fd3-8bb1-313a23e06fad"],


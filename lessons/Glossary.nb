Notebook[{
Cell["Mathematica glossary", "Title",ExpressionUUID->"2b0bdc87-d8b7-41b2-8bd0-9db3f9856af7"],

Cell["\<\
Every Mathematica command, tool or practice used in the lessons, in the order \
the lessons explain it. Each entry gives a one-line summary and the lesson \
whose blue \"Mathematica:\" box explains it in full. Generated by \
lessons/makeLessons.wl from the lesson sources, so it always matches them.\
\>", "Text",ExpressionUUID->"ce6476c6-5ae8-4cc6-aa0f-e0aa2793da79"],

Cell["Lesson 00 \[LongDash] LoaderAndCore", "Section",ExpressionUUID->"1fdb07d7-54a1-4016-a01f-c6b36db7c69e"],

Cell[TextData[{
 StyleBox["Get",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Get[file]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (or ",
 StyleBox["<< file",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") reads a file and evaluates every expression in it, in order."
}], "Item",ExpressionUUID->"a91f1865-76b9-4d51-ab52-b3baf68d541f"],

Cell[TextData[{
 StyleBox["Symbols and contexts",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Every symbol has a full name ",
 StyleBox["context`name",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; short names are looked up in ",
 StyleBox["$Context",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", then in ",
 StyleBox["$ContextPath",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"d1caed8d-b5e3-47ff-aca6-11d00ff9076c"],

Cell[TextData[{
 StyleBox["Set and SetDelayed",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["x = rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates rhs now and stores the result; ",
 StyleBox["f[x_] := rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stores rhs unevaluated and evaluates it at every use."
}], "Item",ExpressionUUID->"3ef60746-ac66-4110-b8f6-979737270dc1"],

Cell[TextData[{
 StyleBox["Attributes and Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Attributes are flags on a symbol that change how it evaluates; ",
 StyleBox["Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " forbids new definitions."
}], "Item",ExpressionUUID->"b7675e2f-264f-4fc2-9cec-e2b9de25ddea"],

Cell[TextData[{
 StyleBox["Pure functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["body &",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is an anonymous function; ",
 StyleBox["#",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is its argument (",
 StyleBox["#1",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["#2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ... for several)."
}], "Item",ExpressionUUID->"f6cfe618-2de4-4017-8047-4adc687a1275"],

Cell[TextData[{
 StyleBox["Map and Scan",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Map[f, list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["f /@ list",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") returns the list of results; ",
 StyleBox["Scan[f, list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f only for its side effects and returns nothing."
}], "Item",ExpressionUUID->"93995fac-cf96-4eb5-8683-f2684ef24a22"],

Cell[TextData[{
 StyleBox["BeginPackage, Begin, End, EndPackage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "The four commands that give a package its public and private namespaces."
}], "Item",ExpressionUUID->"0738294c-174d-40f3-92bf-3642b3f2daf1"],

Cell[TextData[{
 StyleBox["Usage messages",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f::usage = \"text\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " attaches help text to f; ",
 StyleBox["?f",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " shows it."
}], "Item",ExpressionUUID->"ded5c458-f706-4d0d-836e-1dd9b83fa8fa"],

Cell[TextData[{
 StyleBox["Patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["x_",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches any expression and names it x; ",
 StyleBox["x_h",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " only expressions with head h; ",
 StyleBox["x_ : d",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is optional with default d; ",
 StyleBox["patt /; cond",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " adds a condition."
}], "Item",ExpressionUUID->"0b465ed0-ee17-47fa-b917-bce02599ed96"],

Cell[TextData[{
 StyleBox["Hold attributes",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["HoldAll",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["HoldFirst",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["HoldRest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stop Mathematica from evaluating some arguments before the function sees \
them."
}], "Item",ExpressionUUID->"3c38df7d-2e0d-4c9c-a92e-4071583a026a"],

Cell[TextData[{
 StyleBox["If and TrueQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["If[c, a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a if c is True, b if c is False, and stays unevaluated otherwise; ",
 StyleBox["TrueQ[c]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True only if c is literally True."
}], "Item",ExpressionUUID->"ae801d37-a712-420c-8077-dd02af40f2a8"],

Cell[TextData[{
 StyleBox["Abort, CheckAbort, Exit",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Abort[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stops the whole evaluation; ",
 StyleBox["CheckAbort[expr, alt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " catches an abort inside expr and returns alt; ",
 StyleBox["Exit[n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " quits the kernel with exit code n."
}], "Item",ExpressionUUID->"b4239cd7-ad9f-421b-a9a1-1fc937e6f636"],

Cell[TextData[{
 StyleBox["Block and Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Module[{x}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " creates a fresh local x seen only by the code written inside; ",
 StyleBox["Block[{x = v}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " temporarily gives the existing x the value v, seen by every function \
called from body."
}], "Item",ExpressionUUID->"65c1a767-ffe9-43f1-8a0d-b5d4bf9bea6c"],

Cell[TextData[{
 StyleBox["Association",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["<|key -> value, ...|>",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a table of key-value pairs; read with ",
 StyleBox["a[key]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " or ",
 StyleBox["Lookup[a, key, default]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"3c186e4e-b236-45c3-991e-2c31878d5a92"],

Cell[TextData[{
 StyleBox["Hash",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Hash[expr, \"SHA256\", \"HexString\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a 64-character fingerprint of expr; any change to expr changes it."
}], "Item",ExpressionUUID->"e73ae779-fe98-4a7f-b878-e16e2c6c436a"],

Cell[TextData[{
 StyleBox["Options",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Options[f] = {\"Name\" -> default}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " declares named options; ",
 StyleBox["f[x_, OptionsPattern[]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " accepts them; ",
 StyleBox["OptionValue[\"Name\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads them."
}], "Item",ExpressionUUID->"010717dc-d347-499b-8216-7b024b220736"],

Cell[TextData[{
 StyleBox["Cases and level specifications",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Cases[e, patt, {0, Infinity}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns every subexpression of e, at any depth, that matches patt."
}], "Item",ExpressionUUID->"123a2c5e-7659-444c-acf9-3c7559e87b3d"],

Cell[TextData[{
 StyleBox["Rules and replacement",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["lhs -> rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["lhs :> rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are rules; ",
 StyleBox["e /. rules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies them to every part of e."
}], "Item",ExpressionUUID->"0b128046-fe0f-4c73-9c4b-b4a2a9d0f53e"],

Cell[TextData[{
 StyleBox["Alternatives and named patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["p1 | p2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches either pattern; ",
 StyleBox["x : p",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches p and names the whole match x."
}], "Item",ExpressionUUID->"a50260ef-3cb2-4204-bc42-6c99e7c51478"],

Cell[TextData[{
 StyleBox["Memoization",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f[x_] := f[x] = value",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " computes value the first time and stores it as a specific definition for \
that x."
}], "Item",ExpressionUUID->"ee5244bf-6357-4dc8-a81f-508444911a28"],

Cell[TextData[{
 StyleBox["Check and Quiet",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Check[expr, alt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns alt if evaluating expr produced a message; ",
 StyleBox["Quiet[expr, {msgs}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates expr without printing those messages."
}], "Item",ExpressionUUID->"f0d7434f-b518-4e49-9625-0c4ed566a75d"],

Cell[TextData[{
 StyleBox["Exact numbers",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Integers and rationals are exact (",
 StyleBox["Precision",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["Infinity",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "); ",
 StyleBox["Together",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " puts a rational expression over a common denominator."
}], "Item",ExpressionUUID->"4951930b-050e-404e-8295-5fb7cf27a8c3"],

Cell[TextData[{
 StyleBox["OwnValues and DownValues",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "A symbol's definitions are stored as lists of rules: ",
 StyleBox["OwnValues[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for ",
 StyleBox["x = ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["DownValues[f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for ",
 StyleBox["f[...] := ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["UpValues[f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for definitions attached to f as an argument."
}], "Item",ExpressionUUID->"affc17e3-b554-42a9-bba3-d1515e7d7722"],

Cell[TextData[{
 StyleBox["Orderless",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "The attribute ",
 StyleBox["Orderless",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sorts a function's arguments into a canonical order before anything else."
}], "Item",ExpressionUUID->"455eb6c6-e3e5-43d7-9797-d135f7ef5ccb"],

Cell[TextData[{
 StyleBox["Evaluation as rewriting",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Mathematica applies matching definitions repeatedly until no rule matches \
any more."
}], "Item",ExpressionUUID->"8731905c-2704-4f38-8946-7bba47439a0a"],

Cell[TextData[{
 StyleBox["FixedPoint",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["FixedPoint[f, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f repeatedly, starting from x, until the result stops changing."
}], "Item",ExpressionUUID->"3572be48-4ee4-4d28-843a-e6e59f3532ab"],

Cell["Lesson 01 \[LongDash] Theory", "Section",ExpressionUUID->"c496c4da-c5e1-4570-8075-7c3847008c67"],

Cell[TextData[{
 StyleBox["MatchQ and repeated patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["MatchQ[e, patt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True if e matches patt; ",
 StyleBox["p ..",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches one or more repetitions of p, ",
 StyleBox["p ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " zero or more."
}], "Item",ExpressionUUID->"bef4c8cb-010b-434b-ae0b-7aea5814eabb"],

Cell[TextData[{
 StyleBox["AppendTo",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["AppendTo[x, e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["x = Append[x, e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": it rebinds the variable x to a longer list."
}], "Item",ExpressionUUID->"0e6e8052-0af8-4ab3-adce-ea51a7febc26"],

Cell[TextData[{
 StyleBox["Symbol and SymbolName",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Symbol[\"name\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the symbol with that name, creating it if needed; ",
 StyleBox["SymbolName[s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Context[s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " give its short name and its context."
}], "Item",ExpressionUUID->"909288a1-5e92-45ad-88fd-fe74f1b595de"],

Cell[TextData[{
 StyleBox["Apply",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f @@ expr",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces the head of expr by f: ",
 StyleBox["f @@ {a, b}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["f[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"19912ff8-8811-4df1-9712-eed6357bb97b"],

Cell[TextData[{
 StyleBox["Transpose and Flatten",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Transpose[{l1, l2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " pairs up two lists element by element; ",
 StyleBox["Flatten",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes the inner brackets."
}], "Item",ExpressionUUID->"553b36cd-1c31-489c-be8a-04a87d4f237e"],

Cell[TextData[{
 StyleBox["SameQ and Equal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["a === b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (SameQ) asks whether two expressions are identical and is always True or \
False; ",
 StyleBox["a == b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (Equal) asks for mathematical equality and may stay undecided."
}], "Item",ExpressionUUID->"41a8b559-13eb-4770-8e0d-2e6ee85c91be"],

Cell[TextData[{
 StyleBox["Inert heads",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "A symbol with no definitions, used as a head, is just a label: ",
 StyleBox["FixedDimension[2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates to itself and carries its meaning as data."
}], "Item",ExpressionUUID->"2b5652da-cda5-4417-b142-4e9cb79caac2"],

Cell["Lesson 02 \[LongDash] Ansatz", "Section",ExpressionUUID->"de9a9aa4-e222-4473-ab44-3155b07e9019"],

Cell[TextData[{
 StyleBox["FullForm",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["FullForm[e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " shows the tree Mathematica actually stores, with every head written out."
}], "Item",ExpressionUUID->"0d77c958-dafe-4f90-9bbd-4165ad09f146"],

Cell[TextData[{
 StyleBox["Complement and Intersection",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Complement[all, l1, l2, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the elements of all that are in none of the li; ",
 StyleBox["Intersection[l1, l2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the common ones."
}], "Item",ExpressionUUID->"110e3831-5768-449a-bd9a-061d3fb5dc16"],

Cell[TextData[{
 StyleBox["Which",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Which[c1, v1, c2, v2, ..., True, v]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the value of the first condition that is True."
}], "Item",ExpressionUUID->"cfe306d4-d851-4e9a-84ec-23377bda4add"],

Cell[TextData[{
 StyleBox["Several definitions of one function",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "A function can have many rules; Mathematica tries the more specific \
patterns first and the most general last."
}], "Item",ExpressionUUID->"49cf6a57-1164-4c0c-92d1-0ce7883c6065"],

Cell[TextData[{
 StyleBox["Automatic simplification of Times and Plus",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Times",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Plus",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sort their arguments and combine equal ones as soon as an expression is \
built: ",
 StyleBox["x x",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " becomes ",
 StyleBox["x^2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["a + a",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " becomes ",
 StyleBox["2 a",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"dae16058-a135-4837-be3e-285101b4aad6"],

Cell[TextData[{
 StyleBox["Curried definitions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f[a_][x_] := ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " defines a function of a whose result is itself a function of x."
}], "Item",ExpressionUUID->"957467bf-bcb4-4a68-b49c-17c4fec3080b"],

Cell[TextData[{
 StyleBox["MapAt, Table and Sum",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["MapAt[f, e, i]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f to the i-th part of e only; ",
 StyleBox["Table[expr, {i, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Sum[expr, {i, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " build a list or a sum for i = 1..n."
}], "Item",ExpressionUUID->"962733e4-95cf-423e-89ed-e80cfddd1f4f"],

Cell[TextData[{
 StyleBox["Local functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Symbols created by ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " can be given definitions like any symbol; they are private to that call \
and can use the other local variables."
}], "Item",ExpressionUUID->"a88811a9-624f-4d46-8437-c94e483dff23"],

Cell[TextData[{
 StyleBox["With",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["With[{j = value}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates value once and inserts it into body as a constant."
}], "Item",ExpressionUUID->"e5f3bac8-c5ec-4fd1-9508-6dec6f786a73"],

Cell[TextData[{
 StyleBox["Sort and canonical order",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Sort[list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " puts any expressions in Mathematica's canonical order; ",
 StyleBox["Permutations[list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists all orderings."
}], "Item",ExpressionUUID->"f61e293e-6080-46f6-8d1f-c8e856588619"],

Cell[TextData[{
 StyleBox["Except",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Except[p]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches anything that does not match p."
}], "Item",ExpressionUUID->"b39207d8-dbec-42a2-a36b-dd300faa98a8"],

Cell[TextData[{
 StyleBox["GroupBy and KeyValueMap",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["GroupBy[list, key -> value]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " collects the elements with the same key into an association of lists; ",
 StyleBox["KeyValueMap[f, assoc]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f[key, value] to each entry."
}], "Item",ExpressionUUID->"5f34ebde-e427-46bc-9a17-9f7cf876c59d"],

Cell[TextData[{
 StyleBox["DeleteCases, SortBy and FirstPosition",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["DeleteCases[list, patt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " drops the matching elements; ",
 StyleBox["SortBy[list, f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sorts by the value of f (a list of criteria breaks ties in turn); ",
 StyleBox["FirstPosition[list, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the position of the first x."
}], "Item",ExpressionUUID->"b67f27ec-8408-4f5c-a918-cc07efbc2823"],

Cell[TextData[{
 StyleBox["Sequence",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Sequence[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is spliced into whatever contains it: ",
 StyleBox["f[x, Sequence[a, b]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["f[x, a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["Sequence[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " disappears."
}], "Item",ExpressionUUID->"35612bc9-cf12-412e-8f9d-080a9bc869a2"],

Cell["Lesson 03 \[LongDash] Vertices", "Section",ExpressionUUID->"d7dae57a-7195-430d-88c4-cc09afbfa266"],

Cell[TextData[{
 StyleBox["Complex numbers",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["I",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the exact imaginary unit; ",
 StyleBox["Im",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Re",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Conjugate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " work on exact and symbolic expressions."
}], "Item",ExpressionUUID->"9a3bc087-de95-4309-ba32-b4485388489c"],

Cell[TextData[{
 StyleBox["KeySelect and Values",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["KeySelect[assoc, test]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " keeps the entries whose key passes test; ",
 StyleBox["Values[assoc]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists the values."
}], "Item",ExpressionUUID->"8bd84f30-cf03-4812-80cc-95b0a0966904"],

Cell[TextData[{
 StyleBox["Tuples",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Tuples[list, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives every list of n elements drawn from list, with repetition and in \
every order."
}], "Item",ExpressionUUID->"628db254-5993-4742-a063-9b31d4041f8e"],

Cell[TextData[{
 StyleBox["Ordering",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Ordering[list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the positions that would sort list: ",
 StyleBox["list[[Ordering[list]]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is sorted."
}], "Item",ExpressionUUID->"54847080-5f3b-4bd5-947d-1c3353e6b652"],

Cell[TextData[{
 StyleBox["Key",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Key[k]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " wraps a key so that it is never read as something else; ",
 StyleBox["Lookup[assoc, Key[{a, b}], 0]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " looks up the key ",
 StyleBox["{a, b}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"94324186-1e70-4a7a-b8cb-d72ba6f3c355"],

Cell[TextData[{
 StyleBox["Array and explicit vectors",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Array[f, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["{f[1], ..., f[n]}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox[".",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (Dot) contracts explicit lists; ",
 StyleBox["D",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Grad",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Div",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Laplacian",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " differentiate with respect to explicit variables."
}], "Item",ExpressionUUID->"9cf0d2e0-b0fb-4211-940a-f9c1f5e5f714"],

Cell[TextData[{
 StyleBox["Replacing heads by functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "A rule ",
 StyleBox["dt -> (D[#, tt] &)",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns ",
 StyleBox["dt[e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " into ",
 StyleBox["(D[#, tt] &)[e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which evaluates to ",
 StyleBox["D[e, tt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"9469cdb7-fa25-4c3f-ab8e-f9cbd8288b49"],

Cell[TextData[{
 StyleBox["Solve",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Solve[eqn, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the solutions as lists of rules ",
 StyleBox["{{x -> s1}, ...}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["x /. Solve[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " extracts the values."
}], "Item",ExpressionUUID->"cdd6ea32-9e7b-4b3c-92c8-66b4195ecaa2"],

Cell["Lesson 04 \[LongDash] Regulator", "Section",ExpressionUUID->"751e696e-21b8-400f-90fc-76947a104074"],

Cell[TextData[{
 StyleBox["Sequence patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["x__",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches a sequence of one or more arguments, ",
 StyleBox["x___",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of zero or more; inside the body, ",
 StyleBox["{x}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the list of them."
}], "Item",ExpressionUUID->"04555170-7826-4f90-a5ba-0565801b5d02"],

Cell[TextData[{
 StyleBox["PatternTest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["x_?test",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches x only if ",
 StyleBox["test[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True; ",
 StyleBox["n_Integer?EvenQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches even integers."
}], "Item",ExpressionUUID->"cd3f3ba5-7bae-41b2-a803-15c8b7909011"],

Cell[TextData[{
 StyleBox["D and unknown functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["D[e, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " differentiates; on a function with no definition it applies the chain rule \
and writes the derivative as ",
 StyleBox["Derivative[1][r][arg]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", displayed ",
 StyleBox["r'[arg]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"fbe254dd-6622-4552-91f0-38c81fd92a2a"],

Cell[TextData[{
 StyleBox["Map at a level",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Map[f, matrix, {2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f to every element at depth 2, that is, to every entry of a matrix."
}], "Item",ExpressionUUID->"0e8717b9-a197-4b7e-ba15-76d22fa652af"],

Cell[TextData[{
 StyleBox["Function and Evaluate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Function[{x}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " holds its body unevaluated; ",
 StyleBox["Function[{x}, Evaluate[body]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates it first, so the stored function contains the computed result."
}], "Item",ExpressionUUID->"42774519-5e12-4f1f-af79-90c69288f24e"],

Cell["Lesson 05 \[LongDash] Propagator", "Section",ExpressionUUID->"166d7bae-02d4-4220-a14e-ebc5d26da234"],

Cell[TextData[{
 StyleBox["Coefficient and Exponent",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Coefficient[e, x, m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the coefficient of x^m in the polynomial e; ",
 StyleBox["Exponent[e, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " its degree in x."
}], "Item",ExpressionUUID->"5d0a1583-cf45-4cb0-beed-0f21a85a2f0e"],

Cell[TextData[{
 StyleBox["Assigning to an association",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["assoc[key] = value",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " adds or replaces one entry of an association stored in a variable."
}], "Item",ExpressionUUID->"8e6eb3bc-85f1-4eed-aa58-165f11b19218"],

Cell[TextData[{
 StyleBox["Part with lists",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["m[[{1, 3}, {2}]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " extracts the rows 1, 3 and the column 2 of a matrix; the same form on the \
left of ",
 StyleBox["=",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " assigns a block."
}], "Item",ExpressionUUID->"1fd02494-9f54-490f-b725-a1e3e5a013f0"],

Cell[TextData[{
 StyleBox["Matrix algebra",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox[".",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " multiplies matrices (and vectors); ",
 StyleBox["Transpose",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Det",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["IdentityMatrix[n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " work on nested lists."
}], "Item",ExpressionUUID->"76adfe8b-4d2c-40c1-827f-6a896ad4678c"],

Cell["Lesson 06 \[LongDash] Symmetries", "Section",ExpressionUUID->"0e9e0d87-6593-4ac1-996b-d000c5884b5d"],

Cell[TextData[{
 StyleBox["Multiple assignment",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["{a, b} = {1, 2}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " assigns element by element."
}], "Item",ExpressionUUID->"c71d7725-e25c-4dd3-934e-3563a252f4eb"],

Cell[TextData[{
 StyleBox["Iterators that depend on each other",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Table[expr, {pr, pairs}, {m, 0, mf}, {n, 0, mp}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs over every combination; ",
 StyleBox["Flatten[t, 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes two levels of nesting."
}], "Item",ExpressionUUID->"4ff0b095-63c3-4de1-a048-e163be1f9504"],

Cell["Lesson 07 \[LongDash] Loops", "Section",ExpressionUUID->"362b502f-c482-44c6-8a94-a78f1a345175"],

Cell[TextData[{
 StyleBox["Tr and exact constants",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Tr[m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the trace of a matrix; ",
 StyleBox["Pi",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["E",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["I",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are exact constants, never rounded."
}], "Item",ExpressionUUID->"83c5b5fb-878e-4cce-8fb9-fc12de382e0b"],

Cell["Lesson 08 \[LongDash] Projection", "Section",ExpressionUUID->"410cacc6-604f-44be-9a86-190bdc5a5f2a"],

Cell[TextData[{
 StyleBox["Repeated derivatives",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["D[e, {x, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the n-th derivative of e in x; ",
 StyleBox["D[e, {x, n}, {y, m}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " mixes variables."
}], "Item",ExpressionUUID->"663d9e1d-b332-43c4-ac24-068294b39331"],

Cell[TextData[{
 StyleBox["Special functions and products",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["k!!",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the double factorial, ",
 StyleBox["Product[f, {j, a, b}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " a product, ",
 StyleBox["Pochhammer[a, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " = a(a+1)",
 StyleBox["\[CenterEllipsis]",
  FontFamily->"Noto Sans"],
 "(a+n",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1), ",
 StyleBox["Gamma[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 " function; ",
 StyleBox["FunctionExpand",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " rewrites special values in elementary form."
}], "Item",ExpressionUUID->"4ff5c4de-2a84-47be-977b-28cbd5a30e21"],

Cell[TextData[{
 StyleBox["Derivative of several arguments",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Derivative[i, j][f][x, y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["\[PartialD]\:2071",
  FontFamily->"Noto Sans"],
 "_x ",
 StyleBox["\[PartialD]\:02b2",
  FontFamily->"Noto Sans"],
 "_y f; a pattern ",
 StyleBox["Derivative[i_, j_][\[CapitalDelta]][w_, s_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches any such derivative."
}], "Item",ExpressionUUID->"26e3bfba-5d16-4663-8f7c-a7df523e1460"],

Cell[TextData[{
 StyleBox["Nest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Nest[f, x, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f to x n times: ",
 StyleBox["f[f[f[x]]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for n = 3."
}], "Item",ExpressionUUID->"4229243c-1414-4ca3-962b-6fba788f16e0"],

Cell[TextData[{
 StyleBox["SelectFirst and Missing",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["SelectFirst[list, test]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the first element that passes test, or ",
 StyleBox["Missing[\"NotFound\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["MissingQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tests for it."
}], "Item",ExpressionUUID->"643bd933-6d4e-4b67-a920-467db20ceef3"],

Cell["Lesson 09 \[LongDash] FrequencyIntegration", "Section",ExpressionUUID->"3f3de3d5-7184-498b-b88c-1ab208c2d092"],

Cell[TextData[{
 StyleBox["Numerator, Denominator and radicals",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Numerator[r]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Denominator[r]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " split a rational expression; a square root is ",
 StyleBox["Power[x, 1/2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", so ",
 StyleBox["FreeQ[r, Power[_, _Rational]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tests for radicals."
}], "Item",ExpressionUUID->"08453590-6780-45db-9bc8-b0b94256e79b"],

Cell[TextData[{
 StyleBox["Memoization of a function",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f[n_, a_] := f[n, a] = ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stores each computed value as a new definition of f, so the next call with \
the same arguments returns it at once."
}], "Item",ExpressionUUID->"13cb2b3f-118a-4162-b66e-4eb20c3b23ef"],

Cell[TextData[{
 StyleBox["CoefficientRules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["CoefficientRules[poly, {x, y, ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists the monomials of a polynomial as ",
 StyleBox["{exponents} -> coefficient",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"4bab9d55-db2a-4d8c-850d-eb6ab660d9e5"],

Cell[TextData[{
 StyleBox["Return from a loop",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Do[..., {j, 0, 199}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a loop; ",
 StyleBox["Return[value, Module]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " leaves the enclosing ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " at once with that value."
}], "Item",ExpressionUUID->"49e8f0c9-ceaf-4c33-8a6b-7a8791bb7bfc"],

Cell["Lesson 10 \[LongDash] Closure", "Section",ExpressionUUID->"a477577b-a528-4712-86bd-cbae268dcae9"],

Cell[TextData[{
 StyleBox["N and CForm",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["N[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a machine-precision approximation of an exact number; ",
 StyleBox["CForm[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes an expression as C code, here a compact number string."
}], "Item",ExpressionUUID->"f14252cf-28c1-41c6-a8b8-d844ab28f75a"],

Cell[TextData[{
 StyleBox["FactorTermsList",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["FactorTermsList[poly]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " pulls out the numeric factors: ",
 StyleBox["{number, ..., rest}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"eb588b30-c7d0-432b-a94a-1a9077c38584"],

Cell[TextData[{
 StyleBox["Switch",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Switch[expr, form1, value1, form2, value2, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the value of the first form (a pattern) that expr matches."
}], "Item",ExpressionUUID->"ac641af1-7fa1-4814-8831-ea39a73ea5af"],

Cell["Lesson 11 \[LongDash] Assemble", "Section",ExpressionUUID->"77cb791e-69d2-4dbf-99f6-f7a02f4ae97d"],

Cell[TextData[{
 StyleBox["Replace and ReplaceAll",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Replace[e, rule]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tries the rule on the whole of e only; ",
 StyleBox["e /. rule",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["ReplaceAll",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") tries every part."
}], "Item",ExpressionUUID->"a56d635c-040a-49ba-8215-0ef5949491f1"],

Cell[TextData[{
 StyleBox["Collect and Factor",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Collect[e, vars, f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " groups e by powers of vars and applies f to each coefficient; ",
 StyleBox["Factor",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " factors a polynomial."
}], "Item",ExpressionUUID->"9152fe4f-da5b-42fd-bd68-07897b774e5c"],

Cell[TextData[{
 StyleBox["TimeConstrained",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["TimeConstrained[expr, t, alt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates expr for at most t seconds, and returns alt if time runs out."
}], "Item",ExpressionUUID->"c673e02a-d451-4b3e-b851-72108c17cf86"],

Cell["Lesson 12 \[LongDash] OracleAndStages", "Section",ExpressionUUID->"68790283-3da1-47bb-8b80-7c46c3cea293"],

Cell[TextData[{
 StyleBox["Arbitrary precision",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["N[x, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives n digits, in software arithmetic that tracks its own precision; ",
 StyleBox["Chop[x, eps]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces numbers smaller than eps by 0."
}], "Item",ExpressionUUID->"f6fff2f6-7fc4-4be8-84da-5f6a7b1ee61b"],

Cell[TextData[{
 StyleBox["NIntegrate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["NIntegrate[f, {x, a, b}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " integrates numerically; ",
 StyleBox["PrecisionGoal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["AccuracyGoal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " set the relative and absolute target, ",
 StyleBox["WorkingPrecision",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the digits used."
}], "Item",ExpressionUUID->"446e96f0-fd3e-4687-9223-3cdcf61a4e27"],

Cell[TextData[{
 StyleBox["Export and Import",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Export[file, expr, \"WDX\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes any expression in Mathematica's binary format; ",
 StyleBox["Import[file, \"WDX\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads it back identically."
}], "Item",ExpressionUUID->"13a25e2b-ff33-47a5-a97d-d10ba2e51db2"],

Cell["Lesson 13 \[LongDash] Dimensions", "Section",ExpressionUUID->"7a7ec00e-016a-4697-ae22-4c83e61507e7"],

Cell[TextData[{
 StyleBox["Linear algebra",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["NullSpace[m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a basis of the solutions of m.x = 0; ",
 StyleBox["MatrixRank[m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the rank; ",
 StyleBox["LinearSolve[m, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " solves m.x = b."
}], "Item",ExpressionUUID->"bc23c96f-a294-4252-9108-0174177845f1"],

Cell[TextData[{
 StyleBox["Unique and LCM",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Unique[\"x\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " creates a new symbol never used before (x1, x2, ...); ",
 StyleBox["LCM",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the least common multiple."
}], "Item",ExpressionUUID->"af6cc7ec-3820-4481-9b03-a43d5bb86ddf"],

Cell[TextData[{
 StyleBox["PowerExpand and Log",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["PowerExpand[Log[x^a y^b]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives ",
 StyleBox["a Log[x] + b Log[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", assuming positive quantities."
}], "Item",ExpressionUUID->"dfe28684-2e74-407e-880e-5b07ae85c32e"],

Cell["Lesson 14 \[LongDash] Adimensional", "Section",ExpressionUUID->"1845c537-66e6-4eea-9610-e96931b48600"],

Cell[TextData[{
 StyleBox["Catch and Throw",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Throw[value, tag]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " jumps out of any depth of evaluation to the enclosing ",
 StyleBox["Catch[expr, tag]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which returns value."
}], "Item",ExpressionUUID->"56521cc3-87db-450e-80b0-bd0f3d6f555b"],

Cell[TextData[{
 StyleBox["CoefficientArrays",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["CoefficientArrays[{p1, p2, ...}, {x1, x2, ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes linear (or polynomial) equations as ",
 StyleBox["{b, m, ...}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with p = b + m.x + ..."
}], "Item",ExpressionUUID->"bdc8493c-04f4-4b7e-8c53-43af61500ee7"],

Cell["Lesson 15 \[LongDash] JuliaExport", "Section",ExpressionUUID->"5f2fa126-895e-4438-8719-137ec9195b0a"],

Cell[TextData[{
 StyleBox["Expressions as text",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["ToString[e, InputForm, PageWidth -> Infinity]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " prints e on one line in input syntax; ",
 StyleBox["StringReplace[s, {\"a\" -> \"b\", ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " rewrites the text; ",
 StyleBox["RegularExpression[\"...\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches by a regex."
}], "Item",ExpressionUUID->"6f7a920a-0ddf-49ac-8e05-57ea299cfe7c"],

Cell[TextData[{
 StyleBox["Building text",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Riffle[list, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " inserts x between the elements; ",
 StyleBox["StringRiffle[list, sep]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " joins strings; ",
 StyleBox["DateString[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " formats the date; ",
 StyleBox["Export[file, string, \"Text\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes text; ",
 StyleBox["CreateDirectory",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes a folder."
}], "Item",ExpressionUUID->"9de80bb5-a7f2-4549-bef7-cc20d17f3dc8"],

Cell["Lesson 16 \[LongDash] Tests", "Section",ExpressionUUID->"1dd9b386-1874-4017-920f-9ea5ce77c840"],

Cell[TextData[{
 StyleBox["RunProcess",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["RunProcess[{\"cmd\", \"arg\", ...}, \"StandardOutput\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs an external program and returns what it printed."
}], "Item",ExpressionUUID->"838e4972-ed86-471a-850c-5b0b2eb41edd"]
},

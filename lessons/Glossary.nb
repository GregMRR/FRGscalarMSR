Notebook[{
Cell["Mathematica glossary", "Title",ExpressionUUID->"267eac70-f8d9-4bf7-8b23-360f63c308f7"],

Cell["\<\
Every Mathematica command, tool or practice used in the lessons, in the order \
the lessons explain it. Each entry gives a one-line summary and the lesson \
whose blue \"Mathematica:\" box explains it in full. Generated by \
lessons/makeLessons.wl from the lesson sources, so it always matches them.\
\>", "Text",ExpressionUUID->"8f83a020-2264-45b0-8e1a-6b52f374349a"],

Cell["Lesson 00 \[LongDash] LoaderAndCore", "Section",ExpressionUUID->"e006ab7d-7aec-4c1d-9347-732ee22c9916"],

Cell[TextData[{
 StyleBox["Get",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Get[file]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (or ",
 StyleBox["<< file",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") reads a file and evaluates every expression in it, in order."
}], "Item",ExpressionUUID->"7c98a433-ce26-4cfe-8795-5079cff2a9d0"],

Cell[TextData[{
 StyleBox["Symbols and contexts",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Every symbol has a full name ",
 StyleBox["context`name",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; short names are looked up in ",
 StyleBox["$Context",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", then in ",
 StyleBox["$ContextPath",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"decacda0-9028-40ce-8de3-43b2e4390efa"],

Cell[TextData[{
 StyleBox["Set and SetDelayed",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["x = rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates rhs now and stores the result; ",
 StyleBox["f[x_] := rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stores rhs unevaluated and evaluates it at every use."
}], "Item",ExpressionUUID->"ab588c72-09af-4542-b4cc-49677f29baf8"],

Cell[TextData[{
 StyleBox["Attributes and Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Attributes are flags on a symbol that change how it evaluates; ",
 StyleBox["Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " forbids new definitions."
}], "Item",ExpressionUUID->"fdee4ba3-77c5-44c8-87d8-a1a063b81f5e"],

Cell[TextData[{
 StyleBox["Pure functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["body &",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is an anonymous function; ",
 StyleBox["#",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is its argument (",
 StyleBox["#1",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["#2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ... for several)."
}], "Item",ExpressionUUID->"0ac7e7a3-ee78-4066-8d3e-532ab811fb46"],

Cell[TextData[{
 StyleBox["Map and Scan",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Map[f, list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["f /@ list",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") returns the list of results; ",
 StyleBox["Scan[f, list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f only for its side effects and returns nothing."
}], "Item",ExpressionUUID->"e6d7e5ba-f967-44d5-9868-521942eebc96"],

Cell[TextData[{
 StyleBox["BeginPackage, Begin, End, EndPackage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "The four commands that give a package its public and private namespaces."
}], "Item",ExpressionUUID->"5c53eace-b078-4af8-823a-bbfcc3aca486"],

Cell[TextData[{
 StyleBox["Usage messages",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f::usage = \"text\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " attaches help text to f; ",
 StyleBox["?f",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " shows it."
}], "Item",ExpressionUUID->"8301af94-5488-4cd0-9919-e20eba14d0e3"],

Cell[TextData[{
 StyleBox["Patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["x_",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches any expression and names it x; ",
 StyleBox["x_h",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " only expressions with head h; ",
 StyleBox["x_ : d",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is optional with default d; ",
 StyleBox["patt /; cond",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " adds a condition."
}], "Item",ExpressionUUID->"88b946be-c0f8-4dc3-a7b9-77fedc30d8a8"],

Cell[TextData[{
 StyleBox["Hold attributes",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["HoldAll",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["HoldFirst",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["HoldRest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stop Mathematica from evaluating some arguments before the function sees \
them."
}], "Item",ExpressionUUID->"19cc5772-72b7-43cb-8c80-83ec003a9266"],

Cell[TextData[{
 StyleBox["If and TrueQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["If[c, a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a if c is True, b if c is False, and stays unevaluated otherwise; ",
 StyleBox["TrueQ[c]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True only if c is literally True."
}], "Item",ExpressionUUID->"b463a9fd-9f54-437e-9fe6-abec83ac78c2"],

Cell[TextData[{
 StyleBox["Abort, CheckAbort, Exit",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Abort[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stops the whole evaluation; ",
 StyleBox["CheckAbort[expr, alt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " catches an abort inside expr and returns alt; ",
 StyleBox["Exit[n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " quits the kernel with exit code n."
}], "Item",ExpressionUUID->"1e1b3cb8-685c-4412-ba46-05d316114fe2"],

Cell[TextData[{
 StyleBox["Block and Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Module[{x}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " creates a fresh local x seen only by the code written inside; ",
 StyleBox["Block[{x = v}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " temporarily gives the existing x the value v, seen by every function \
called from body."
}], "Item",ExpressionUUID->"8186f1f1-18c3-4323-9fc2-3fd0d7275daf"],

Cell[TextData[{
 StyleBox["Association",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["<|key -> value, ...|>",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a table of key-value pairs; read with ",
 StyleBox["a[key]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " or ",
 StyleBox["Lookup[a, key, default]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"8a411174-1ffe-4f86-ac81-fff3c2b6d05b"],

Cell[TextData[{
 StyleBox["Hash",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Hash[expr, \"SHA256\", \"HexString\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a 64-character fingerprint of expr; any change to expr changes it."
}], "Item",ExpressionUUID->"3879fe06-6340-4b5d-be3c-096ff302af77"],

Cell[TextData[{
 StyleBox["Options",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Options[f] = {\"Name\" -> default}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " declares named options; ",
 StyleBox["f[x_, OptionsPattern[]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " accepts them; ",
 StyleBox["OptionValue[\"Name\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads them."
}], "Item",ExpressionUUID->"69ff9751-5d09-4e80-bdbe-823bf986d80d"],

Cell[TextData[{
 StyleBox["Cases and level specifications",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Cases[e, patt, {0, Infinity}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns every subexpression of e, at any depth, that matches patt."
}], "Item",ExpressionUUID->"da50f737-645a-4c7c-af4e-e3223e6e5cde"],

Cell[TextData[{
 StyleBox["Rules and replacement",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["lhs -> rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["lhs :> rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are rules; ",
 StyleBox["e /. rules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies them to every part of e."
}], "Item",ExpressionUUID->"c6bf48a4-9d41-49d8-9a47-ce4efabf0ddf"],

Cell[TextData[{
 StyleBox["Alternatives and named patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["p1 | p2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches either pattern; ",
 StyleBox["x : p",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches p and names the whole match x."
}], "Item",ExpressionUUID->"5aca56e7-364d-43ed-9bb4-9e6c958c930c"],

Cell[TextData[{
 StyleBox["Memoization",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f[x_] := f[x] = value",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " computes value the first time and stores it as a specific definition for \
that x."
}], "Item",ExpressionUUID->"f4aea51d-cb18-49b2-b9f6-23b049c3bd78"],

Cell[TextData[{
 StyleBox["Check and Quiet",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Check[expr, alt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns alt if evaluating expr produced a message; ",
 StyleBox["Quiet[expr, {msgs}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates expr without printing those messages."
}], "Item",ExpressionUUID->"8199946d-399b-4ae0-b7ff-5446e6001963"],

Cell[TextData[{
 StyleBox["Exact numbers",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Integers and rationals are exact (",
 StyleBox["Precision",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["Infinity",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "); ",
 StyleBox["Together",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " puts a rational expression over a common denominator."
}], "Item",ExpressionUUID->"50144480-e7bf-4ca9-bcfa-eaa04738ace7"],

Cell[TextData[{
 StyleBox["OwnValues and DownValues",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "A symbol's definitions are stored as lists of rules: ",
 StyleBox["OwnValues[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for ",
 StyleBox["x = ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["DownValues[f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for ",
 StyleBox["f[...] := ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["UpValues[f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for definitions attached to f as an argument."
}], "Item",ExpressionUUID->"79cc49cf-2b06-4492-b7fc-b64adfb5ad3e"],

Cell[TextData[{
 StyleBox["Orderless",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "The attribute ",
 StyleBox["Orderless",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sorts a function's arguments into a canonical order before anything else."
}], "Item",ExpressionUUID->"620fce09-75f0-4eea-b17e-c20a9e6261c9"],

Cell[TextData[{
 StyleBox["Evaluation as rewriting",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Mathematica applies matching definitions repeatedly until no rule matches \
any more."
}], "Item",ExpressionUUID->"fa8f4286-b74f-4834-bdf2-c8c2f5255a36"],

Cell[TextData[{
 StyleBox["FixedPoint",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["FixedPoint[f, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f repeatedly, starting from x, until the result stops changing."
}], "Item",ExpressionUUID->"b8563332-eded-4db8-bd7d-8ab9a49c69ec"],

Cell["Lesson 01 \[LongDash] Theory", "Section",ExpressionUUID->"b7dece9a-a7a2-4241-8eac-823c1f0b4e04"],

Cell[TextData[{
 StyleBox["MatchQ and repeated patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["MatchQ[e, patt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True if e matches patt; ",
 StyleBox["p ..",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches one or more repetitions of p, ",
 StyleBox["p ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " zero or more."
}], "Item",ExpressionUUID->"f6ea9575-ab82-49ad-9f32-62268ef11756"],

Cell[TextData[{
 StyleBox["AppendTo",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["AppendTo[x, e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["x = Append[x, e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": it rebinds the variable x to a longer list."
}], "Item",ExpressionUUID->"c6401f23-88be-4434-97f8-bde317ac5511"],

Cell[TextData[{
 StyleBox["Symbol and SymbolName",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Symbol[\"name\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the symbol with that name, creating it if needed; ",
 StyleBox["SymbolName[s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Context[s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " give its short name and its context."
}], "Item",ExpressionUUID->"5b410ace-d186-4be1-b01b-0a1583e2eab8"],

Cell[TextData[{
 StyleBox["Apply",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f @@ expr",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces the head of expr by f: ",
 StyleBox["f @@ {a, b}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["f[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"136e7649-b6c6-4c3a-a156-8148f67379cd"],

Cell[TextData[{
 StyleBox["Transpose and Flatten",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Transpose[{l1, l2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " pairs up two lists element by element; ",
 StyleBox["Flatten",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes the inner brackets."
}], "Item",ExpressionUUID->"e7b945a1-ecb5-4bf3-baea-891545970972"],

Cell[TextData[{
 StyleBox["SameQ and Equal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["a === b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (SameQ) asks whether two expressions are identical and is always True or \
False; ",
 StyleBox["a == b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (Equal) asks for mathematical equality and may stay undecided."
}], "Item",ExpressionUUID->"09a5cda6-1a82-4a48-9342-67ad4317297c"],

Cell[TextData[{
 StyleBox["Inert heads",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "A symbol with no definitions, used as a head, is just a label: ",
 StyleBox["FixedDimension[2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates to itself and carries its meaning as data."
}], "Item",ExpressionUUID->"4831ede1-8b54-47b6-ae8d-2358c2fe975b"],

Cell["Lesson 02 \[LongDash] Ansatz", "Section",ExpressionUUID->"03a14fe1-5c31-4a18-8215-ab14eb82a7a9"],

Cell[TextData[{
 StyleBox["FullForm",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["FullForm[e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " shows the tree Mathematica actually stores, with every head written out."
}], "Item",ExpressionUUID->"c5122654-6977-4d0f-96b3-7bdec2a4676b"],

Cell[TextData[{
 StyleBox["Complement and Intersection",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Complement[all, l1, l2, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the elements of all that are in none of the li; ",
 StyleBox["Intersection[l1, l2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the common ones."
}], "Item",ExpressionUUID->"8cfcd2f5-d070-4d99-b91c-eb63f13b8cb1"],

Cell[TextData[{
 StyleBox["Which",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Which[c1, v1, c2, v2, ..., True, v]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the value of the first condition that is True."
}], "Item",ExpressionUUID->"588be7ef-0586-4b3b-bb52-cde230798489"],

Cell[TextData[{
 StyleBox["Several definitions of one function",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "A function can have many rules; Mathematica tries the more specific \
patterns first and the most general last."
}], "Item",ExpressionUUID->"29304f91-d8b9-4212-bbee-13e4ebc8cf74"],

Cell[TextData[{
 StyleBox["Automatic simplification of Times and Plus",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Times",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Plus",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sort their arguments and combine equal ones as soon as an expression is \
built: ",
 StyleBox["x x",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " becomes ",
 StyleBox["x^2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["a + a",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " becomes ",
 StyleBox["2 a",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"1501a9f5-9c9e-4927-9f41-4e1fbfeb142d"],

Cell[TextData[{
 StyleBox["Curried definitions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f[a_][x_] := ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " defines a function of a whose result is itself a function of x."
}], "Item",ExpressionUUID->"983c87aa-c728-43d6-a99c-c63deddcf98f"],

Cell[TextData[{
 StyleBox["MapAt, Table and Sum",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["MapAt[f, e, i]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f to the i-th part of e only; ",
 StyleBox["Table[expr, {i, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Sum[expr, {i, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " build a list or a sum for i = 1..n."
}], "Item",ExpressionUUID->"13f82a12-5f13-4b48-9446-fa41ad0d0cd9"],

Cell[TextData[{
 StyleBox["Local functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Symbols created by ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " can be given definitions like any symbol; they are private to that call \
and can use the other local variables."
}], "Item",ExpressionUUID->"c8c9c27f-7624-4856-9a32-b275a88f9403"],

Cell[TextData[{
 StyleBox["With",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["With[{j = value}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates value once and inserts it into body as a constant."
}], "Item",ExpressionUUID->"c2929a73-c827-4227-8b53-cbd55d7e3fa3"],

Cell[TextData[{
 StyleBox["Sort and canonical order",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Sort[list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " puts any expressions in Mathematica's canonical order; ",
 StyleBox["Permutations[list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists all orderings."
}], "Item",ExpressionUUID->"0a55144e-61b7-4918-9615-886b80b7ff46"],

Cell[TextData[{
 StyleBox["Except",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Except[p]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches anything that does not match p."
}], "Item",ExpressionUUID->"6e7fc965-81b9-449d-b148-fee85ef29798"],

Cell[TextData[{
 StyleBox["GroupBy and KeyValueMap",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["GroupBy[list, key -> value]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " collects the elements with the same key into an association of lists; ",
 StyleBox["KeyValueMap[f, assoc]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f[key, value] to each entry."
}], "Item",ExpressionUUID->"e585de8d-2bbf-4423-adfc-1a0edd131f2f"],

Cell[TextData[{
 StyleBox["DeleteCases, SortBy and FirstPosition",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["DeleteCases[list, patt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " drops the matching elements; ",
 StyleBox["SortBy[list, f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sorts by the value of f (a list of criteria breaks ties in turn); ",
 StyleBox["FirstPosition[list, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the position of the first x."
}], "Item",ExpressionUUID->"a6dc5301-99b6-48cd-80d2-d2cb3c4e1484"],

Cell[TextData[{
 StyleBox["Sequence",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Sequence[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is spliced into whatever contains it: ",
 StyleBox["f[x, Sequence[a, b]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["f[x, a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["Sequence[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " disappears."
}], "Item",ExpressionUUID->"42d56287-891b-49dc-8bb0-ca9e6a33afa9"],

Cell["Lesson 03 \[LongDash] Vertices", "Section",ExpressionUUID->"69a0baee-832f-4654-ae42-8df26babe1e1"],

Cell[TextData[{
 StyleBox["Complex numbers",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["I",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the exact imaginary unit; ",
 StyleBox["Im",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Re",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Conjugate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " work on exact and symbolic expressions."
}], "Item",ExpressionUUID->"038a0da0-5f07-45aa-aef2-1455c7b7caa6"],

Cell[TextData[{
 StyleBox["KeySelect and Values",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["KeySelect[assoc, test]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " keeps the entries whose key passes test; ",
 StyleBox["Values[assoc]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists the values."
}], "Item",ExpressionUUID->"ee43cfb6-3c2c-4269-9c7c-2fc62f0a30a1"],

Cell[TextData[{
 StyleBox["Tuples",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Tuples[list, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives every list of n elements drawn from list, with repetition and in \
every order."
}], "Item",ExpressionUUID->"8a0eb64b-ff89-4c05-b33f-577720ecde72"],

Cell[TextData[{
 StyleBox["Ordering",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Ordering[list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the positions that would sort list: ",
 StyleBox["list[[Ordering[list]]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is sorted."
}], "Item",ExpressionUUID->"605113c6-d5fb-4c38-a989-917a8ec404c6"],

Cell[TextData[{
 StyleBox["Key",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Key[k]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " wraps a key so that it is never read as something else; ",
 StyleBox["Lookup[assoc, Key[{a, b}], 0]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " looks up the key ",
 StyleBox["{a, b}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"af904462-139c-48a1-a835-9e808fdfd2e0"],

Cell[TextData[{
 StyleBox["Array and explicit vectors",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Array[f, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["{f[1], ..., f[n]}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox[".",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (Dot) contracts explicit lists; ",
 StyleBox["D",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Grad",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Div",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Laplacian",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " differentiate with respect to explicit variables."
}], "Item",ExpressionUUID->"030d1dff-0249-466f-a7ab-db76a809558f"],

Cell[TextData[{
 StyleBox["Replacing heads by functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "A rule ",
 StyleBox["dt -> (D[#, tt] &)",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns ",
 StyleBox["dt[e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " into ",
 StyleBox["(D[#, tt] &)[e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which evaluates to ",
 StyleBox["D[e, tt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"ef072ba9-55af-4b2f-b614-5e4d19e18236"],

Cell[TextData[{
 StyleBox["Solve",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Solve[eqn, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the solutions as lists of rules ",
 StyleBox["{{x -> s1}, ...}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["x /. Solve[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " extracts the values."
}], "Item",ExpressionUUID->"4e1d6a67-48a8-49d5-b0e7-fd409263ed00"],

Cell["Lesson 04 \[LongDash] Regulator", "Section",ExpressionUUID->"0a33d97e-c8c6-45bd-aed4-318c32618e20"],

Cell[TextData[{
 StyleBox["Sequence patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["x__",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches a sequence of one or more arguments, ",
 StyleBox["x___",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of zero or more; inside the body, ",
 StyleBox["{x}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the list of them."
}], "Item",ExpressionUUID->"c4a8047b-f1d5-4685-a03d-1509d81f74d8"],

Cell[TextData[{
 StyleBox["PatternTest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["x_?test",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches x only if ",
 StyleBox["test[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True; ",
 StyleBox["n_Integer?EvenQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches even integers."
}], "Item",ExpressionUUID->"6f4f2f10-3599-4958-8062-d9bf49c6a8a6"],

Cell[TextData[{
 StyleBox["D and unknown functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["D[e, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " differentiates; on a function with no definition it applies the chain rule \
and writes the derivative as ",
 StyleBox["Derivative[1][r][arg]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", displayed ",
 StyleBox["r'[arg]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"726a9e00-9a84-4418-afaf-4887db78d5a3"],

Cell[TextData[{
 StyleBox["Map at a level",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Map[f, matrix, {2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f to every element at depth 2, that is, to every entry of a matrix."
}], "Item",ExpressionUUID->"26dc2273-3563-44bd-b7ee-778b0ce95966"],

Cell[TextData[{
 StyleBox["Function and Evaluate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Function[{x}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " holds its body unevaluated; ",
 StyleBox["Function[{x}, Evaluate[body]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates it first, so the stored function contains the computed result."
}], "Item",ExpressionUUID->"76e168c7-24b5-46c2-80c1-21c62788b1cc"],

Cell["Lesson 05 \[LongDash] Propagator", "Section",ExpressionUUID->"a73d96fa-c0be-4131-94f0-f3c33f278017"],

Cell[TextData[{
 StyleBox["Coefficient and Exponent",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Coefficient[e, x, m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the coefficient of x^m in the polynomial e; ",
 StyleBox["Exponent[e, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " its degree in x."
}], "Item",ExpressionUUID->"988bd615-ec69-46d9-b12f-07dbe9d06adf"],

Cell[TextData[{
 StyleBox["Assigning to an association",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["assoc[key] = value",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " adds or replaces one entry of an association stored in a variable."
}], "Item",ExpressionUUID->"f062635e-c54f-4de4-8be7-f431d9b00e1f"],

Cell[TextData[{
 StyleBox["Part with lists",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["m[[{1, 3}, {2}]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " extracts the rows 1, 3 and the column 2 of a matrix; the same form on the \
left of ",
 StyleBox["=",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " assigns a block."
}], "Item",ExpressionUUID->"47742ff2-7401-4819-a7a3-8fed85ba3a8c"],

Cell[TextData[{
 StyleBox["Matrix algebra",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox[".",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " multiplies matrices (and vectors); ",
 StyleBox["Transpose",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Det",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["IdentityMatrix[n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " work on nested lists."
}], "Item",ExpressionUUID->"c6553fbe-d804-4b57-9596-9a6fa61940ba"],

Cell["Lesson 06 \[LongDash] Symmetries", "Section",ExpressionUUID->"b2c75ec3-8308-4745-9851-45795c0c8e4e"],

Cell[TextData[{
 StyleBox["Multiple assignment",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["{a, b} = {1, 2}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " assigns element by element."
}], "Item",ExpressionUUID->"b94e66a4-a9f7-4d30-8afd-eecfad017eb5"],

Cell[TextData[{
 StyleBox["Iterators that depend on each other",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Table[expr, {pr, pairs}, {m, 0, mf}, {n, 0, mp}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs over every combination; ",
 StyleBox["Flatten[t, 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes two levels of nesting."
}], "Item",ExpressionUUID->"9cde5b8d-0077-419f-8cab-314c1089e370"],

Cell["Lesson 07 \[LongDash] Loops", "Section",ExpressionUUID->"9043101a-f27f-4db7-8151-6e39b18e329d"],

Cell[TextData[{
 StyleBox["Tr and exact constants",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Tr[m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the trace of a matrix; ",
 StyleBox["Pi",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["E",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["I",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are exact constants, never rounded."
}], "Item",ExpressionUUID->"6987a86d-520e-4fa5-afb8-1bc5f1e29eee"],

Cell["Lesson 08 \[LongDash] Projection", "Section",ExpressionUUID->"fc324f8b-0a6d-42f1-83ab-2457945934ec"],

Cell[TextData[{
 StyleBox["Repeated derivatives",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["D[e, {x, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the n-th derivative of e in x; ",
 StyleBox["D[e, {x, n}, {y, m}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " mixes variables."
}], "Item",ExpressionUUID->"1c21d398-9d29-4020-a07b-ab560f4abb7e"],

Cell[TextData[{
 StyleBox["Special functions and products",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["k!!",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the double factorial, ",
 StyleBox["Product[f, {j, a, b}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " a product, ",
 StyleBox["Pochhammer[a, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " = a(a+1)",
 StyleBox["\[CenterEllipsis]",
  FontFamily->"Noto Sans"],
 "(a+n",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1), ",
 StyleBox["Gamma[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 " function; ",
 StyleBox["FunctionExpand",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " rewrites special values in elementary form."
}], "Item",ExpressionUUID->"7f8f390b-9c29-4e97-aae3-2b6d23965b05"],

Cell[TextData[{
 StyleBox["Derivative of several arguments",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Derivative[i, j][f][x, y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["\[PartialD]\:2071",
  FontFamily->"Noto Sans"],
 "_x ",
 StyleBox["\[PartialD]\:02b2",
  FontFamily->"Noto Sans"],
 "_y f; a pattern ",
 StyleBox["Derivative[i_, j_][\[CapitalDelta]][w_, s_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches any such derivative."
}], "Item",ExpressionUUID->"2da8c059-009e-4c8b-bb4e-5f4e1560b395"],

Cell[TextData[{
 StyleBox["Nest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Nest[f, x, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f to x n times: ",
 StyleBox["f[f[f[x]]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for n = 3."
}], "Item",ExpressionUUID->"1d94f2c1-fe61-4fec-b94e-5280d7b469b3"],

Cell[TextData[{
 StyleBox["SelectFirst and Missing",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["SelectFirst[list, test]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the first element that passes test, or ",
 StyleBox["Missing[\"NotFound\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["MissingQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tests for it."
}], "Item",ExpressionUUID->"27f68e7a-7812-413b-8635-4608a753cc05"],

Cell["Lesson 09 \[LongDash] FrequencyIntegration", "Section",ExpressionUUID->"e6dcc609-ab29-422e-a384-c908d8dba696"],

Cell[TextData[{
 StyleBox["Numerator, Denominator and radicals",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Numerator[r]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Denominator[r]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " split a rational expression; a square root is ",
 StyleBox["Power[x, 1/2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", so ",
 StyleBox["FreeQ[r, Power[_, _Rational]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tests for radicals."
}], "Item",ExpressionUUID->"ca3c463b-9526-40b8-b973-3c07282c42e4"],

Cell[TextData[{
 StyleBox["Memoization of a function",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f[n_, a_] := f[n, a] = ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stores each computed value as a new definition of f, so the next call with \
the same arguments returns it at once."
}], "Item",ExpressionUUID->"50dbfb5f-aec3-452f-91e7-7006eea50474"],

Cell[TextData[{
 StyleBox["CoefficientRules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["CoefficientRules[poly, {x, y, ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists the monomials of a polynomial as ",
 StyleBox["{exponents} -> coefficient",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"ca6df310-ef6c-4572-bb61-88c1d7270655"],

Cell[TextData[{
 StyleBox["Return from a loop",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Do[..., {j, 0, 199}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a loop; ",
 StyleBox["Return[value, Module]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " leaves the enclosing ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " at once with that value."
}], "Item",ExpressionUUID->"c9a835e0-95b2-45e3-ab57-684b531971e2"],

Cell["Lesson 10 \[LongDash] Closure", "Section",ExpressionUUID->"1a394118-dfe9-48c9-80d2-806e560f605d"],

Cell[TextData[{
 StyleBox["N and CForm",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["N[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a machine-precision approximation of an exact number; ",
 StyleBox["CForm[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes an expression as C code, here a compact number string."
}], "Item",ExpressionUUID->"9c808681-4fcd-45c8-adbb-519b8b2df287"],

Cell[TextData[{
 StyleBox["FactorTermsList",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["FactorTermsList[poly]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " pulls out the numeric factors: ",
 StyleBox["{number, ..., rest}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"fe295836-9c60-4b22-8569-6e338cd0fe24"],

Cell[TextData[{
 StyleBox["Switch",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Switch[expr, form1, value1, form2, value2, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the value of the first form (a pattern) that expr matches."
}], "Item",ExpressionUUID->"ff01a4f0-3697-4615-aaa9-44a86c527c16"],

Cell["Lesson 11 \[LongDash] Assemble", "Section",ExpressionUUID->"5876f116-e7bb-4bce-9610-699463150b33"],

Cell[TextData[{
 StyleBox["Replace and ReplaceAll",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Replace[e, rule]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tries the rule on the whole of e only; ",
 StyleBox["e /. rule",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["ReplaceAll",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") tries every part."
}], "Item",ExpressionUUID->"1fad03ab-c4b1-4565-b68e-4b04486e48b5"],

Cell[TextData[{
 StyleBox["Collect and Factor",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Collect[e, vars, f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " groups e by powers of vars and applies f to each coefficient; ",
 StyleBox["Factor",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " factors a polynomial."
}], "Item",ExpressionUUID->"fc896789-7a90-4b01-8b12-da1cac579ec3"],

Cell[TextData[{
 StyleBox["TimeConstrained",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["TimeConstrained[expr, t, alt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates expr for at most t seconds, and returns alt if time runs out."
}], "Item",ExpressionUUID->"55af1541-e364-4318-be7b-5fa7426ed27c"],

Cell["Lesson 12 \[LongDash] OracleAndStages", "Section",ExpressionUUID->"2af2286e-7ec1-4ca2-af44-f1b5b0852d7f"],

Cell[TextData[{
 StyleBox["Arbitrary precision",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["N[x, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives n digits, in software arithmetic that tracks its own precision; ",
 StyleBox["Chop[x, eps]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces numbers smaller than eps by 0."
}], "Item",ExpressionUUID->"5f76ce90-409e-40f3-9362-b5a5591aaa40"],

Cell[TextData[{
 StyleBox["NIntegrate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["NIntegrate[f, {x, a, b}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " integrates numerically; ",
 StyleBox["PrecisionGoal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["AccuracyGoal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " set the relative and absolute target, ",
 StyleBox["WorkingPrecision",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the digits used."
}], "Item",ExpressionUUID->"f61a0c48-9dd3-4f5f-b544-01cef2ed2719"],

Cell[TextData[{
 StyleBox["Export and Import",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Export[file, expr, \"WDX\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes any expression in Mathematica's binary format; ",
 StyleBox["Import[file, \"WDX\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads it back identically."
}], "Item",ExpressionUUID->"83eed470-95e3-4cbd-9114-7c5796bc8ef7"],

Cell["Lesson 13 \[LongDash] Dimensions", "Section",ExpressionUUID->"53b612f9-e29f-42fc-a570-12a9a355ffbb"],

Cell[TextData[{
 StyleBox["Linear algebra",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["NullSpace[m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a basis of the solutions of m.x = 0; ",
 StyleBox["MatrixRank[m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the rank; ",
 StyleBox["LinearSolve[m, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " solves m.x = b."
}], "Item",ExpressionUUID->"3896d62b-93f7-40c3-9a99-2623734dca92"],

Cell[TextData[{
 StyleBox["Unique and LCM",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Unique[\"x\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " creates a new symbol never used before (x1, x2, ...); ",
 StyleBox["LCM",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the least common multiple."
}], "Item",ExpressionUUID->"4e028b45-baa6-45cf-a10c-ed74213c19c1"],

Cell[TextData[{
 StyleBox["PowerExpand and Log",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["PowerExpand[Log[x^a y^b]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives ",
 StyleBox["a Log[x] + b Log[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", assuming positive quantities."
}], "Item",ExpressionUUID->"2fd51f53-fcc8-4b2f-b486-98e0005e03e3"],

Cell["Lesson 14 \[LongDash] Adimensional", "Section",ExpressionUUID->"d5146012-5336-46ee-9823-8f017dba52c3"],

Cell[TextData[{
 StyleBox["Catch and Throw",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Throw[value, tag]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " jumps out of any depth of evaluation to the enclosing ",
 StyleBox["Catch[expr, tag]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which returns value."
}], "Item",ExpressionUUID->"09f91bad-2456-475f-9551-04d727bf9cd5"],

Cell[TextData[{
 StyleBox["CoefficientArrays",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["CoefficientArrays[{p1, p2, ...}, {x1, x2, ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes linear (or polynomial) equations as ",
 StyleBox["{b, m, ...}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with p = b + m.x + ..."
}], "Item",ExpressionUUID->"cf68d80d-d1f9-486c-828d-ff18cdbc97ef"],

Cell["Lesson 15 \[LongDash] JuliaExport", "Section",ExpressionUUID->"e8132063-67e8-44e6-98ad-30c48d190b3a"],

Cell[TextData[{
 StyleBox["Expressions as text",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["ToString[e, InputForm, PageWidth -> Infinity]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " prints e on one line in input syntax; ",
 StyleBox["StringReplace[s, {\"a\" -> \"b\", ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " rewrites the text; ",
 StyleBox["RegularExpression[\"...\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches by a regex."
}], "Item",ExpressionUUID->"e4eee11c-d5b9-4be5-a8ad-e2e5aad214a0"],

Cell[TextData[{
 StyleBox["Building text",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Riffle[list, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " inserts x between the elements; ",
 StyleBox["StringRiffle[list, sep]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " joins strings; ",
 StyleBox["DateString[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " formats the date; ",
 StyleBox["Export[file, string, \"Text\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes text; ",
 StyleBox["CreateDirectory",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes a folder."
}], "Item",ExpressionUUID->"3c856416-b43b-444f-89bd-fb502206dce4"],

Cell["Lesson 16 \[LongDash] Tests", "Section",ExpressionUUID->"378703db-dbe4-49fb-95e7-06252f182442"],

Cell[TextData[{
 StyleBox["RunProcess",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["RunProcess[{\"cmd\", \"arg\", ...}, \"StandardOutput\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs an external program and returns what it printed."
}], "Item",ExpressionUUID->"45dc91dd-c6a1-49a5-809b-aea50d0fcfb0"]
},

Notebook[{
Cell["Mathematica glossary", "Title",ExpressionUUID->"9579d35a-2d64-4f0d-86f3-80f18c45ca03"],

Cell["\<\
Every Mathematica command, tool or practice used in the lessons, in the order \
the lessons explain it. Each entry gives a one-line summary and the lesson \
whose blue \"Mathematica:\" box explains it in full. Generated by \
lessons/makeLessons.wl from the lesson sources, so it always matches them.\
\>", "Text",ExpressionUUID->"7e2664a3-dee1-4a12-8a1f-147a91b3d3b6"],

Cell["Lesson 00 \[LongDash] LoaderAndCore", "Section",ExpressionUUID->"7062b294-7ad8-484a-950b-621228f199ea"],

Cell[TextData[{
 StyleBox["Get",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Get[file]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (or ",
 StyleBox["<< file",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") reads a file and evaluates every expression in it, in order."
}], "Item",ExpressionUUID->"489a6aa6-aaba-4beb-863c-d3774f5590dc"],

Cell[TextData[{
 StyleBox["Symbols and contexts",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Every symbol has a full name ",
 StyleBox["context`name",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; short names are looked up in ",
 StyleBox["$Context",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", then in ",
 StyleBox["$ContextPath",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"a735f48d-4bc8-4639-9423-5815bd3a8a5b"],

Cell[TextData[{
 StyleBox["Set and SetDelayed",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["x = rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates rhs now and stores the result; ",
 StyleBox["f[x_] := rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stores rhs unevaluated and evaluates it at every use."
}], "Item",ExpressionUUID->"a4b413b3-068c-4ef3-8e7e-f45637cdaa0b"],

Cell[TextData[{
 StyleBox["Attributes and Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Attributes are flags on a symbol that change how it evaluates; ",
 StyleBox["Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " forbids new definitions."
}], "Item",ExpressionUUID->"773209bf-c19b-49b0-bd17-d94fe6f93dce"],

Cell[TextData[{
 StyleBox["Pure functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["body &",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is an anonymous function; ",
 StyleBox["#",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is its argument (",
 StyleBox["#1",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["#2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ... for several)."
}], "Item",ExpressionUUID->"9afe90be-38fe-4a86-98fd-7a85d98bb49a"],

Cell[TextData[{
 StyleBox["Map and Scan",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Map[f, list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["f /@ list",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") returns the list of results; ",
 StyleBox["Scan[f, list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f only for its side effects and returns nothing."
}], "Item",ExpressionUUID->"bcb6c93a-0ba0-4ae9-8b89-efafe33d2df4"],

Cell[TextData[{
 StyleBox["BeginPackage, Begin, End, EndPackage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "The four commands that give a package its public and private namespaces."
}], "Item",ExpressionUUID->"4a744438-f9c6-4724-b1fd-0861b0bf3e83"],

Cell[TextData[{
 StyleBox["Usage messages",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f::usage = \"text\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " attaches help text to f; ",
 StyleBox["?f",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " shows it."
}], "Item",ExpressionUUID->"88613c34-126f-4a08-899e-a39814f8eab0"],

Cell[TextData[{
 StyleBox["Patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["x_",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches any expression and names it x; ",
 StyleBox["x_h",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " only expressions with head h; ",
 StyleBox["x_ : d",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is optional with default d; ",
 StyleBox["patt /; cond",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " adds a condition."
}], "Item",ExpressionUUID->"0df4d6d0-bb08-4c4c-b2f7-8ec7f60d134f"],

Cell[TextData[{
 StyleBox["Hold attributes",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["HoldAll",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["HoldFirst",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["HoldRest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stop Mathematica from evaluating some arguments before the function sees \
them."
}], "Item",ExpressionUUID->"46d24d0d-950b-414a-87d9-4a5eafaa040c"],

Cell[TextData[{
 StyleBox["If and TrueQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["If[c, a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a if c is True, b if c is False, and stays unevaluated otherwise; ",
 StyleBox["TrueQ[c]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True only if c is literally True."
}], "Item",ExpressionUUID->"ae955303-6872-4b8f-bce3-b1d2cc136c6f"],

Cell[TextData[{
 StyleBox["Abort, CheckAbort, Exit",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Abort[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stops the whole evaluation; ",
 StyleBox["CheckAbort[expr, alt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " catches an abort inside expr and returns alt; ",
 StyleBox["Exit[n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " quits the kernel with exit code n."
}], "Item",ExpressionUUID->"8c85246a-f722-4e8d-860f-672cf2fd34df"],

Cell[TextData[{
 StyleBox["Block and Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Module[{x}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " creates a fresh local x seen only by the code written inside; ",
 StyleBox["Block[{x = v}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " temporarily gives the existing x the value v, seen by every function \
called from body."
}], "Item",ExpressionUUID->"840e9fa7-44ea-499c-b5a7-6f7aacc5e0fd"],

Cell[TextData[{
 StyleBox["Association",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["<|key -> value, ...|>",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a table of key-value pairs; read with ",
 StyleBox["a[key]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " or ",
 StyleBox["Lookup[a, key, default]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"233ae9da-2539-40ca-8f69-478228bce4d5"],

Cell[TextData[{
 StyleBox["Hash",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Hash[expr, \"SHA256\", \"HexString\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a 64-character fingerprint of expr; any change to expr changes it."
}], "Item",ExpressionUUID->"44a01cad-9826-41fa-a869-d42d096b86e7"],

Cell[TextData[{
 StyleBox["Options",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Options[f] = {\"Name\" -> default}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " declares named options; ",
 StyleBox["f[x_, OptionsPattern[]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " accepts them; ",
 StyleBox["OptionValue[\"Name\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads them."
}], "Item",ExpressionUUID->"e31f4d72-cc16-4377-b4f4-7f6ffb951be6"],

Cell[TextData[{
 StyleBox["Cases and level specifications",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Cases[e, patt, {0, Infinity}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns every subexpression of e, at any depth, that matches patt."
}], "Item",ExpressionUUID->"19258b46-eb91-4eb9-9102-8f986d5c6717"],

Cell[TextData[{
 StyleBox["Rules and replacement",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["lhs -> rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["lhs :> rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are rules; ",
 StyleBox["e /. rules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies them to every part of e."
}], "Item",ExpressionUUID->"563a8f15-6149-419d-a9f0-ffea25147066"],

Cell[TextData[{
 StyleBox["Alternatives and named patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["p1 | p2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches either pattern; ",
 StyleBox["x : p",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches p and names the whole match x."
}], "Item",ExpressionUUID->"8666bca7-b0b8-4ed3-9bc5-40213602dc88"],

Cell[TextData[{
 StyleBox["Memoization",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f[x_] := f[x] = value",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " computes value the first time and stores it as a specific definition for \
that x."
}], "Item",ExpressionUUID->"f7e54dd1-44ff-40f0-8c3c-e22cc57de5d0"],

Cell[TextData[{
 StyleBox["Check and Quiet",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Check[expr, alt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns alt if evaluating expr produced a message; ",
 StyleBox["Quiet[expr, {msgs}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates expr without printing those messages."
}], "Item",ExpressionUUID->"0a8874cc-dcec-479b-9ad8-757155912b06"],

Cell[TextData[{
 StyleBox["Exact numbers",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Integers and rationals are exact (",
 StyleBox["Precision",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["Infinity",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "); ",
 StyleBox["Together",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " puts a rational expression over a common denominator."
}], "Item",ExpressionUUID->"a5dcd7fd-b3f5-4dfb-8267-642000532ccf"],

Cell[TextData[{
 StyleBox["OwnValues and DownValues",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "A symbol's definitions are stored as lists of rules: ",
 StyleBox["OwnValues[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for ",
 StyleBox["x = ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["DownValues[f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for ",
 StyleBox["f[...] := ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["UpValues[f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for definitions attached to f as an argument."
}], "Item",ExpressionUUID->"3808c161-5333-4968-b74f-97ecf89cb4e8"],

Cell[TextData[{
 StyleBox["Orderless",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "The attribute ",
 StyleBox["Orderless",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sorts a function's arguments into a canonical order before anything else."
}], "Item",ExpressionUUID->"7eacc44e-624f-431a-861e-5a46a6340d77"],

Cell[TextData[{
 StyleBox["Evaluation as rewriting",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Mathematica applies matching definitions repeatedly until no rule matches \
any more."
}], "Item",ExpressionUUID->"3999af72-8142-467c-ac46-bdd286a4e330"],

Cell[TextData[{
 StyleBox["FixedPoint",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["FixedPoint[f, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f repeatedly, starting from x, until the result stops changing."
}], "Item",ExpressionUUID->"323c4456-f186-4dfe-9959-a3f8377205d0"],

Cell["Lesson 01 \[LongDash] Theory", "Section",ExpressionUUID->"6895eeb1-5ba4-4564-81dd-ba0696a4ae6a"],

Cell[TextData[{
 StyleBox["MatchQ and repeated patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["MatchQ[e, patt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True if e matches patt; ",
 StyleBox["p ..",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches one or more repetitions of p, ",
 StyleBox["p ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " zero or more."
}], "Item",ExpressionUUID->"0cb2772c-717b-4006-b30c-a4a63c976da7"],

Cell[TextData[{
 StyleBox["AppendTo",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["AppendTo[x, e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["x = Append[x, e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": it rebinds the variable x to a longer list."
}], "Item",ExpressionUUID->"e33a22b5-9347-4e08-b495-34609ac374fe"],

Cell[TextData[{
 StyleBox["Symbol and SymbolName",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Symbol[\"name\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the symbol with that name, creating it if needed; ",
 StyleBox["SymbolName[s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Context[s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " give its short name and its context."
}], "Item",ExpressionUUID->"893ac884-7d1d-4892-9410-c4939cea9b34"],

Cell[TextData[{
 StyleBox["Apply",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f @@ expr",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces the head of expr by f: ",
 StyleBox["f @@ {a, b}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["f[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"303cafbb-f680-429c-ba01-877253b571f2"],

Cell[TextData[{
 StyleBox["Transpose and Flatten",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Transpose[{l1, l2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " pairs up two lists element by element; ",
 StyleBox["Flatten",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes the inner brackets."
}], "Item",ExpressionUUID->"f05d05b0-e200-408e-a6b3-f678eee2c455"],

Cell[TextData[{
 StyleBox["SameQ and Equal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["a === b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (SameQ) asks whether two expressions are identical and is always True or \
False; ",
 StyleBox["a == b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (Equal) asks for mathematical equality and may stay undecided."
}], "Item",ExpressionUUID->"ae328483-b2f0-4bc9-b284-50463a55adc6"],

Cell[TextData[{
 StyleBox["Inert heads",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "A symbol with no definitions, used as a head, is just a label: ",
 StyleBox["FixedDimension[2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates to itself and carries its meaning as data."
}], "Item",ExpressionUUID->"52e3c053-f3c5-42e8-886a-929c4ae359f0"],

Cell["Lesson 02 \[LongDash] Ansatz", "Section",ExpressionUUID->"5652444e-010b-40ed-a8b4-db8eb4c7de68"],

Cell[TextData[{
 StyleBox["FullForm",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["FullForm[e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " shows the tree Mathematica actually stores, with every head written out."
}], "Item",ExpressionUUID->"e8e0f776-5936-4e04-915a-174d4143e55c"],

Cell[TextData[{
 StyleBox["Complement and Intersection",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Complement[all, l1, l2, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the elements of all that are in none of the li; ",
 StyleBox["Intersection[l1, l2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the common ones."
}], "Item",ExpressionUUID->"51859046-ed1e-49fe-9ee1-3dc45951e563"],

Cell[TextData[{
 StyleBox["Which",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Which[c1, v1, c2, v2, ..., True, v]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the value of the first condition that is True."
}], "Item",ExpressionUUID->"6d7d8b62-3e8d-4c67-ac65-6699fca751f8"],

Cell[TextData[{
 StyleBox["Several definitions of one function",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "A function can have many rules; Mathematica tries the more specific \
patterns first and the most general last."
}], "Item",ExpressionUUID->"62af53b3-16cb-4f41-ad32-865f367de14b"],

Cell[TextData[{
 StyleBox["Automatic simplification of Times and Plus",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Times",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Plus",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sort their arguments and combine equal ones as soon as an expression is \
built: ",
 StyleBox["x x",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " becomes ",
 StyleBox["x^2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["a + a",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " becomes ",
 StyleBox["2 a",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"c613ca36-c193-4d60-bc85-e7c9269d0c54"],

Cell[TextData[{
 StyleBox["Curried definitions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f[a_][x_] := ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " defines a function of a whose result is itself a function of x."
}], "Item",ExpressionUUID->"c3e9f7a3-a11e-452b-ade2-65c5fca62ba8"],

Cell[TextData[{
 StyleBox["MapAt, Table and Sum",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["MapAt[f, e, i]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f to the i-th part of e only; ",
 StyleBox["Table[expr, {i, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Sum[expr, {i, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " build a list or a sum for i = 1..n."
}], "Item",ExpressionUUID->"7cf36c3e-81b5-4c89-b36e-2b646a9f9a13"],

Cell[TextData[{
 StyleBox["Local functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "Symbols created by ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " can be given definitions like any symbol; they are private to that call \
and can use the other local variables."
}], "Item",ExpressionUUID->"fb075589-75fe-4966-bf51-044b53dc8241"],

Cell[TextData[{
 StyleBox["With",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["With[{j = value}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates value once and inserts it into body as a constant."
}], "Item",ExpressionUUID->"82f11ce1-420e-40d6-a91d-a9eaf081bdfc"],

Cell[TextData[{
 StyleBox["Sort and canonical order",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Sort[list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " puts any expressions in Mathematica's canonical order; ",
 StyleBox["Permutations[list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists all orderings."
}], "Item",ExpressionUUID->"f2a27a65-a2b2-4766-a63d-451529062cca"],

Cell[TextData[{
 StyleBox["Except",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Except[p]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches anything that does not match p."
}], "Item",ExpressionUUID->"09b17854-4461-43b0-bdff-62f14afc235a"],

Cell[TextData[{
 StyleBox["GroupBy and KeyValueMap",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["GroupBy[list, key -> value]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " collects the elements with the same key into an association of lists; ",
 StyleBox["KeyValueMap[f, assoc]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f[key, value] to each entry."
}], "Item",ExpressionUUID->"8194e37e-a3d4-4b5a-913f-4733d8fa4be5"],

Cell[TextData[{
 StyleBox["DeleteCases, SortBy and FirstPosition",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["DeleteCases[list, patt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " drops the matching elements; ",
 StyleBox["SortBy[list, f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sorts by the value of f (a list of criteria breaks ties in turn); ",
 StyleBox["FirstPosition[list, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the position of the first x."
}], "Item",ExpressionUUID->"e99a3a78-2ca5-4a6d-b16c-a43e4bd185fa"],

Cell[TextData[{
 StyleBox["Sequence",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Sequence[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is spliced into whatever contains it: ",
 StyleBox["f[x, Sequence[a, b]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["f[x, a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["Sequence[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " disappears."
}], "Item",ExpressionUUID->"a7e4b59d-27a4-4b2a-ae01-e67ab49a5f86"],

Cell["Lesson 03 \[LongDash] Vertices", "Section",ExpressionUUID->"009ed086-106d-4b51-a180-e70a1f164e61"],

Cell[TextData[{
 StyleBox["Complex numbers",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["I",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the exact imaginary unit; ",
 StyleBox["Im",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Re",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Conjugate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " work on exact and symbolic expressions."
}], "Item",ExpressionUUID->"77d4daf1-f9b9-455e-9734-174a474dcf4d"],

Cell[TextData[{
 StyleBox["KeySelect and Values",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["KeySelect[assoc, test]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " keeps the entries whose key passes test; ",
 StyleBox["Values[assoc]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists the values."
}], "Item",ExpressionUUID->"73db8121-2f00-49d3-9c98-9dceaf01c779"],

Cell[TextData[{
 StyleBox["Tuples",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Tuples[list, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives every list of n elements drawn from list, with repetition and in \
every order."
}], "Item",ExpressionUUID->"b7b2b4cc-26a8-4083-b821-6c0d19a01f58"],

Cell[TextData[{
 StyleBox["Ordering",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Ordering[list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the positions that would sort list: ",
 StyleBox["list[[Ordering[list]]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is sorted."
}], "Item",ExpressionUUID->"16a764e9-a27e-4859-8f2a-433dc3486345"],

Cell[TextData[{
 StyleBox["Key",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Key[k]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " wraps a key so that it is never read as something else; ",
 StyleBox["Lookup[assoc, Key[{a, b}], 0]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " looks up the key ",
 StyleBox["{a, b}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"4affed9b-2cb9-44a2-ab33-0c5de486e757"],

Cell[TextData[{
 StyleBox["Array and explicit vectors",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Array[f, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["{f[1], ..., f[n]}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox[".",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (Dot) contracts explicit lists; ",
 StyleBox["D",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Grad",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Div",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Laplacian",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " differentiate with respect to explicit variables."
}], "Item",ExpressionUUID->"776c574d-4a7b-416e-805e-056cce9c8f66"],

Cell[TextData[{
 StyleBox["Replacing heads by functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 "A rule ",
 StyleBox["dt -> (D[#, tt] &)",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns ",
 StyleBox["dt[e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " into ",
 StyleBox["(D[#, tt] &)[e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which evaluates to ",
 StyleBox["D[e, tt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"2939fd18-683a-463c-817c-b446e30a1f70"],

Cell[TextData[{
 StyleBox["Solve",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Solve[eqn, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the solutions as lists of rules ",
 StyleBox["{{x -> s1}, ...}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["x /. Solve[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " extracts the values."
}], "Item",ExpressionUUID->"b13aa66d-472d-40d0-a5c4-7a9c1f99130e"],

Cell["Lesson 04 \[LongDash] Regulator", "Section",ExpressionUUID->"4c3882f5-cd63-4dd5-807b-d7f6d54cd6b5"],

Cell[TextData[{
 StyleBox["Sequence patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["x__",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches a sequence of one or more arguments, ",
 StyleBox["x___",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of zero or more; inside the body, ",
 StyleBox["{x}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the list of them."
}], "Item",ExpressionUUID->"a997837b-83fc-4de3-ba06-af8ca25468f7"],

Cell[TextData[{
 StyleBox["PatternTest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["x_?test",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches x only if ",
 StyleBox["test[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True; ",
 StyleBox["n_Integer?EvenQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches even integers."
}], "Item",ExpressionUUID->"cdc8b3f3-4f74-422b-b4f9-91a365f869bc"],

Cell[TextData[{
 StyleBox["D and unknown functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["D[e, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " differentiates; on a function with no definition it applies the chain rule \
and writes the derivative as ",
 StyleBox["Derivative[1][r][arg]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", displayed ",
 StyleBox["r'[arg]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"3d915568-1373-4255-803d-68a755db3f90"],

Cell[TextData[{
 StyleBox["Map at a level",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Map[f, matrix, {2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f to every element at depth 2, that is, to every entry of a matrix."
}], "Item",ExpressionUUID->"7d56205d-2f44-42ef-9059-186a65c7838d"],

Cell[TextData[{
 StyleBox["Function and Evaluate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Function[{x}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " holds its body unevaluated; ",
 StyleBox["Function[{x}, Evaluate[body]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates it first, so the stored function contains the computed result."
}], "Item",ExpressionUUID->"184b7550-1432-439c-a253-dc204b197a7a"],

Cell["Lesson 05 \[LongDash] Propagator", "Section",ExpressionUUID->"064f586c-2a40-4b79-b3ec-a93c28eaa2fc"],

Cell[TextData[{
 StyleBox["Coefficient and Exponent",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Coefficient[e, x, m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the coefficient of x^m in the polynomial e; ",
 StyleBox["Exponent[e, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " its degree in x."
}], "Item",ExpressionUUID->"f945cbc7-2564-4c95-b1c3-1bec78d257c2"],

Cell[TextData[{
 StyleBox["Assigning to an association",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["assoc[key] = value",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " adds or replaces one entry of an association stored in a variable."
}], "Item",ExpressionUUID->"e1b53c33-05e5-470d-b8b3-5373af05d7be"],

Cell[TextData[{
 StyleBox["Part with lists",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["m[[{1, 3}, {2}]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " extracts the rows 1, 3 and the column 2 of a matrix; the same form on the \
left of ",
 StyleBox["=",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " assigns a block."
}], "Item",ExpressionUUID->"0f20c885-f776-4ba2-954b-201e3662429b"],

Cell[TextData[{
 StyleBox["Matrix algebra",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox[".",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " multiplies matrices (and vectors); ",
 StyleBox["Transpose",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Det",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["IdentityMatrix[n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " work on nested lists."
}], "Item",ExpressionUUID->"0ba688b5-16c3-4636-bc3d-ace8e3a831f5"],

Cell["Lesson 06 \[LongDash] Symmetries", "Section",ExpressionUUID->"cb388b86-e677-44a7-8d24-df365fd9de8d"],

Cell[TextData[{
 StyleBox["Multiple assignment",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["{a, b} = {1, 2}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " assigns element by element."
}], "Item",ExpressionUUID->"3cce5864-a911-4739-ae14-47d21ccadbc5"],

Cell[TextData[{
 StyleBox["Iterators that depend on each other",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Table[expr, {pr, pairs}, {m, 0, mf}, {n, 0, mp}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs over every combination; ",
 StyleBox["Flatten[t, 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes two levels of nesting."
}], "Item",ExpressionUUID->"3f52eea1-a716-4415-8812-2a47d851975d"],

Cell["Lesson 07 \[LongDash] Loops", "Section",ExpressionUUID->"17046749-13fa-4c7b-9614-1887b5139bfb"],

Cell[TextData[{
 StyleBox["Tr and exact constants",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Tr[m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the trace of a matrix; ",
 StyleBox["Pi",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["E",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["I",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are exact constants, never rounded."
}], "Item",ExpressionUUID->"39aa4a78-0f3a-47e5-a1bf-2b7871dbbed0"],

Cell["Lesson 08 \[LongDash] Projection", "Section",ExpressionUUID->"d774505f-8c00-45c6-9c65-1ac145f997f0"],

Cell[TextData[{
 StyleBox["Repeated derivatives",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["D[e, {x, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the n-th derivative of e in x; ",
 StyleBox["D[e, {x, n}, {y, m}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " mixes variables."
}], "Item",ExpressionUUID->"3daaff71-5c87-489e-8fde-5d6e8adaa427"],

Cell[TextData[{
 StyleBox["Special functions and products",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["k!!",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the double factorial, ",
 StyleBox["Product[f, {j, a, b}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " a product, ",
 StyleBox["Pochhammer[a, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " = a(a+1)",
 StyleBox["\[CenterEllipsis]",
  FontFamily->"Noto Sans"],
 "(a+n",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1), ",
 StyleBox["Gamma[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 " function; ",
 StyleBox["FunctionExpand",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " rewrites special values in elementary form."
}], "Item",ExpressionUUID->"b9ebd026-9623-4063-953f-37ba0d08b8f7"],

Cell[TextData[{
 StyleBox["Derivative of several arguments",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Derivative[i, j][f][x, y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["\[PartialD]\:2071",
  FontFamily->"Noto Sans"],
 "_x ",
 StyleBox["\[PartialD]\:02b2",
  FontFamily->"Noto Sans"],
 "_y f; a pattern ",
 StyleBox["Derivative[i_, j_][\[CapitalDelta]][w_, s_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches any such derivative."
}], "Item",ExpressionUUID->"31e46e2e-54e6-4208-a3a0-edc893cb7d37"],

Cell[TextData[{
 StyleBox["Nest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Nest[f, x, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f to x n times: ",
 StyleBox["f[f[f[x]]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for n = 3."
}], "Item",ExpressionUUID->"5492921d-6114-4651-8166-07c767f961e4"],

Cell[TextData[{
 StyleBox["SelectFirst and Missing",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["SelectFirst[list, test]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the first element that passes test, or ",
 StyleBox["Missing[\"NotFound\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["MissingQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tests for it."
}], "Item",ExpressionUUID->"4a0b23e1-7375-43d6-8456-9316019afe93"],

Cell["Lesson 09 \[LongDash] FrequencyIntegration", "Section",ExpressionUUID->"8839d18e-8131-46cf-bcb1-c946625722fb"],

Cell[TextData[{
 StyleBox["Numerator, Denominator and radicals",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Numerator[r]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Denominator[r]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " split a rational expression; a square root is ",
 StyleBox["Power[x, 1/2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", so ",
 StyleBox["FreeQ[r, Power[_, _Rational]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tests for radicals."
}], "Item",ExpressionUUID->"b07872c9-d573-43c5-96ea-debc2da00916"],

Cell[TextData[{
 StyleBox["Memoization of a function",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["f[n_, a_] := f[n, a] = ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stores each computed value as a new definition of f, so the next call with \
the same arguments returns it at once."
}], "Item",ExpressionUUID->"31207169-30ad-4bdb-babd-0ec641c27747"],

Cell[TextData[{
 StyleBox["CoefficientRules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["CoefficientRules[poly, {x, y, ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists the monomials of a polynomial as ",
 StyleBox["{exponents} -> coefficient",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"1996aac9-2ab2-4633-a43a-55526379b942"],

Cell[TextData[{
 StyleBox["Return from a loop",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Do[..., {j, 0, 199}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a loop; ",
 StyleBox["Return[value, Module]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " leaves the enclosing ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " at once with that value."
}], "Item",ExpressionUUID->"f9f7c27b-a484-4e91-998c-85e39b718b27"],

Cell["Lesson 10 \[LongDash] Closure", "Section",ExpressionUUID->"a5d8198f-2998-4d79-aa80-e1d14a2cf85f"],

Cell[TextData[{
 StyleBox["N and CForm",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["N[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a machine-precision approximation of an exact number; ",
 StyleBox["CForm[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes an expression as C code, here a compact number string."
}], "Item",ExpressionUUID->"a2b25c7a-8e45-4ce1-8aaa-07b07db1e835"],

Cell[TextData[{
 StyleBox["FactorTermsList",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["FactorTermsList[poly]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " pulls out the numeric factors: ",
 StyleBox["{number, ..., rest}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Item",ExpressionUUID->"c8d2b39d-6b52-47b9-a690-e63bd251e4a4"],

Cell[TextData[{
 StyleBox["Switch",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Switch[expr, form1, value1, form2, value2, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the value of the first form (a pattern) that expr matches."
}], "Item",ExpressionUUID->"90577c9c-d503-4f2f-8266-3e1fdbc164e9"],

Cell["Lesson 11 \[LongDash] Assemble", "Section",ExpressionUUID->"2ff631f0-8491-4ac1-9f71-dfc997a80e25"],

Cell[TextData[{
 StyleBox["Replace and ReplaceAll",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Replace[e, rule]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tries the rule on the whole of e only; ",
 StyleBox["e /. rule",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["ReplaceAll",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") tries every part."
}], "Item",ExpressionUUID->"e1d06e7f-77cc-4a55-aa1b-a0e045a9929a"],

Cell[TextData[{
 StyleBox["Collect and Factor",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Collect[e, vars, f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " groups e by powers of vars and applies f to each coefficient; ",
 StyleBox["Factor",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " factors a polynomial."
}], "Item",ExpressionUUID->"8256d493-457b-483c-9cf7-ba0101d3848a"],

Cell[TextData[{
 StyleBox["TimeConstrained",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["TimeConstrained[expr, t, alt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates expr for at most t seconds, and returns alt if time runs out."
}], "Item",ExpressionUUID->"3f5d4e5e-cdce-45ef-a368-6714d8adca32"],

Cell["Lesson 12 \[LongDash] OracleAndStages", "Section",ExpressionUUID->"9d185f9b-1164-4aef-b5f7-1540e646ca9b"],

Cell[TextData[{
 StyleBox["Arbitrary precision",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["N[x, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives n digits, in software arithmetic that tracks its own precision; ",
 StyleBox["Chop[x, eps]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces numbers smaller than eps by 0."
}], "Item",ExpressionUUID->"9468fff1-ebce-426b-ab1e-1d64e7fb173a"],

Cell[TextData[{
 StyleBox["NIntegrate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["NIntegrate[f, {x, a, b}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " integrates numerically; ",
 StyleBox["PrecisionGoal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["AccuracyGoal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " set the relative and absolute target, ",
 StyleBox["WorkingPrecision",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the digits used."
}], "Item",ExpressionUUID->"a275dfdf-f4db-444d-97d1-b0e214b1bb99"],

Cell[TextData[{
 StyleBox["Export and Import",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Export[file, expr, \"WDX\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes any expression in Mathematica's binary format; ",
 StyleBox["Import[file, \"WDX\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads it back identically."
}], "Item",ExpressionUUID->"007f51ad-f363-456f-ae39-718c0f4c2730"],

Cell["Lesson 13 \[LongDash] Dimensions", "Section",ExpressionUUID->"0f2a1526-d63c-4c68-9dbb-b1230110851a"],

Cell[TextData[{
 StyleBox["Linear algebra",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["NullSpace[m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a basis of the solutions of m.x = 0; ",
 StyleBox["MatrixRank[m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the rank; ",
 StyleBox["LinearSolve[m, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " solves m.x = b."
}], "Item",ExpressionUUID->"b68ea7f3-6ba3-4673-91de-469cc9d705e5"],

Cell[TextData[{
 StyleBox["Unique and LCM",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Unique[\"x\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " creates a new symbol never used before (x1, x2, ...); ",
 StyleBox["LCM",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the least common multiple."
}], "Item",ExpressionUUID->"2e9f1eec-ec84-4e17-bcce-764dddf18306"],

Cell[TextData[{
 StyleBox["PowerExpand and Log",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["PowerExpand[Log[x^a y^b]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives ",
 StyleBox["a Log[x] + b Log[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", assuming positive quantities."
}], "Item",ExpressionUUID->"962514e2-30b2-4417-9d61-372b38504d2b"],

Cell["Lesson 14 \[LongDash] Adimensional", "Section",ExpressionUUID->"dcf7cf9b-dfdf-479e-ab28-3ec754618fec"],

Cell[TextData[{
 StyleBox["Catch and Throw",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Throw[value, tag]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " jumps out of any depth of evaluation to the enclosing ",
 StyleBox["Catch[expr, tag]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which returns value."
}], "Item",ExpressionUUID->"20245064-e26b-4d12-a08b-10e0c9df1ff6"],

Cell[TextData[{
 StyleBox["CoefficientArrays",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["CoefficientArrays[{p1, p2, ...}, {x1, x2, ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes linear (or polynomial) equations as ",
 StyleBox["{b, m, ...}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with p = b + m.x + ..."
}], "Item",ExpressionUUID->"e8f7e463-ee8b-4976-bc02-f6cc558e84dd"],

Cell["Lesson 15 \[LongDash] JuliaExport", "Section",ExpressionUUID->"f09ad6e1-78cc-43b3-a273-dade3e7a559a"],

Cell[TextData[{
 StyleBox["Expressions as text",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["ToString[e, InputForm, PageWidth -> Infinity]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " prints e on one line in input syntax; ",
 StyleBox["StringReplace[s, {\"a\" -> \"b\", ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " rewrites the text; ",
 StyleBox["RegularExpression[\"...\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches by a regex."
}], "Item",ExpressionUUID->"d491858b-813e-4f7e-9aa3-f3d977012f5e"],

Cell[TextData[{
 StyleBox["Building text",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["Riffle[list, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " inserts x between the elements; ",
 StyleBox["StringRiffle[list, sep]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " joins strings; ",
 StyleBox["DateString[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " formats the date; ",
 StyleBox["Export[file, string, \"Text\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes text; ",
 StyleBox["CreateDirectory",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes a folder."
}], "Item",ExpressionUUID->"27370866-fadc-4a16-af10-f499d31fc2a7"],

Cell["Lesson 16 \[LongDash] Tests", "Section",ExpressionUUID->"6f456b19-9fd0-4c96-abf4-025c4fbf2b5f"],

Cell[TextData[{
 StyleBox["RunProcess",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "  \[LongDash]  ",
 StyleBox["RunProcess[{\"cmd\", \"arg\", ...}, \"StandardOutput\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs an external program and returns what it printed."
}], "Item",ExpressionUUID->"b122a38a-ebba-4b10-a4d3-88b068a41ea6"]
},

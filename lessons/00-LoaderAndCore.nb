Notebook[{
Cell["Lesson 00 - The loader and Core", "Title",ExpressionUUID->"a66c8720-4634-4a10-abbc-fed17abc7dad"],

Cell["\<\
This is the first of a series of lessons, one per module, in the order the \
library loads them. Each lesson explains how its module works inside: which \
Mathematica tools it uses, how, and why the code is organised that way.\
\>", "Text",ExpressionUUID->"39e37087-c2ec-44e6-9988-9ed4aca1eeb4"],

Cell[TextData[{
 "Three kinds of boxes recur. A blue ",
 StyleBox["Mathematica",
  FontWeight->Bold],
 " box explains a command or practice the first time it appears; later \
lessons point back to it, and ",
 StyleBox["Glossary.nb",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists them all. A grey ",
 StyleBox["Why it's built this way",
  FontWeight->Bold],
 " box explains an architectural choice and names the alternative that was \
rejected. ",
 StyleBox["Exercises",
  FontWeight->Bold],
 " close each lesson; their solutions are folded (click the cell bracket of \
\"Solution\" to open them)."
}], "Text",ExpressionUUID->"51e2b960-16e6-4e19-ae47-ecbc64aa4262"],

Cell[TextData[{
 "Core does no physics. It is the machinery every stage relies on: failing \
checks, stages and their fingerprints, exact zero tests, the user-symbol \
checks, and the scalar product ",
 StyleBox["scal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Every later lesson uses it, which is why it comes first."
}], "Text",ExpressionUUID->"b83e2e3a-6c0f-4664-a848-bed74107b636"],

Cell["1. Loading the library", "Section",ExpressionUUID->"47565c03-cb29-472c-91f5-ae5ef337d6eb"],

Cell["Get[\"~/Physics/Sources/FRGscalarMSR/FRGscalarMSR.wl\"]", "Input",ExpressionUUID->"ba9dddc7-362c-4063-921e-8e62f1e9609a"],

Cell[TextData[{
 StyleBox["Mathematica: Get",
  FontWeight->Bold],
 "\n",
 StyleBox["Get[file]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (or ",
 StyleBox["<< file",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") reads a file and evaluates every expression in it, in order.",
 "\n\n",
 "A ",
 StyleBox[".wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " file is just a sequence of Mathematica expressions. ",
 StyleBox["Get",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " parses them one by one and evaluates each, exactly as if you had typed \
them into cells. Definitions made in the file stay defined afterwards. ",
 StyleBox["Get",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the value of the last expression (here ",
 StyleBox["Null",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", because the last line is a ",
 StyleBox["Print",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"4b830eb8-c5a3-47cf-9d44-56c741d74a93"],

Cell[TextData[{
 "The lessons also need two small helpers of their own, ",
 StyleBox["lessonUpTo",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["showFailure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". They live in ",
 StyleBox["lessons/LessonSetup.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; we will read them when we use them."
}], "Text",ExpressionUUID->"f7079ea1-f956-4031-8390-d0ab380ed29f"],

Cell["Get[FileNameJoin[{$FRGRoot, \"lessons\", \"LessonSetup.wl\"}]]", "Input",ExpressionUUID->"ba2766e1-45b4-4b5d-8868-06ff5b4fd40b"],

Cell["Here is the loader in full:", "Text",ExpressionUUID->"48d7c9b8-4cb3-408f-a703-5d0a72764463"],

Cell["\<\
(* FRGscalarMSR.wl:1-22 *)
(* ::Package:: *)

(* FRGscalarMSR -- Wetterich flow equations for N MSR scalars, \
derivative-expansion pipeline.
   Load from a notebook or a script with
       Get[\"~/Physics/Sources/FRGscalarMSR/FRGscalarMSR.wl\"]
   Modules are documented in docs/MODULES.md, conventions in \
docs/CONVENTIONS.md. *)

(* reloading: drop the previous definitions (several symbols are Protected) \
*)
If[MemberQ[Contexts[], \"FRGscalarMSR`\"],
  Unprotect[\"FRGscalarMSR`*\", \"FRGscalarMSR`Internal`*\"];
  ClearAll[\"FRGscalarMSR`*\", \"FRGscalarMSR`Internal`*\"]];

FRGscalarMSR`$FRGRoot = DirectoryName[$InputFileName];
FRGscalarMSR`$FRGVersion = \"1.0.0\";

(* load order matters: each module only uses the ones above it *)
FRGscalarMSR`$FRGModules = {\"Core\", \"Theory\", \"Ansatz\", \"Vertices\", \
\"Regulator\", \"Propagator\", \"Symmetries\", \"Loops\", \"Projection\", \
\"FrequencyIntegration\", \"Closure\", \"Assemble\", \"Oracle\", \"Stages\", \
\"Dimensions\", \"Adimensional\", \"JuliaExport\"};

Scan[Get[FileNameJoin[{FRGscalarMSR`$FRGRoot, \"Kernel\", # <> \".wl\"}]] &, \
FRGscalarMSR`$FRGModules];

Print[\"FRGscalarMSR \", FRGscalarMSR`$FRGVersion, \" -- modules: \", \
StringRiffle[FRGscalarMSR`$FRGModules, \", \"]];
Print[\"WARNING: Ward identities are assumed (user-declared), not derived.\"];\
\>", "Program",ExpressionUUID->"bff64815-cb66-47ab-8044-bdfb340120ec"],

Cell[TextData[{
 "The first line, ",
 StyleBox["(* ::Package:: *)",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", is a comment: the kernel ignores it, but the front end reads it and opens \
the file in its package editor rather than as a notebook. Everything between ",
 StyleBox["(*",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["*)",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a comment."
}], "Text",ExpressionUUID->"f6d764cf-c38a-4dbc-877f-a430b79d1793"],

Cell[TextData[{
 StyleBox["Mathematica: Symbols and contexts",
  FontWeight->Bold],
 "\n",
 "Every symbol has a full name ",
 StyleBox["context`name",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; short names are looked up in ",
 StyleBox["$Context",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", then in ",
 StyleBox["$ContextPath",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ".",
 "\n\n",
 "Each name you type, like ",
 StyleBox["DefineTheory",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " or ",
 StyleBox["h",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", is a ",
 StyleBox["symbol",
  FontWeight->Bold],
 ". Its full name has a context prefix ending in a backquote: ",
 StyleBox["FRGscalarMSR`DefineTheory",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Global`h",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". When you type a short name, Mathematica looks for it first in the current \
context ",
 StyleBox["$Context",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Global`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " in a notebook), then in each context of the list ",
 StyleBox["$ContextPath",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". If it finds nothing, it creates a new symbol in ",
 StyleBox["$Context",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Contexts are Mathematica's namespaces: two packages can both have a \
symbol called ",
 StyleBox["rank",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " without clashing, as long as they live in different contexts."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"f1372112-9b1e-4cde-a1a6-b30e2b66515f"],

Cell["{$Context, $ContextPath, Context[DefineTheory]}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"8bbabf39-405e-439d-adbb-7a39c28dcdcb"],

Cell[TextData[{
 "In these lesson notebooks ",
 StyleBox["$Context",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is not ",
 StyleBox["Global`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " but a context private to each notebook (the builder sets the notebook \
option ",
 StyleBox["CellContext -> Notebook",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), so the variables of one lesson do not leak into another. Run headless, \
as ",
 StyleBox["examples/runNotebook.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " does, they live in ",
 StyleBox["Global`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"94e5b211-5174-4299-89e4-911a0d81cd07"],

Cell[TextData[{
 StyleBox["Mathematica: Set and SetDelayed",
  FontWeight->Bold],
 "\n",
 StyleBox["x = rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates rhs now and stores the result; ",
 StyleBox["f[x_] := rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stores rhs unevaluated and evaluates it at every use.",
 "\n\n",
 StyleBox["FRGscalarMSR`$FRGRoot = DirectoryName[$InputFileName]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a ",
 StyleBox["Set",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": the folder of the file is computed once, at load time, and stored. A ",
 StyleBox["SetDelayed",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox[":=",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") stores the right-hand side as it is written; it is what you use to define \
functions, whose body must be evaluated afresh for each argument. Note that \
the loader writes the full name ",
 StyleBox["FRGscalarMSR`$FRGRoot",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": at that point no package context has been opened yet, so a short name \
would create ",
 StyleBox["Global`$FRGRoot",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"149d33ef-52ba-4192-95e1-c0a179196731"],

Cell[TextData[{
 StyleBox["$InputFileName",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the path of the file currently being read by ",
 StyleBox["Get",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Using it, the library finds its own ",
 StyleBox["Kernel/",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " folder wherever it is installed."
}], "Text",ExpressionUUID->"d4518a4b-7736-49b9-b038-113e1fd64a87"],

Cell[TextData[{
 "The reload guard at the top runs only if the library was loaded before. ",
 StyleBox["Contexts[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists every context that exists, and ",
 StyleBox["MemberQ[list, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tests whether ",
 StyleBox["x",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is in the list."
}], "Text",ExpressionUUID->"e9450407-92f2-4d62-9a7d-ceb19a5bb39e"],

Cell[TextData[{
 StyleBox["Mathematica: Attributes and Protected",
  FontWeight->Bold],
 "\n",
 "Attributes are flags on a symbol that change how it evaluates; ",
 StyleBox["Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " forbids new definitions.",
 "\n\n",
 StyleBox["SetAttributes[f, attr]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " attaches a flag. ",
 StyleBox["Protected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes a symbol read-only: any ",
 StyleBox["f[...] := ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " fails with a message. The library protects the symbols the user writes in \
input (",
 StyleBox["dt",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["grad",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["FixedDimension",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ...) so that nobody accidentally gives them a meaning. ",
 StyleBox["Unprotect",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes the flag. ",
 StyleBox["ClearAll[\"FRGscalarMSR`*\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes the values, definitions, attributes and options of every symbol \
whose full name matches the string pattern."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"509e005a-6f6a-406d-9f7b-a9de622cc17d"],

Cell[TextData[{
 StyleBox["Why it's built this way: Reloading starts from a clean slate",
  FontWeight->Bold],
 "\n\n",
 "Definitions in Mathematica accumulate. If a function was defined as ",
 StyleBox["f[x_Integer] := ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and the new version of the file says ",
 StyleBox["f[x_] := ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", after a plain reload both rules exist, and the old one still wins for \
integers. Clearing every library symbol before reading the files again \
guarantees that what runs is exactly what is in the files. The ",
 StyleBox["Unprotect",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is needed because ",
 StyleBox["ClearAll",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " cannot touch protected symbols."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"a972a353-bf3a-4ae5-8181-81bd3aee5762"],

Cell[TextData[{
 StyleBox["$FRGModules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists the module files. ",
 StyleBox["Scan",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads them in that order."
}], "Text",ExpressionUUID->"ece388ad-766e-4dd6-b653-a827413abc57"],

Cell[TextData[{
 StyleBox["Mathematica: Pure functions",
  FontWeight->Bold],
 "\n",
 StyleBox["body &",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is an anonymous function; ",
 StyleBox["#",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is its argument (",
 StyleBox["#1",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["#2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ... for several).",
 "\n\n",
 StyleBox["Get[FileNameJoin[{FRGscalarMSR`$FRGRoot, \"Kernel\", # <> \
\".wl\"}]] &",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a function of one argument ",
 StyleBox["#",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": given ",
 StyleBox["\"Core\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", it reads ",
 StyleBox[".../Kernel/Core.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["<>",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " joins strings (",
 StyleBox["StringJoin",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). ",
 StyleBox["Function[x, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the same thing with a named argument."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"c197ff22-22c9-416a-ba8b-baafcd6ca021"],

Cell["(# <> \".wl\" &) /@ {\"Core\", \"Theory\"}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"547d2d84-904d-4fe5-b8a9-c91076eaf2ef"],

Cell[TextData[{
 StyleBox["Mathematica: Map and Scan",
  FontWeight->Bold],
 "\n",
 StyleBox["Map[f, list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["f /@ list",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") returns the list of results; ",
 StyleBox["Scan[f, list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f only for its side effects and returns nothing.",
 "\n\n",
 "The loader uses ",
 StyleBox["Scan",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " because it wants the effect of each ",
 StyleBox["Get",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (the definitions), not the return values. ",
 StyleBox["/@",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the short form of ",
 StyleBox["Map",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"d1e976b0-197f-4ef4-ba2d-e7f1bbb9d072"],

Cell[TextData[{
 StyleBox["Why it's built this way: One file per stage, loaded in a fixed \
order",
  FontWeight->Bold],
 "\n\n",
 "Each module may use only the modules listed above it in ",
 StyleBox["$FRGModules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". The dependencies therefore form a line, not a web: Core uses nothing, \
Theory uses Core, Ansatz uses Theory and Core, and so on. This has three \
consequences. There are no circular dependencies. You can understand the \
modules one at a time in load order, which is the order of these lessons. And \
a module can be tested on its own with the stages built by the modules before \
it (",
 StyleBox["tests/unit/",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). The rejected alternative is a single large file, as in the older ",
 StyleBox["DE4plus_fast.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", where any helper can depend on any other (",
 StyleBox["design/FRGDESIGN.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", decision Q8)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"f52fb5e0-a785-434a-be85-6a80ed39a740"],

Cell["2. Packages: public, internal and private names", "Section",ExpressionUUID->"0e30e2bb-59d8-4086-bba4-b48cee0948ba"],

Cell["\<\
Every module starts and ends the same way. This is the top of Core:\
\>", "Text",ExpressionUUID->"60c4dedb-397b-40a9-b241-a188fd6d3c22"],

Cell["\<\
(* Kernel/Core.wl:7-38 *)
BeginPackage[\"FRGscalarMSR`Internal`\"];
assertCheck::usage = \"assertCheck[name, cond, details, hint, summary] runs \
FRGAssert and returns a check record for a stage card.\";
infoCheck::usage = \"infoCheck[status, name, summary] is a non-failing card \
line (\\\"WARN\\\", \\\"INFO\\\", \\\"ASSUMPTION\\\").\";
stampStage::usage = \"stampStage[assoc] adds the \\\"Fingerprint\\\" key \
(hash of the stage content).\";
validateStage::usage = \"validateStage[stage, name] asserts the stage key and \
fingerprint of an upstream stage.\";
reservedNames::usage = \"reservedNames: symbol names the user may not use for \
fields or couplings.\";
assertFreshSymbols::usage = \"assertFreshSymbols[check, syms, what] asserts \
that user symbols are usable as fields / couplings.\";
inputForm::usage = \"inputForm[e, n] is a short one-line InputForm string of \
e.\";
displayString::usage = \"displayString[e] is a full one-line InputForm string \
of e without package contexts; scal[a, a] -> a^2, scal[a, b] -> a.b, \\
wedge[a, b] -> wedge(a,b).\";
reduceWedge2D::usage = \"reduceWedge2D[e] rewrites every product of two \
wedges by the d = 2 identity \\
wedge[a,b] wedge[c,d] = scal[a,c] scal[b,d] - scal[a,d] scal[b,c] until each \
term of the expanded e has at most one wedge.\";
EndPackage[];

BeginPackage[\"FRGscalarMSR`\", {\"FRGscalarMSR`Internal`\"}];

FRGAssert::usage = \"FRGAssert[name, cond, details, hint] returns name if \
cond is True; otherwise prints a red FAIL block \\
(check, module, short offending expression, hint), sets $FRGLastFailure = \
name and aborts (Exit[2] in a math -script run).\";
$FRGLastFailure::usage = \"$FRGLastFailure is the name of the last check that \
failed (diagnostic only).\";
$FRGModule::usage = \"$FRGModule is the module name printed in FAIL blocks \
(set with Block by each constructor).\";
$FRGExitOnFail::usage = \"$FRGExitOnFail: if True a failed check calls \
Exit[2] instead of Abort[] (default: True in math -script runs).\";
ExactlyZeroQ::usage = \"ExactlyZeroQ[expr] is True iff expr vanishes exactly \
at several random rational points: every non-System \\
symbol (couplings, q, k, Dim, ...) gets an independent random rational, and \
every remaining function atom r[y], r'[y], r''[y], \\
f[...], f[a][y], Derivative[k][f[a]][y] (as a whole) gets its own independent \
random rational (same atom, same value). Option \\\"Seeds\\\" -> {1, 2, \
3}.\";
RandomRationalPoint::usage = \"RandomRationalPoint[syms, seed] gives rules \
sym -> random rational in (0, 1), reproducible from seed.\";
PrintCard::usage = \"PrintCard[stage] prints the stage summary card: \
PASS/WARN/INFO/ASSUMPTION lines, LeafCount, timing, fingerprint.\";
scal::usage = \"scal[a, b] is the scalar product of the vectors a, b (bare \
symbols). Orderless; linear over sums and over \\
explicit numbers only (not over couplings).\";
wedge::usage = \"wedge[a, b] = eps_ij a_i b_j (d = 2, eps_12 = +1) of the \
vectors a, b (bare symbols). Antisymmetric (canonical \\
order, not Orderless), wedge[a, a] = 0; linear over sums and over explicit \
numbers only.\";

Begin[\"`Private`\"];\
\>", "Program",ExpressionUUID->"42d5a814-fc8b-46dd-b4c6-92626e2700ea"],

Cell[TextData[{
 StyleBox["Mathematica: BeginPackage, Begin, End, EndPackage",
  FontWeight->Bold],
 "\n",
 "The four commands that give a package its public and private namespaces.",
 "\n\n",
 StyleBox["BeginPackage[\"FRGscalarMSR`\", {\"FRGscalarMSR`Internal`\"}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes ",
 StyleBox["FRGscalarMSR`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the current context and sets ",
 StyleBox["$ContextPath",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " to just that context, the listed ones, and ",
 StyleBox["System`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Every symbol ",
 StyleBox["mentioned",
  FontSlant->Italic],
 " from now on is created in ",
 StyleBox["FRGscalarMSR`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": these are the public names. ",
 StyleBox["Begin[\"`Private`\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " switches to the sub-context ",
 StyleBox["FRGscalarMSR`Private`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (the leading backquote means \"relative to the current context\"); symbols \
first mentioned after it, such as helper functions, are created there. ",
 StyleBox["End[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " goes back, and ",
 StyleBox["EndPackage[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " restores the previous ",
 StyleBox["$Context",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and puts ",
 StyleBox["FRGscalarMSR`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " at the front of ",
 StyleBox["$ContextPath",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", so its public symbols are visible to you by their short names."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"6f9f2f15-5257-4057-8b18-d32b86a0bc1f"],

Cell[TextData[{
 StyleBox["Mathematica: Usage messages",
  FontWeight->Bold],
 "\n",
 StyleBox["f::usage = \"text\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " attaches help text to f; ",
 StyleBox["?f",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " shows it.",
 "\n\n",
 "In a package, the usage line has a second job: it is the first mention of \
the symbol, so it creates the symbol in the public context, before ",
 StyleBox["Begin[\"`Private`\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". The list of usage messages at the top of each module ",
 StyleBox["is",
  FontSlant->Italic],
 " its public interface."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"66b1d156-473e-49a9-9fa7-b3a7f65925f4"],

Cell["?FRGAssert", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"4360a768-416c-403c-953e-f6cffbbbaf1e"],

Cell[TextData[{
 "Core actually opens two packages. The first, ",
 StyleBox["FRGscalarMSR`Internal`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", holds helpers that the modules share with each other but that are not \
meant for you (",
 StyleBox["assertCheck",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["stampStage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["validateStage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ...). The second, ",
 StyleBox["FRGscalarMSR`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", holds the public names. Later modules list ",
 StyleBox["FRGscalarMSR`Internal`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " among the contexts they need, so they can use the internal helpers by \
their short names."
}], "Text",ExpressionUUID->"5c9e7d7e-bce9-41f1-a188-0962c341ef91"],

Cell["\<\
{Context[FRGAssert], Context[assertCheck], MemberQ[$ContextPath, \
\"FRGscalarMSR`Internal`\"]}\
\>", "Input",ExpressionUUID->"73311874-438d-4f85-85af-0832a2ebffa0"],

Cell[TextData[{
 "Note the last answer: ",
 StyleBox["True",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". The comment in ",
 StyleBox["Kernel/Core.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " says the internal helpers are \"not on the user's $ContextPath\", but they \
are, because the first ",
 StyleBox["EndPackage[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " puts ",
 StyleBox["FRGscalarMSR`Internal`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " on ",
 StyleBox["$ContextPath",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " like any package. In practice this means you can call ",
 StyleBox["assertCheck",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " or ",
 StyleBox["stampStage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " from a notebook (we will, in section 4), and that a symbol of yours called \
",
 StyleBox["inputForm",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " would refer to the library's helper."
}], "Text",ExpressionUUID->"635468c9-d712-4675-9b4f-8e70570499ba"],

Cell[TextData[{
 "The private parts of all modules share one context. Every module calls ",
 StyleBox["Begin[\"`Private`\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " inside ",
 StyleBox["BeginPackage[\"FRGscalarMSR`\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", so all helpers land in ",
 StyleBox["FRGscalarMSR`Private`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ":"
}], "Text",ExpressionUUID->"cababf22-1665-4b35-bab1-77d2392b57e7"],

Cell["Length[Names[\"FRGscalarMSR`Private`*\"]]", "Input",ExpressionUUID->"fde5fd9e-76e8-46e2-ad84-277418e15e6c"],

Cell[TextData[{
 StyleBox["Names[\"pattern\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the names of all symbols matching a string pattern."
}], "Text",ExpressionUUID->"1e6156b4-fa21-441f-bf6e-ec29af985476"],

Cell[TextData[{
 StyleBox["Why it's built this way: Three layers of names",
  FontWeight->Bold],
 "\n\n",
 "The user's symbols (",
 StyleBox["h",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["nuk",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Dim",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") live in ",
 StyleBox["Global`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the API in ",
 StyleBox["FRGscalarMSR`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the shared plumbing in ",
 StyleBox["FRGscalarMSR`Internal`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and the implementation in ",
 StyleBox["FRGscalarMSR`Private`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". A helper called ",
 StyleBox["rank",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " never clashes with a coupling you call ",
 StyleBox["rank",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". The library made one compromise: a single private context for all modules \
instead of one per module (",
 StyleBox["FRGscalarMSR`Ansatz`Private`",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ...). It is simpler, but a helper defined in one module is visible to, \
and can be overwritten by, every other. That is why CLAUDE.md asks for \
distinctive helper names (the Regulator's ",
 StyleBox["sq",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the example given there)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"3357db9f-e2f9-4880-aa44-5aa8ab7d2938"],

Cell["3. Failing loudly: FRGAssert", "Section",ExpressionUUID->"c4c6e5fa-7d20-4837-958c-eab081e05cda"],

Cell["Every check in the library goes through one function:", "Text",ExpressionUUID->"3cd456eb-c3ae-47f2-bd05-9c7b118f13e8"],

Cell["\<\
(* Kernel/Core.wl:53-59 *)
failBlock[name_, details_, hint_] := Module[{lines},
   lines = {\"FAIL  check: \" <> ToString[name] <> \"   module: \" <> \
ToString[$FRGModule],
     \"      offending: \" <> inputForm[details, 4],
     \"      hint: \" <> ToString[hint]};
   If[$FrontEnd === Null,
    Scan[Print, lines],
    Print[Framed[Column[Style[#, Red, If[# === First[lines], Bold, Plain]] & \
/@ lines], FrameStyle -> Red]]]];\
\>", "Program",ExpressionUUID->"fc591480-3e50-4d2e-ab9a-32222ffa42a8"],

Cell["\<\
(* Kernel/Core.wl:61-66 *)
SetAttributes[FRGAssert, HoldRest];
FRGAssert[name_, cond_, details_, hint_ : \"\"] :=
  If[TrueQ[cond], name,
   failBlock[name, details, hint];
   $FRGLastFailure = name;
   If[TrueQ[$FRGExitOnFail], Exit[2], Abort[]]];\
\>", "Program",ExpressionUUID->"8ca3375f-fa74-4a55-bc59-8baf58e387fc"],

Cell[TextData[{
 StyleBox["Mathematica: Patterns",
  FontWeight->Bold],
 "\n",
 StyleBox["x_",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches any expression and names it x; ",
 StyleBox["x_h",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " only expressions with head h; ",
 StyleBox["x_ : d",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is optional with default d; ",
 StyleBox["patt /; cond",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " adds a condition.",
 "\n\n",
 "The left-hand side of a definition is a ",
 StyleBox["pattern",
  FontWeight->Bold],
 ". ",
 StyleBox["FRGAssert[name_, cond_, details_, hint_ : \"\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches a call with three or four arguments; inside the body, ",
 StyleBox["name",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["cond",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ... stand for whatever was passed. ",
 StyleBox["hint_ : \"\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes the fourth argument optional. The ",
 StyleBox["head",
  FontWeight->Bold],
 " of an expression is what stands before the brackets: the head of ",
 StyleBox["f[1, 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["f",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", of ",
 StyleBox["a + b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["Plus",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", of ",
 StyleBox["{1, 2}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["List",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". So ",
 StyleBox["e_Plus",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches only sums. A definition is really a rule \"rewrite anything that \
matches this pattern into this\", which Mathematica stores and applies \
automatically."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"1d440012-5706-4639-a3c5-8d0a122ffcc4"],

Cell["\<\
f[x_Integer] := \"integer\"; f[x_] := \"something else\"; {f[3], f[3.5], f[a \
+ b]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"763571b6-8f1d-4bcc-acac-093f998ecfb9"],

Cell[TextData[{
 StyleBox["Mathematica: Hold attributes",
  FontWeight->Bold],
 "\n",
 StyleBox["HoldAll",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["HoldFirst",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["HoldRest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stop Mathematica from evaluating some arguments before the function sees \
them.",
 "\n\n",
 "Normally Mathematica evaluates every argument first, then calls the \
function. ",
 StyleBox["SetAttributes[FRGAssert, HoldRest]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " keeps all arguments but the first unevaluated. Inside the body, ",
 StyleBox["cond",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is evaluated where it is used, inside ",
 StyleBox["TrueQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["details",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["hint",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are evaluated only when ",
 StyleBox["failBlock",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is called, that is, only when the check fails."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"9f81860b-b5b7-4b02-b676-25b4ea161bd7"],

Cell["\<\
g[x_] := \"done\"; SetAttributes[g2, HoldAll]; g2[x_] := \"done\";
{g[Print[\"evaluated\"]], g2[Print[\"not evaluated\"]]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"18703d33-b013-48bf-9c44-51ef7f2f0a28"],

Cell[TextData[{
 "The library uses ",
 StyleBox["HoldRest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for speed: ",
 StyleBox["details",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is often something like ",
 StyleBox["Select[monomials, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " over a large list, and on success it should cost nothing."
}], "Text",ExpressionUUID->"14d93396-5202-47e7-88b3-06964f1576fc"],

Cell[TextData[{
 StyleBox["Mathematica: If and TrueQ",
  FontWeight->Bold],
 "\n",
 StyleBox["If[c, a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a if c is True, b if c is False, and stays unevaluated otherwise; ",
 StyleBox["TrueQ[c]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True only if c is literally True.",
 "\n\n",
 "In Mathematica a condition can be neither true nor false: ",
 StyleBox["nuk > 0",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stays as it is when ",
 StyleBox["nuk",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " has no value, and ",
 StyleBox["If[nuk > 0, a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " then returns itself unevaluated. ",
 StyleBox["TrueQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns \"undecided\" into ",
 StyleBox["False",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". For a check this is the safe choice: a condition the library cannot \
decide is a failed check, not a passed one."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"b9e29717-7760-41f2-a21d-faef37d11576"],

Cell["{If[nuk > 0, \"yes\", \"no\"], TrueQ[nuk > 0]}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"b3e2e6bf-2898-4c8d-9be9-6fe3e7500530"],

Cell["A check that holds returns its name:", "Text",ExpressionUUID->"0950135c-9814-4cd2-b001-dbe8ae885610"],

Cell["FRGAssert[\"Demo.positive\", 3 > 0, \"never computed\"]", "Input",ExpressionUUID->"07b6d261-42bd-487c-8b15-039121876944"],

Cell[TextData[{
 "A failing check prints its FAIL block and aborts. In this notebook we wrap \
it in ",
 StyleBox["showFailure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which shows the block and returns the name of the check instead of \
stopping:"
}], "Text",ExpressionUUID->"4593476b-7a11-4934-8933-817745343e06"],

Cell["\<\
showFailure[FRGAssert[\"Demo.positive\", -3 > 0, {-3}, \"the number must be \
positive\"]]\
\>", "Input",ExpressionUUID->"a148593e-b390-4d73-b78d-a864a9316be6"],

Cell[TextData[{
 StyleBox["Mathematica: Abort, CheckAbort, Exit",
  FontWeight->Bold],
 "\n",
 StyleBox["Abort[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stops the whole evaluation; ",
 StyleBox["CheckAbort[expr, alt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " catches an abort inside expr and returns alt; ",
 StyleBox["Exit[n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " quits the kernel with exit code n.",
 "\n\n",
 StyleBox["Abort[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " unwinds every function call back to the top level; the cell prints ",
 StyleBox["$Aborted",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Nothing downstream runs. ",
 StyleBox["CheckAbort",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the only way to catch it. ",
 StyleBox["Exit[2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " ends the kernel process itself; the library uses it when it runs as a \
script (",
 StyleBox["math -script",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), so the shell sees a non-zero exit code. ",
 StyleBox["$FRGExitOnFail",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " chooses between the two: ",
 StyleBox["$FrontEnd === Null",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True when no front end is attached, and ",
 StyleBox["$CommandLine",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " holds the command-line arguments."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"8c7eb91e-bd04-4aa3-9a47-f6f0ee2ee9a1"],

Cell[TextData[{
 "Here is ",
 StyleBox["showFailure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ":"
}], "Text",ExpressionUUID->"9e9b46f4-5ed7-42f9-88f1-b225bf3a7bb0"],

Cell["\<\
(* lessons/LessonSetup.wl:46-50 *)
(* A failed check calls Exit[2] in a math -script run ($FRGExitOnFail); Block \
turns that into Abort[] for the duration of
   expr, and CheckAbort catches the abort, so a lesson cell can show a FAIL \
block without stopping the notebook. *)
SetAttributes[showFailure, HoldAll];
showFailure[expr_] := Block[{$FRGExitOnFail = False}, $FRGLastFailure = None;
   CheckAbort[expr; Print[\"showFailure: no check failed\"]; None, \
$FRGLastFailure]];\
\>", "Program",ExpressionUUID->"52151290-1d46-4dfb-8e6e-d31df32f2ab3"],

Cell[TextData[{
 StyleBox["Mathematica: Block and Module",
  FontWeight->Bold],
 "\n",
 StyleBox["Module[{x}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " creates a fresh local x seen only by the code written inside; ",
 StyleBox["Block[{x = v}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " temporarily gives the existing x the value v, seen by every function \
called from body.",
 "\n\n",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["lexical",
  FontWeight->Bold],
 " scoping: ",
 StyleBox["Module[{x}, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " renames ",
 StyleBox["x",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " to a unique ",
 StyleBox["x$123",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", so only the text inside the ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " can refer to it. ",
 StyleBox["Block",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["dynamic",
  FontWeight->Bold],
 " scoping: during the evaluation of the body, the global symbol itself has \
the new value, for every function that runs, however deep, and the old value \
comes back afterwards. ",
 StyleBox["showFailure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " uses ",
 StyleBox["Block",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " on ",
 StyleBox["$FRGExitOnFail",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " because ",
 StyleBox["FRGAssert",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", called deep inside some constructor, must see the changed value. Every \
constructor does the same with ",
 StyleBox["Block[{$FRGModule = \"Theory\"}, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which is how ",
 StyleBox["failBlock",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " knows which module to print."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"087fa106-ccad-4d1a-9730-de87279d6db6"],

Cell["\<\
yy = \"global\"; show[] := yy;
{Module[{yy = \"module\"}, show[]], Block[{yy = \"block\"}, show[]], yy}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"f29f92a8-58d5-4bcc-a07f-e726aad17eee"],

Cell[TextData[{
 StyleBox["failBlock",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " prints plain lines in a script and a red framed column in a notebook. \
Constructors do not call ",
 StyleBox["FRGAssert",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " directly for the checks they report; they call ",
 StyleBox["assertCheck",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which asserts and then returns a small record for the stage's card:"
}], "Text",ExpressionUUID->"1a2905bd-d8cf-4081-8802-75d72dfa9478"],

Cell["\<\
(* Kernel/Core.wl:68-71 *)
SetAttributes[assertCheck, HoldRest];
assertCheck[name_, cond_, details_, hint_, summary_ : \"\"] := \
(FRGAssert[name, cond, details, hint];
   <|\"Status\" -> \"PASS\", \"Check\" -> name, \"Detail\" -> summary|>);
infoCheck[status_String, name_, summary_ : \"\"] := <|\"Status\" -> status, \
\"Check\" -> name, \"Detail\" -> summary|>;\
\>", "Program",ExpressionUUID->"7ea0f02e-eef0-4294-b00f-b81f98cefbab"],

Cell[TextData[{
 StyleBox["Why it's built this way: Named checks that abort",
  FontWeight->Bold],
 "\n\n",
 "The library is meant to be read as a set of grey boxes: you read the cards \
and the FAIL blocks, not the code. A failure therefore has a name (",
 StyleBox["Ansatz.MSR",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Stage.fingerprint",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") that you can look up in ",
 StyleBox["docs/MODULES.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the offending part of the input, and a hint. It then aborts. \
Mathematica's own convention is different: a function that fails prints a \
message and returns unevaluated or ",
 StyleBox["$Failed",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and evaluation continues. In a pipeline whose expressions reach a million \
leaves, that convention lets a wrong intermediate result travel silently into \
the flow equations. Aborting stops at the first wrong step. ",
 StyleBox["Exit[2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes the same failure visible to shell scripts and to the test runner."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"9842f08b-1c79-43e0-8478-9af2a8eca047"],

Cell["4. Stages: immutable, fingerprinted Associations", "Section",ExpressionUUID->"82ca1b07-c799-426d-849e-0500e10826a1"],

Cell[TextData[{
 "Every module returns a ",
 StyleBox["stage",
  FontWeight->Bold],
 ": an ",
 StyleBox["Association",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " holding everything it computed, plus bookkeeping."
}], "Text",ExpressionUUID->"35af1364-1ee8-4bbb-a769-6e8104d869b5"],

Cell[TextData[{
 StyleBox["Mathematica: Association",
  FontWeight->Bold],
 "\n",
 StyleBox["<|key -> value, ...|>",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a table of key-value pairs; read with ",
 StyleBox["a[key]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " or ",
 StyleBox["Lookup[a, key, default]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ".",
 "\n\n",
 "Keys are usually strings. ",
 StyleBox["a[\"Stage\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads a key, ",
 StyleBox["Lookup[a, \"Warnings\", {}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads it with a default when it is absent, ",
 StyleBox["Keys[a]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists the keys. ",
 StyleBox["Append[a, k -> v]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["KeyDrop[a, {k1, ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " return a ",
 StyleBox["new",
  FontWeight->Bold],
 " association and leave ",
 StyleBox["a",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " unchanged: an association is a value, not a reference. Inside a pure \
function, ",
 StyleBox["#Status",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is short for ",
 StyleBox["#[\"Status\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["AssociationThread[{k1, k2} -> {v1, v2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " builds one from two lists."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"160b70f8-45ee-41e0-8631-8285e9254136"],

Cell["\<\
toyA = <|\"Stage\" -> \"Toy\", \"Data\" -> {1, 2}|>;
{toyA[\"Data\"], Lookup[toyA, \"Missing\", \"default\"], Keys[Append[toyA, \
\"New\" -> 3]], Keys[toyA]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"e7483853-83d5-4d9b-acb5-9a237a21c614"],

Cell["The bookkeeping code is short:", "Text",ExpressionUUID->"07c87def-1a45-43ba-aae8-e58a2997e1d7"],

Cell["\<\
(* Kernel/Core.wl:101-105 *)
(* keys that do not define the content of a stage, hence are not hashed *)
volatileKeys = {\"Fingerprint\", \"Checks\", \"Timing\", \"Warnings\", \
\"Assumptions\"};
(* Normal re-evaluates the content: a field or coupling that got a value \
after the stage was built changes the hash *)
contentHash[stage_Association] := Hash[Normal[KeyDrop[stage, volatileKeys], \
Association], \"SHA256\", \"HexString\"];
stampStage[stage_Association] := Append[stage, \"Fingerprint\" -> \
contentHash[stage]];\
\>", "Program",ExpressionUUID->"68523277-95f9-4063-9215-85d77a61661d"],

Cell["\<\
(* Kernel/Core.wl:107-112 *)
validateStage[stage_, name_String] := (
   FRGAssert[\"Stage.input\", AssociationQ[stage] && Lookup[stage, \"Stage\", \
None] === name, Lookup[If[AssociationQ[stage], stage, <||>], \"Stage\", stage],
    \"expected the output of the \" <> name <> \" stage\"];
   FRGAssert[\"Stage.fingerprint\", contentHash[stage] === \
stage[\"Fingerprint\"], stage[\"Stage\"],
    \"the stage was modified after it was built, or one of its symbols got a \
value since: rebuild it\"];
   stage);\
\>", "Program",ExpressionUUID->"3c15fb18-3fee-464b-b7cc-f32593101df3"],

Cell[TextData[{
 StyleBox["Mathematica: Hash",
  FontWeight->Bold],
 "\n",
 StyleBox["Hash[expr, \"SHA256\", \"HexString\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a 64-character fingerprint of expr; any change to expr changes it.",
 "\n\n",
 "A hash is a short digest of an arbitrarily large expression. Two equal \
expressions have the same hash, and in practice two different ones never do. \
Comparing hashes is a cheap way to ask \"is this still exactly the expression \
that was built?\"."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"2384aba7-db57-40ea-b698-4221ff9ac6ca"],

Cell[TextData[{
 "Let us build a toy stage. ",
 StyleBox["stampStage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is an internal helper, but as we saw it is reachable from the notebook."
}], "Text",ExpressionUUID->"024a8764-8ee5-4500-8a45-f6f7de173c47"],

Cell["\<\
toy = stampStage[<|\"Stage\" -> \"Toy\", \"Data\" -> {a, b}, \"Checks\" -> \
{}|>];
validateStage[toy, \"Toy\"][\"Fingerprint\"]\
\>", "Input",ExpressionUUID->"eb722400-5fc8-4e96-b6c9-b3e69af8f956"],

Cell["\<\
A stage passed to the wrong constructor, or modified by hand, is refused:\
\>", "Text",ExpressionUUID->"0c5e7dae-2b56-4990-ad87-90df16b8b528"],

Cell["showFailure[validateStage[toy, \"Theory\"]]", "Input",ExpressionUUID->"fa128e3d-95bb-41fd-9641-3376239070b1"],

Cell["\<\
showFailure[validateStage[Append[toy, \"Data\" -> {a}], \"Toy\"]]\
\>", "Input",ExpressionUUID->"46a234a8-0ab9-407f-8034-969cf2234319"],

Cell[TextData[{
 "The subtle case is a symbol of the stage that gets a value after the stage \
was built. ",
 StyleBox["contentHash",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is private, so we call it by its full name:"
}], "Text",ExpressionUUID->"86db900c-bf09-4cee-9361-23778d8d5718"],

Cell["FRGscalarMSR`Private`contentHash[toy] === toy[\"Fingerprint\"]", "Input",ExpressionUUID->"989d8f9f-43d4-4988-99f9-47ae40695daa"],

Cell["\<\
a = 5;
{toy, toy[\"Data\"], FRGscalarMSR`Private`contentHash[toy] === \
toy[\"Fingerprint\"]}\
\>", "Input",ExpressionUUID->"72c593ee-4b1a-43fa-a4ab-4095e34eaaf4"],

Cell[TextData[{
 "The association still displays ",
 StyleBox["{a, b}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": it does not re-evaluate its contents when you use it. The part you \
extract, ",
 StyleBox["toy[\"Data\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", is evaluated and gives ",
 StyleBox["{5, b}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["Normal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns the association back into a list of rules, which does get \
re-evaluated; that is why ",
 StyleBox["contentHash",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " hashes ",
 StyleBox["Normal[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and why the fingerprint no longer matches:"
}], "Text",ExpressionUUID->"c7ea2a93-abe5-4eaa-a282-96e71bfafe72"],

Cell["showFailure[validateStage[toy, \"Toy\"]]", "Input",ExpressionUUID->"88182c1c-466c-43cf-9fde-4e52f66b6177"],

Cell["Clear[a]", "Input",ExpressionUUID->"d1edc8b7-13e5-4c71-9cec-9a7bd18cf05a"],

Cell[TextData[{
 StyleBox["PrintCard",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " prints the summary card that every constructor shows:"
}], "Text",ExpressionUUID->"8c41f96f-df68-4bbc-8c63-76d5b2141565"],

Cell["\<\
(* Kernel/Core.wl:114-119 *)
PrintCard[stage_Association] := Module[{chk = Lookup[stage, \"Checks\", {}], \
extra},
   extra = Join[Lookup[stage, \"Warnings\", {}], Lookup[stage, \
\"Assumptions\", {}]];
   Print[\"==== \", stage[\"Stage\"], \" card   fingerprint \", \
StringTake[Lookup[stage, \"Fingerprint\", \"--------\"], UpTo[8]],
    \"   LeafCount \", LeafCount[KeyDrop[stage, volatileKeys]], \"   \", \
Round[1000 Lookup[stage, \"Timing\", 0]], \" ms ====\"];
   Scan[Print[StringPadRight[#Status, 11], #Check, If[#Detail === \"\", \"\", \
\"   \" <> ToString[#Detail]]] &, Join[chk, extra]];
   Print[\"==== \", Count[chk, KeyValuePattern[\"Status\" -> \"PASS\"]], \" \
PASS, \", Length[extra], \" warnings/assumptions ====\"];];\
\>", "Program",ExpressionUUID->"c0cd602f-7e33-4f20-a950-1c4aa421ff57"],

Cell["\<\
PrintCard[Append[toy, \"Checks\" -> {assertCheck[\"Demo.check\", True, Null, \
\"\", \"a passing check\"]}]]\
\>", "Input",ExpressionUUID->"80133589-2e5f-40fb-9c01-2439bf9f722a"],

Cell[TextData[{
 StyleBox["Count[list, KeyValuePattern[\"Status\" -> \"PASS\"]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " counts the records whose ",
 StyleBox["\"Status\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " key is ",
 StyleBox["\"PASS\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["StringPadRight",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " pads a string to a fixed width."
}], "Text",ExpressionUUID->"0ec74395-1bc8-41fc-93a3-179eaa266650"],

Cell[TextData[{
 StyleBox["Why it's built this way: Immutable stages instead of global state",
  
  FontWeight->Bold],
 "\n\n",
 "A classical Mathematica notebook keeps its state in global variables that \
later cells read and overwrite. Re-evaluating cells out of order then gives \
results that depend on history. Here each constructor takes stages as \
arguments and returns a new one; nothing is stored anywhere else (",
 StyleBox["design/FRGDESIGN.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", Q8: \"immutable stage Associations passed explicitly, no global state\"). \
Re-running a cell is always safe, two models can live in one kernel, and any \
stage can be saved to disk and loaded back (lesson 12). The fingerprint \
closes the remaining hole: a stage that was edited, or whose couplings \
acquired values, would silently give wrong results downstream, so every \
constructor recomputes the hash of its inputs and aborts with ",
 StyleBox["Stage.fingerprint",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". The keys in ",
 StyleBox["volatileKeys",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are excluded because they describe how the stage was built (timing, card \
lines), not what it contains."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"76f713af-197b-4bd5-bf2e-d77bdc84706d"],

Cell["5. Exact zero tests", "Section",ExpressionUUID->"5fcca8d0-fb60-41ab-bcc7-6dba26f8679f"],

Cell[TextData[{
 "The library constantly has to decide whether a large expression is exactly \
zero: whether two forms of a vertex agree, whether a projection cancels. ",
 StyleBox["ExactlyZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " does it numerically, but exactly:"
}], "Text",ExpressionUUID->"21ea419a-adc3-44dc-b152-fc6a72a4f468"],

Cell["\<\
(* Kernel/Core.wl:75-76 *)
RandomRationalPoint[syms_List, seed_Integer] := (SeedRandom[seed];
   Thread[syms -> RandomInteger[{2, 60}, Length[syms]]/RandomInteger[{61, \
97}, Length[syms]]]);\
\>", "Program",ExpressionUUID->"885734f6-33e6-4a36-b369-211972ac9c39"],

Cell["\<\
(* Kernel/Core.wl:78-79 *)
systemSymbolQ[s_Symbol] := Context[s] === \"System`\";
userSymbols[e_] := Union[Cases[e, s_Symbol /; ! systemSymbolQ[s], {0, \
Infinity}, Heads -> False]];\
\>", "Program",ExpressionUUID->"4e8348e4-5ffa-4733-9ef2-edbcb9d684ab"],

Cell["\<\
(* Kernel/Core.wl:81-88 *)
valueAt[e_, seed_Integer] := Module[{pt, memo, atomRule},
   pt = RandomRationalPoint[userSymbols[e], seed];
   SeedRandom[seed + 7919];
   memo[x_] := memo[x] = RandomInteger[{2, 60}]/RandomInteger[{61, 97}];
   (* whole atoms first: f[y], f'[y], f[a, b][y], Derivative[k][f[a, b]][y] \
each get their own value; matching inside
      Derivative[k][f[a, b]] would turn it into Derivative[k][number] = 0 \
(design/MOMENTUMPROJECTION.md step 0, E1) *)
   atomRule = x : (Derivative[__][_][___] | (_[___])[___] | (h_Symbol /; ! \
systemSymbolQ[h])[___]) :> memo[x];
   Quiet[Check[Together[(e /. pt) /. atomRule], $Failed], {Power::infy, \
Infinity::indet}]];\
\>", "Program",ExpressionUUID->"74ec95d4-006e-446d-aa4f-297dd59bfaaf"],

Cell["\<\
(* Kernel/Core.wl:90-97 *)
Options[ExactlyZeroQ] = {\"Seeds\" -> {1, 2, 3}};
ExactlyZeroQ[l_List, opts : OptionsPattern[]] := AllTrue[Flatten[l], \
ExactlyZeroQ[#, opts] &];
ExactlyZeroQ[e_, OptionsPattern[]] := Module[{vals},
   vals = Table[Module[{v = valueAt[e, sd]}, If[v === $Failed, valueAt[e, sd \
+ 1000], v]], {sd, OptionValue[\"Seeds\"]}];
   Block[{$FRGModule = \"Core\"},
    FRGAssert[\"ExactlyZeroQ.numeric\", AllTrue[vals, NumericQ[#] && \
Precision[#] === Infinity &], Select[vals, ! NumericQ[#] &],
     \"after substituting random rationals the expression is not an exact \
number: an unknown head or a pattern is left\"]];
   AllTrue[vals, PossibleZeroQ]];\
\>", "Program",ExpressionUUID->"9fe5b804-703e-4b75-9757-3ee0b621f5d3"],

Cell["Several new tools appear in these few lines.", "Text",ExpressionUUID->"b847c2d0-3f32-4c4f-84cf-75aaf1ec29c3"],

Cell[TextData[{
 StyleBox["Mathematica: Options",
  FontWeight->Bold],
 "\n",
 StyleBox["Options[f] = {\"Name\" -> default}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " declares named options; ",
 StyleBox["f[x_, OptionsPattern[]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " accepts them; ",
 StyleBox["OptionValue[\"Name\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads them.",
 "\n\n",
 "Options are optional arguments passed by name, ",
 StyleBox["ExactlyZeroQ[e, \"Seeds\" -> {5, 6}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", with defaults stored in ",
 StyleBox["Options[f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". They keep a function's signature readable when it has many settings."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"8f0381a5-3403-47fb-a896-fafc6fcbee8c"],

Cell[TextData[{
 StyleBox["Mathematica: Cases and level specifications",
  FontWeight->Bold],
 "\n",
 StyleBox["Cases[e, patt, {0, Infinity}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns every subexpression of e, at any depth, that matches patt.",
 "\n\n",
 StyleBox["Cases",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " walks the expression tree. The level specification ",
 StyleBox["{0, Infinity}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " means \"the whole expression and everything inside it\". ",
 StyleBox["Heads -> False",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " skips heads, so in ",
 StyleBox["r[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " it sees ",
 StyleBox["y",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " but not ",
 StyleBox["r",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["userSymbols",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " thus collects the plain symbols (couplings, ",
 StyleBox["q",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["k",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Dim",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), and ",
 StyleBox["Union",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sorts them and removes duplicates. ",
 StyleBox["FreeQ[e, patt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", used everywhere later, is the opposite question: True if nothing in e \
matches."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"aa7e8357-8383-455a-b96f-b92cb6e75159"],

Cell["\<\
Cases[nuk q^2 r[q^2/k^2] + Dim, s_Symbol, {0, Infinity}, Heads -> False] // \
Union\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"cd3d4765-5b71-4a3b-83a5-2a19ee2e58a8"],

Cell[TextData[{
 StyleBox["Mathematica: Rules and replacement",
  FontWeight->Bold],
 "\n",
 StyleBox["lhs -> rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["lhs :> rhs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are rules; ",
 StyleBox["e /. rules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies them to every part of e.",
 "\n\n",
 StyleBox["e /. x -> 2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces ",
 StyleBox["x",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " by 2 everywhere in ",
 StyleBox["e",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". With ",
 StyleBox["->",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the right-hand side is evaluated once, when the rule is made; with ",
 StyleBox[":>",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["RuleDelayed",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") it is evaluated afresh at each match, using the matched parts. ",
 StyleBox["Thread[{a, b} -> {1, 2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes ",
 StyleBox["{a -> 1, b -> 2}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["/.",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " scans the expression from the outside in and does not look inside a part \
it has just replaced."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"41a5da5e-a518-4fdb-91b4-41d0227c4c58"],

Cell["\<\
{(x + x^2) /. x -> 2, {r[1], r[2]} /. r[n_] :> n^2, Thread[{a, b} -> {1, 2}]}\
\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"16b00b6f-0974-457e-b1b4-34e68dbd1848"],

Cell[TextData[{
 StyleBox["Mathematica: Alternatives and named patterns",
  FontWeight->Bold],
 "\n",
 StyleBox["p1 | p2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches either pattern; ",
 StyleBox["x : p",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches p and names the whole match x.",
 "\n\n",
 StyleBox["atomRule = x : (Derivative[__][_][___] | (_[___])[___] | ...) :> \
memo[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches any of three shapes of \"function atom\" (",
 StyleBox["r'[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["f[a][y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["r[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") and calls the whole match ",
 StyleBox["x",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["__",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches one or more arguments, ",
 StyleBox["___",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " zero or more."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"72080df5-50df-402f-80c4-0f078d32b128"],

Cell[TextData[{
 StyleBox["Mathematica: Memoization",
  FontWeight->Bold],
 "\n",
 StyleBox["f[x_] := f[x] = value",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " computes value the first time and stores it as a specific definition for \
that x.",
 "\n\n",
 "The first call ",
 StyleBox["memo[r[y]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates the right-hand side, which is itself an assignment ",
 StyleBox["memo[r[y]] = 37/61",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": a new, specific definition. Every later ",
 StyleBox["memo[r[y]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " uses it. Here it guarantees that the same atom gets the same random number \
wherever it appears."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"2c73538e-e35e-41a4-8adf-b46ec8ae58a1"],

Cell[TextData[{
 "Why the atoms are replaced ",
 StyleBox["whole",
  FontSlant->Italic],
 " is the subtle point. ",
 StyleBox["/.",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " goes from the outside in, so ",
 StyleBox["r'[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (which is ",
 StyleBox["Derivative[1][r][y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") is matched as one atom before ",
 StyleBox["r",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " alone could be. Had the symbol ",
 StyleBox["r",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " been replaced by a number first, ",
 StyleBox["Derivative[1][37/61]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " would be zero, and every derivative term would vanish without notice (",
 StyleBox["design/MOMENTUMPROJECTION.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", step 0)."
}], "Text",ExpressionUUID->"558a01e3-0e1a-4225-b45c-c790b39bb194"],

Cell[TextData[{
 StyleBox["Mathematica: Check and Quiet",
  FontWeight->Bold],
 "\n",
 StyleBox["Check[expr, alt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns alt if evaluating expr produced a message; ",
 StyleBox["Quiet[expr, {msgs}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates expr without printing those messages.",
 "\n\n",
 "A random point can hit a pole (",
 StyleBox["1/0",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). ",
 StyleBox["valueAt",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " then returns ",
 StyleBox["$Failed",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " without printing anything, and ",
 StyleBox["ExactlyZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " retries with another seed."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"da7d7efe-6a4a-465f-a395-ef40c79667da"],

Cell[TextData[{
 StyleBox["Mathematica: Exact numbers",
  FontWeight->Bold],
 "\n",
 "Integers and rationals are exact (",
 StyleBox["Precision",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["Infinity",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "); ",
 StyleBox["Together",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " puts a rational expression over a common denominator.",
 "\n\n",
 StyleBox["3/7",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stays a rational number forever; ",
 StyleBox["0.4286",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a machine number with rounding errors. After all symbols are replaced \
by rationals, ",
 StyleBox["Together",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reduces the expression to a single exact rational, and ",
 StyleBox["PossibleZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of an exact number is an exact test. ",
 StyleBox["ExactlyZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " asserts that what is left is an exact number: if a symbol or pattern \
survived the substitution, the test would be meaningless."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"4c094eac-5fee-4ef2-8488-4d54f45dc960"],

Cell["\<\
{ExactlyZeroQ[(a + b)^2 - a^2 - 2 a b - b^2], ExactlyZeroQ[D[r[y]^2, y] - 2 \
r[y] r'[y]], ExactlyZeroQ[r'[y] - r''[y]]}\
\>", "Input",ExpressionUUID->"9daed33a-b5bd-442f-82fe-1adddf367187"],

Cell[TextData[{
 StyleBox["Why it's built this way: Random rationals instead of Simplify",
  FontWeight->Bold],
 "\n\n",
 StyleBox["Simplify[expr] == 0",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the obvious test, and the library forbids it (CLAUDE.md, Conventions). \
On expressions with 10^5 to 10^6 leaves, ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " can run for hours, and when it returns something non-zero that proves \
nothing: it may simply have failed to find the simplification. Evaluating at \
random rational points is fast, has no rounding error, and is reliable: a \
non-zero rational function of degree D vanishes at a random point drawn from \
M values with probability at most D/M (the Schwartz-Zippel bound), so three \
independent points make an accidental pass negligible. Giving each function \
atom its own value tests the identity for arbitrary shape functions, not for \
one particular regulator."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"9e466816-9344-45c5-a622-c81f7013ede2"],

Cell["6. User symbols", "Section",ExpressionUUID->"83a087db-832a-4281-b45d-95d8b037a5d5"],

Cell["\<\
Fields and couplings are symbols that you choose. Before using them, the \
library checks that they are usable:\
\>", "Text",ExpressionUUID->"244ff9e4-26ee-4701-a469-e63f456d8c62"],

Cell["\<\
(* Kernel/Core.wl:123-127 *)
(* names the user writes or reads in library input/output with a fixed \
meaning: RG scale k, loop momentum q, external momentum p,
   shape argument y = q^2/k^2, time t, position x, frequencies, and the \
cosine c and dimensionless external momentum ap of the
   functional equations (design/MOMENTUMFUNCTIONS.md); internal names (A, CC, \
X, ...) live in private contexts.
   Dim is user-chosen and therefore not reserved. *)
reservedNames = {\"k\", \"q\", \"p\", \"y\", \"t\", \"x\", \"c\", \"ap\", \
\"\\[Omega]\", \"\\[Nu]\"};\
\>", "Program",ExpressionUUID->"412e161c-5fd0-4b3a-8625-25b45c56169a"],

Cell["\<\
(* Kernel/Core.wl:129-140 *)
assertFreshSymbols[check_String, syms_List, what_String] := Module[{lib = \
Join[Names[\"FRGscalarMSR`*\"], Names[\"FRGscalarMSR`Internal`*\"]]},
   FRGAssert[check <> \".symbols\", AllTrue[syms, Head[#] === Symbol &], \
Select[syms, Head[#] =!= Symbol &],
    what <> \" must be plain symbols without values (one of them evaluated to \
something else)\"];
   FRGAssert[check <> \".system\", NoneTrue[syms, systemSymbolQ], \
Select[syms, systemSymbolQ], what <> \" must not be System symbols\"];
   FRGAssert[check <> \".reserved\", NoneTrue[syms, MemberQ[reservedNames, \
SymbolName[#]] &], Select[syms, MemberQ[reservedNames, SymbolName[#]] &],
    \"these names are reserved (RG scale k, momenta, frequencies, Delta \
coefficients): rename them\"];
   FRGAssert[check <> \".library\", NoneTrue[syms, MemberQ[lib, \
SymbolName[#]] &], Select[syms, MemberQ[lib, SymbolName[#]] &],
    \"these names collide with FRGscalarMSR symbols: rename them\"];
   FRGAssert[check <> \".values\", NoneTrue[syms, (OwnValues[#] =!= {} || \
DownValues[#] =!= {} || UpValues[#] =!= {}) &],
    Select[syms, (OwnValues[#] =!= {} || DownValues[#] =!= {} || UpValues[#] \
=!= {}) &], what <> \" must have no definitions: ClearAll them\"];
   FRGAssert[check <> \".duplicates\", DuplicateFreeQ[syms], syms, what <> \" \
are listed twice\"];
   syms];\
\>", "Program",ExpressionUUID->"ee6c7333-3bc0-481e-96ab-f8c345f1adc8"],

Cell[TextData[{
 StyleBox["Mathematica: OwnValues and DownValues",
  FontWeight->Bold],
 "\n",
 "A symbol's definitions are stored as lists of rules: ",
 StyleBox["OwnValues[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for ",
 StyleBox["x = ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["DownValues[f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for ",
 StyleBox["f[...] := ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["UpValues[f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for definitions attached to f as an argument.",
 "\n\n",
 "A symbol with no definitions has all three empty. A field that has a value, \
say ",
 StyleBox["h = 3",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", would be replaced by 3 inside the library, so ",
 StyleBox["assertFreshSymbols",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " requires them empty."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"302ab65f-767e-479a-8b61-98615744cd3d"],

Cell["\<\
v = 3; w[x_] := x^2; {OwnValues[v], DownValues[w], OwnValues[nuk]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"c708aae7-3a7e-496e-9604-6d2eda745199"],

Cell[TextData[{
 StyleBox["Select[list, test]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " keeps the elements that pass ",
 StyleBox["test",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["AllTrue",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["NoneTrue",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["DuplicateFreeQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " test a whole list; ",
 StyleBox["SymbolName[s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the short name of a symbol, as a string."
}], "Text",ExpressionUUID->"9918ffb9-bbb4-452b-b79d-7321a9619ace"],

Cell[TextData[{
 StyleBox["Why it's built this way: Reserved names",
  FontWeight->Bold],
 "\n\n",
 "The library writes some symbols itself into its results: the RG scale ",
 StyleBox["k",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the loop momentum ",
 StyleBox["q",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the external momentum ",
 StyleBox["p",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the shape argument ",
 StyleBox["y = q^2/k^2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". If one of your couplings were called ",
 StyleBox["k",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", it would become indistinguishable from the RG scale in the flow \
equations. Checking the names once, at the entrance, is cheaper than \
debugging the confusion at the exit."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"b39715e7-0600-4d65-88e2-23b0091003d7"],

Cell["7. scal and wedge: algebra by rewriting rules", "Section",ExpressionUUID->"c4d6d5ed-0029-4815-a474-cb2d5d76b14f"],

Cell[TextData[{
 "Vectors (momenta) are bare symbols, and their scalar product is ",
 StyleBox["scal[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Its algebra is entirely defined by rewriting rules:"
}], "Text",ExpressionUUID->"01bd9960-c9f5-4d1a-84d8-81d22309d910"],

Cell["\<\
(* Kernel/Core.wl:144-148 *)
SetAttributes[scal, Orderless];
scal[(a_) + (b_), c_] := scal[a, c] + scal[b, c];
scal[(a_)*(b_), c_] /; NumberQ[a] := a*scal[b, c];
scal[-(a_), b_] := -scal[a, b];
scal[0, b_] := 0;\
\>", "Program",ExpressionUUID->"53f439e0-b142-4b97-884c-8782e8152959"],

Cell[TextData[{
 StyleBox["Mathematica: Orderless",
  FontWeight->Bold],
 "\n",
 "The attribute ",
 StyleBox["Orderless",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sorts a function's arguments into a canonical order before anything \
else.",
 "\n\n",
 "With ",
 StyleBox["Orderless",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["scal[b, a]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is turned into ",
 StyleBox["scal[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": the symmetry of the scalar product is built into how the expression is \
stored. ",
 StyleBox["Plus",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Times",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are Orderless too, which is why ",
 StyleBox["b + a",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " prints as ",
 StyleBox["a + b",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"666b23f4-71b0-4a04-8c38-1dd009485baa"],

Cell[TextData[{
 StyleBox["Mathematica: Evaluation as rewriting",
  FontWeight->Bold],
 "\n",
 "Mathematica applies matching definitions repeatedly until no rule matches \
any more.",
 "\n\n",
 StyleBox["scal[a + 2 b, c]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches ",
 StyleBox["scal[(a_) + (b_), c_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and becomes ",
 StyleBox["scal[a, c] + scal[2 b, c]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; the second term matches the number rule and becomes ",
 StyleBox["2 scal[b, c]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; then nothing matches, and that is the result. You never call these rules: \
writing the expression is enough."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"7558f78e-e091-467c-a1f3-374dc30f1a29"],

Cell["{scal[a + 2 b, c], scal[b, a], scal[nuk a, b], scal[-a, b]}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"b27dd0db-d486-4a64-bda9-52429ef0be55"],

Cell[TextData[{
 "The third result, ",
 StyleBox["scal[a nuk, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", stays as it is. ",
 StyleBox["scal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is linear over explicit numbers only. Vectors and couplings are both bare \
symbols, so ",
 StyleBox["scal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " cannot tell whether ",
 StyleBox["nuk",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " in ",
 StyleBox["scal[nuk a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a coupling or a vector; only numbers can be pulled out safely. The \
modules that build ",
 StyleBox["scal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " terms keep couplings outside."
}], "Text",ExpressionUUID->"b79ac0b7-e211-4fd4-9f7a-a0eea5ba197a"],

Cell[TextData[{
 StyleBox["wedge[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the antisymmetric product of d = 2 (it appears with ",
 StyleBox["jac",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the Levi-Civita operator of ",
 StyleBox["design/LEVICIVITA.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). It cannot be ",
 StyleBox["Orderless",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; instead a conditional rule puts its arguments in canonical order and \
flips the sign:"
}], "Text",ExpressionUUID->"27b9639a-f2b0-417d-bbcc-48ba8f82bca6"],

Cell["\<\
(* Kernel/Core.wl:16 *)
wedge[a, b] -> wedge(a,b).\";\
\>", "Program",ExpressionUUID->"328b96c3-438d-46ea-b08d-947d035e74ac"],

Cell["\<\
(* Kernel/Core.wl:18 *)
wedge[a,b] wedge[c,d] = scal[a,c] scal[b,d] - scal[a,d] scal[b,c] until each \
term of the expanded e has at most one wedge.\";\
\>", "Program",ExpressionUUID->"23587f8b-5e62-4987-b7f1-51cdbf11e8df"],

Cell["\<\
(* Kernel/Core.wl:152-159 *)
wedge[0, _] := 0;
wedge[_, 0] := 0;
wedge[a_, a_] := 0;
wedge[(a_) + (b_), c_] := wedge[a, c] + wedge[b, c];
wedge[a_, (b_) + (c_)] := wedge[a, b] + wedge[a, c];
wedge[(a_)*(b_), c_] /; NumberQ[a] := a*wedge[b, c];
wedge[a_, (b_)*(c_)] /; NumberQ[b] := b*wedge[a, c];
wedge[b_, a_] /; ! OrderedQ[{b, a}] := -wedge[a, b];\
\>", "Program",ExpressionUUID->"70c5f469-47e2-4ba5-9aa1-71039bbd4f75"],

Cell["\<\
(* Kernel/Core.wl:161-165 *)
(* F2, valid in d = 2 only *)
wedgePairRules = {
   wedge[a_, b_] wedge[c_, d_] :> scal[a, c] scal[b, d] - scal[a, d] scal[b, \
c],
   Power[wedge[a_, b_], n_Integer /; n >= 2] :> (scal[a, a] scal[b, b] - \
scal[a, b]^2) wedge[a, b]^(n - 2)};
reduceWedge2D[e_] := FixedPoint[Expand[# /. wedgePairRules] &, Expand[e]];\
\>", "Program",ExpressionUUID->"88e85910-99d9-4f36-ac34-c06785f3e6de"],

Cell[TextData[{
 StyleBox["Mathematica: FixedPoint",
  FontWeight->Bold],
 "\n",
 StyleBox["FixedPoint[f, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f repeatedly, starting from x, until the result stops changing.",
 "\n\n",
 StyleBox["reduceWedge2D",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces products of two wedges by scalar products, expands, and repeats \
until no product of wedges is left."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"a7932ce0-37be-4eff-9a1e-ac818ce7dacb"],

Cell["{wedge[b, a], wedge[a, a], reduceWedge2D[wedge[a, b]^2]}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"6ed11aff-a5cf-477c-b1c1-a8e49f6da7f0"],

Cell[TextData[{
 StyleBox["Why it's built this way: Let the evaluator do the algebra",
  FontWeight->Bold],
 "\n\n",
 "Because ",
 StyleBox["scal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["wedge",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " rewrite themselves into canonical forms, two equal expressions built along \
different paths end up looking the same. Terms combine automatically, ",
 StyleBox["Collect",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Together",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " see common factors, and ",
 StyleBox["ExactlyZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " works on smaller expressions. The alternative, a vector package with \
explicit components, would fix d and multiply the size of every expression by \
the number of components; here d stays the symbol ",
 StyleBox["Dim",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " to the end."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"a1b01bfe-7da7-4410-a82d-df9c48e0e8f3"],

Cell["Exercises", "Section",ExpressionUUID->"3d365774-eb95-460e-a107-c69fba7942fc"],

Cell["Exercise: Read a FAIL block", "Subsection",ExpressionUUID->"f67f8ae8-5557-4447-881a-9f571ba77e70"],

Cell[TextData[{
 "Write a check named ",
 StyleBox["\"Me.even\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " that ",
 StyleBox["7",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is an even number (",
 StyleBox["EvenQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), with the offending value and a hint, and run it through ",
 StyleBox["showFailure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Then evaluate ",
 StyleBox["$FRGLastFailure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["$FRGModule",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Why does ",
 StyleBox["$FRGModule",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " print ",
 StyleBox["FRGscalarMSR",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " here, not a module name?"
}], "Text",ExpressionUUID->"be01dbd8-3840-444c-8e9e-e1d59565aae9"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"54eb5efb-cf35-4870-af21-3fa8047fca71"],

Cell["\<\
showFailure[FRGAssert[\"Me.even\", EvenQ[7], 7, \"pass an even number\"]]\
\>", "Input",ExpressionUUID->"11e068cf-dadb-4448-be9c-e5de1fc14541"],

Cell["{$FRGLastFailure, $FRGModule}", "Input",ExpressionUUID->"7a2297a8-3552-4887-9654-78ea9a714c97"],

Cell[TextData[{
 "No constructor is running, so no ",
 StyleBox["Block[{$FRGModule = ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is active and the global default set in ",
 StyleBox["Kernel/Core.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is printed."
}], "Text",ExpressionUUID->"9af4a945-6e49-4300-afae-69c13b0bc99c"]
}, Closed]],

Cell["Exercise: HoldRest at work", "Subsection",ExpressionUUID->"ad289ed2-611b-40fc-9459-48583e61d534"],

Cell[TextData[{
 StyleBox["FRGAssert",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " holds its ",
 StyleBox["details",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " argument. Verify it: call it once with a true condition and once with a \
false one, passing ",
 StyleBox["Print[\"details computed\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " as details. How many times is the message printed?"
}], "Text",ExpressionUUID->"ad271e50-7b40-4f8c-9ce2-2441e5fc8698"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"82d67ed9-c127-467b-a2b3-c08cff4d4b0f"],

Cell["FRGAssert[\"Me.hold\", True, Print[\"details computed\"]]", "Input",ExpressionUUID->"26a14ea2-649f-4c61-804d-e59c249ebd22"],

Cell["\<\
showFailure[FRGAssert[\"Me.hold\", False, Print[\"details computed\"]]]\
\>", "Input",ExpressionUUID->"ddaae5ff-13e1-4a2a-820c-2efd10c2e36b"],

Cell[TextData[{
 "Once: only the failing call evaluates ",
 StyleBox["details",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", inside ",
 StyleBox["failBlock",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (the printed \"offending\" is then ",
 StyleBox["Null",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the value of ",
 StyleBox["Print",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",ExpressionUUID->"f8459f9a-47ee-446d-869e-97eda205be1d"]
}, Closed]],

Cell["Exercise: An identity with a shape function", "Subsection",ExpressionUUID->"130203eb-4f8a-4f31-8f46-9d457ef69223"],

Cell[TextData[{
 "Use ",
 StyleBox["ExactlyZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " to check that the derivative of ",
 StyleBox["y r[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["r[y] + y r'[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and that it is not ",
 StyleBox["r[y] + r'[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Then ask yourself what would go wrong if ",
 StyleBox["valueAt",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaced the symbol ",
 StyleBox["r",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " by a number before the atoms."
}], "Text",ExpressionUUID->"b15d9d8c-9044-4b52-b8a7-eebef23b33c1"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"65d529f6-6187-457a-974e-f84ce3061ff4"],

Cell["\<\
{ExactlyZeroQ[D[y r[y], y] - (r[y] + y r'[y])], ExactlyZeroQ[D[y r[y], y] - \
(r[y] + r'[y])]}\
\>", "Input",ExpressionUUID->"d11e5049-967d-4088-979d-b6c414fe56bb"],

Cell[TextData[{
 StyleBox["r'[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["Derivative[1][r][y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". With ",
 StyleBox["r",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaced by 37/61 it would become ",
 StyleBox["Derivative[1][37/61][y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the derivative of a constant, which is 0. The difference in the wrong \
identity is ",
 StyleBox["(y - 1) r'[y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", so it would pass."
}], "Text",ExpressionUUID->"90b89123-a96a-4a0c-9467-690693557b0e"]
}, Closed]]
},

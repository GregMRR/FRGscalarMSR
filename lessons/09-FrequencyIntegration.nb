Notebook[{
Cell["Lesson 09 - FrequencyIntegration", "Title",ExpressionUUID->"375f91cf-55f1-4e98-b163-6ef3ee357a4f"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Integrate every projected integrand over the real ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " axis, exactly, by residues. Each integrand is a sum of terms ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "^n ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")^{",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "a} ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ")^{",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "b}; the roots of ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") lie in the upper half plane (the propagator's validity conditions), those \
of ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ") in the lower one, so closing the contour upwards picks the residues of ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") only. The result is a rational function of the coefficients c0, c1, c2 of \
",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 ": no ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", no ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 ", no square roots."
}], "Text",ExpressionUUID->"39aa2eff-8380-496d-8893-1c8a27f91f6c"],

Cell[TextData[{
 StyleBox["Stage.",
  FontWeight->Bold],
 " Input: the Projection stage. Output: the ",
 StyleBox["\"Integrated\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stage, whose ",
 StyleBox["\"Flows\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " hold, for each monomial, either the symbolic flow (",
 StyleBox["\"Value\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", class Declared) or exact values at random points (",
 StyleBox["\"Samples\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the other classes)."
}], "Text",ExpressionUUID->"522bf04e-40e6-4789-bcc1-2aded7fbb5a6"],


}], "Text",ExpressionUUID->"ddd242ce-dd06-4eb7-bc14-574691e27da6"],

Cell["\<\
{N[FrequencyIntegral[0, 1, 1, 1] /. {FrequencyIntegralC[0] -> 2, \

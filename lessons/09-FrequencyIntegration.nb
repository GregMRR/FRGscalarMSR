 ":"
}], "Text",ExpressionUUID->"0ac8938f-a1e7-4195-97c6-fd8567445507"],

Cell["\<\
{N[FrequencyIntegral[0, 1, 1, 1] /. {FrequencyIntegralC[0] -> 2, \
FrequencyIntegralC[1] -> 3}], NIntegrate[1/((2 + 3 I w) (2 - 3 I w)), {w, \
-Infinity, Infinity}]}\
\>", "Input",ExpressionUUID->"6a8c07a1-4452-48f4-9960-dfcf5b7812d9"],

Cell[TextData[{
 StyleBox["Mathematica: Numerator, Denominator and radicals",
  FontWeight->Bold],
 "\n",
 StyleBox["Numerator[r]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Denominator[r]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " split a rational expression; a square root is ",
 StyleBox["Power[x, 1/2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", so ",
 StyleBox["FreeQ[r, Power[_, _Rational]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tests for radicals.",
 "\n\n",
 StyleBox["r",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is made even in ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 " by multiplying numerator and denominator by the denominator with ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Minus]\[Beta]",
  FontFamily->"Noto Sans"],
 "; then both contain only even powers of ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 ", and ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Sqrt]",
  FontFamily->"Noto Sans"],
 "x followed by x ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " its value leaves no root. ",
 StyleBox["FrequencyIntegration.rational",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " asserts that no ",
 StyleBox["Power[_, _Rational]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is left (CLAUDE.md, Conventions: no radicals)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"808086a8-c66c-4e78-89af-d226214d8f29"],

Cell["\<\
{Numerator[(a + b)/c2], Denominator[(a + b)/c2], FullForm[Sqrt[x]], \
FreeQ[Sqrt[x], Power[_, _Rational]]}\
\>", "Input",

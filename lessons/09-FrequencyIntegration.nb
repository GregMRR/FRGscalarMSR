Notebook[{
Cell["Lesson 09 - FrequencyIntegration", "Title",ExpressionUUID->"3c16b6c9-d0a7-4fb9-8818-fb8aa3af5b78"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Integrate every projected integrand over the real ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " axis, exactly, by residues. Each integrand is a sum of terms ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "^n ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")^{",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "a} ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ")^{",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "b}; the roots of ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") lie in the upper half plane (the propagator's validity conditions), those \
of ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ") in the lower one, so closing the contour upwards picks the residues of ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") only. The result is a rational function of the coefficients c0, c1, c2 of \
",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 ": no ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", no ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 ", no square roots."
}], "Text",ExpressionUUID->"759ff403-1c1a-4992-83be-6596ea5d4f4a"],

Cell[TextData[{
 StyleBox["Stage.",
  FontWeight->Bold],
 " Input: the Projection stage. Output: the ",
 StyleBox["\"Integrated\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stage, whose ",
 StyleBox["\"Flows\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " hold, for each monomial, either the symbolic flow (",
 StyleBox["\"Value\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", class Declared) or exact values at random points (",
 StyleBox["\"Samples\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the other classes)."
}], "Text",ExpressionUUID->"f699b4ee-8c48-4097-a188-69af3db7d3cb"],


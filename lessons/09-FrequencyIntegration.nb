Get[FileNameJoin[{$FRGRoot, \"lessons\", \"LessonSetup.wl\"}]];
projected = lessonUpTo[\"Projection\"];\
\>", "Input",ExpressionUUID->"39c49589-6458-416c-8015-609f695d6f1f"],


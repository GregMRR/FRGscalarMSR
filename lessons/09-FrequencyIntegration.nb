\>", "Input",ExpressionUUID->"311bb558-97cb-4f9b-80c9-19c5a0b6a945"],

Cell[TextData[{
 StyleBox["Mathematica: Numerator, Denominator and radicals",
  FontWeight->Bold],
 "\n",
 StyleBox["Numerator[r]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Denominator[r]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " split a rational expression; a square root is ",
 StyleBox["Power[x, 1/2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", so ",
 StyleBox["FreeQ[r, Power[_, _Rational]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tests for radicals.",
 "\n\n",
 StyleBox["r",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is made even in ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 " by multiplying numerator and denominator by the denominator with ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Minus]\[Beta]",
  FontFamily->"Noto Sans"],
 "; then both contain only even powers of ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 ", and ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Sqrt]",
  FontFamily->"Noto Sans"],
 "x followed by x ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " its value leaves no root. ",
 StyleBox["FrequencyIntegration.rational",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " asserts that no ",
 StyleBox["Power[_, _Rational]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is left (CLAUDE.md, Conventions: no radicals)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"2e5b7d97-7ac6-4d10-82d2-025b0221c7ad"],

Cell["\<\
{Numerator[(a + b)/c2], Denominator[(a + b)/c2], FullForm[Sqrt[x]], \

Cell[TextData[{
 StyleBox["Mathematica: Memoization of a function",
  FontWeight->Bold],
 "\n",
 StyleBox["f[n_, a_] := f[n, a] = ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stores each computed value as a new definition of f, so the next call with \
the same arguments returns it at once.",
 "\n\n",
 "This is ",
 StyleBox["Memoization",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " applied to a top-level function: ",
 StyleBox["FrequencyIntegral[0, 1, 1, 1]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is computed once per session, and every integrand that needs it afterwards \
reuses the stored rule. The stored values are visible in ",
 StyleBox["DownValues[FrequencyIntegral]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["OwnValues and DownValues",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") as the rules without patterns; the card counts them."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"7a87ce8d-8f42-465a-ba7f-281c1f950e2d"],

Cell["\<\
Length[Select[DownValues[FrequencyIntegral], FreeQ[#, Pattern] &]]\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"99af916d-28f2-43b0-815b-49a9ff24336f"],

Cell[TextData[{
 StyleBox["Why it's built this way: A memoised formula instead of a lookup \
table",
  FontWeight->Bold],
 "\n\n",
 "The original notebook used a hand-made table of integrals, which had to be \
extended whenever a new combination (n, a, b) appeared, and silently missed \
any combination that was not in it. Here each integral is computed from one \
residue formula the first time it is needed and remembered: nothing is \
skipped, and nothing depends on the order of rules. The memo is a cache of a \
pure function of (n, a, b, deg), so it is the one kind of global state that \
cannot make results depend on history."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"4cb31bb8-9cc2-445d-a36c-f4f9473fe513"],

Cell["3. Integrating an integrand", "Section",ExpressionUUID->"011c8cdd-9b95-43f9-879f-57e3a4526ac8"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:48-55 *)
(* dispatch on monomials w^n X^a Y^b, X = 1/Delta(w), Y = 1/Delta(-w): no \
table, nothing skipped *)
integrate[e_, w_, deg_, cvals_] := Module[{exy, res},
   exy = e /. {\\[CapitalDelta][w, _] -> 1/xX, \\[CapitalDelta][-w, _] -> \
1/yY};
   FRGAssert[\"FrequencyIntegration.ready\", FreeQ[exy, \\[CapitalDelta] | \
Derivative[__][\\[CapitalDelta]]], Cases[exy, _\\[CapitalDelta], Infinity],
    \"integrand not ready: Delta with another argument\"];
   res = Total[#[[2]] (FrequencyIntegral[#[[1, 1]], #[[1, 2]], #[[1, 3]], \
deg] /. cvals) & /@ CoefficientRules[exy, {w, xX, yY}]];
   FRGAssert[\"FrequencyIntegration.complete\", FreeQ[res, w | xX | yY | \
\\[CapitalDelta] | Power[_, _Rational]], res, \"leftover w, Delta or radicals\
\"];
   res];\
\>", "Program",ExpressionUUID->"8e85b89d-d311-4b66-ae8e-098eb652d375"],

Cell[TextData[{
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " 1/X and ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ") ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " 1/Y turn the integrand into a polynomial in ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", X, Y with coefficients free of ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "."
}], "Text",ExpressionUUID->"3ef8ca3f-105b-4148-8011-e5237fe96f6c"],

Cell[TextData[{
 StyleBox["Mathematica: CoefficientRules",
  FontWeight->Bold],
 "\n",
 StyleBox["CoefficientRules[poly, {x, y, ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists the monomials of a polynomial as ",
 StyleBox["{exponents} -> coefficient",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ".",
 "\n\n",
 "Each rule ",
 StyleBox["{n, a, b} -> coefficient",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is one term ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "^n X^a Y^b, so the integral is ",
 StyleBox["Total",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of coefficient ",
 StyleBox["\[Times]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["FrequencyIntegral[n, a, b, deg]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". This dispatches on the structure of the integrand, term by term, without \
pattern rules that could miss a term."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"ea974436-3435-428b-87d5-78f95e86f6cc"],

Cell["CoefficientRules[3 w^2 x + 5 y, {w, x, y}]", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"52b7d0c2-ec00-44f1-a02d-9749331f61d4"],

Cell["4. Sampled flows", "Section",ExpressionUUID->"7cf206df-2153-4992-9fe1-378199f1f157"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:57-66 *)
(* random rational point of every atom, Delta coefficients consistent with \
the atoms, w and Delta kept *)
samplePoint[e_, prop_, w_, seed_] := Module[{e1, syms, atoms, pt, memo},
   e1 = e /. Join[{}, {DeltaCoefficient[m_][s_] :> \
prop[\"DeltaCoefficients\"][s][[m + 1]],
       Derivative[k_][DeltaCoefficient[m_]][s_] :> \
(D[prop[\"DeltaCoefficients\"][xs][[m + 1]], {xs, k}] /. xs -> s)}] /. \
\\[CapitalDelta] -> dd;
   syms = DeleteCases[Union[Cases[e1, x_Symbol /; Context[x] =!= \"System`\", \
{0, Infinity}, Heads -> False], {LoopMomentumSquared}], w];
   pt = RandomRationalPoint[syms, seed];
   SeedRandom[seed + 104729];
   memo[x_] := memo[x] = RandomInteger[{2, 60}]/RandomInteger[{61, 97}];
   e1 = e1 /. pt /. x : (Derivative[__][GammaAtom[__]][_] | GammaAtom[__][_] \
| dsR[__] | dsCoupling[_]) :> memo[x];
   {e1 /. dd -> \\[CapitalDelta], pt, memo}];\
\>", "Program",ExpressionUUID->"6d96a4f0-c82d-4b43-b0c3-99f6415e63b1"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:68-72 *)
sampleValue[e_, prop_, w_, deg_, seed_] := Module[{e1, pt, memo, s, cv},
   {e1, pt, memo} = samplePoint[e, prop, w, seed];
   s = LoopMomentumSquared /. pt;
   cv = Thread[cc /@ Range[0, 2] -> (prop[\"DeltaCoefficients\"][s] /. x : \
(GammaAtom[__][_]) :> memo[x])];
   {integrate[e1, w, deg, cv], validPointQ[prop, s, cv]}];\
\>", "Program",ExpressionUUID->"4035bd7c-b13a-48aa-b8f9-42a2e8f7eee2"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:74-75 *)
(* the point is physical: q^2 > 0 and every root of Delta(w) in the upper \
half plane (Propagator validity conditions) *)
validPointQ[prop_, s_, cv_] := TrueQ[s > 0] && TrueQ[And @@ \
(prop[\"ValidityConditions\"][s] /. DeltaCoefficient[m_][_] :> (cc[m] /. \
cv))];\
\>", "Program",ExpressionUUID->"26a6d6b5-313d-40d3-87f2-5d5098dfa470"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:77-80 *)
(* a sample at a valid point, for values that are reported as sizes \
(Neglected); zero tests do not need valid points *)
validSample[e_, prop_, w_, deg_, seed_] := Module[{r},
   Do[r = sampleValue[e, prop, w, deg, seed + 1009 j]; If[r[[2]], \
Return[r[[1]], Module]], {j, 0, 199}];
   FRGAssert[\"FrequencyIntegration.validPoint\", False, e, \"no random point \
satisfies the validity conditions in 200 tries: check the signs of the ansatz\
\"]];\
\>", "Program",ExpressionUUID->"f67489df-5ef6-4215-8d4e-c9ebf890d328"],

Cell[TextData[{
 "A flow that must vanish (Protected, DeclaredNumeric, Causality) is not \
integrated symbolically: an exact zero is zero at every point, so three \
random rational points prove it with the reliability of ",
 StyleBox["ExactlyZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 00, section 5). Every atom, ",
 StyleBox["dsR",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["dsCoupling",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gets a random value, and the coefficients of ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " are computed ",
 StyleBox["from",
  FontSlant->Italic],
 " these atoms, so that ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " = det B still holds at the point."
}], "Text",ExpressionUUID->"90dc4fac-95e0-402c-8af8-8963336644a0"],

Cell[TextData[{
 "A Neglected flow is reported as a size, so its point must be physical: q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " > 0 and the validity conditions of the propagator satisfied. ",
 StyleBox["validSample",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " redraws points until one is valid."
}], "Text",ExpressionUUID->"701a2321-4e80-40c8-9f32-c60e76f7ca85"],

Cell[TextData[{
 StyleBox["Mathematica: Return from a loop",
  FontWeight->Bold],
 "\n",
 StyleBox["Do[..., {j, 0, 199}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a loop; ",
 StyleBox["Return[value, Module]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " leaves the enclosing ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " at once with that value.",
 "\n\n",
 StyleBox["validSample",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tries up to 200 seeds and returns the first valid sample; if the loop \
ends, the next line, a failing ",
 StyleBox["FRGAssert",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", runs. ",
 StyleBox["And @@ list",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Apply",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") combines a list of conditions into one."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"864fa15c-368d-43d5-8f84-28ca02f447ca"],

Cell["5. The constructor", "Section",ExpressionUUID->"dc26c8a2-d04f-4518-baf2-87ac4e7ca895"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:82-102 *)
IntegrateFrequencies[projected_] := Block[{$FRGModule = \
\"FrequencyIntegration\"},
  Module[{t0 = AbsoluteTime[], prop, w, deg, res, checks = {}, warns = {}, \
stage, symbolicC, nI},
   validateStage[projected, \"Projection\"];
   prop = projected[\"Loops\"][\"Propagator\"]; w = projected[\"LoopFrequency\
\"]; deg = prop[\"DeltaDegree\"];
   symbolicC = Thread[cc /@ Range[0, 2] -> \
(DeltaCoefficient[#][LoopMomentumSquared] & /@ Range[0, 2])];
   res = Function[r, Module[{t1 = AbsoluteTime[], out},
        out = If[r[\"Class\"] === \"Declared\",
          <|\"Value\" -> integrate[r[\"Integrand\"], w, deg, symbolicC]|>,
          If[r[\"Class\"] === \"Neglected\",
           <|\"Samples\" -> {validSample[r[\"Integrand\"], prop, w, deg, 1]}, \
\"SampleValid\" -> True|>,
           <|\"Samples\" -> Table[First[sampleValue[r[\"Integrand\"], prop, \
w, deg, sd]], {sd, {1, 2, 3}}]|>]];
        Join[KeyDrop[r, \"Integrand\"], out, <|\"Seconds\" -> AbsoluteTime[] \
- t1|>]]] /@ projected[\"Integrands\"];
   nI = Length[Select[DownValues[FrequencyIntegral], FreeQ[#, Pattern] &]];
   AppendTo[checks, assertCheck[\"FrequencyIntegration.allIntegrated\", True, \
Null, \"\",
     ToString[Count[res, KeyValuePattern[\"Class\" -> \"Declared\"]]] <> \" \
symbolic, \" <> ToString[Count[res, _?(KeyExistsQ[#, \"Samples\"] &)]] <>
      \" sampled; no leftover w, Delta or radicals; \" <> ToString[nI] <> \" \
distinct residue integrals\"]];
   AppendTo[warns, infoCheck[\"INFO\", \"FrequencyIntegration.samples\", \
\"zero tests use 3 arbitrary random points; Neglected values use one point \
where q^2 > 0 and the validity conditions hold\"]];
   AppendTo[warns, infoCheck[\"ASSUMPTION\", \"FrequencyIntegration.poles\", \
\"all roots of Delta(w) in the upper half plane (Propagator validity \
conditions)\"]];
   stage = stampStage[<|\"Stage\" -> \"Integrated\", \"Pipeline\" -> \
\"DerivativeExpansion\", \"Upstream\" -> {projected[\"Fingerprint\"]},
      \"Projection\" -> projected, \"Flows\" -> res, \"Checks\" -> checks, \
\"Warnings\" -> warns, \"Timing\" -> AbsoluteTime[] - t0|>];
   PrintCard[stage];\
\>", "Program",ExpressionUUID->"bee0a93a-835d-496c-bb8e-2f0c6180cacc"],

Cell[TextData[{
 StyleBox["Join[KeyDrop[r, \"Integrand\"], out, <|\"Seconds\" -> ...|>]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces the integrand of each record by its result and adds the time it \
took; ",
 StyleBox["Join",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " merges associations (",
 StyleBox["Association",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ")."
}], "Text",ExpressionUUID->"2e92ea27-2662-4493-bd42-515e52bc1c38"],

Cell[TextData[{
 StyleBox["Why it's built this way: Symbolic where needed, sampled where \
enough",
  FontWeight->Bold],
 "\n\n",
 "Only the Declared flows become equations, so only they are integrated \
symbolically. The others only have to be shown zero, or measured; doing that \
at exact random points is faster by orders of magnitude and loses nothing: a \
zero test at random rationals is as reliable as a symbolic simplification, \
and much more so than ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " on large expressions. The card says how it was done (the INFO line), so \
that a reader knows what \"0\" means."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"b15f5187-54c1-4a41-9696-9d2a59e55179"],

Cell["Exercises", "Section",ExpressionUUID->"5322ebff-c5df-4539-9d3b-fa1c74ecf106"],

Cell["Exercise: A residue by hand", "Subsection",ExpressionUUID->"28b0c42c-65c7-41b3-9d5b-81fb4c44d31e"],

Cell[TextData[{
 "For degree 1, ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") = c0 + i c1 ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " has its root at ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " = i c0/c1. Compute ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 " d",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " / (",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ")) by residues and compare with ",
 StyleBox["FrequencyIntegral[0, 1, 1, 1]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"364194f0-2e00-4b5a-be9c-ce8493a5a905"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"7b55b660-c5c2-49ec-a946-cc92e1e2e3cb"],

Cell[TextData[{
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ") = c0",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " + c1",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Omega]\.b2",
  FontFamily->"Noto Sans"],
 ": the residue at ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " = i c0/c1 of 1/(c1",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " i c0/c1)(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " + i c0/c1)) is 1/(c1",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 " 2i c0/c1) = 1/(2i c0 c1); times 2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 "i gives ",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 "/(c0 c1)."
}], "Text",ExpressionUUID->"269fbb8d-3a42-44a9-8ef8-31744e943a86"],

Cell["FrequencyIntegral[0, 1, 1, 1]", "Input",ExpressionUUID->"c935d094-49eb-4168-9c4d-177c71cade7f"]
}, Closed]],

Cell["Exercise: Degree 2 against NIntegrate", "Subsection",ExpressionUUID->"be635eab-ee12-48b5-9452-954c29aed629"],

Cell[TextData[{
 "Take ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") = 2 + 3(i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") + (i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " (roots in the upper half plane). Compare ",
 StyleBox["FrequencyIntegral[2, 2, 2, 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with a numerical integral of ",
 StyleBox["\[Omega]\.b2",
  FontFamily->"Noto Sans"],
 "/(",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")."
}], "Text",ExpressionUUID->"f5aac6f9-e521-4784-9245-b3cc2b6c47e9"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"466c9514-4803-4ce3-8ee9-01d7397e7b6f"],

Cell["\<\
dd[x_] := 2 + 3 I x - x^2;
{N[FrequencyIntegral[2, 2, 2, 2] /. {FrequencyIntegralC[0] -> 2, \
FrequencyIntegralC[1] -> 3, FrequencyIntegralC[2] -> 1}],
 NIntegrate[w^2/(dd[w]^2 dd[-w]^2), {w, -Infinity, Infinity}]}\
\>", "Input",ExpressionUUID->"e76a5306-6777-4e1d-90af-ecb94498f583"]
}, Closed]],

Cell["Exercise: Which flows are sampled", "Subsection",ExpressionUUID->"c87b2075-7d44-4a88-b8ff-fbe41f59bc8c"],

Cell[TextData[{
 "List the classes of the records of ",
 StyleBox["integrated[\"Flows\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and how many have a ",
 StyleBox["\"Value\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " or ",
 StyleBox["\"Samples\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"91e0866b-3c62-4a2d-90bd-20d4f0f02913"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"6ab07b96-b3c2-4ebb-a957-95743671a943"],

Cell["\<\
Tally[{#Class, If[KeyExistsQ[#, \"Value\"], \"Value\", \"Samples\"]} & /@ \
integrated[\"Flows\"]]\
\>", "Input",ExpressionUUID->"dbcc171c-7a88-46b5-9e10-18c8c4277386"],

Cell[TextData[{
 StyleBox["Tally",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " counts the distinct pairs: only the two Declared monomials (",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " and D) are symbolic."
}], "Text",ExpressionUUID->"d1b59b7a-5133-487c-a025-bc98495faf7b"]
}, Closed]]
},

Cell[TextData[{
 StyleBox["Mathematica: Memoization of a function",
  FontWeight->Bold],
 "\n",
 StyleBox["f[n_, a_] := f[n, a] = ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stores each computed value as a new definition of f, so the next call with \
the same arguments returns it at once.",
 "\n\n",
 "This is ",
 StyleBox["Memoization",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " applied to a top-level function: ",
 StyleBox["FrequencyIntegral[0, 1, 1, 1]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is computed once per session, and every integrand that needs it afterwards \
reuses the stored rule. The stored values are visible in ",
 StyleBox["DownValues[FrequencyIntegral]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["OwnValues and DownValues",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") as the rules without patterns; the card counts them."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"9c3baa96-de58-4242-826b-eeb62137a92c"],

Cell["\<\
Length[Select[DownValues[FrequencyIntegral], FreeQ[#, Pattern] &]]\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"0bfff8ed-7747-4728-b601-8d5774f56b5f"],

Cell[TextData[{
 StyleBox["Why it's built this way: A memoised formula instead of a lookup \
table",
  FontWeight->Bold],
 "\n\n",
 "The original notebook used a hand-made table of integrals, which had to be \
extended whenever a new combination (n, a, b) appeared, and silently missed \
any combination that was not in it. Here each integral is computed from one \
residue formula the first time it is needed and remembered: nothing is \
skipped, and nothing depends on the order of rules. The memo is a cache of a \
pure function of (n, a, b, deg), so it is the one kind of global state that \
cannot make results depend on history."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"df1f015d-3be3-4607-b53a-72bf5a4994fd"],

Cell["3. Integrating an integrand", "Section",ExpressionUUID->"43d55365-b139-45ce-9fd8-c69a56929f11"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:80-99 *)
(* dispatch on monomials w^n Prod_f X_f^a_f Y_f^b_f, X_f = 1/Delta(w, s_f), \
Y_f = 1/Delta(-w, s_f): one family per distinct momentum
   argument s_f; a monomial with one family uses FrequencyIntegral, several \
use FrequencyIntegralFamilies. coefOf[s] = {c0, c1, c2} at s.
   No table, nothing skipped *)
integrate[e_, w_, deg_, coefOf_] := Module[{args, exy, xs, ys, res, nf},
   args = DeleteDuplicates[Expand /@ Cases[e, \\[CapitalDelta][w | -w, s_] :> \
s, {0, Infinity}]];
   nf = Length[args];
   xs = Array[famX, nf]; ys = Array[famY, nf];
   exy = e /. \\[CapitalDelta][x_, s_] :> With[{i = FirstPosition[args, \
Expand[s], {0}, {1}][[1]]}, Which[i == 0, \\[CapitalDelta][x, s], x === w, \
1/xs[[i]], x === -w, 1/ys[[i]], True, \\[CapitalDelta][x, s]]];
   FRGAssert[\"FrequencyIntegration.ready\", FreeQ[exy, \\[CapitalDelta] | \
Derivative[__][\\[CapitalDelta]]], Cases[exy, _\\[CapitalDelta], Infinity],
    \"integrand not ready: Delta with another argument\"];
   res = Total[Function[cr, Module[{ex = Transpose[{cr[[1, 2 ;; nf + 1]], \
cr[[1, nf + 2 ;;]]}], used},
        used = Flatten[Position[ex, {a_, b_} /; a + b > 0, {1}, Heads -> \
False]];
        cr[[2]] Which[
          used === {}, FRGAssert[\"FrequencyIntegration.convergence\", False, \
cr, \"a term without propagator: the frequency integral diverges\"],
          Length[used] == 1, FrequencyIntegral[cr[[1, 1]], ex[[used[[1]], \
1]], ex[[used[[1]], 2]], deg] /. Thread[cc /@ Range[0, 2] -> \
coefOf[args[[used[[1]]]]]],
          True, FrequencyIntegralFamilies[cr[[1, 1]], ex[[used]], deg] /.
            Flatten[Table[Thread[Table[FrequencyIntegralC[j, m], {m, 0, 2}] \
-> coefOf[args[[used[[j]]]]]], {j, Length[used]}]]]]] /@
      CoefficientRules[exy, Join[{w}, xs, ys]]];
   FRGAssert[\"FrequencyIntegration.complete\", FreeQ[res, w | famX | famY | \
\\[CapitalDelta] | Power[_, _Rational]], res, \"leftover w, Delta or radicals\
\"];
   res];\
\>", "Program",ExpressionUUID->"421ac223-fb02-4898-9a9e-70fd5c097fad"],

Cell[TextData[{
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " 1/X and ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ") ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " 1/Y turn the integrand into a polynomial in ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", X, Y with coefficients free of ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "."
}], "Text",ExpressionUUID->"c7a7245b-eb6a-4db8-9818-24360d214e41"],

Cell[TextData[{
 StyleBox["Mathematica: CoefficientRules",
  FontWeight->Bold],
 "\n",
 StyleBox["CoefficientRules[poly, {x, y, ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists the monomials of a polynomial as ",
 StyleBox["{exponents} -> coefficient",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ".",
 "\n\n",
 "Each rule ",
 StyleBox["{n, a, b} -> coefficient",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is one term ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "^n X^a Y^b, so the integral is ",
 StyleBox["Total",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of coefficient ",
 StyleBox["\[Times]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["FrequencyIntegral[n, a, b, deg]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". This dispatches on the structure of the integrand, term by term, without \
pattern rules that could miss a term."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"d2f79974-c318-4ee0-b63e-b3c7bcd42119"],

Cell["CoefficientRules[3 w^2 x + 5 y, {w, x, y}]", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"cbf7373e-5bdf-4103-bab2-f0f3f73e07e9"],

Cell["4. Sampled flows", "Section",ExpressionUUID->"7bc59b47-2603-4b43-b06b-96deb1ec6c08"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:110-119 *)
samplePoint[e_, prop_, w_, seed_] := Module[{e1, syms, pt, memo, mom},
   e1 = e /. {DeltaCoefficient[m_][s_] :> prop[\"DeltaCoefficients\"][s][[m + \
1]],
       Derivative[k_][DeltaCoefficient[m_]][s_] :> \
(D[prop[\"DeltaCoefficients\"][xs][[m + 1]], {xs, k}] /. xs -> s)} /. \
\\[CapitalDelta] -> dd;
   syms = DeleteCases[Complement[Union[Cases[e1, x_Symbol /; Context[x] =!= \
\"System`\", {0, Infinity}, Heads -> False]], momentumInvariants], w];
   pt = RandomRationalPoint[syms, seed];
   mom = momentumPoint[seed];
   SeedRandom[seed + 104729];
   memo[x_] := memo[x] = RandomInteger[{2, 60}]/RandomInteger[{61, 97}];
   e1 = e1 /. mom /. pt /. sampleAtoms :> memo[x];
   {e1 /. dd -> \\[CapitalDelta], Join[pt, mom], memo}];\
\>", "Program",ExpressionUUID->"7df3d3b5-ca73-400d-a838-a40d1cf0db9c"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:121-126 *)
(* {value, valid}: valid = every momentum argument of a Delta is > 0 and \
satisfies the Propagator validity conditions there *)
sampleValue[e_, prop_, w_, deg_, seed_] := Module[{e1, pt, memo, coefOf, args},
   {e1, pt, memo} = samplePoint[e, prop, w, seed];
   coefOf = Function[s, prop[\"DeltaCoefficients\"][s] /. x : \
(GammaAtom[__][_]) :> memo[x]];
   args = DeleteDuplicates[Cases[e1, \\[CapitalDelta][_, s_] :> s, {0, \
Infinity}]];
   {integrate[e1, w, deg, coefOf], AllTrue[args, validPointQ[prop, #, \
coefOf[#]] &]}];\
\>", "Program",ExpressionUUID->"0ff6af19-415e-4ceb-84d5-2b8fd806d2f9"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:128-129 *)
(* the point is physical: s > 0 and every root of Delta(w) in the upper half \
plane (Propagator validity conditions) *)
validPointQ[prop_, s_, cv_] := TrueQ[s > 0] && TrueQ[And @@ \
(prop[\"ValidityConditions\"][s] /. DeltaCoefficient[m_][_] :> cv[[m + 1]])];\
\
\>", "Program",ExpressionUUID->"7529bcb4-8058-4eab-88cb-c15c7cfb4a43"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:131-134 *)
(* a sample at a valid point, for values that are reported as sizes \
(Neglected); zero tests do not need valid points *)
validSample[e_, prop_, w_, deg_, seed_] := Module[{r},
   Do[r = sampleValue[e, prop, w, deg, seed + 1009 j]; If[r[[2]], \
Return[r[[1]], Module]], {j, 0, 199}];
   FRGAssert[\"FrequencyIntegration.validPoint\", False, e, \"no random point \
satisfies the validity conditions in 200 tries: check the signs of the ansatz\
\"]];\
\>", "Program",ExpressionUUID->"776e684b-5a6d-4514-b6b2-0ff87166a8b6"],

Cell[TextData[{
 "A flow that must vanish (Protected, DeclaredNumeric, Causality) is not \
integrated symbolically: an exact zero is zero at every point, so three \
random rational points prove it with the reliability of ",
 StyleBox["ExactlyZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 00, section 5). Every atom, ",
 StyleBox["dsR",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["dsCoupling",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gets a random value, and the coefficients of ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " are computed ",
 StyleBox["from",
  FontSlant->Italic],
 " these atoms, so that ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " = det B still holds at the point."
}], "Text",ExpressionUUID->"7d73a9ca-2e46-4057-819d-a231bb9e7ebf"],

Cell[TextData[{
 "A Neglected flow is reported as a size, so its point must be physical: q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " > 0 and the validity conditions of the propagator satisfied. ",
 StyleBox["validSample",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " redraws points until one is valid."
}], "Text",ExpressionUUID->"37db1108-5e89-418f-af1c-47c24db36243"],

Cell[TextData[{
 StyleBox["Mathematica: Return from a loop",
  FontWeight->Bold],
 "\n",
 StyleBox["Do[..., {j, 0, 199}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a loop; ",
 StyleBox["Return[value, Module]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " leaves the enclosing ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " at once with that value.",
 "\n\n",
 StyleBox["validSample",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tries up to 200 seeds and returns the first valid sample; if the loop \
ends, the next line, a failing ",
 StyleBox["FRGAssert",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", runs. ",
 StyleBox["And @@ list",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Apply",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") combines a list of conditions into one."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"e1b9db80-1e99-4b9b-9a03-1e45db1c1e15"],

Cell["5. The constructor", "Section",ExpressionUUID->"3bf4a994-499b-419a-b733-563180db43b2"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:138-163 *)
IntegrateFrequencies[projected_] := Block[{$FRGModule = \
\"FrequencyIntegration\"},
  Module[{t0 = AbsoluteTime[], prop, w, deg, res, checks = {}, warns = {}, \
stage, nI, nF, zeroSamples},
   validateStage[projected, \"Projection\"];
   prop = projected[\"Loops\"][\"Propagator\"]; w = projected[\"LoopFrequency\
\"]; deg = prop[\"DeltaDegree\"];
   zeroSamples[ig_] := Table[First[sampleValue[ig, prop, w, deg, sd]], {sd, \
{1, 2, 3}}];
   res = Function[r, Module[{t1 = AbsoluteTime[], out},
        out = Switch[r[\"Class\"],
          \"Declared\", <|\"Value\" -> integrate[r[\"Integrand\"], w, deg, \
symbolicCoefficients]|>,
          \"Functional\", Join[<|\"Value\" -> integrate[r[\"Integrand\"], w, \
deg, symbolicCoefficients],
             \"AtZeroValue\" -> integrate[r[\"AtZero\"], w, deg, \
symbolicCoefficients]|>,
            If[r[\"ProtectedAtZero\"] === None, <||>, <|\"AtZeroSamples\" -> \
zeroSamples[r[\"AtZero\"]]|>]],
          \"Neglected\", <|\"Samples\" -> {validSample[r[\"Integrand\"], \
prop, w, deg, 1]}, \"SampleValid\" -> True|>,
          _, <|\"Samples\" -> zeroSamples[r[\"Integrand\"]]|>];
        Join[KeyDrop[r, {\"Integrand\", \"AtZero\"}], out, <|\"Seconds\" -> \
AbsoluteTime[] - t1|>]]] /@ projected[\"Integrands\"];
   nI = Length[Select[DownValues[FrequencyIntegral], FreeQ[#, Pattern] &]];
   nF = Length[Select[DownValues[FrequencyIntegralFamilies], FreeQ[#, \
Pattern] &]];
   AppendTo[checks, assertCheck[\"FrequencyIntegration.allIntegrated\", True, \
Null, \"\",
     ToString[Count[res, KeyValuePattern[\"Class\" -> \"Declared\" | \
\"Functional\"]]] <> \" symbolic, \" <> ToString[Count[res, _?(KeyExistsQ[#, \
\"Samples\"] &)]] <>
      \" sampled; no leftover w, Delta or radicals; \" <> ToString[nI] <> \" \
distinct residue integrals\" <>
      If[nF > 0, \", \" <> ToString[nF] <> \" with several pole families \
(combined residues, finite where families coincide)\", \"\"]]];
   AppendTo[warns, infoCheck[\"INFO\", \"FrequencyIntegration.samples\", \
\"zero tests use 3 arbitrary random points; Neglected values use one point \
where q^2 > 0 and the validity conditions hold\"]];
   AppendTo[warns, infoCheck[\"ASSUMPTION\", \"FrequencyIntegration.poles\", \
\"all roots of Delta(w) in the upper half plane (Propagator validity \
conditions)\" <>
      If[nF > 0, \", at every momentum argument (|q -+ p/2|^2 and q^2 for the \
generic-p flows)\", \"\"]]];
   stage = stampStage[<|\"Stage\" -> \"Integrated\", \"Pipeline\" -> \
\"DerivativeExpansion\", \"Upstream\" -> {projected[\"Fingerprint\"]},
      \"Projection\" -> projected, \"Flows\" -> res, \"Checks\" -> checks, \
\"Warnings\" -> warns, \"Timing\" -> AbsoluteTime[] - t0|>];
   PrintCard[stage];\
\>", "Program",ExpressionUUID->"5eae1b79-6ac2-4f55-a0e4-e44245ab4f81"],

Cell[TextData[{
 StyleBox["Join[KeyDrop[r, \"Integrand\"], out, <|\"Seconds\" -> ...|>]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces the integrand of each record by its result and adds the time it \
took; ",
 StyleBox["Join",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " merges associations (",
 StyleBox["Association",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ")."
}], "Text",ExpressionUUID->"505f58ca-9e0b-4d69-bb79-bf18bb6101da"],

Cell[TextData[{
 StyleBox["Why it's built this way: Symbolic where needed, sampled where \
enough",
  FontWeight->Bold],
 "\n\n",
 "Only the Declared flows become equations, so only they are integrated \
symbolically. The others only have to be shown zero, or measured; doing that \
at exact random points is faster by orders of magnitude and loses nothing: a \
zero test at random rationals is as reliable as a symbolic simplification, \
and much more so than ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " on large expressions. The card says how it was done (the INFO line), so \
that a reader knows what \"0\" means."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"198e073f-da83-439f-8c23-9e54d4bc6cb1"],

Cell["Exercises", "Section",ExpressionUUID->"78fb7997-21a1-4014-942c-5d2f92b16a1b"],

Cell["Exercise: A residue by hand", "Subsection",ExpressionUUID->"ecfb635f-d91f-4a3a-b630-f64de58c8a2a"],

Cell[TextData[{
 "For degree 1, ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") = c0 + i c1 ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " has its root at ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " = i c0/c1. Compute ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 " d",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " / (",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ")) by residues and compare with ",
 StyleBox["FrequencyIntegral[0, 1, 1, 1]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"49abcff3-5b30-4148-8e5c-4d68b0770df8"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"ea447ecd-99ae-4d69-a34f-0f08af9a9736"],

Cell[TextData[{
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ") = c0",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " + c1",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Omega]\.b2",
  FontFamily->"Noto Sans"],
 ": the residue at ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " = i c0/c1 of 1/(c1",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " i c0/c1)(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " + i c0/c1)) is 1/(c1",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 " 2i c0/c1) = 1/(2i c0 c1); times 2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 "i gives ",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 "/(c0 c1)."
}], "Text",ExpressionUUID->"f6bd6500-ecdb-41a9-a45b-72d8dc81ec1c"],

Cell["FrequencyIntegral[0, 1, 1, 1]", "Input",ExpressionUUID->"1b06a6c3-d172-4203-a50d-39813c81828f"]
}, Closed]],

Cell["Exercise: Degree 2 against NIntegrate", "Subsection",ExpressionUUID->"85845d63-9eb0-4e06-a3e7-8116cd047647"],

Cell[TextData[{
 "Take ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") = 2 + 3(i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") + (i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " (roots in the upper half plane). Compare ",
 StyleBox["FrequencyIntegral[2, 2, 2, 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with a numerical integral of ",
 StyleBox["\[Omega]\.b2",
  FontFamily->"Noto Sans"],
 "/(",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")."
}], "Text",ExpressionUUID->"6850d52b-7084-47e7-9e40-93cd26d08aa2"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"149d3df7-a5d3-4b43-8ade-08100132af91"],

Cell["\<\
dd[x_] := 2 + 3 I x - x^2;
{N[FrequencyIntegral[2, 2, 2, 2] /. {FrequencyIntegralC[0] -> 2, \
FrequencyIntegralC[1] -> 3, FrequencyIntegralC[2] -> 1}],
 NIntegrate[w^2/(dd[w]^2 dd[-w]^2), {w, -Infinity, Infinity}]}\
\>", "Input",ExpressionUUID->"233a1046-8cd5-4020-9d2c-ca2eccaa4604"]
}, Closed]],

Cell["Exercise: Which flows are sampled", "Subsection",ExpressionUUID->"86f5fcbe-5a2e-4dbf-b38c-8679d0e9a5d6"],

Cell[TextData[{
 "List the classes of the records of ",
 StyleBox["integrated[\"Flows\"]",

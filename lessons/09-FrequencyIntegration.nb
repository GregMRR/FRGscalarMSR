Cell[TextData[{
 "The first is the flow of ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " (class Declared): symbolic, in atoms. The second is protected by the \
Galilean Ward identity: it is not integrated symbolically, only evaluated \
exactly at three random points, and all three values are 0 (the closure check \
of lesson 10 will assert it)."
}], "Text",ExpressionUUID->"5ebbc56b-7ac2-4a5e-a4d5-d421908c1c91"],

Cell["2. One integral, by residues", "Section",ExpressionUUID->"5ee12a63-630a-48e7-a479-c0adf83ac1ee"],

Cell["\<\
(* Kernel/FrequencyIntegration.wl:27-50 *)
(* residues at the roots z1, z2 of Delta(w) (upper half plane); z1,2 = I \
alpha +- beta, the result is even in beta *)
FrequencyIntegral[n_Integer, a_Integer, b_Integer, deg_Integer] := \
FrequencyIntegral[n, a, b, deg] = Block[{$FRGModule = \
\"FrequencyIntegration\"},
   Module[{w, z1, z2, z, f1, f2, r, al, be, x, num, den},
    FRGAssert[\"FrequencyIntegration.convergence\", n - deg (a + b) <= -2, \
{n, a, b, deg},
     \"divergent frequency integral: the integrand does not decay faster than \
1/w^2\"];
    Which[
     a == 0, 0,   (* no pole in the upper half plane *)
     deg == 1,
      z = I cc[0]/cc[1];
      f1 = w^n/((I cc[1])^a (-I cc[1])^b (w + z)^b);
      Together[2 Pi I (D[f1, {w, a - 1}] /. w -> z)/(a - 1)!],
     deg == 2,
      z1 = I al + be; z2 = I al - be;
      f1 = w^n/((-cc[2])^(a + b) (w - z2)^a ((w + z1) (w + z2))^b);
      f2 = w^n/((-cc[2])^(a + b) (w - z1)^a ((w + z1) (w + z2))^b);
      r = Together[2 Pi I ((D[f1, {w, a - 1}] /. w -> z1) + (D[f2, {w, a - \
1}] /. w -> z2))/(a - 1)!];
      (* make the denominator even in beta, then beta^2 -> x *)
      num = Expand[Numerator[r] (Denominator[r] /. be -> -be)]; den = \
Expand[Denominator[r] (Denominator[r] /. be -> -be)];
      FRGAssert[\"FrequencyIntegration.evenInBeta\", Expand[(num /. be -> \
-be) - num] === 0 && Expand[(den /. be -> -be) - den] === 0, {n, a, b},
       \"internal: the residue sum is not symmetric in the two roots\"];
      r = Together[((num /. be -> Sqrt[x]) /(den /. be -> Sqrt[x])) /. {x -> \
(4 cc[0] cc[2] - cc[1]^2)/(4 cc[2]^2), al -> cc[1]/(2 cc[2])}];
      FRGAssert[\"FrequencyIntegration.rational\", FreeQ[r, be | x | al | \
Power[_, _Rational]], r, \"internal: square roots survived\"];
      r,
     True, FRGAssert[\"FrequencyIntegration.degree\", False, deg, \"deg Delta \
must be 1 or 2\"]]]];\
\>", "Program",ExpressionUUID->"18cbd380-404f-4352-bf9e-37eac79f02cf"],

Cell[TextData[{
 "The residue of a pole of order a at z is the (a",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1)-th derivative of (",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " z)^a f(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "), at z, divided by (a",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1)! (",
 StyleBox["Repeated derivatives",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 08)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "). With degree 2, the roots are z1,2 = i",
 StyleBox["\[Alpha]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[PlusMinus]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 "; the sum of the two residues is symmetric under z1 ",
 StyleBox["\[LeftRightArrow]",
  FontFamily->"Noto Sans"],
 " z2, hence even in ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 ", and replacing ",
 StyleBox["\[Beta]\.b2",
  FontFamily->"Noto Sans"],
 " by (4c0c2 ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " c1",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")/(4c2",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ") makes the result rational. The same formula covers the overdamped (",
 StyleBox["\[Beta]\.b2",
  FontFamily->"Noto Sans"],
 " < 0) and the underdamped (",
 StyleBox["\[Beta]\.b2",
  FontFamily->"Noto Sans"],
 " > 0) cases."
}], "Text",ExpressionUUID->"e64652f7-c925-4c30-bf3c-d559a5ff9e29"],

Cell["\<\
{FrequencyIntegral[0, 1, 1, 1], FrequencyIntegral[0, 1, 1, 2]}\
\>", "Input",ExpressionUUID->"29e1eab6-5df4-4f3b-b43f-6686a3ba32f4"],


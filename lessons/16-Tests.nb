Notebook[{
Cell["Lesson 16 - Tests", "Title",ExpressionUUID->"94560651-6b59-4306-b583-9e097e0e5e37"],

Cell[TextData[{
 "The library's checks run inside the pipeline, on your model, every time. \
The test suite checks the library itself: that each module gives known \
results on known models, and that each check fires when it should. This \
lesson reads the harness ",
 StyleBox["tests/runTests.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and the way tests are written, and points to the benchmarks."
}], "Text",ExpressionUUID->"c7863986-1605-44d6-a275-e526fb3c404d"],

Cell["\<\
Get[\"~/Physics/Sources/FRGscalarMSR/FRGscalarMSR.wl\"];
Get[FileNameJoin[{$FRGRoot, \"lessons\", \"LessonSetup.wl\"}]]\
\>", "Input",ExpressionUUID->"f768a898-dd43-46e9-9427-5f60b725dc7e"],

Cell["1. Running the suite", "Section",ExpressionUUID->"4127b66b-075a-413f-85c9-664fc9eb5aa6"],

Cell[TextData[{
 "From a shell: ",
 StyleBox["math -script tests/runTests.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs every file (exit code 0 means all pass); ",
 StyleBox["--only TheoryTest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs the files whose name contains the string; ",
 StyleBox["--verbose",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " shows the cards and FAIL blocks; ",
 StyleBox["--require-julia",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns the SKIPs of the Julia tests into failures. From a notebook, a \
separate kernel can run it:"
}], "Text",ExpressionUUID->"cf4f79ad-b462-4ee1-a7c8-8f77b912e020"],

Cell[TextData[{
 StyleBox["Mathematica: RunProcess",
  FontWeight->Bold],
 "\n",
 StyleBox["RunProcess[{\"cmd\", \"arg\", ...}, \"StandardOutput\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs an external program and returns what it printed.",
 "\n\n",
 "The tests run in a fresh kernel, as a script, so they cannot disturb this \
notebook's kernel, and the ",
 StyleBox["Exit[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " at the end of the harness ends that process only."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"7f863c4d-20c8-4ace-bbe3-ec5300a2a230"],

Cell["\<\
RunProcess[{\"math\", \"-script\", FileNameJoin[{$FRGRoot, \"tests\", \
\"runTests.wl\"}], \"--only\", \"TheoryTest\"}, \"StandardOutput\"]\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"9429e328-f5b1-4a9d-a3eb-53c894ffaaa6"],

Cell["2. The harness", "Section",ExpressionUUID->"14b8657e-7160-4260-9f34-f16ac80493af"],

Cell["\<\
(* tests/runTests.wl:8-13 *)
$HistoryLength = 0;
testRoot = DirectoryName[$InputFileName];
Get[FileNameJoin[{ParentDirectory[testRoot], \"FRGscalarMSR.wl\"}]];
verboseQ = MemberQ[$CommandLine, \"--verbose\"];
requireJuliaQ = MemberQ[$CommandLine, \"--require-julia\"];
$FRGExitOnFail = False;   (* failed checks abort (caught below) instead of \
exiting the kernel *)\
\>", "Program",ExpressionUUID->"d9f43610-34df-4a73-9809-ea60ca2c26aa"],

Cell[TextData[{
 StyleBox["$FRGExitOnFail = False",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns every failed check into an ",
 StyleBox["Abort[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " instead of ",
 StyleBox["Exit[2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Abort, CheckAbort, Exit",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "), so the harness can catch failures and go on. ",
 StyleBox["$HistoryLength = 0",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stops the kernel from remembering every output (",
 StyleBox["Out[n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), which matters with million-leaf expressions."
}], "Text",ExpressionUUID->"7f2ebc2f-6836-457c-a219-5553df078d2c"],

Cell["\<\
(* tests/runTests.wl:16-19 *)
SetAttributes[quiet, HoldAll];
quiet[e_] := If[verboseQ, e, Block[{Print}, e]];
record[name_, ok_, msg_] := (AppendTo[results, {name, TrueQ[ok]}];
   If[! TrueQ[ok] || verboseQ, Print[If[TrueQ[ok], \"  ok    \", \"  FAIL  \
\"], name, If[TrueQ[ok], \"\", \"   \" <> msg]]]);\
\>", "Program",ExpressionUUID->"1a117a7e-579d-4568-be24-bd64f8ce4595"],

Cell["\<\
(* tests/runTests.wl:21-23 *)
(* skip[name, why]: a test that cannot run here (julia, FlowRG missing); a \
failure with --require-julia *)
skip[name_String, why_String] := (AppendTo[skipped, name]; Print[\"  SKIP  \
\", name, \"   \", why];
   If[requireJuliaQ, record[name, False, \"skipped with --require-julia: \" \
<> why]]);\
\>", "Program",ExpressionUUID->"8fd36d5c-547e-449d-8091-2f2b59cdf16e"],

Cell["\<\
(* tests/runTests.wl:25-28 *)
(* test[name, actual, expected]: actual must evaluate (without aborting) to \
expected *)
SetAttributes[test, HoldRest];
test[name_String, actual_, expected_] := Module[{a = \
CheckAbort[quiet[actual], $Aborted], e = expected},
   record[name, a === e, \"got \" <> ToString[Short[InputForm[a], 3]] <> \", \
expected \" <> ToString[Short[InputForm[e], 3]]]];\
\>", "Program",ExpressionUUID->"d1ea31cd-ff51-4b63-82d1-b52ef16beb91"],

Cell["\<\
(* tests/runTests.wl:30-36 *)
(* expectFail[name, expr, check]: expr must abort through the library check \
named check *)
SetAttributes[expectFail, HoldRest];
expectFail[name_String, expr_, check_String] := Module[{r},
   $FRGLastFailure = None;
   r = CheckAbort[quiet[expr]; \"returned\", \"aborted\"];
   record[name, r === \"aborted\" && $FRGLastFailure === check,
    \"outcome \" <> r <> \", failed check \" <> ToString[$FRGLastFailure] <> \
\" (expected \" <> check <> \")\"]];\
\>", "Program",ExpressionUUID->"0d53aba2-015f-4ad9-b413-0842b1e28fda"],

Cell[TextData[{
 StyleBox["quiet[e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " hides the cards while e runs, unless ",
 StyleBox["--verbose",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Block[{Print}, e]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", as ",
 StyleBox["lessonUpTo",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " does)."
}], "Item",ExpressionUUID->"f35d890a-f410-4bc8-b34b-2a3cded7b2d5"],

Cell[TextData[{
 StyleBox["test[name, actual, expected]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates ",
 StyleBox["actual",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " under ",
 StyleBox["CheckAbort",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and compares it with ",
 StyleBox["expected",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " by ",
 StyleBox["===",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["SameQ and Equal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "): exact structural identity, no tolerance."
}], "Item",ExpressionUUID->"06ba4f80-9cfd-43dc-87ca-8fad6635bae8"],

Cell[TextData[{
 StyleBox["expectFail[name, expr, check]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " passes only if ",
 StyleBox["expr",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " aborts, ",
 StyleBox["and",
  FontSlant->Italic],
 " the check that stopped it is the named one (",
 StyleBox["$FRGLastFailure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). An abort from another check is a failure: a test of ",
 StyleBox["Theory.N",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " that fails on ",
 StyleBox["Theory.scalars.reserved",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is not testing what it says."
}], "Item",ExpressionUUID->"16ba321a-cb4e-414e-a87e-85f29189d087"],

Cell[TextData[{
 StyleBox["skip[name, why]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " records a test that cannot run here (no Julia, no FlowRG)."
}], "Item",ExpressionUUID->"1163be28-267f-46d9-b881-5fa2eed98701"],

Cell[TextData[{
 "Both take their arguments held (",
 StyleBox["HoldRest",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), so the expression is evaluated inside ",
 StyleBox["CheckAbort",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", not before the call (",
 StyleBox["Hold attributes",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ")."
}], "Text",ExpressionUUID->"041aeaaf-0fc8-4147-a933-627fdb2afb72"],

Cell["\<\
(* tests/runTests.wl:38-51 *)
testFiles = Join[FileNames[\"*Test.wl\", FileNameJoin[{testRoot, \"unit\"}]], \
FileNames[\"*.wl\", FileNameJoin[{testRoot, \"acceptance\"}]]];
(* --only Name: run only the test files whose base name contains Name (e.g. \
--only Dimensions, --only KPZ) *)
With[{i = FirstPosition[$CommandLine, \"--only\"]}, If[! MissingQ[i] && \
Length[$CommandLine] > First[i],
   testFiles = Select[testFiles, StringContainsQ[FileBaseName[#], \
$CommandLine[[First[i] + 1]]] &]]];
Do[Module[{n0 = Length[results]},
   Print[\"--- \", FileBaseName[f]];
   CheckAbort[Get[f], record[FileBaseName[f] <> \" (file aborted)\", False, \
\"uncaught abort\"]];
   Print[\"    \", Count[Drop[results, n0], {_, True}], \"/\", \
Length[results] - n0, \" passed\"]], {f, testFiles}];

nFail = Count[results, {_, False}];
Print[\"=== \", Length[results] - nFail, \"/\", Length[results], \" tests \
passed\",
  If[nFail == 0, \"\", \"; FAILED: \" <> StringRiffle[Cases[results, {n_, \
False} :> n], \", \"]],
  If[skipped === {}, \"\", \"; \" <> ToString[Length[skipped]] <> \" \
SKIPPED\"], \" ===\"];
Exit[If[nFail == 0 && results =!= {}, 0, 1]];\
\>", "Program",ExpressionUUID->"8fa93306-c737-4ce1-b94d-bf8f956df044"],

Cell[TextData[{
 "The test files are plain ",
 StyleBox[".wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " files read with ",
 StyleBox["Get",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Get",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") one after the other, in alphabetical order, in one kernel: they share \
global variables. Heavy setups (",
 StyleBox["tests/reference/ShallowWaterSetup.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", about 85 s) are therefore built once, behind ",
 StyleBox["If[! ValueQ[...]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and reused by every file that needs them (CLAUDE.md, Gotchas)."
}], "Text",ExpressionUUID->"a4af6acb-0a26-4aa6-a846-b2b91e52b7f4"],

Cell["3. A unit test file", "Section",ExpressionUUID->"776ec7db-972c-47a4-bd29-690fb7e43d9e"],

Cell["\<\
(* tests/unit/TheoryTest.wl:1-34 *)
(* ::Package:: *)

(* Theory: response fields, field order, collisions *)

Module[{th = quiet[DefineTheory[\"Scalars\" -> {H, Psi}, \"Dimension\" -> \
Dim]]},
  test[\"two scalars: field order\", th[\"Fields\"], {H, Hbar, Psi, Psibar}];
  test[\"two scalars: response fields\", th[\"ResponseFields\"], {Hbar, \
Psibar}];
  test[\"response field of Psi\", ResponseField[th, Psi], Psibar];
  test[\"stage key\", th[\"Stage\"], \"Theory\"]];

test[\"one scalar (KPZ)\", quiet[DefineTheory[\"Scalars\" -> {h}, \"Dimension\
\" -> Dim]][\"Fields\"], {h, hbar}];

expectFail[\"N = 3 aborts (deg Delta <= 2)\", DefineTheory[\"Scalars\" -> \
{f1, f2, f3}, \"Dimension\" -> Dim], \"Theory.N\"];
expectFail[\"reserved name k\", DefineTheory[\"Scalars\" -> {k}, \
\"Dimension\" -> Dim], \"Theory.scalars.reserved\"];
expectFail[\"library name collision\", DefineTheory[\"Scalars\" -> {scal}, \
\"Dimension\" -> Dim], \"Theory.scalars.library\"];
expectFail[\"System symbol\", DefineTheory[\"Scalars\" -> {Pi}, \"Dimension\" \
-> Dim], \"Theory.scalars.system\"];
hh = 3;
expectFail[\"scalar with a value\", DefineTheory[\"Scalars\" -> {hh}, \
\"Dimension\" -> Dim], \"Theory.scalars.symbols\"];
ClearAll[hh];
hf[x_] := x;
expectFail[\"scalar with a definition\", DefineTheory[\"Scalars\" -> {hf}, \
\"Dimension\" -> Dim], \"Theory.scalars.values\"];
ClearAll[hf];
expectFail[\"missing dimension\", DefineTheory[\"Scalars\" -> {H}], \
\"Theory.dimension\"];
expectFail[\"dimension equal to a field\", DefineTheory[\"Scalars\" -> {H}, \
\"Dimension\" -> Hbar], \"Theory.dimensionDistinct\"];
expectFail[\"duplicate scalars\", DefineTheory[\"Scalars\" -> {H, H}, \
\"Dimension\" -> Dim], \"Theory.scalars.duplicates\"];
expectFail[\"unknown option\", DefineTheory[\"Scalars\" -> {H}, \"Dimension\" \
-> Dim, \"Foo\" -> 1], \"Theory.options\"];

(* declared dimension (jac, design/LEVICIVITA.md) *)
test[\"FixedDimension[2] accepted: the stage stores 2\", \
quiet[DefineTheory[\"Scalars\" -> {H}, \"Dimension\" -> \
FixedDimension[2]]][\"Dimension\"], 2];
expectFail[\"FixedDimension[3] aborts\", DefineTheory[\"Scalars\" -> {H}, \
\"Dimension\" -> FixedDimension[3]], \"Theory.dimension\"];
expectFail[\"a literal 2 aborts\", DefineTheory[\"Scalars\" -> {H}, \
\"Dimension\" -> 2], \"Theory.dimension\"];
Dim = 2;
expectFail[\"a leftover Dim = 2 still aborts\", DefineTheory[\"Scalars\" -> \
{H}, \"Dimension\" -> Dim], \"Theory.dimension\"];
ClearAll[Dim];\
\>", "Program",ExpressionUUID->"dec91f79-81ed-4664-8e9b-d76ccba5e724"],

Cell[TextData[{
 "Each check of lesson 01 has an ",
 StyleBox["expectFail",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". That is the rule of the library (CLAUDE.md, Where to change X): a new \
check is a named ",
 StyleBox["FRGAssert",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "/",
 StyleBox["assertCheck",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and it comes with an ",
 StyleBox["expectFail[..., \"Module.check\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " test. A check that is never seen failing might never fail."
}], "Text",ExpressionUUID->"898b800c-44dd-4aed-bdb9-ccb15b168e12"],

Cell[TextData[{
 StyleBox["Why it's built this way: Tests that name the failure",
  FontWeight->Bold],
 "\n\n",
 StyleBox["expectFail",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " compares the ",
 StyleBox["name",
  FontSlant->Italic],
 " of the check that aborted, which is possible only because every check has \
a unique name and records it in ",
 StyleBox["$FRGLastFailure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 00, section 3). The same names appear on the cards, in the FAIL \
blocks, in ",
 StyleBox["docs/MODULES.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and in the tests: one vocabulary for the user, the documentation and the \
test suite. In the notebooks of these lessons, ",
 StyleBox["showFailure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " plays the same role as ",
 StyleBox["expectFail",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": it returns the name, so a cell can be checked by eye."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"be977b8a-e549-41be-bbbe-a825f136693f"],

Cell["4. Kinds of tests", "Section",ExpressionUUID->"64a4c905-6a99-4551-9881-b367cecec532"],

Cell[TextData[{
 StyleBox["Unit tests",
  FontWeight->Bold],
 " (",
 StyleBox["tests/unit/<Module>Test.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "): one file per module, small inputs, every check made to fail at least \
once."
}], "Item",ExpressionUUID->"1c7b52ff-97ba-4aa7-bb6b-b0a9cd9e7778"],

Cell[TextData[{
 StyleBox["Acceptance tests",
  FontWeight->Bold],
 " (",
 StyleBox["tests/acceptance/",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "): whole models against independent results. Shallow water against the \
original hand-derived script and the old notebooks (",
 StyleBox["tests/reference/legacy/",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "); KPZ against Canet's flow (",
 StyleBox["KPZ.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the computation of lesson 11's last exercise); the Julia round trip (",
 StyleBox["tests/reference/JuliaRoundTrip.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", lesson 15)."
}], "Item",ExpressionUUID->"501293a9-a27b-4259-992a-c5009e139961"],

Cell[TextData[{
 StyleBox["Regression tests",
  FontWeight->Bold],
 ": ",
 StyleBox["ProjectionRegression.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " keeps the old projection operator (",
 StyleBox["tests/reference/OldProjection.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") only to require that the new one agrees with it (lesson 08)."
}], "Item",ExpressionUUID->"8baf0a25-affd-4fb7-b3a3-ba29eb2a626f"],

Cell[TextData[{
 StyleBox["Benchmarks",
  FontWeight->Bold],
 " (",
 StyleBox["benchmarks/",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "): published results reproduced with the library, one folder each, with the \
paper's equations (",
 StyleBox["Reference.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), the pipeline (",
 StyleBox["Pipeline.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), the comparisons (",
 StyleBox["Checks.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), a headless driver and a notebook. Each has a suite hook in ",
 StyleBox["tests/acceptance/",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " that only wraps its checks in ",
 StyleBox["test[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ":"
}], "Item",ExpressionUUID->"1a35bd4c-a93b-4a53-befb-098dff936ad1"],

Cell["\<\
(* tests/acceptance/KuramotoSivashinsky.wl:1-15 *)
(* ::Package:: *)

(* Suite hook of benchmarks/KuramotoSivashinsky (Gosteva, Wschebor, Canet, \
arXiv:2607.15784): the library's KS flows equal the
   paper's Eqs. (34)-(37) exactly, including the p^4 projection (d_s tau), \
plus the time-reversal identities at d = 1. The benchmark's
   logic lives in benchmarks/KuramotoSivashinsky; this file only wraps its \
checks in test[...]. *)

ksBenchDir = FileNameJoin[{ParentDirectory[testRoot], \"benchmarks\", \
\"KuramotoSivashinsky\"}];
quiet[Get[FileNameJoin[{ksBenchDir, \"Pipeline.wl\"}]]];
Get[FileNameJoin[{ksBenchDir, #}]] & /@ {\"Reference.wl\", \"Checks.wl\"};

Scan[test[\"KS benchmark: \" <> #Name <> \" [\" <> #Paper <> \"]\", #Pass, \
True] &, ksChecks[]];

(* the comparison discriminates: a 1/100 change of one coefficient of Eq. \
(37) (3 hn^4 sd -> 303/100 hn^4 sd) is detected *)
test[\"KS benchmark: a perturbed Eq. (37) is rejected\",
  ExactlyZeroQ[ksLibrary[\"tau\"] - ((ksRef[\"tau\"] + Gh/(12 (Fh + Th qh^2 + \
rnu[qh^2])^2 qh^4) (3/100) sD[qh^2]) /. ksSRules)], False];\
\>", "Program",ExpressionUUID->"ab560fd3-38ed-4cfa-b1da-ef66cd00658b"],

Cell[TextData[{
 "The last test is worth copying in any comparison: it perturbs the reference \
by 1% and requires the comparison to ",
 StyleBox["fail",
  FontSlant->Italic],
 ". A comparison that cannot fail tests nothing."
}], "Text",ExpressionUUID->"5ad8627c-df25-4b7c-852c-95a916de140c"],

Cell["Exercises", "Section",ExpressionUUID->"3a4cbbf8-fbb6-4ede-a4e6-00dd78a6d775"],

Cell["Exercise: Your own expectFail", "Subsection",ExpressionUUID->"86e7d1c6-d51d-4d80-9341-6cc94492ee97"],

Cell[TextData[{
 "Without the harness, write the equivalent of ",
 StyleBox["expectFail[\"N = 3 aborts\", DefineTheory[\"Scalars\" -> {f1, f2, \
f3}, \"Dimension\" -> Dim], \"Theory.N\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with ",
 StyleBox["showFailure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", returning ",
 StyleBox["True",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " or ",
 StyleBox["False",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"3873e4b4-27b8-43c2-9bdc-4c996f7fd77d"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"2330b2ff-777a-4fdc-a09e-4ae94b619966"],

Cell["\<\
showFailure[DefineTheory[\"Scalars\" -> {f1, f2, f3}, \"Dimension\" -> Dim]] \
=== \"Theory.N\"\
\>", "Input",ExpressionUUID->"db9f554a-cfbb-4e8f-b0f2-940f13703f52"]
}, Closed]],

Cell["Exercise: A test that tests the wrong thing", "Subsection",ExpressionUUID->"2849fb2a-cec1-411d-8026-c0cce5f8b032"],

Cell[TextData[{
 "You want to test the reserved-name check, and write the scalars as ",
 StyleBox["{k, f2, f3}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Compare the result of ",
 StyleBox["showFailure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with ",
 StyleBox["\"Theory.scalars.reserved\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Why is it ",
 StyleBox["False",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and why is that the right answer?"
}], "Text",ExpressionUUID->"23b52424-cd92-425a-8500-347b866a1f25"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"804b4fa6-75a4-424f-88c3-9ffa56942c3c"],

Cell["\<\
showFailure[DefineTheory[\"Scalars\" -> {k, f2, f3}, \"Dimension\" -> Dim]] \
=== \"Theory.scalars.reserved\"\
\>", "Input",ExpressionUUID->"baba9881-ee41-4e7b-a846-3591058124df"],

Cell[TextData[{
 StyleBox["False",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": ",
 StyleBox["DefineTheory",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " checks the number of scalars before their names, so ",
 StyleBox["Theory.N",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " fires first. An ",
 StyleBox["expectFail",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " written this way would fail and reveal that the test does not exercise the \
check it is named after; a test that only asked \"did it abort?\" would pass \
and test nothing about reserved names."
}], "Text",ExpressionUUID->"ad69daef-697f-4ebd-90b2-070507e9c57d"]
}, Closed]],

Cell["Exercise: The Julia round trip", "Subsection",ExpressionUUID->"b2fead3a-e2ce-4be8-b510-910ed701efe2"],

Cell[TextData[{
 "Run the KPZ acceptance files with ",
 StyleBox["--only KPZ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " in a separate kernel. Which tests are about Julia, and do they run or SKIP \
on this machine?"
}], "Text",ExpressionUUID->"fb76cea3-fe25-412d-b107-8244d021c70c"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"377b924b-dfa9-41c5-8dc6-cab7750eae22"],

Cell["\<\
StringCases[RunProcess[{\"math\", \"-script\", FileNameJoin[{$FRGRoot, \
\"tests\", \"runTests.wl\"}], \"--only\", \"KPZ\"}, \"StandardOutput\"], \
(\"SKIP\" | \"===\") ~~ Except[\"\\n\"] ..]\
\>", "Input",ExpressionUUID->"c1f605f2-dc76-4f2c-83f8-589110d32b19"],

Cell["\<\
With Julia and FlowRG installed, the round-trip tests run and count among the \
passed ones; otherwise they print SKIP with the reason.\
\>", "Text",ExpressionUUID->"ce21a28e-6446-455e-b78d-82aa6bae267b"]
}, Closed]]
},

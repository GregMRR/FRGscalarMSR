Cell["5. The report", "Section",ExpressionUUID->"aa826d2e-375c-4646-bb2c-8b12f6d70634"],

Cell["\<\
(* Kernel/Closure.wl:70-74 *)
outcome[r_] := Switch[r[\"Class\"],
   \"Declared\", \"equation for d_s(\" <> \
inputForm[Last[splitCoefficient[r[\"GammaK\"]]]] <> \")\",
   \"Neglected\", If[First[r[\"Samples\"]] === 0, \"vanishes (dropped)\", \
\"generated, dropped: \" <> numString[First[r[\"Samples\"]]]],
   \"Structure\", \"vanishes identically (not computed)\",
   _, \"flow = 0 (checked)\"];\
\>", "Program",ExpressionUUID->"62b7ba23-beb7-4966-98d6-5efd64790912"],


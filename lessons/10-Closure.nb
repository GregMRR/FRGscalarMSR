 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"792215dc-e7d3-41ed-ab46-c07eaef907d1"],

Cell["{N[2/3], N[2/3, 4], ToString[CForm[N[2/3]]]}", "Input",

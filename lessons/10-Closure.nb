Notebook[{
Cell["Lesson 10 - Closure", "Title",ExpressionUUID->"81a2e077-f135-484e-ad83-9a81d57c5089"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Decide whether the flow closes on the ansatz. Every flow that a symmetry, \
causality, or a number in the ansatz forbids must vanish; every neglected \
flow is reported with a sample value; every declared coefficient gets its \
equation ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s(combination) = RHS, where the ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_k coefficient is split into a pure number and the flowing combination of \
couplings."
}], "Text",ExpressionUUID->"3843b2f2-b824-4ddd-a6b4-c019b5a9eb2c"],

Cell[TextData[{
 StyleBox["Stage.",
  FontWeight->Bold],
 " Input: the Integrated stage and the Symmetries stage it was projected \
with. Output: the ",
 StyleBox["\"Closure\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stage, with the ",
 StyleBox["\"Equations\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and a ",
 StyleBox["\"Report\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of every monomial."
}], "Text",ExpressionUUID->"f234d256-f2ef-49c6-b614-e541d4586ee7"],

Cell["\<\
Get[\"~/Physics/Sources/FRGscalarMSR/FRGscalarMSR.wl\"];
Get[FileNameJoin[{$FRGRoot, \"lessons\", \"LessonSetup.wl\"}]];
integrated = lessonUpTo[\"FrequencyIntegration\"]; symmetries = kpzSymmetries;\
\>", "Input",ExpressionUUID->"a2430a9f-d4a5-46e1-9e7a-b451cd20a0ca"],

Cell["1. Using it", "Section",ExpressionUUID->"f0aab4e5-f439-4961-970b-5459f8aa0ab9"],

Cell["closure = CheckClosure[integrated, symmetries];", "Input",ExpressionUUID->"d5ee0bbc-be12-4d7d-87bb-2defa5b6fff5"],

Cell["\<\
Three PASS lines say that the protected, numeric and causality flows vanish \
exactly. The WARN lines are the neglected monomials that the flow generates; \
their values are a sample at one random physical point, not a bound. The \
report puts it all in one table:\
\>", "Text",ExpressionUUID->"bd02af25-a3a3-4901-807d-426923e32e93"],

Cell["ShowClosureReport[closure]", "Input",ExpressionUUID->"b7762483-fe83-42b8-a1cb-297359b889b8"],

Cell["2. The flows that must vanish", "Section",ExpressionUUID->"190b3eea-47fd-4a67-850a-71ada6a97a59"],

Cell["\<\
(* Kernel/Closure.wl:24-39 *)
CheckClosure[integrated_, symmetries_] := Block[{$FRGModule = \"Closure\"},
  Module[{t0 = AbsoluteTime[], flows, checks = {}, warns = {}, zeroCl, bad, \
eqs, neg, report, stage},
   FRGAssert[\"Closure.pipeline\", NoneTrue[{integrated, symmetries}, \
AssociationQ[#] && Lookup[#, \"Pipeline\", None] === \"LO\" &], \"LO\", \
\"this is a derivative-expansion stage; an LO ansatz (fn[...]) goes through \
BuildLOEquations (design/LOPIPELINE.md)\"];
   validateStage[integrated, \"Integrated\"]; validateStage[symmetries, \
\"Symmetries\"];
   FRGAssert[\"Closure.sameSymmetries\", \
MemberQ[integrated[\"Projection\"][\"Upstream\"], symmetries[\"Fingerprint\"]],
    integrated[\"Projection\"][\"Upstream\"], \"the flows were projected with \
another Symmetries stage\"];
   flows = integrated[\"Flows\"];

   (* flows that must vanish: one check per class, the hint carries the \
reasons of the offenders *)
   Do[Module[{cl = c[[1]], name = c[[2]]},
      bad = Select[flows, #Class === cl && ! MatchQ[Lookup[#, \"Samples\"], \
{0 ..}] &];
      AppendTo[checks, assertCheck[name, bad === {}, {#Pair, #Frequency, \
#Momentum, N[#Samples, 4]} & /@ bad,
        \"these flows must vanish but do not: \" <> \
StringRiffle[(recordString[#] <> \" (\" <> #Reason <> \")\") & /@ bad, \"; \
\"] <>
         \". The tag is wrong (the symmetry is not a symmetry of the ansatz \
and regulator), or the ansatz breaks it\",
        ToString[Count[flows, KeyValuePattern[\"Class\" -> cl]]] <> \" \" <> \
cl <> \" flows vanish exactly (3 random rational points each)\"]]],
    {c, {{\"Protected\", \"Closure.protected\"}, {\"DeclaredNumeric\", \
\"Closure.declaredNumeric\"}, {\"Causality\", \"Closure.causality\"}}}];\
\>", "Program",ExpressionUUID->"e388459d-2ab9-48c3-be4e-cf6c167aeb99"],

Cell[TextData[{
 StyleBox["! MatchQ[Lookup[#, \"Samples\"], {0 ..}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " selects the records whose samples are not all exactly 0 (",
 StyleBox["MatchQ and repeated patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "). The ",
 StyleBox["Do",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " runs over a list of pairs (class, check name), so the three checks share \
one piece of code. The hint names each offending monomial with the reason of \
its tag, because a failure here means the tag is wrong or the ansatz breaks \
the symmetry, and the reason is what you need to decide which."
}], "Text",ExpressionUUID->"5cbf06a1-c0b9-4248-9391-79d07c63e425"],

Cell[TextData[{
 "Tagging ",
 StyleBox["\[Omega]\.b2",
  FontFamily->"Noto Sans"],
 " of ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "} as Protected, which it is not:"
}], "Text",ExpressionUUID->"9f0abcb1-9a26-43fa-8b01-2e75681ee24b"],

Cell["\<\
symmetries2 = Block[{Print}, DeclareSymmetries[kpzAnsatz,
     Protected[{hbar, h}, \"Frequency\" -> 1, \"Momentum\" -> 0, \"Reason\" \
-> \"Galilean Ward identity\"],
     Protected[{h, hbar}, \"Frequency\" -> 0, \"Momentum\" -> 0, \"Reason\" \
-> \"shift\"],
     Protected[{hbar, hbar}, \"Frequency\" -> 2, \"Momentum\" -> 0, \
\"Reason\" -> \"wrong on purpose\"],
     Neglected[_, \"Reason\" -> \"beyond\"], \"TruncationOrders\" -> \
<|\"Frequency\" -> 2, \"Momentum\" -> 1|>]];
integrated2 = Block[{Print}, \
IntegrateFrequencies[ProjectOnMonomials[kpzLoops, symmetries2]]];
showFailure[CheckClosure[integrated2, symmetries2]]\
\>", "Input",ExpressionUUID->"bf1f3480-1ac3-48c9-add2-fad9309e6059"],

Cell[TextData[{
 StyleBox["Why it's built this way: A false symmetry is caught, a true one is \
only assumed",
  FontWeight->Bold],
 "\n\n",
 "The library cannot derive Ward identities; you declare them. What it can do \
is test the consequence: a declared symmetry forbids certain flows, and those \
flows are computed and required to be exactly 0. A wrong tag therefore aborts \
here, with its reason. A correct tag passes, which supports it but does not \
prove the symmetry (the flows might vanish for another reason, or only at \
this truncation), and the card keeps the ASSUMPTION line \"Ward identities \
are assumed, not derived\"."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"06763231-284e-4117-a171-396b1776d304"],

Cell["3. The neglected flows", "Section",ExpressionUUID->"c433d66b-40c4-46a8-b527-02950c70cfcb"],

Cell["\<\
(* Kernel/Closure.wl:41-46 *)
   (* neglected flows: reported, not asserted *)
   neg = Select[flows, #Class === \"Neglected\" &];
   warns = Join[warns, If[First[#Samples] === 0,
        infoCheck[\"INFO\", \"Closure.neglected \" <> recordString[#], \"flow \
vanishes at a valid random point (\" <> #Reason <> \")\"],
        infoCheck[\"WARN\", \"Closure.neglected \" <> recordString[#],
         \"generated, dropped: value \" <> numString[First[#Samples]] <> \" \
at one random valid point, not a bound (\" <> #Reason <> \")\"]] & /@ neg];\
\>", "Program",ExpressionUUID->"8b8f0b9a-3d25-4d28-8ead-bd9f3c70bdb8"],

Cell["\<\
(* Kernel/Closure.wl:17-19 *)
monomialString[r_] := \"(I w)^\" <> ToString[r[\"Frequency\"]] <> \" (q^2)^\" \
<> ToString[r[\"Momentum\"]];
numString[x_] := ToString[CForm[N[x]]];
recordString[r_] := ToString[r[\"Pair\"]] <> \" \" <> monomialString[r];\
\>", "Program",ExpressionUUID->"dd470467-9e0f-4170-b3c3-39b9e9e3738c"],

Cell[TextData[{
 StyleBox["Mathematica: N and CForm",
  FontWeight->Bold],
 "\n",
 StyleBox["N[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives a machine-precision approximation of an exact number; ",
 StyleBox["CForm[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes an expression as C code, here a compact number string.",
 "\n\n",
 "The samples are exact rationals; the card shows them as decimals. ",
 StyleBox["N[x, 4]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " asks for 4 digits."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"3d510551-fdf7-41ff-8ff2-d584444b4708"],

Cell["{N[2/3], N[2/3, 4], ToString[CForm[N[2/3]]]}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"6e55b809-6096-424d-a7fd-ae23301fd4bf"],

Cell["4. Declared monomials become equations", "Section",ExpressionUUID->"0a07f889-0da1-4e6a-9777-74f664bf2991"],

Cell["\<\
(* Kernel/Closure.wl:21-22 *)
(* numeric content (sign included) and flowing combination: -2 Dhk aDhk -> \
{-2, Dhk aDhk} *)
splitCoefficient[c_] := Module[{f = FactorTermsList[c]}, {Times @@ Most[f], \
Last[f]}];\
\>", "Program",ExpressionUUID->"360b1874-dcb6-40ac-a706-7df40def4005"],

Cell[TextData[{
 StyleBox["Mathematica: FactorTermsList",
  FontWeight->Bold],
 "\n",
 StyleBox["FactorTermsList[poly]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " pulls out the numeric factors: ",
 StyleBox["{number, ..., rest}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ".",
 "\n\n",
 StyleBox["splitCoefficient",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " multiplies all numeric parts together (",
 StyleBox["Times @@ Most[f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Apply",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") and keeps the rest: ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2 Dk gives normalisation ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2 and combination Dk, ",
 StyleBox["\[Minus]\[Lambda]",
  FontFamily->"Noto Sans"],
 "/2 gives ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1/2 and ",
 StyleBox["\[Lambda]",
  FontFamily->"Noto Sans"],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"e4b01f67-854f-4bfa-8da1-d91d183a90d8"],

Cell["\<\
{FactorTermsList[-2 Dk], FactorTermsList[-lamk/2], FactorTermsList[6 a b + 4 \
a]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"b2a74bc8-b237-49b1-990e-ec97fb2ed0d7"],

Cell["\<\
(* Kernel/Closure.wl:48-55 *)
   (* declared monomials: d_s(comb) = Value / norm *)
   eqs = Function[r, Module[{norm, comb},
       {norm, comb} = splitCoefficient[r[\"GammaK\"]];
       FRGAssert[\"Closure.normalisation\", NumericQ[norm] && norm =!= 0 && \
Expand[norm comb - r[\"GammaK\"]] === 0 && ! NumericQ[comb],
        {r[\"GammaK\"], norm, comb}, \"internal: the Gamma_k coefficient does \
not split into number x combination\"];
       Join[r, <|\"Normalisation\" -> norm, \"Flowing\" -> comb, \"RHS\" -> \
r[\"Value\"]/norm|>]]] /@ Select[flows, #Class === \"Declared\" &];
   AppendTo[checks, assertCheck[\"Closure.equations\", eqs =!= {}, flows, \
\"no declared monomial: nothing flows\",
     ToString[Length[eqs]] <> \" equations d_s(comb) = Value/norm: \" <> \
StringRiffle[(inputForm[#Flowing] <> \" (/\" <> ToString[#Normalisation, \
InputForm] <> \")\") & /@ eqs, \", \"]]];\
\>", "Program",ExpressionUUID->"083bb095-94ae-4ac5-af3d-2db2c6a2c637"],

Cell[TextData[{
 "The equation for a coefficient written as ",

ShowClosureReport[c_Association] := Module[{rows},
   Print[\"Closure report. Declared: the coefficient is in the ansatz and \
gets a flow equation. Protected: a symmetry (Ward identity, \\\
\>", "Program",ExpressionUUID->"25069383-3b7c-4d42-a053-8d5825cfc951"],


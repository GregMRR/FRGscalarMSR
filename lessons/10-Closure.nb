Cell["\<\
nuEq = SelectFirst[closure[\"Equations\"], #Flowing === nuk &];
{LeafCount[nuEq[\"RHS\"]], Union[Cases[nuEq[\"RHS\"], _GammaAtom[_] | _dsR | \
DeltaCoefficient[_][_] | Derivative[_][DeltaCoefficient[_]][_], Infinity]]}\
\>", "Input",ExpressionUUID->"98f72d83-58f7-48e4-acaf-8ac0ed07fc36"],


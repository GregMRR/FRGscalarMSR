Cell["5. The report", "Section",ExpressionUUID->"1241ec9d-422b-4c73-b0f7-6b5f97fc2343"],

Cell["\<\
(* Kernel/Closure.wl:78-83 *)
outcome[r_] := Switch[r[\"Class\"],
   \"Declared\", \"equation for d_s(\" <> \
inputForm[Last[splitCoefficient[r[\"GammaK\"]]]] <> \")\",
   \"Functional\", \"equation for d_s(\" <> \
inputForm[Last[splitCoefficient[r[\"GammaK\"]]]] <> \") at every p\",
   \"Neglected\", If[First[r[\"Samples\"]] === 0, \"vanishes (dropped)\", \
\"generated, dropped: \" <> numString[First[r[\"Samples\"]]]],
   \"Structure\", \"vanishes identically (not computed)\",
   _, \"flow = 0 (checked)\"];\
\>", "Program",ExpressionUUID->"a305e3d8-f72a-4c6d-824b-a7ce319f365e"],

Cell["\<\

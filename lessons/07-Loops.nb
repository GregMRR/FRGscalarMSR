Notebook[{
Cell["Lesson 07 - Loops", "Title",ExpressionUUID->"f81b2c25-33dd-47e3-9521-59ff11722a83"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " The one-loop flow of ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2, from two field derivatives of the Wetterich equation ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 " = ",
 StyleBox["\.bd",
  FontFamily->"Noto Sans"],
 " Tr[",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "sR (",
 StyleBox["\[CapitalGamma]\:207d\.b2\:207e",
  FontFamily->"Noto Sans"],
 " + R)",
 StyleBox["\:207b\.b9",
  FontFamily->"Noto Sans"],
 "]:"
}], "Text",ExpressionUUID->"42d120fa-df81-4eef-afca-35dd844058a2"],

Cell[TextData[{
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2_ab(",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ", p) = ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 "d",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "/(2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 ") ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 "d",
 StyleBox["\:1d48",
  FontFamily->"Noto Sans"],
 "q/(2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\:1d48",
  FontFamily->"Noto Sans"],
 " { Tr[",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "sR G(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ",q) ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "3_a(",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ",p; ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ",q) G(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "+",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ", p+q) ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "3_b(",
 StyleBox["\[Minus]\[Nu]",
  FontFamily->"Noto Sans"],
 ",",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "p; ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "+",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ", p+q) G(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ",q)] ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\.bd",
  FontFamily->"Noto Sans"],
 " Tr[",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "sR G ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "4_ab G] }."
}], "Text",ExpressionUUID->"f5c5c27c-af3c-453e-8d6c-df704d2426b7"],

Cell[TextData[{
 "The module builds the integrand at a fixed loop point (",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", q), with the 1/(2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 ") of the frequency measure included; the integral over q is left to the \
numerics. The derivation (steps 1",
 StyleBox["\[Dash]",
  FontFamily->"Noto Sans"],
 "6) is written out in ",
 StyleBox["docs/MODULES.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", section Loops."
}], "Text",ExpressionUUID->"b0e45545-13b6-4973-8f17-d5fcb356ef84"],

Cell[TextData[{
 StyleBox["Stage.",
  FontWeight->Bold],
 " Input: the Vertices, Propagator and Regulator stages. Output: the ",
 StyleBox["\"Loops\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stage, which holds its ingredients; the integrand of each entry is \
computed on request."
}], "Text",ExpressionUUID->"5bd4e05e-9a2c-4b4c-96de-6e0473862a7b"],

Cell["\<\
Get[\"~/Physics/Sources/FRGscalarMSR/FRGscalarMSR.wl\"];
Get[FileNameJoin[{$FRGRoot, \"lessons\", \"LessonSetup.wl\"}]];
propagator = lessonUpTo[\"Propagator\"];\
\>", "Input",ExpressionUUID->"8730bedb-9da4-4e6a-ba54-43512dad06d2"],

Cell["1. Using it", "Section",ExpressionUUID->"d12acec9-78f8-4f34-bfc7-334bdb2e666f"],

Cell["\<\
loops = BuildLoopIntegrands[kpzVertices, propagator, kpzRegulator];\
\>", "Input",ExpressionUUID->"9cda9f85-814c-485a-8a5f-75301d2fafab"],

Cell[TextData[{
 "The card has no PASS line that tests the formula, and an ASSUMPTION line \
that says what was tested elsewhere: the bubble against Canet's KPZ flow (",
 StyleBox["tests/acceptance/KPZ.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), the tadpole not at all."
}], "Text",ExpressionUUID->"1e97e200-948b-41f8-8a0e-2094d98d0855"],

Cell["\<\
{wq = LoopVariables[loops], LeafCount[LoopIntegrand[loops, {hbar, hbar}, nu, \
p]]}\
\>", "Input",ExpressionUUID->"9e041115-00c3-486f-80db-46ececa02522"],

Cell[TextData[{
 "The loop variables are private symbols (",
 StyleBox["wL",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["qL",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "): they appear in the integrand, and only the next modules, which integrate \
over them, need to know them."
}], "Text",ExpressionUUID->"8c303fa9-2091-4270-b091-a11e010c051c"],

Cell["2. The whole module", "Section",ExpressionUUID->"c9b6726a-c922-4189-bbc5-0bd8c44d208a"],

Cell["\<\
(* Kernel/Loops.wl:18 *)
LoopVariables[l_Association] := {wL, qL};\
\>", "Program",ExpressionUUID->"d8585d95-f87c-43ca-b923-7e61b4902a3e"],

Cell["\<\
(* Kernel/Loops.wl:20 *)
gMat[prop_, w_, vec_] := prop[\"G\"][w, scal[vec, vec]];\
\>", "Program",ExpressionUUID->"a6dcf4d8-7557-4635-ab1a-7890c4ffe565"],

Cell["\<\
(* Kernel/Loops.wl:22 *)
gamma4Matrix[v_, a_, b_, {nu_, p_}, {w_, q_}] := Table[VertexValue[v, {a, b, \
c, d}, {{nu, p}, {-nu, -p}, {w, q}}], {c, v[\"Fields\"]}, {d, v[\"Fields\"]}];\
\>", "Program",ExpressionUUID->"9c5247f9-30bf-4799-a790-6fb0833ca91e"],

Cell["\<\
(* Kernel/Loops.wl:24-29 *)
LoopIntegrand[l_Association, {a_, b_}, nu_, p_] := Module[{v = \
l[\"Vertices\"], prop = l[\"Propagator\"], dsr = l[\"DsR\"], g0, gm, bubble, \
tadpole},
   g0 = gMat[prop, wL, qL];
   gm = gMat[prop, wL + nu, p + qL];
   bubble = Tr[dsr . g0 . Gamma3Matrix[v, a, {nu, p}, {wL, qL}] . gm . \
Gamma3Matrix[v, b, {-nu, -p}, {wL + nu, p + qL}] . g0];
   tadpole = If[l[\"HasGamma4\"], Tr[dsr . g0 . gamma4Matrix[v, a, b, {nu, \
p}, {wL, qL}] . g0], 0];
   (bubble - tadpole/2)/(2 Pi)];\
\>", "Program",ExpressionUUID->"d7eb7db8-8dd3-489f-b271-98e337ad207f"],

Cell["\<\
(* Kernel/Loops.wl:31-49 *)
BuildLoopIntegrands[vertices_, prop_, regulator_] := Block[{$FRGModule = \
\"Loops\"},
  Module[{t0 = AbsoluteTime[], checks = {}, warns = {}, dsr, g4, stage},
   validateStage[vertices, \"Vertices\"]; validateStage[prop, \
\"Propagator\"]; validateStage[regulator, \"Regulator\"];
   FRGAssert[\"Loops.sameUpstream\", prop[\"Upstream\"] === \
{vertices[\"Fingerprint\"], regulator[\"Fingerprint\"]}, prop[\"Upstream\"],
    \"the propagator was not built from these vertices and this regulator\"];
   dsr = DsRAbstractMatrix[regulator];
   AppendTo[checks, assertCheck[\"Loops.dsRSymmetric\", dsr === \
Transpose[dsr], dsr, \"internal: d_s R must be symmetric\", \"d_s R \
symmetric, abstract entries dsR[a, b]\"]];
   g4 = AnyTrue[Keys[vertices[\"VertexTable\"]], Length[#] == 4 &];
   If[g4, AppendTo[warns, infoCheck[\"WARN\", \"Loops.tadpole\", \"Gamma4 != \
0: tadpole term -1/2 Tr[d_sR G Gamma4 G] included; hand-derived, untested\"]]];
   AppendTo[warns, infoCheck[\"ASSUMPTION\", \"Loops.normalisation\",
     \"loop prefactor 1, tadpole -1/2 and 1/(2 Pi) hand-derived \
(docs/MODULES.md); bubble checked against Canet's KPZ flow \
(tests/acceptance/KPZ.wl), tadpole untested\"]];
   stage = stampStage[<|\"Stage\" -> \"Loops\", \"Pipeline\" -> \
vertices[\"Pipeline\"],
      \"Upstream\" -> {vertices[\"Fingerprint\"], prop[\"Fingerprint\"], \
regulator[\"Fingerprint\"]},
      \"Vertices\" -> vertices, \"Propagator\" -> prop, \"Regulator\" -> \
regulator, \"Fields\" -> vertices[\"Fields\"], \"DsR\" -> dsr, \"HasGamma4\" \
-> g4,
      \"Formula\" -> \"d_s Gamma2_ab(nu,p) = Int dw/(2Pi) [Tr(dsR G Gamma3_a \
G(w+nu,p+q) Gamma3_b G) - 1/2 Tr(dsR G Gamma4_ab G)], Int d^dq/(2Pi)^d left \
to the numerics\",
      \"Checks\" -> checks, \"Warnings\" -> warns, \"Timing\" -> \
AbsoluteTime[] - t0|>];
   Print[\"Loops: \", stage[\"Formula\"]];
   PrintCard[stage];
   stage]];\
\>", "Program",ExpressionUUID->"1ec62b69-c3f0-455b-b94d-1704b683d3a5"],

Cell[TextData[{
 StyleBox["gMat",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates the propagator's stored function (",
 StyleBox["Function and Evaluate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 04)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") at a frequency and at the square of a momentum vector, ",
 StyleBox["scal[vec, vec]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": with ",
 StyleBox["vec = p + qL",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the regulator and the atoms inside G are automatically at (p + q)",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " (",
 StyleBox["Evaluation as rewriting",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " expands ",
 StyleBox["scal[p + qL, p + qL]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). ",
 StyleBox["Gamma3Matrix",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 03) gives the vertex matrices; their product is a ",
 StyleBox["Matrix algebra",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 05)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " product."
}], "Text",ExpressionUUID->"6c8e4ae0-d972-493a-b889-a9dcf8289000"],

Cell[TextData[{
 StyleBox["Mathematica: Tr and exact constants",
  FontWeight->Bold],
 "\n",
 StyleBox["Tr[m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the trace of a matrix; ",
 StyleBox["Pi",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["E",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["I",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are exact constants, never rounded.",
 "\n\n",
 StyleBox["(bubble - tadpole/2)/(2 Pi)",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " keeps ",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 " as a symbol: the integrand is exact, and the final equations carry exactly \
the factors of 2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 " the derivation puts there."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"967b7f3b-7023-44e5-96d1-84a6c4806f4f"],

Cell["{Tr[{{a, b}, {c, d}}], InputForm[Pi/2], N[Pi/2]}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"2ad70607-4a45-4e46-94c7-f3311f899f2c"],

Cell[TextData[{
 "The tadpole is included only when there is a quartic vertex (",
 StyleBox["\"HasGamma4\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), and then with a WARN: its prefactor ",
 StyleBox["\[Minus]\.bd",
  FontFamily->"Noto Sans"],
 " is derived by hand but has never been tested against an independent result."
}], "Text",ExpressionUUID->"e782a0d4-e99d-4901-ab96-f1fef2561bcc"],

Cell[TextData[{
 StyleBox["Why it's built this way: The integrand as a function of the entry",
  
  FontWeight->Bold],
 "\n\n",
 "The stage stores the vertices, the propagator, the regulator and the \
abstract ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "sR matrix, and ",
 StyleBox["LoopIntegrand[loops, {a, b}, nu, p]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " assembles the integrand only when it is asked for. The projection (lesson \
08) needs it for a few entries only, and expanded around different external \
momenta; building all entries in advance would compute and store expressions \
nobody uses. Holding the full upstream stages inside the Loops stage also \
keeps it self-contained: a later module can reach the vertices or the \
propagator through it, and its fingerprint covers them."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"1cbf59b5-b4c5-4bd8-b912-1112208f9d5c"],

Cell[TextData[{
 StyleBox["Why it's built this way: Say on the card what has not been tested",
  
  FontWeight->Bold],
 "\n\n",
 "The loop formula is the one part of the pipeline that is only derived by \
hand, never computed twice (review E3/E4). The library cannot check it by \
itself; an acceptance test fixes the bubble's prefactor, sign and 2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 " against an independent result from the literature (Canet, \
arXiv:2509.01472, Eq. (20)), and nothing yet tests the tadpole. Instead of a \
PASS line that would suggest otherwise, the card carries an ASSUMPTION and, \
when ",
 StyleBox["\[CapitalGamma]\:207d\:2074\:207e",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[NotEqual]",
  FontFamily->"Noto Sans"],
 " 0, a WARN. The benchmarks in ",
 StyleBox["benchmarks/",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " exist for the same reason: they test the pipeline against papers."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"ca55908e-07c8-4607-9c2d-14117a518242"],

Cell["3. What the integrand looks like", "Section",ExpressionUUID->"5a3e8e1d-0967-44a9-8151-8696eb4a9239"],

Cell["LoopIntegrand[loops, {hbar, hbar}, nu, p]", "Input",ExpressionUUID->"fce3a48e-d762-40fc-9f28-cd6818ccc84b"],

Cell[TextData[{
 "Everything is still abstract: the atoms ",
 StyleBox["GammaAtom[...][...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["\[CapitalDelta][...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 05) at q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " and at (p + q)",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ", the regulator derivatives ",
 StyleBox["dsR[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 04), and the couplings of the vertices. Each ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " factor carries its frequency and momentum, which is what the frequency \
integration (lesson 09) needs to find the poles."
}], "Text",ExpressionUUID->"24d826f5-4b54-45d3-868b-ea48e1d7352f"],

Cell["Exercises", "Section",ExpressionUUID->"123d64fb-894b-453a-91fb-4772644534ed"],

Cell["Exercise: The poles of the integrand", "Subsection",ExpressionUUID->"29ab523e-a5d4-4b46-9c44-edb31e987e79"],

Cell[TextData[{
 "List the different ",
 StyleBox["\[CapitalDelta][...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " factors of the ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " integrand. Which are evaluated at the loop momentum q, which at p + q?"
}], "Text",ExpressionUUID->"ce260895-08e7-423b-8670-aa6bc5d7bdde"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"138ce9bd-b7cf-4858-8d9f-b6e4c3ee30f8"],

Cell["\<\
Union[Cases[LoopIntegrand[loops, {hbar, hbar}, nu, p], _\[CapitalDelta], \
Infinity]]\
\>", "Input",ExpressionUUID->"8f607bb4-9dcf-4304-97b3-e5e0a2121d8f"],

Cell[TextData[{
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[PlusMinus]\[Omega]",
  FontFamily->"Noto Sans"],
 ") at q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " come from the two G(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", q); ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[PlusMinus]",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " + ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ")) at (p + q)",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " from G(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " + ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ", p + q). ",
 StyleBox["_\[CapitalDelta]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches any expression with head ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ")."
}], "Text",ExpressionUUID->"78237ac5-87e9-41dd-8208-da9363decf52"]
}, Closed]],

Cell["Exercise: A quartic vertex", "Subsection",ExpressionUUID->"7b42db52-bb33-46f9-867c-bee9b29b8e31"],

Cell[TextData[{
 "Add the quartic term ",
 StyleBox["g hbar h^3",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " to the KPZ density (coupling ",
 StyleBox["g",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") and build the chain up to the loops. What does the card say?"
}], "Text",ExpressionUUID->"afbb1f6c-e63e-43ef-9594-39d3742a9981"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"86b558df-9aa9-4b36-ada1-cd1c0e82624c"],

Cell["\<\
Block[{Print},
  a4 = DefineAnsatz[kpzTheory, \"Density\" -> hbar (dt[h] - nuk lap[h] - \
lamk/2 grad[h].grad[h]) - Dk hbar^2 + g hbar h^3, \"Couplings\" -> {nuk, \
lamk, Dk, g}];
  v4 = BuildVertices[a4];
  r4 = DefineRegulator[a4, {hbar, h} -> nuk q^2 rn[q^2/k^2], {hbar, hbar} -> \
-2 Dk rd[q^2/k^2], \"Shapes\" -> {rn, rd}];
  p4 = BuildPropagator[v4, r4]];
BuildLoopIntegrands[v4, p4, r4];\
\>", "Input",ExpressionUUID->"56857b0d-c8e8-4e55-a7c1-d0983f33facd"],

Cell[TextData[{
 "A WARN ",
 StyleBox["Loops.tadpole",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": ",
 StyleBox["\[CapitalGamma]\:207d\:2074\:207e",
  FontFamily->"Noto Sans"],
 "_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "hhh} ",
 StyleBox["\[NotEqual]",
  FontFamily->"Noto Sans"],
 " 0, so the tadpole term is included, and it is untested. (",
 StyleBox["Block[{Print}, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " hides the cards of the intermediate stages, as ",
 StyleBox["lessonUpTo",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " does.)"
}], "Text",ExpressionUUID->"a9baa216-224a-42ed-9076-19da9eaaa2f6"]
}, Closed]],

Cell["Exercise: A propagator from elsewhere", "Subsection",ExpressionUUID->"69cbd779-00f1-431a-bf01-e07d4511c521"],

Cell[TextData[{
 "Pass ",
 StyleBox["kpzVertices",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the propagator ",
 StyleBox["p4",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of the previous exercise, and ",
 StyleBox["kpzRegulator",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " to ",
 StyleBox["BuildLoopIntegrands",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Which check fails?"
}], "Text",ExpressionUUID->"d3660376-4cb1-4323-834e-f51b8befb78a"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"34655e9d-89d8-4f19-954d-e5f4bc5863c0"],

Cell["\<\
showFailure[BuildLoopIntegrands[kpzVertices, p4, kpzRegulator]]\
\>", "Input",ExpressionUUID->"f374079b-da65-4926-a3b1-cc38bd95f0ba"],

Cell[TextData[{
 StyleBox["Loops.sameUpstream",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": the propagator's ",
 StyleBox["\"Upstream\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " must be exactly the fingerprints of these vertices and this regulator."
}], "Text",ExpressionUUID->"ef5044e9-ad14-4107-ba3c-1d8818874758"]

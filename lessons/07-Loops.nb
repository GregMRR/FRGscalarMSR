}, Closed]],

Cell["Exercise: A quartic vertex", "Subsection",ExpressionUUID->"36e385bf-7754-4f24-8441-93107e3d524e"],

Cell[TextData[{
 "Add the quartic term ",
 StyleBox["g hbar h^3",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " to the KPZ density (coupling ",
 StyleBox["g",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") and build the chain up to the loops. What does the card say?"
}], "Text",ExpressionUUID->"db67f597-549e-4c08-84e4-22098821531a"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"62117f59-e8e0-4466-97eb-6280920df62c"],

Cell["\<\
Block[{Print},
  a4 = DefineAnsatz[kpzTheory, \"Density\" -> hbar (dt[h] - nuk lap[h] - \
lamk/2 grad[h].grad[h]) - Dk hbar^2 + g hbar h^3, \"Couplings\" -> {nuk, \
lamk, Dk, g}];
  v4 = BuildVertices[a4];
  r4 = DefineRegulator[a4, {hbar, h} -> nuk q^2 rn[q^2/k^2], {hbar, hbar} -> \
-2 Dk rd[q^2/k^2], \"Shapes\" -> {rn, rd}];
  p4 = BuildPropagator[v4, r4]];
BuildLoopIntegrands[v4, p4, r4];\
\>", "Input",ExpressionUUID->"b8bbb669-ce94-4035-989e-4472ee83a309"],

Cell[TextData[{
 "A WARN ",
 StyleBox["Loops.tadpole",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": ",
 StyleBox["\[CapitalGamma]\:207d\:2074\:207e",
  FontFamily->"Noto Sans"],
 "_{",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "hhh} ",
 StyleBox["\[NotEqual]",
  FontFamily->"Noto Sans"],
 " 0, so the tadpole term is included, and it is untested. (",
 StyleBox["Block[{Print}, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " hides the cards of the intermediate stages, as ",
 StyleBox["lessonUpTo",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " does.)"
}], "Text",ExpressionUUID->"47ae4ab9-375e-458c-8881-ffa7a246c8cc"]
}, Closed]],

Cell["Exercise: A propagator from elsewhere", "Subsection",ExpressionUUID->"8a55793b-4baa-4c28-912f-3f9884103e4f"],

Cell[TextData[{
 "Pass ",
 StyleBox["kpzVertices",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the propagator ",
 StyleBox["p4",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of the previous exercise, and ",
 StyleBox["kpzRegulator",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " to ",
 StyleBox["BuildLoopIntegrands",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Which check fails?"
}], "Text",ExpressionUUID->"2088bf3d-18f3-4fe4-8f0e-704ef54a4d76"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"27198a0b-f53d-42b5-a4d2-86b3721e98f1"],

Cell["\<\
showFailure[BuildLoopIntegrands[kpzVertices, p4, kpzRegulator]]\
\>", "Input",ExpressionUUID->"fb9d5cac-3b2a-4e79-9cf1-a19ea7dc3209"],

Cell[TextData[{
 StyleBox["Loops.sameUpstream",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": the propagator's ",
 StyleBox["\"Upstream\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " must be exactly the fingerprints of these vertices and this regulator."
}], "Text",ExpressionUUID->"daf9258a-d205-4d87-ba15-da65bb75969b"]
}, Closed]]

Cell["3. Checks before any work", "Section",ExpressionUUID->"91e0d089-7452-483f-9b95-27b1605fe3c1"],

Cell["\<\
(* Kernel/Ansatz.wl:140-157 *)
DefineAnsatz[theory_, opts : OptionsPattern[]] := Block[{$FRGModule = \
\"Ansatz\"},
  Module[{t0 = AbsoluteTime[], dens, cps, fields, fld, responses, checks = \
{}, warns = {}, counter = 0, new, ops, expanded, terms, mons,
    badSyms, unused, stage, jacQ, epsQ, fns, fnPat, pipeline},
   validateStage[theory, \"Theory\"];
   FRGAssert[\"Ansatz.options\", MatchQ[{opts}, {(Rule | \
RuleDelayed)[\"Density\" | \"Couplings\" | \"MomentumFunctions\" | \"Pipeline\
\", _] ...}], {opts},
    \"only the options \\\"Density\\\", \\\"Couplings\\\", \
\\\"MomentumFunctions\\\", \\\"Pipeline\\\" are accepted\"];
   dens = OptionValue[\"Density\"]; cps = OptionValue[\"Couplings\"]; fns = \
OptionValue[\"MomentumFunctions\"];
   fields = theory[\"Fields\"]; responses = theory[\"ResponseFields\"]; fld = \
Alternatives @@ fields;
   FRGAssert[\"Ansatz.functionList\", ListQ[fns], fns, \
\"\\\"MomentumFunctions\\\" -> {Fnu, FD, ...}\"];
   (* the pipeline follows from the declared functions \
(design/MOMENTUMFUNCTIONS.md A2) *)
   pipeline = If[fns === {}, \"DerivativeExpansion\", \"MomentumFunctions\"];
   AppendTo[checks, assertCheck[\"Ansatz.pipeline\", MemberQ[{Automatic, \
pipeline}, OptionValue[\"Pipeline\"]], OptionValue[\"Pipeline\"],
     \"drop \\\"Pipeline\\\": it is set from \\\"MomentumFunctions\\\" \
(\\\"DerivativeExpansion\\\" without functions, \\\"MomentumFunctions\\\" \
with them)\", pipeline]];
   FRGAssert[\"Ansatz.density\", dens =!= None && dens =!= 0, dens, \
\"\\\"Density\\\" -> expression is required\"];
   FRGAssert[\"Ansatz.couplingList\", ListQ[cps], cps, \"\\\"Couplings\\\" -> \
{c1, c2, ...}\"];
   assertFreshSymbols[\"Ansatz.couplings\", cps, \"couplings\"];
   FRGAssert[\"Ansatz.couplingsNotFields\", Intersection[cps, Append[fields, \
theory[\"Dimension\"]]] === {}, Intersection[cps, Append[fields, \
theory[\"Dimension\"]]],
    \"a coupling has the name of a field or of the dimension\"];\
\>", "Program",ExpressionUUID->"d5c2736f-8f6e-4751-bf62-38f0417e07a4"],

Cell[TextData[{
 StyleBox["validateStage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " comes first (",
 StyleBox["Hash",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "): the theory must be a genuine, unmodified Theory stage. Then the options, \
then the couplings (",
 StyleBox["OwnValues and DownValues",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " through ",
 StyleBox["assertFreshSymbols",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",ExpressionUUID->"d9fa088e-ecec-4257-8858-984d129b66d3"],

Cell["\<\
(* Kernel/Ansatz.wl:164-190 *)
   (* E7: System derivative heads would silently differentiate the couplings \
(Dt[nk H] = H Dt[nk] + nk Dt[H]) *)
   AppendTo[checks, assertCheck[\"Ansatz.noSystemDerivatives\", FreeQ[dens, \
systemOps], Cases[dens, systemOps[___] | Derivative[__][_], {0, Infinity}, \
Heads -> True],
     \"use the package operators dt, grad, div, lap (System Dt, Grad, Div, \
Laplacian, D are not allowed)\", \"no Dt/D/Grad/Div/Laplacian\"]];

   badSyms = Complement[Cases[dens, s_Symbol /; Context[s] =!= \"System`\", \
{0, Infinity}, Heads -> True], fields, cps, fns, {theory[\"Dimension\"], dt, \
grad, div, lap, jac}];
   AppendTo[checks, assertCheck[\"Ansatz.knownSymbols\", badSyms === {}, \
badSyms,
     If[MemberQ[SymbolName /@ badSyms, \"t\" | \"x\"], \"couplings depend on \
k only: no explicit t or x dependence is allowed\",
      \"every symbol must be a declared coupling (\\\"Couplings\\\"), a \
momentum function (\\\"MomentumFunctions\\\") or a field of the theory\"],
     \"every symbol is a field, a coupling\" <> If[fns === {}, \"\", \", a \
momentum function\"] <> \" or Dim\"]];
   If[fns =!= {},
    AppendTo[checks, assertCheck[\"Ansatz.functionBare\", FreeQ[dens, \
fnPat[___]], Cases[dens, fnPat[___], {0, Infinity}],
      \"write the function bare (Fnu, not Fnu[0] or Fnu[p^2]): it already \
means Fnu(p^2)\", \"momentum functions written bare\"]]];

   (* operators act on field expressions only: couplings depend on k only and \
must stand outside (no dt[nk H], no lap[nk]) *)
   ops = Cases[dens, opHeads[___], {0, Infinity}];
   FRGAssert[\"Ansatz.operatorArity\", AllTrue[ops, Length[#] == arity[#] &], \
Select[ops, Length[#] =!= arity[#] &],
    \"dt, grad, div, lap take exactly one argument; jac takes two\"];
   AppendTo[checks, assertCheck[\"Ansatz.couplingsOutsideOperators\", \
AllTrue[ops, FreeQ[List @@ #, Alternatives @@ cps] &],
     Select[ops, ! FreeQ[List @@ #, Alternatives @@ cps] &],
     \"couplings depend on k only: write nk dt[H], not dt[nk H] (and never \
differentiate a coupling)\", \"no coupling under dt/grad/div/lap\"]];
   If[fns =!= {}, AppendTo[checks, assertCheck[\"Ansatz.functionNotInOperator\
\", AllTrue[ops, FreeQ[List @@ #, fnPat] &],
      Select[ops, ! FreeQ[List @@ #, fnPat] &], \"write the function outside \
the operators: Fnu lap[h], not lap[Fnu h]\", \"no momentum function under an \
operator\"]]];
   FRGAssert[\"Ansatz.operatorOnField\", AllTrue[ops, AllTrue[List @@ #, ! \
FreeQ[#, fld] &] &], Select[ops, ! AllTrue[List @@ #, ! FreeQ[#, fld] &] &],
    \"an operator acts on an expression without fields\"];
   jacQ = ! FreeQ[dens, jac];
   If[jacQ, AppendTo[checks, assertCheck[\"Ansatz.epsilonDimension\", theory[\
\"Dimension\"] === 2, theory[\"Dimension\"],
      \"jac (eps_ij) exists only in d = 2: declare \\\"Dimension\\\" -> \
FixedDimension[2]\", \"jac with d = 2 (declared)\"]]];\
\>", "Program",ExpressionUUID->"a0151b25-8443-4e7f-9ded-60c5ba454a2b"],

Cell[TextData[{
 StyleBox["Mathematica: Complement and Intersection",
  FontWeight->Bold],
 "\n",
 StyleBox["Complement[all, l1, l2, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the elements of all that are in none of the li; ",
 StyleBox["Intersection[l1, l2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the common ones.",
 "\n\n",
 StyleBox["badSyms",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " collects every non-System symbol of the density (heads included: ",
 StyleBox["Heads -> True",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", see ",
 StyleBox["Cases and level specifications",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") and removes the fields, the couplings, ",
 StyleBox["Dim",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and the operators. Anything left is a symbol you forgot to declare."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"d32e411d-ddbe-494f-9f7a-1b1ce9db100d"],

Cell["\<\
These checks look at the raw input, so their hints can be precise:\
\>", "Text",ExpressionUUID->"299c9793-1fcd-419e-81c2-e141cbd7f5d5"],


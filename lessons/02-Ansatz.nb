Cell["Lesson 02 - Ansatz", "Title",ExpressionUUID->"c454f287-c5ff-4d1b-b4e5-57bc5911527e"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_k = ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 "dt d^dx ",
 StyleBox["\|01d4db",
  FontFamily->"Noto Sans"],
 ". The ansatz is the density ",
 StyleBox["\|01d4db",
  FontFamily->"Noto Sans"],
 ", written by you with the operators ",
 StyleBox["dt",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["grad",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["div",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["lap",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (and ",
 StyleBox["jac",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " in d = 2). The module rewrites it as a list of ",
 StyleBox["monomials",
  FontWeight->Bold],
 ": a coefficient (couplings only) times a product of derivatives of single \
fields. That is the form the next module, Vertices, can Fourier-transform \
term by term (",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "t ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " +i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", ",
 StyleBox["\[Del]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "iq, ",
 StyleBox["docs/CONVENTIONS.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",ExpressionUUID->"65c85bda-a6ff-4225-8b0d-6796e7a4159d"],


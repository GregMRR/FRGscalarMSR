  Background->GrayLevel[0.92]],
 ":"
}], "Text",ExpressionUUID->"46927f17-104a-4c84-af76-9d45eba6b565"],

Cell["ansatz[\"Monomials\"][[4]]", "Input",ExpressionUUID->"2f7bafd2-6147-4b06-b13e-fb70332fd5c3"],


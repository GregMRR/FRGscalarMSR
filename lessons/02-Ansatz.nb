Cell[TextData[{
 StyleBox["Mathematica: Automatic simplification of Times and Plus",
  FontWeight->Bold],
 "\n",
 StyleBox["Times",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Plus",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sort their arguments and combine equal ones as soon as an expression is \
built: ",
 StyleBox["x x",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " becomes ",
 StyleBox["x^2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["a + a",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " becomes ",
 StyleBox["2 a",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ".",
 "\n\n",
 StyleBox["Times",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " has the attributes ",
 StyleBox["Flat",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Orderless",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["OneIdentity",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and built-in rules that collect powers. So ",
 StyleBox["grad[h] grad[h]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is already ",
 StyleBox["Power[grad[h], 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " when ",
 StyleBox["rank",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sees it, and the failure comes from the ",
 StyleBox["Power",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " rule (\"only scalars can be raised to a power\"), not from the product \
rule. Code that walks expressions must be written for the stored form, never \
for the typed one."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"6d5ba65a-4402-4ad4-9b2c-890d57756a0e"],

Cell["{FullForm[grad[h] grad[h]], Attributes[Times]}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"7ac206ca-cf05-49ab-b34f-1fce6e5f4906"],

Cell["5. Expanding the operators: the Leibniz rule", "Section",ExpressionUUID->"55d1b8b7-a920-4e6c-8566-b95eabb9078f"],

Cell[TextData[{
 "Next, every operator is pushed down until it acts on a single field, and \
every field becomes a ",
 StyleBox["FieldFactor",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"d452812c-e0d4-4163-ad5c-5b9c202b78ba"],

Cell["\<\
(* Kernel/Ansatz.wl:67-72 *)
(* derivations acting on a sum of products of FieldFactors *)
derive[op_][e_Plus] := derive[op] /@ e;
derive[op_][e_Times] := Sum[MapAt[derive[op], e, i], {i, Length[e]}];
derive[op_][Power[f_, n_Integer]] := n f^(n - 1) derive[op][f];
derive[op_][FieldFactor[f_, nt_, ix_, fnf___]] := Replace[op, {\"t\" -> \
FieldFactor[f, nt + 1, ix, fnf], i_ :> FieldFactor[f, nt, Append[ix, i], \
fnf]}];
derive[op_][c_] /; FreeQ[c, FieldFactor] := 0;\
\>", "Program",ExpressionUUID->"60335568-0a32-48ce-8e65-d632672d34c1"],

Cell["\<\
(* Kernel/Ansatz.wl:74-98 *)
toFactors[e_, fld_, new_] := Module[{S, V},
   S[x_] /; FreeQ[x, fld | opHeads] := x;
   S[x : fld] := FieldFactor[x, 0, {}];
   S[x_Plus] := S /@ x;
   S[x_Times] := S /@ x;
   (* each factor of a power gets its own dummies: lap[h]^2, (grad h.grad \
h)^2 (design/MOMENTUMPROJECTION.md, review E14) *)
   S[Power[x_, n_Integer?Positive]] := Expand[Times @@ Table[S[x], {n}]];
   S[Power[x_, n_]] := Expand[S[x]^n];
   S[dt[x_]] := Expand[derive[\"t\"][S[x]]];
   (* fn[f, x]: the factors of x (one field) carry f in a 4th slot (LO \
pipeline, design/LOPIPELINE.md L3) *)
   S[fn[f_, x_]] := fnTag[S[x], f];
   V[fn[f_, x_], i_] := fnTag[V[x, i], f];
   S[lap[x_]] := With[{j = new[]}, Expand[derive[j][derive[j][S[x]]]]];
   S[div[v_]] := With[{j = new[]}, Expand[derive[j][V[v, j]]]];
   S[Dot[u_, v_]] := With[{j = new[]}, Expand[V[u, j] V[v, j]]];
   S[jac[a_, b_]] := With[{j = new[]}, Expand[derive[EpsIndex[j, 1]][S[a]] \
derive[EpsIndex[j, 2]][S[b]]]];
   V[grad[x_], i_] := Expand[derive[i][S[x]]];
   V[dt[v_], i_] := Expand[derive[\"t\"][V[v, i]]];
   V[x_Plus, i_] := V[#, i] & /@ x;
   V[x_Times, i_] := Module[{fs = List @@ x, r},
     r = rank[#, fld] & /@ fs;
     Expand[S[Times @@ Pick[fs, r, 0]] V[First[Pick[fs, r, 1]], i]]];
   V[x_, i_] := FRGAssert[\"Ansatz.vectorRank\", False, x, \"a vector was \
expected here (grad[...] or a sum/product containing one)\"];
   S[x_] := FRGAssert[\"Ansatz.vectorRank\", False, x, \"a scalar was \
expected here; a vector must be contracted (grad[a].grad[b]) or divided \
(div[...])\"];
   S[e]];\
\>", "Program",ExpressionUUID->"4c9ee7ca-37dd-47bc-8680-d90fc4623c55"],

Cell[TextData[{
 StyleBox["Mathematica: Curried definitions",
  FontWeight->Bold],
 "\n",
 StyleBox["f[a_][x_] := ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " defines a function of a whose result is itself a function of x.",
 "\n\n",
 StyleBox["derive[op]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is \"the derivation in direction op\": ",
 StyleBox["derive[\"t\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "t, ",
 StyleBox["derive[SpaceIndex[...]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "_i. Each rule implements one property of a derivation: linearity (",
 StyleBox["e_Plus",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), the Leibniz rule (",
 StyleBox["e_Times",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), the chain rule for powers, the action on a single field (one more ",
 StyleBox["dt",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", or one more index), and zero on constants. Such rules are stored in ",
 StyleBox["SubValues[derive]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " rather than ",
 StyleBox["DownValues",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"eaadba26-00c2-478e-832b-09125153dce9"],

Cell[TextData[{
 StyleBox["Mathematica: MapAt, Table and Sum",
  FontWeight->Bold],
 "\n",
 StyleBox["MapAt[f, e, i]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f to the i-th part of e only; ",
 StyleBox["Table[expr, {i, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Sum[expr, {i, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " build a list or a sum for i = 1..n.",
 "\n\n",
 StyleBox["derive[op][e_Times] := Sum[MapAt[derive[op], e, i], {i, \
Length[e]}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the Leibniz rule written literally: the sum over i of the product with \
only the i-th factor differentiated. ",
 StyleBox["{i, n}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is an ",
 StyleBox["iterator",
  FontWeight->Bold],
 "; ",
 StyleBox["Table",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Sum",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Do",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " all take them."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"15c3ed81-79fb-4db3-ace9-dd007c51efbd"],

Cell["\<\
FRGscalarMSR`Private`derive[\"t\"][FieldFactor[h, 0, {}] FieldFactor[hbar, 0, \
{}]]\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"4f50dc44-61d3-447e-a7da-4023e48b7229"],

Cell[TextData[{
 StyleBox["toFactors",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " defines two local functions, ",
 StyleBox["S",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (convert a scalar expression) and ",
 StyleBox["V",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (convert a vector expression, given the index it carries), with a rule per \
operator: ",
 StyleBox["lap[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is two derivatives along one fresh index, ",
 StyleBox["div[v]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " contracts a fresh index of ",
 StyleBox["v",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", a dot product gives both vectors the same fresh index."
}], "Text",ExpressionUUID->"a7500196-9e05-469e-8d96-5d1dad0411c6"],

Cell[TextData[{
 StyleBox["Mathematica: Local functions",
  FontWeight->Bold],
 "\n",
 "Symbols created by ",
 StyleBox["Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " can be given definitions like any symbol; they are private to that call \
and can use the other local variables.",
 "\n\n",
 StyleBox["S",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["V",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " exist only inside one call of ",
 StyleBox["toFactors",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and they see ",
 StyleBox["fld",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (the pattern of the fields) and ",
 StyleBox["new",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (the index generator) without these being passed around. ",
 StyleBox["S[x_] /; FreeQ[x, fld | opHeads] := x",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a conditional definition (",
 StyleBox["Patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "): a field-free factor is left as it is. As with ",
 StyleBox["Several definitions of one function",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ", the final ",
 StyleBox["S[x_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the catch-all failure."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"2f807d41-8bbf-4e18-818e-748e43b1c70e"],

Cell[TextData[{
 StyleBox["Mathematica: With",
  FontWeight->Bold],
 "\n",
 StyleBox["With[{j = value}, body]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " evaluates value once and inserts it into body as a constant.",
 "\n\n",
 StyleBox["With[{j = new[]}, Expand[derive[j][derive[j][S[x]]]]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " draws one fresh index and uses the ",
 StyleBox["same",
  FontSlant->Italic],
 " one for both derivatives: that is the Laplacian ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "_j",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "_j. Writing ",
 StyleBox["new[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " twice would give two different indices. ",
 StyleBox["With",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the lightest of the three scoping constructs (",
 StyleBox["Block and Module",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "): it creates no variable at all."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"0777ae4c-a2ea-4f26-a0e4-2a032c0f96ea"],

Cell[TextData[{
 StyleBox["new[] := SpaceIndex[{\"dummy\", ++counter}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (in ",
 StyleBox["DefineAnsatz",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") increments the local ",
 StyleBox["counter",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["++counter",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " adds 1 and returns the new value), so every call gives an index never used \
before. ",
 StyleBox["Expand",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " multiplies out products of sums."
}], "Text",ExpressionUUID->"efaeec58-ebc2-4063-8b0f-78ee2ed092dd"],

Cell["\<\
Module[{c = 0}, FRGscalarMSR`Private`toFactors[lap[h hbar], h | hbar, \
SpaceIndex[{\"dummy\", ++c}] &]]\
\>", "Input",ExpressionUUID->"52b7cf1c-8be1-4607-9c8b-b3a03184b546"],

Cell[TextData[{
 "This is ",
 StyleBox["\[Del]\.b2",
  FontFamily->"Noto Sans"],
 "(h ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 ") = ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Del]\.b2",
  FontFamily->"Noto Sans"],
 "h + 2 ",
 StyleBox["\[Del]",
  FontFamily->"Noto Sans"],
 "h",
 StyleBox["\[CenterDot]\[Del]",
  FontFamily->"Noto Sans"],
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 " + h ",
 StyleBox["\[Del]\.b2",
  FontFamily->"Noto Sans"],
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 ". The vector case of a product, ",
 StyleBox["V[x_Times, i_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", uses ",
 StyleBox["Pick[fs, r, 0]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which keeps the factors whose rank is 0: in ",
 StyleBox["H grad[Psi]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the scalar ",
 StyleBox["H",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is converted with ",
 StyleBox["S",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and the vector ",
 StyleBox["grad[Psi]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with ",
 StyleBox["V",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"2d2c7f21-4ee8-42e9-bda5-904d273d82da"],

Cell["6. Canonical monomials", "Section",ExpressionUUID->"9b550c97-5929-4591-9d9c-d2e2b6341220"],

Cell[TextData[{
 "After expansion the density is a sum of products of ",
 StyleBox["FieldFactor",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "s with dummy indices. Two monomials that differ only by the names of their \
dummy indices, or by the order of their factors, are the same term and must \
be combined."
}], "Text",ExpressionUUID->"7ca869b4-46e4-4fe8-9892-04f5a47aa72b"],

Cell["\<\
(* Kernel/Ansatz.wl:212-218 *)
   FRGAssert[\"Ansatz.scalarDensity\", rank[dens, fld] === 0, dens, \"the \
density must be a scalar (contract gradients with a dot)\"];
   new[] := SpaceIndex[{\"dummy\", ++counter}];
   expanded = Expand[toFactors[dens, fld, new]];
   FRGAssert[\"Ansatz.fieldsInFactors\", FreeQ[expanded /. _FieldFactor -> 1, \
fld | opHeads | Dot], expanded,
    \"some field or operator was not converted (internal error, or a \
non-polynomial structure such as Exp[H])\"];
   terms = If[Head[expanded] === Plus, List @@ expanded, {expanded}];
   mons = splitTerm /@ terms;\
\>", "Program",ExpressionUUID->"43bac37e-468c-473f-92b7-8b99cd926e8f"],

Cell["\<\
(* Kernel/Ansatz.wl:102-114 *)
(* canonical form of a monomial, so that equal monomials combine; returns \
{sign, factors}. For every numbering of the summed
   indices as SpaceIndex[1..]: sort each factor's index list (derivatives \
commute), sort the factor list; keep the smallest
   (a class invariant for any number of contractions: lap[lap[A]] = \
div[grad[lap[A]]], review E9).
   With eps (one pair EpsIndex[1], EpsIndex[2]): eps_ij is antisymmetric, so \
the factor list with the slots swapped is the same
   monomial with sign -1; the smaller of the two minima is kept, and equal \
minima mean zero (sign 0). *)
canonMinForm[factors_List, ix_List] := First[Sort[Function[perm,
     Sort[(factors /. Thread[ix -> (SpaceIndex /@ perm)]) /. FieldFactor[f_, \
nt_, i_, fnf___] :> FieldFactor[f, nt, Sort[i], fnf]]] /@ \
Permutations[Range[Length[ix]]]]];
canonical[factors0_List] := Module[{factors = factors0 /. EpsIndex[_, s_] :> \
EpsIndex[s], ix, l, ls},
   ix = Union[Cases[Flatten[factors[[All, 3]]], Except[_EpsIndex]]];
   l = canonMinForm[factors, ix];
   If[FreeQ[l, EpsIndex], {1, l},
    ls = canonMinForm[factors /. {EpsIndex[1] -> EpsIndex[2], EpsIndex[2] -> \
EpsIndex[1]}, ix];
    Which[ls === l, {0, l}, OrderedQ[{l, ls}], {1, l}, True, {-1, ls}]]];\
\>", "Program",ExpressionUUID->"c55381cd-5a47-4a4f-949b-d4d9616336a2"],

Cell["\<\
(* Kernel/Ansatz.wl:119-123 *)
splitTerm[t_] := Module[{fs = If[Head[t] === Times, List @@ t, {t}]},
   FRGAssert[\"Ansatz.polynomial\", AllTrue[fs, MatchQ[#, _FieldFactor | \
Power[_FieldFactor, _Integer?Positive] | _?(FreeQ[#, FieldFactor] &)] &], t,
    \"the density must be polynomial in the fields\"];
   {Times @@ Select[fs, FreeQ[#, FieldFactor] &],
    Flatten[Replace[Select[fs, ! FreeQ[#, FieldFactor] &], {Power[f_, n_] :> \
Table[f, n], f_ :> {f}}, {1}]]}];\
\>", "Program",ExpressionUUID->"4d22ce93-8f45-43b0-b8f4-fb2ea59896e2"],

Cell[TextData[{
 StyleBox["splitTerm",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " separates each term into its coefficient (the factors free of ",
 StyleBox["FieldFactor",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") and its list of field factors, writing a power ",
 StyleBox["f^2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " as two copies of ",
 StyleBox["f",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"cb50f09d-5bea-4626-856e-287c2efcef8d"],

Cell[TextData[{
 StyleBox["Mathematica: Sort and canonical order",
  FontWeight->Bold],
 "\n",
 StyleBox["Sort[list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " puts any expressions in Mathematica's canonical order; ",
 StyleBox["Permutations[list]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists all orderings.",
 "\n\n",
 StyleBox["Sort",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " works on arbitrary expressions, not only numbers: every expression has a \
place in one total order. ",
 StyleBox["canonMinForm",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tries every numbering of the summed indices (",
 StyleBox["Permutations",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), sorts the indices of each factor (derivatives commute) and then the \
factors, and keeps the smallest result (",
 StyleBox["First[Sort[...]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). Equal monomials give the same minimum, whatever their dummy names. ",
 StyleBox["Function[perm, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a ",
 StyleBox["Pure functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " with a named argument."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"9241483f-0907-4128-904e-ba71b6c8498d"],

Cell["\<\
{Permutations[{1, 2, 3}], Sort[{FieldFactor[hbar, 0, {}], FieldFactor[h, 1, \
{}], FieldFactor[h, 0, {}]}]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"eed9237d-9d9e-4791-986b-6c47ccbc9173"],

Cell[TextData[{
 StyleBox["Mathematica: Except",
  FontWeight->Bold],
 "\n",
 StyleBox["Except[p]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches anything that does not match p.",
 "\n\n",
 StyleBox["Cases[..., Except[_EpsIndex]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " collects the summed indices but not the slots of ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"da367906-05ec-4e2f-a9c3-e004a7c5053c"],

Cell[TextData[{
 StyleBox["Why it's built this way: Canonical form by brute force",
  FontWeight->Bold],
 "\n\n",
 "Trying every permutation of the dummy indices costs n! steps, which looks \
wasteful. But a monomial of the derivative expansion carries few contractions \
(one at order p",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ", two at p",
 StyleBox["\:2074",
  FontFamily->"Noto Sans"],
 "), and the result is a class invariant: two monomials are equal exactly \
when their minima are, for any number of contractions (review E9 of ",
 StyleBox["design/MOMENTUMPROJECTION.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). A cleverer canonicalisation would be faster and much harder to prove \
right. Because of it, ",
 StyleBox["lap[lap[h]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["div[grad[lap[h]]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " are recognised as the same term (exercise 2)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"ddd4e603-cc76-4559-9cf8-4cf366ac2817"],

Cell[TextData[{
 "For ",
 StyleBox["jac",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", the two slots of ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 "_ij are swapped as well: a monomial equal to its own swap is zero, and when \
the swapped form is the smaller one the sign is ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1."
}], "Text",ExpressionUUID->"301866c2-0fe9-445a-8f1a-6203d29ef413"],

Cell["7. Combining, recording, sorting", "Section",ExpressionUUID->"8ce6871d-02de-4a37-92e5-908e89d8be39"],

Cell["\<\
(* Kernel/Ansatz.wl:221-226 *)
   mons = Function[m, With[{c = canonical[m[[2]]]}, {c[[1]] m[[1]], c[[2]]}]] \
/@ mons;
   mons = KeyValueMap[{Together[Total[#2]], #1} &, GroupBy[mons, Last -> \
First]];
   If[MemberQ[mons[[All, 1]], 0],
    AppendTo[warns, infoCheck[\"INFO\", \"Ansatz.cancelled\", \
ToString[Count[mons[[All, 1]], 0]] <> \" monomial(s) cancel and are \
dropped\"]]];
   mons = monomialRecord[#, fields, responses] & /@ DeleteCases[mons, {0, \
_}];
   mons = SortBy[mons, {#FieldCount, Sort[First /@ (FirstPosition[fields, #] \
& /@ #Fields)], #TimeOrder, #MomentumOrder} &];\
\>", "Program",ExpressionUUID->"603083f0-7d18-4340-ab46-25a351b4059c"],

Cell[TextData[{
 StyleBox["Mathematica: GroupBy and KeyValueMap",
  FontWeight->Bold],
 "\n",
 StyleBox["GroupBy[list, key -> value]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " collects the elements with the same key into an association of lists; ",
 StyleBox["KeyValueMap[f, assoc]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f[key, value] to each entry.",
 "\n\n",
 StyleBox["GroupBy[mons, Last -> First]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " groups the pairs ",
 StyleBox["{coefficient, factors}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " by their factors (the last part) and keeps the coefficients (the first \
part). ",
 StyleBox["KeyValueMap[{Together[Total[#2]], #1} &, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " adds the coefficients of each group. Equal monomials are combined in one \
pass, without comparing them pairwise."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"f157d802-078e-4bfd-baba-0271535c850f"],

Cell["GroupBy[{{1, x}, {2, y}, {3, x}}, Last -> First]", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"696dd058-bc7b-4917-9b4a-755e2742faf7"],

Cell[TextData[{
 StyleBox["Mathematica: DeleteCases, SortBy and FirstPosition",
  FontWeight->Bold],
 "\n",
 StyleBox["DeleteCases[list, patt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " drops the matching elements; ",
 StyleBox["SortBy[list, f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " sorts by the value of f (a list of criteria breaks ties in turn); ",
 StyleBox["FirstPosition[list, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the position of the first x.",
 "\n\n",
 StyleBox["DeleteCases[mons, {0, _}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes the monomials whose coefficients cancelled; their number is \
reported as an INFO line. ",
 StyleBox["SortBy",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " then orders the monomials by number of fields, then by the fields, then by \
time order, then by momentum order: the order of the printed table."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"9a7f8c0f-470a-49ed-9d0d-e96353f1afc9"],

Cell[TextData[{
 StyleBox["monomialRecord",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns each pair into the record you saw in section 1:"
}], "Text",ExpressionUUID->"764ff677-7f7e-4acc-a4bb-43dbd855fbdb"],

Cell["\<\
(* Kernel/Ansatz.wl:142-147 *)
(* factors stored response fields first, then in field order (display order; \
identity was fixed by canonical) *)
monomialRecord[{coef_, fac0_}, fieldOrder_, responses_] := Module[{nIx = \
Length[Flatten[fac0[[All, 3]]]], fac},
   fac = SortBy[fac0, {! MemberQ[responses, #[[1]]], \
First[FirstPosition[fieldOrder, #[[1]]]], #[[2]], Length[#[[3]]]} &];
   <|\"Coefficient\" -> coef, \"Factors\" -> fac, \"Fields\" -> fac[[All, \
1]],
    \"FieldCount\" -> Length[fac], \"ResponseCount\" -> Count[fac[[All, 1]], \
Alternatives @@ responses],
    \"TimeOrder\" -> Total[fac[[All, 2]]], \"MomentumOrder\" -> nIx|>];\
\>", "Program",ExpressionUUID->"52131fd4-c382-449c-afef-c8a59aed92e6"],

Cell[TextData[{
 StyleBox["Why it's built this way: One simple record per monomial",
  FontWeight->Bold],
 "\n\n",
 "Every later module reads ",
 StyleBox["ansatz[\"Monomials\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", never the density you typed. The records state explicitly what they would \
otherwise recompute: the fields, how many are response fields, the time and \
momentum orders. The parser is the only code that has to understand the \
ansatz language; the rest of the pipeline works on a flat list of records. \
The printed table is the same records shown to you, so the step where your \
physics turns into data can be checked by eye."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"a2f3d654-b23a-41b8-a366-a0afeb9adc33"],

Cell["8. Checks on the monomials, and the stage", "Section",ExpressionUUID->"746a1ccf-5670-4e07-9ed5-10ec24444891"],

Cell["\<\
(* Kernel/Ansatz.wl:227-244 *)
   epsQ = ! FreeQ[mons[[All, \"Factors\"]], EpsIndex];
   If[epsQ, AppendTo[checks, assertCheck[\"Ansatz.jacQuadratic\", \
NoneTrue[mons, #FieldCount == 2 && ! FreeQ[#Factors, EpsIndex] &],
      MonomialString /@ Select[mons, #FieldCount == 2 && ! FreeQ[#Factors, \
EpsIndex] &],
      \"a quadratic jac term is a total derivative and does not contribute: \
remove it\", \"no quadratic jac term (total derivative)\"]]];

   AppendTo[checks, assertCheck[\"Ansatz.MSR\", AllTrue[mons, #ResponseCount \
>= 1 &], MonomialString /@ Select[mons, #ResponseCount == 0 &],
     \"every monomial must contain at least one response field (MSR \
action)\", \"every monomial has >= 1 response field\"]];
   AppendTo[checks, assertCheck[\"Ansatz.noLinear\", AllTrue[mons, \
#FieldCount >= 2 &], MonomialString /@ Select[mons, #FieldCount < 2 &],
     \"terms linear in the fields are not supported (expand around a \
stationary point)\", \"no linear term\"]];
   AppendTo[checks, assertCheck[\"Ansatz.quartic\", AllTrue[mons, #FieldCount \
<= 4 &], MonomialString /@ Select[mons, #FieldCount > 4 &],
     \"v1 supports at most quartic monomials\", \"at most quartic (max \" <> \
ToString[Max[#FieldCount & /@ mons]] <> \")\"]];
   FRGAssert[\"Ansatz.indexPairs\", AllTrue[mons, indexPairsQ], Select[mons, \
! indexPairsQ[#] &],
    \"internal: every spatial index must appear exactly twice, and \
EpsIndex[1], EpsIndex[2] once each or not at all\"];
   If[loQ, checks = Join[checks, loMonomialChecks[mons, funcs, cps, fld]]];
   AppendTo[checks, assertCheck[\"Ansatz.couplingsInCoefficients\", \
AllTrue[mons, FreeQ[#Coefficient, fld | opHeads | SpaceIndex | EpsIndex] &], \
mons,
     \"internal: a coefficient contains a field\", \"coefficients are \
field-free\"]];
   unused = Select[cps, FreeQ[mons[[All, \"Coefficient\"]], #] &];
   If[unused =!= {}, AppendTo[warns, infoCheck[\"WARN\", \
\"Ansatz.unusedCouplings\", \"declared but absent from the density: \" <> \
ToString[unused]]]];\
\>", "Program",ExpressionUUID->"d21e84f0-b3bc-4c5a-ba8a-eaeef5c14988"],

Cell[TextData[{
 "These are the physical assumptions of v1: every monomial contains a \
response field (MSR structure), there are no terms linear in the fields, at \
most quartic monomials, and a quadratic ",
 StyleBox["jac",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " term, a total derivative, is refused rather than silently doing nothing. \
",
 StyleBox["Count[list, patt]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " counts the elements that match (",
 StyleBox["Patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ")."
}], "Text",ExpressionUUID->"36d9dce9-aa96-4063-8200-c541b4915f2c"],

Cell["\<\
showFailure[DefineAnsatz[theory, \"Density\" -> hbar dt[h] + nuk h lap[h], \
\"Couplings\" -> {nuk}]]\
\>", "Input",ExpressionUUID->"0d57aa16-0f10-4e18-8ae8-1968c0cd833e"],

Cell[BoxData[
 $CellContext`regionCells[
 "Kernel/Ansatz.wl", "stage = stampStage[<", "\"Stage\" -> \"Ansatz\"", 
  "PrintCard[stage];"]], "Input",ExpressionUUID->"391764fd-4ec8-4b96-b4b0-\
3af010d3c174"],

Cell[TextData[{
 StyleBox["Mathematica: Sequence",
  FontWeight->Bold],
 "\n",
 StyleBox["Sequence[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is spliced into whatever contains it: ",
 StyleBox["f[x, Sequence[a, b]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["f[x, a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; ",
 StyleBox["Sequence[]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " disappears.",
 "\n\n",
 StyleBox["Sequence @@ If[epsQ, {\"Epsilon\" -> True}, {}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " adds the key ",
 StyleBox["\"Epsilon\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " only when a monomial carries ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 ". Without ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 " the key is absent, and later modules read it with ",
 StyleBox["Lookup[ansatz, \"Epsilon\", False]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"5eefacee-fb8f-45b9-8ca2-62405f151273"],

Cell[TextData[{
 "The Ansatz stage contains the whole Theory stage under ",
 StyleBox["\"Theory\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and ",
 StyleBox["\"Upstream\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists its fingerprint. Every stage carries its ancestors, so a later stage \
is self-contained."
}], "Text",ExpressionUUID->"28528439-9cf1-49b0-9b73-8d97ce811daf"],

Cell["9. Printing the table", "Section",ExpressionUUID->"1fe53c80-4f93-419a-888e-d2bb6a911ea6"],

Cell["\<\
(* Kernel/Ansatz.wl:125-128 *)
fieldString[FieldFactor[f_, nt_, ix_, fnf___]] := Nest[\"dt[\" <> # <> \"]\" &,
   If[{fnf} === {}, #, \"fn[\" <> ToString[fnf] <> \", \" <> # <> \"]\"] &[
    Which[ix === {}, ToString[f], EvenQ[Length[ix]] && \
AllTrue[Tally[ix][[All, 2]], EvenQ], Nest[\"lap[\" <> # <> \"]\" &, \
ToString[f], Length[ix]/2],
     Length[ix] == 1, \"grad[\" <> ToString[f] <> \"]\", True, \"d\" <> \
ToString[ix] <> \"[\" <> ToString[f] <> \"]\"]], nt];\
\>", "Program",ExpressionUUID->"e50d9b22-acfb-49e8-a064-f9e2b92fbe52"],

Cell["\<\
(* Kernel/Ansatz.wl:131-136 *)
MonomialString[m_Association] := Module[{fs0 = m[\"Factors\"], fs, pair, \
eps},
   eps = SortBy[Select[fs0, ! FreeQ[#[[3]], EpsIndex] &], First[Cases[#[[3]], \
EpsIndex[s_] :> s]] &];
   fs = Select[fs0, FreeQ[#[[3]], EpsIndex] &];
   pair = Select[fs, Length[#[[3]]] == 1 &];
   StringRiffle[Join[fieldString /@ Select[fs, Length[#[[3]]] =!= 1 &], \
If[pair === {}, {}, {StringRiffle[fieldString /@ pair, \".\"]}],
     If[eps === {}, {}, {\"jac[\" <> \
StringRiffle[fieldString[MapAt[DeleteCases[#, _EpsIndex] &, #, 3]] & /@ eps, \
\", \"] <> \"]\"}]], \" \"]];\
\>", "Program",ExpressionUUID->"fd034f65-5ed2-4406-8b56-8b70628884e6"],

Cell["\<\
(* Kernel/Ansatz.wl:277-283 *)
ShowMonomials[ansatz_Association] := Module[{mons = validateStage[ansatz, \
\"Ansatz\"][\"Monomials\"], fo = ansatz[\"Theory\"][\"Fields\"], rows},
   rows = {inputForm[#Coefficient], ToString[#Fields], MonomialString[#],
       \"dt^\" <> ToString[#TimeOrder] <> \" p^\" <> \
ToString[#MomentumOrder]} & /@ mons;
   Print[\"Parsed density: \", Length[mons], \" monomials   (Gamma_k = \
Integral dt d^dx [ sum of coefficient x operators ])\"];
   Print[If[$FrontEnd === Null,
     StringRiffle[StringRiffle[MapThread[StringPadRight, {#, {22, 26, 34, \
10}}], \" | \"] & /@ Prepend[rows, {\"coefficient\", \"fields\", \
\"operators\", \"order\"}], \"\\n\"],
     Grid[Prepend[rows, {\"coefficient\", \"fields\", \"operators\", \
\"order\"}], Frame -> All, Alignment -> Left]]];];\
\>", "Program",ExpressionUUID->"406b8385-8104-414e-a968-b94df7b7441e"],

Cell[TextData[{
 StyleBox["MonomialString",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes a record back in the input language. ",
 StyleBox["Nest[f, x, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f n times (",
 StyleBox["Nest[\"dt[\" <> # <> \"]\" &, \"h\", 2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["\"dt[dt[h]]\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), ",
 StyleBox["StringRiffle[list, sep]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " joins strings with a separator, ",
 StyleBox["Tally",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " counts repetitions, ",
 StyleBox["MapThread[f, {l1, l2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " applies f to pairs of elements. In a notebook the table is a ",
 StyleBox["Grid",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "; in a script it is padded text, chosen with the same ",
 StyleBox["$FrontEnd === Null",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " test as the FAIL block (",
 StyleBox["Abort, CheckAbort, Exit",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ")."
}], "Text",ExpressionUUID->"35edf6d8-0516-4430-97c4-81afc249b6f4"],

Cell["MonomialString /@ ansatz[\"Monomials\"]", "Input",ExpressionUUID->"1f6062f6-828b-4b12-ad3c-4a660d65cb7b"],

Cell["10. jac, in d = 2", "Section",ExpressionUUID->"0d375f3f-3646-428a-b29c-685d90d9e3c1"],

Cell[TextData[{
 StyleBox["jac[a, b]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " = ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 "_ij ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "_i a ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "_j b exists only in d = 2, so its theory must declare ",
 StyleBox["FixedDimension[2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 01). The slots of ",
 StyleBox["\[CurlyEpsilon]",
  FontFamily->"Noto Sans"],
 " are tagged ",
 StyleBox["EpsIndex[1]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["EpsIndex[2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ":"
}], "Text",ExpressionUUID->"d0257eb2-a40d-4487-b95e-7911863ee87c"],

Cell["\<\
theory2D = DefineTheory[\"Scalars\" -> {A1, A2}, \"Dimension\" -> \
FixedDimension[2]];
ansatz2D = DefineAnsatz[theory2D, \"Density\" -> A1bar dt[A1] + A2bar dt[A2] \
+ g A1bar jac[A1, A2] + g2 A1bar jac[A2, A1], \"Couplings\" -> {g, g2}];
Last[ansatz2D[\"Monomials\"]]\
\>", "Input",ExpressionUUID->"20fa7db6-b0e0-46fc-9452-db4d2d8929e0"],

Cell[TextData[{
 StyleBox["jac[A2, A1]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["\[Minus]jac[A1, A2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": the two terms combine into one monomial with coefficient ",
 StyleBox["g - g2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". A quadratic ",
 StyleBox["jac",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a total derivative and aborts:"
}], "Text",ExpressionUUID->"dd9463ea-fb26-4efc-882b-ea271a0bc147"],

Cell["\<\
showFailure[DefineAnsatz[theory2D, \"Density\" -> A1bar dt[A1] + g jac[A1bar, \
A1], \"Couplings\" -> {g}]]\
\>", "Input",ExpressionUUID->"7424ec9d-45a2-43c1-a60b-6098e3b27f01"],

Cell[TextData[{
 "The momentum projection of ",
 StyleBox["jac",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " terms needs the d = 2 identity of ",
 StyleBox["wedge",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 00, section 7); it reappears in lesson 08."
}], "Text",ExpressionUUID->"f7f24583-06cf-46b8-b9c9-5711695bbd25"],

Cell["Exercises", "Section",ExpressionUUID->"8bc89598-d4f3-4888-b8ad-84dc3b0a4c44"],


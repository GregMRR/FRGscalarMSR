Cell["3. Checks before any work", "Section",ExpressionUUID->"1fef2f2e-9ad4-47e2-9632-a94694aa1aee"],

Cell["\<\
(* Kernel/Ansatz.wl:153-174 *)
DefineAnsatz[theory_, opts : OptionsPattern[]] := Block[{$FRGModule = \
\"Ansatz\"},
  Module[{t0 = AbsoluteTime[], dens, cps, fields, fld, responses, checks = \
{}, warns = {}, counter = 0, new, ops, expanded, terms, mons,
    badSyms, unused, stage, jacQ, epsQ, loQ, pipeline, funcs, fsyms, frefs, \
fnOps, bad, kinds},
   validateStage[theory, \"Theory\"];
   FRGAssert[\"Ansatz.options\", MatchQ[{opts}, {(Rule | \
RuleDelayed)[\"Density\" | \"Couplings\" | \"Pipeline\" | \"Functions\", _] \
...}], {opts},
    \"only the options \\\"Density\\\", \\\"Couplings\\\", \\\"Pipeline\\\", \
\\\"Functions\\\" are accepted\"];
   dens = OptionValue[\"Density\"]; cps = OptionValue[\"Couplings\"];
   fields = theory[\"Fields\"]; responses = theory[\"ResponseFields\"]; fld = \
Alternatives @@ fields;
   (* the pipeline is inferred: fn[...] in the density means couplings that \
are functions of p^2 (LO, design/LOPIPELINE.md L4) *)
   loQ = ! FreeQ[dens, fn];
   pipeline = If[loQ, \"LO\", \"DerivativeExpansion\"];
   AppendTo[checks, assertCheck[\"Ansatz.pipeline\", MemberQ[{Automatic, \
pipeline}, OptionValue[\"Pipeline\"]], {OptionValue[\"Pipeline\"], \"inferred\
\" -> pipeline},
     \"\\\"Pipeline\\\" is inferred from the density (fn[...] present: \\\"LO\
\\\", otherwise \\\"DerivativeExpansion\\\"); an explicit value must match it\
\", pipeline]];
   funcs = OptionValue[\"Functions\"];
   FRGAssert[\"Ansatz.functionReference\", MatchQ[funcs, {(_Symbol -> \
_Symbol) ...}], funcs, \"\\\"Functions\\\" -> {f1 -> reference1, ...}\"];
   fsyms = funcs[[All, 1]]; frefs = funcs[[All, 2]];
   If[! loQ, FRGAssert[\"Ansatz.functionReference\", funcs === {}, funcs, \
\"\\\"Functions\\\" are declared but the density has no fn[f, X]\"]];
   FRGAssert[\"Ansatz.density\", dens =!= None && dens =!= 0, dens, \
\"\\\"Density\\\" -> expression is required\"];
   FRGAssert[\"Ansatz.couplingList\", ListQ[cps], cps, \"\\\"Couplings\\\" -> \
{c1, c2, ...}\"];
   assertFreshSymbols[\"Ansatz.couplings\", cps, \"couplings\"];
   FRGAssert[\"Ansatz.couplingsNotFields\", Intersection[cps, Append[fields, \
theory[\"Dimension\"]]] === {}, Intersection[cps, Append[fields, \
theory[\"Dimension\"]]],
    \"a coupling has the name of a field or of the dimension\"];\
\>", "Program",ExpressionUUID->"7a382d4c-d69b-4566-8d01-999a83c409fa"],

Cell[TextData[{
 StyleBox["validateStage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " comes first (",
 StyleBox["Hash",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "): the theory must be a genuine, unmodified Theory stage. Then the options, \
then the couplings (",
 StyleBox["OwnValues and DownValues",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " through ",
 StyleBox["assertFreshSymbols",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",ExpressionUUID->"ca8fd40c-87de-4220-9d47-69dc0166b89e"],

Cell["\<\
(* Kernel/Ansatz.wl:176-210 *)
   (* E7: System derivative heads would silently differentiate the couplings \
(Dt[nk H] = H Dt[nk] + nk Dt[H]) *)
   AppendTo[checks, assertCheck[\"Ansatz.noSystemDerivatives\", FreeQ[dens, \
systemOps], Cases[dens, systemOps[___] | Derivative[__][_], {0, Infinity}, \
Heads -> True],
     \"use the package operators dt, grad, div, lap (System Dt, Grad, Div, \
Laplacian, D are not allowed)\", \"no Dt/D/Grad/Div/Laplacian\"]];

   (* functions (LO): fresh symbols tied to distinct references; every fn[f, \
X] has a declared f and X = one field under grad/lap *)
   If[loQ,
    assertFreshSymbols[\"Ansatz.functions\", fsyms, \"functions\"];
    fnOps = Cases[dens, _fn, {0, Infinity}];
    AppendTo[checks, assertCheck[\"Ansatz.functionReference\",
      SubsetQ[cps, frefs] && DuplicateFreeQ[frefs] && Intersection[fsyms, \
Join[cps, fields, {theory[\"Dimension\"]}]] === {} &&
       SubsetQ[fsyms, Cases[fnOps, fn[f_, ___] :> f]],
      <|\"functions\" -> funcs, \"undeclared\" -> Complement[Cases[fnOps, \
fn[f_, ___] :> f], fsyms]|>,
      \"each fn[f, X] needs f declared in \\\"Functions\\\" -> {f -> \
reference}, the reference a coupling of the ansatz, one reference per \
function \\
(f(0) = 1 fixes the eta of its reference)\", \"functions \" <> \
StringRiffle[(ToString[#[[1]]] <> \" -> \" <> ToString[#[[2]]]) & /@ funcs, \
\", \"]]];
    AppendTo[checks, assertCheck[\"Ansatz.fnOneField\", AllTrue[fnOps, \
MatchQ[#, fn[_Symbol, x_] /; fnArgumentQ[x, fld]] &],
      Select[fnOps, ! MatchQ[#, fn[_Symbol, x_] /; fnArgumentQ[x, fld]] &],
      \"fn[f, X]: X is one field, optionally under grad/lap (e.g. fn[fnu, \
lap[h]]); no coupling, product or fn inside\", \"fn[f, X] acts on one \
field\"]]];

   badSyms = Complement[Cases[dens, s_Symbol /; Context[s] =!= \"System`\", \
{0, Infinity}, Heads -> True], fields, cps, fsyms, {theory[\"Dimension\"], \
dt, grad, div, lap, jac, fn}];
   AppendTo[checks, assertCheck[\"Ansatz.knownSymbols\", badSyms === {}, \
badSyms,
     If[MemberQ[SymbolName /@ badSyms, \"t\" | \"x\"], \"couplings depend on \
k only: no explicit t or x dependence is allowed\",
      \"every symbol must be a declared coupling (\\\"Couplings\\\") or a \
field of the theory\"], \"every symbol is a field, a coupling or Dim\"]];

   (* operators act on field expressions only: couplings depend on k only and \
must stand outside (no dt[nk H], no lap[nk]) *)
   ops = Cases[dens, opHeads[___], {0, Infinity}];
   FRGAssert[\"Ansatz.operatorArity\", AllTrue[ops, Length[#] == arity[#] &], \
Select[ops, Length[#] =!= arity[#] &],
    \"dt, grad, div, lap take exactly one argument; jac takes two\"];
   AppendTo[checks, assertCheck[\"Ansatz.couplingsOutsideOperators\", \
AllTrue[ops, FreeQ[List @@ #, Alternatives @@ cps] &],
     Select[ops, ! FreeQ[List @@ #, Alternatives @@ cps] &],
     \"couplings depend on k only: write nk dt[H], not dt[nk H] (and never \
differentiate a coupling)\", \"no coupling under dt/grad/div/lap\"]];
   FRGAssert[\"Ansatz.operatorOnField\", AllTrue[ops, AllTrue[List @@ #, ! \
FreeQ[#, fld] &] &], Select[ops, ! AllTrue[List @@ #, ! FreeQ[#, fld] &] &],
    \"an operator acts on an expression without fields\"];
   jacQ = ! FreeQ[dens, jac];
   If[jacQ, AppendTo[checks, assertCheck[\"Ansatz.epsilonDimension\", theory[\
\"Dimension\"] === 2, theory[\"Dimension\"],
      \"jac (eps_ij) exists only in d = 2: declare \\\"Dimension\\\" -> \
FixedDimension[2]\", \"jac with d = 2 (declared)\"]]];\
\>", "Program",ExpressionUUID->"c9e262bc-31c3-4fa3-981d-16550ec991bf"],

Cell[TextData[{
 StyleBox["Mathematica: Complement and Intersection",
  FontWeight->Bold],
 "\n",
 StyleBox["Complement[all, l1, l2, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " gives the elements of all that are in none of the li; ",
 StyleBox["Intersection[l1, l2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the common ones.",
 "\n\n",
 StyleBox["badSyms",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " collects every non-System symbol of the density (heads included: ",
 StyleBox["Heads -> True",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", see ",
 StyleBox["Cases and level specifications",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") and removes the fields, the couplings, ",
 StyleBox["Dim",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and the operators. Anything left is a symbol you forgot to declare."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"9db74b40-e720-45d6-b654-0b3205755739"],

Cell["\<\
These checks look at the raw input, so their hints can be precise:\
\>", "Text",ExpressionUUID->"c76af2cd-92ec-4ae6-ae4d-b58e747502a5"],

Cell["\<\
showFailure[DefineAnsatz[theory, \"Density\" -> hbar dt[nuk h], \"Couplings\" \
-> {nuk}]]\
\>", "Input",ExpressionUUID->"842db9ae-0cd5-447f-831c-38a9c4b0aadb"],

Cell["\<\
showFailure[DefineAnsatz[theory, \"Density\" -> hbar Dt[h] + g hbar^2, \
\"Couplings\" -> {}]]\
\>", "Input",ExpressionUUID->"697efa9f-5758-4f09-b08a-4f9b232c72cf"],

Cell[TextData[{
 StyleBox["Why it's built this way: Validate the input before transforming it",
  FontWeight->Bold],
 "\n\n",
 "A malformed density caught after the expansion would show up as a strange \
monomial, far from what you wrote. Checked first, it is reported as you wrote \
it, with a hint in the vocabulary of the input (",
 StyleBox["write nk dt[H], not dt[nk H]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). Each check also documents an assumption of the module: couplings depend \
on k only, the density is polynomial, only package operators are allowed."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"56c2f2a1-4c2b-4dac-a655-b33cbba534cc"],

Cell["4. Vector rank: is this a scalar or a vector?", "Section",ExpressionUUID->"74041225-e2e3-46b8-ada0-c1c89a1ff11f"],

Cell[TextData[{
 "Before expanding, the module checks the vector algebra: ",
 StyleBox["grad",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes a vector, ",
 StyleBox["div",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox[".",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " make scalars, a sum cannot mix the two."
}], "Text",ExpressionUUID->"2af84c73-ea97-450c-abd4-7f25a17ec3e2"],

Cell["\<\
(* Kernel/Ansatz.wl:38-57 *)
rank[e_, fld_] := Which[
   FreeQ[e, fld | opHeads], 0,
   MatchQ[e, fld], 0,
   True, rankOf[e, fld]];
rankOf[grad[a_], fld_] := (needRank[a, 0, fld, \"grad[...] acts on a \
scalar\"]; 1);
rankOf[dt[a_], fld_] := rank[a, fld];
rankOf[fn[f_, a_], fld_] := rank[a, fld];
rankOf[div[a_], fld_] := (needRank[a, 1, fld, \"div[...] acts on a vector, \
e.g. div[H grad[Psi]]\"]; 0);
rankOf[lap[a_], fld_] := (needRank[a, 0, fld, \"lap[...] acts on a scalar\"]; \
0);
rankOf[jac[a_, b_], fld_] := (needRank[a, 0, fld, \"jac[a, b] acts on two \
scalars\"]; needRank[b, 0, fld, \"jac[a, b] acts on two scalars\"]; 0);
rankOf[Dot[a_, b_], fld_] := (needRank[a, 1, fld, \"a dot contracts two \
vectors\"]; needRank[b, 1, fld, \"a dot contracts two vectors\"]; 0);
rankOf[e_Plus, fld_] := Module[{r = rank[#, fld] & /@ List @@ e},
   FRGAssert[\"Ansatz.vectorSum\", Equal @@ r, e, \"a sum mixes scalar and \
vector terms\"]; First[r]];
rankOf[e_Times, fld_] := Module[{r = Total[rank[#, fld] & /@ List @@ e]},
   FRGAssert[\"Ansatz.vectorProduct\", r <= 1, e, \"a product of two vectors \
must be written as a dot: grad[a].grad[b]\"]; r];
rankOf[Power[a_, n_], fld_] := (FRGAssert[\"Ansatz.polynomial\", IntegerQ[n] \
&& n > 0, Power[a, n],
    \"the density must be polynomial in the fields (positive integer powers \
only)\"]; needRank[a, 0, fld, \"only scalars can be raised to a power\"]; 0);
rankOf[e_, fld_] := FRGAssert[\"Ansatz.unknownStructure\", False, e,
   \"unknown structure: use products, sums, positive powers and the operators \
dt, grad, div, lap, and . between two grads\"];
needRank[a_, r_, fld_, hint_] := FRGAssert[\"Ansatz.vectorRank\", rank[a, \
fld] === r, a, hint];\
\>", "Program",ExpressionUUID->"a8186d78-825c-4061-92fe-48fd8e26d337"],

Cell[TextData[{
 StyleBox["Mathematica: Which",
  FontWeight->Bold],
 "\n",
 StyleBox["Which[c1, v1, c2, v2, ..., True, v]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the value of the first condition that is True.",
 "\n\n",
 "A chain of ",
 StyleBox["If",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "s written flat. The final ",
 StyleBox["True",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the \"otherwise\" case."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"07343bc7-2409-481d-a3c3-af807e333ff7"],

Cell[TextData[{
 StyleBox["Mathematica: Several definitions of one function",
  FontWeight->Bold],
 "\n",
 "A function can have many rules; Mathematica tries the more specific \
patterns first and the most general last.",
 "\n\n",
 StyleBox["rankOf",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " has one rule per kind of expression: ",
 StyleBox["grad[a_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["dt[a_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["e_Plus",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["e_Times",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Power[a_, n_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and finally ",
 StyleBox["rankOf[e_, fld_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which matches anything. Mathematica orders the rules by specificity, so \
the catch-all only runs when nothing else matched. Here it is a failed check: \
an expression the parser does not know is an error, not something to guess \
about. ",
 StyleBox["DownValues",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["OwnValues and DownValues",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") lists the rules in the order they are tried; the catch-all is last. Each \
left-hand side stays wrapped in ",
 StyleBox["HoldPattern",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which stops it from being evaluated (evaluating ",
 StyleBox["rankOf[e_, fld_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " would run the catch-all). This \"dispatch on the head\" is the main way \
the library structures its code; you will see it in every module."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"33965393-b867-4a91-a471-092a0c32bc93"],

Cell["\<\
{Length[DownValues[FRGscalarMSR`Private`rankOf]], \
DownValues[FRGscalarMSR`Private`rankOf][[-1, 1]]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"f3a0e6b7-d169-4962-930d-34277e4ba899"],

Cell[TextData[{
 StyleBox["rankOf[e_Plus, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " computes the rank of every term (",
 StyleBox["List @@ e",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Apply",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") and requires them all equal (",
 StyleBox["Equal @@ r",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["Equal[r1, r2, ...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",ExpressionUUID->"6c73ec7d-702a-4013-8ff6-38eddf82506b"],


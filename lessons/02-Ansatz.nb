 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"dcf0ef51-308a-497c-a304-3bbcbf930a4c"],

Cell["\<\
{FullForm[grad[h].grad[h]], FullForm[hbar (dt[h] - nuk lap[h])]}\

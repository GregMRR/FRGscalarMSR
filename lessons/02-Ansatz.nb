Cell["2. A small language of inert operators", "Section",ExpressionUUID->"fe03730d-a8be-4bb0-815e-7d28611bf40b"],

Cell["\<\
(* Kernel/Ansatz.wl:9-12 *)
dt::usage = \"dt[e]: time derivative in the ansatz density (package-owned and \
inert; not System`Dt).\";
grad::usage = \"grad[e]: spatial gradient (a vector) in the ansatz density; \
contract two of them with a dot: grad[a].grad[b].\";
div::usage = \"div[v]: divergence of a vector expression in the ansatz \
density, e.g. div[H grad[Psi]].\";
lap::usage = \"lap[e]: Laplacian in the ansatz density.\";\
\>", "Program",ExpressionUUID->"343605ec-e6c1-4d70-8801-d84e457fedc4"],

Cell["\<\
(* Kernel/Ansatz.wl:27-30 *)
SetAttributes[{dt, grad, div, lap, jac, FieldFactor, SpaceIndex, EpsIndex}, \
Protected];

opHeads = dt | grad | div | lap | jac;
systemOps = Dt | D | Grad | Div | Laplacian | Curl | Derivative | Integrate | \
Inactive | Inactivate;\
\>", "Program",ExpressionUUID->"8af3d4a0-18c4-4182-94ef-a1bbf69bf2e4"],

Cell[TextData[{
 StyleBox["dt",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["grad",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["div",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["lap",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["jac",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " have usage messages and no definitions: they are ",
 StyleBox["Inert heads",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ", protected so nobody gives them one. ",
 StyleBox["opHeads",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["systemOps",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " store ",
 StyleBox["patterns",
  FontWeight->Bold],
 " in variables, built with ",
 StyleBox["Alternatives and named patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ": ",
 StyleBox["FreeQ[e, opHeads]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads \"e contains none of the five operators\"."
}], "Text",ExpressionUUID->"697b7724-eda3-4bde-ada0-316b8b99728d"],

Cell[TextData[{
 StyleBox["Why it's built this way: The ansatz has its own operators",
  FontWeight->Bold],
 "\n\n",
 "Mathematica's ",
 StyleBox["Dt",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the total derivative and knows nothing about which symbols are \
couplings: it differentiates them too. Its ",
 StyleBox["Laplacian",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " needs explicit coordinates and, applied to a symbol that does not depend \
on them, gives zero before the library can see anything (",
 StyleBox["docs/MODULES.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", Ansatz caveat). With inert operators, the library alone decides what a \
derivative means: it acts on fields, never on couplings, which depend on k \
only."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"be4f80a4-7484-4f18-a325-a4b4fb5f913f"],

Cell["{Dt[nuk h], Laplacian[h, {x, y}]}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"c7775501-fc4a-4f0d-aec0-056b8ca001f2"],


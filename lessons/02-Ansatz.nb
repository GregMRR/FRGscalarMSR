  Background->GrayLevel[0.92]],
 ":"
}], "Text",ExpressionUUID->"02c74853-b1fa-41e6-b12b-13435d1e605f"],

Cell["ansatz[\"Monomials\"][[4]]", "Input",ExpressionUUID->"e9d6ffb3-3dbf-4992-a9e2-05c2283d88a0"],


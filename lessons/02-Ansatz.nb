Cell["\<\
ansatz = DefineAnsatz[theory, \"Density\" -> hbar (dt[h] - nuk lap[h] - \
lamk/2 grad[h].grad[h]) - Dk hbar^2, \"Couplings\" -> {nuk, lamk, Dk}];\
\>", "Input",ExpressionUUID->"18f09ff4-24a3-4aa0-8e23-6e819040805c"],

Cell[TextData[{
 "The table is printed before the card so you can check the parse by eye. \
Each row is one record of ",

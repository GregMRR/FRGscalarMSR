Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"f3817bc5-9810-4f23-b828-df834f06d9b8"],

Cell[TextData[{
 StyleBox["\[Del]\[CenterDot]",
  FontFamily->"Noto Sans"],
 "(h ",
 StyleBox["\[Del]",
  FontFamily->"Noto Sans"],
 "h) = ",
 StyleBox["\[Del]",
  FontFamily->"Noto Sans"],
 "h",
 StyleBox["\[CenterDot]\[Del]",
  FontFamily->"Noto Sans"],
 "h + h ",
 StyleBox["\[Del]\.b2",
  FontFamily->"Noto Sans"],
 "h, so two cubic monomials, each with coefficient 1:"
}], "Text",ExpressionUUID->"d7ae06db-9adb-43e4-9102-a47f1c23e128"],

Cell["\<\
DefineAnsatz[theory, \"Density\" -> hbar div[h grad[h]], \"Couplings\" -> {}];\
\>", "Input",ExpressionUUID->"43ddd7b7-8808-4bd9-84d3-e33b861b9b10"]
}, Closed]],

Cell["Exercise: Two ways to write \[Del]\:2074", "Subsection",ExpressionUUID->"2c2e436f-997b-4388-8921-728ca56f9164"],

Cell[TextData[{
 "Give ",
 StyleBox["lap[lap[h]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["div[grad[lap[h]]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " two different couplings in one density. How many monomials do you expect, \
and with which coefficient?"
}], "Text",ExpressionUUID->"91922ebe-410d-484f-b9f0-4b380da718d0"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"2e070964-8157-4758-9e8d-2952935b2fba"],

Cell["\<\
DefineAnsatz[theory, \"Density\" -> c1 hbar lap[lap[h]] + c2 hbar \
div[grad[lap[h]]], \"Couplings\" -> {c1, c2}];\
\>", "Input",ExpressionUUID->"d228f42e-8e2b-469f-8899-3a400def2f6f"],

Cell[TextData[{
 "One monomial, ",
 StyleBox["hbar lap[lap[h]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with coefficient ",
 StyleBox["c1 + c2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", of order p",
 StyleBox["\:2074",
  FontFamily->"Noto Sans"],
 ": the canonical form of section 6 recognises the two as the same term."
}], "Text",ExpressionUUID->"308f5ca4-5322-47d2-85b3-c03baefbe916"]
}, Closed]],

Cell["Exercise: Query the records", "Subsection",ExpressionUUID->"9785dbc9-4d5f-4c98-b05f-d9faf7c95224"],

Cell[TextData[{
 "From ",
 StyleBox["ansatz",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", select the monomials of momentum order 2 and print them in the input \
language with their coefficients."
}], "Text",ExpressionUUID->"10ad8ed7-fa6f-488f-8797-4fe6ff410bb3"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"8f6d2fec-ca3b-4c34-b62f-402427431e97"],

Cell["\<\
{#Coefficient, MonomialString[#]} & /@ Select[ansatz[\"Monomials\"], \
#MomentumOrder == 2 &]\
\>", "Input",ExpressionUUID->"fecaa648-306c-48d7-a413-db15cab64335"],

Cell[TextData[{
 StyleBox["#MomentumOrder",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " reads a key of the record (",

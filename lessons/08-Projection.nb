 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"c90661b0-0d5c-44a3-83b2-1df7f768688c"],

Cell["\<\
{Nest[f, x, 3], FRGscalarMSR`Private`explicitProjection[scal[p, q]^2, 0, 1, \
{nu, p}, {w, q}, 3, 1]}\
\>", "Input",

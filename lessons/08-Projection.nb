Cell["2. The operator", "Section",ExpressionUUID->"980665e7-0062-4d05-9324-e68858e35a5a"],

Cell["\<\
(* Kernel/Projection.wl:82-90 *)
(* (d/d(I nu))^m / m! at nu = 0, and the (p^2)^n coefficient by \
directionalAverage *)
project[e0_, m_, n_, {nu_, p_}, {w_, q_}, dim_, deg_, eps_ : False] := \
Module[{e = e0},
   If[eps, e = dropWedge[e, m, n, {nu, p}, {w, q}]];
   If[m > 0, e = D[e, {nu, m}]];
   e = directionalAverage[e, n, p, q, dim] /. nu -> 0;
   e = e /. scal[q, q] -> LoopMomentumSquared /. deltaCompletion[deg];
   FRGAssert[\"Projection.complete\", FreeQ[e, q | p | nu | projS | projC | \
wedge | Derivative[__][scal] | Derivative[__][\\[CapitalDelta]]], e,
    \"internal: external variables, vectors or Delta derivatives left after \
the projection\"];
   e/(I^m m!)];\
\>", "Program",ExpressionUUID->"bd4d4040-1d11-4ea9-81da-41fcf89952f1"],

Cell[TextData[{
 StyleBox["project",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " takes the integrand at general (",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ", p), differentiates m times in ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ", takes the p-projection, sets ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " = 0, renames q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " and completes the derivatives of ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " (section 4). ",
 StyleBox["eps_ : False",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is an optional argument with a default (",
 StyleBox["Patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ")."
}], "Text",ExpressionUUID->"6a655243-b65c-4b8a-8c6d-8de9a982f328"],

Cell[TextData[{
 StyleBox["Mathematica: Repeated derivatives",
  FontWeight->Bold],
 "\n",
 StyleBox["D[e, {x, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the n-th derivative of e in x; ",
 StyleBox["D[e, {x, n}, {y, m}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " mixes variables.",
 "\n\n",
 StyleBox["D[e, {nu, m}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " followed by ",
 StyleBox["/I^m m!",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " 0 is the coefficient of (i",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ")^m in the Taylor series. The same ",
 StyleBox["D[e, {projS, 2 n}]/(2 n)!",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " at s = 0 gives the s^{2n} coefficient in ",
 StyleBox["directionalAverage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"f48efe64-5bd7-4da9-b4ee-ec3677bdbf55"],

Cell["3. The momentum projection: a direction average", "Section",ExpressionUUID->"b3d6086c-12a8-4905-a7c2-3d44e11137db"],

Cell["\<\
(* Kernel/Projection.wl:21-22 *)
(* <c^k> |q|^k, c = cosine between a random unit direction e and q in d \
dimensions (design/MOMENTUMPROJECTION.md M1) *)
projCAverage[k_, dim_, qq_] := If[OddQ[k], 0, qq^(k/2) (k - 1)!!/Product[dim \
+ 2 j, {j, 0, k/2 - 1}]];\
\>", "Program",ExpressionUUID->"c12569c8-7b46-4e75-a50c-96471e3b3baf"],

Cell["\<\
(* Kernel/Projection.wl:24-32 *)
(* M1: the (p^2)^n coefficient of f(p) is the direction average of the s^(2n) \
Taylor coefficient of f(p = s e). The loop holds p only
   in scal[p, p] = s^2 and scal[p, q] = s c (scal is bilinear: (p + q)^2 is \
already expanded); c^k averages to projCAverage *)
directionalAverage[e0_, n_, p_, q_, dim_] := Module[{e = e0 /. {scal[p, p] -> \
projS^2, scal[p, q] -> projS projC}, odd},
   If[n == 0, Return[e /. projS -> 0]];
   e = (D[e, {projS, 2 n}] /. projS -> 0)/(2 n)!;
   odd = Table[D[e, {projC, k}] /. projC -> 0, {k, 1, 2 n - 1, 2}];
   FRGAssert[\"Projection.noOddC\", ExactlyZeroQ[odd, \"Seeds\" -> {1}], \
Short[odd],
    \"internal invariant: a term odd in p.q survived at order s^(2n) \
(impossible by degree counting: c-degree is 2n - 2a)\"];
   Sum[(D[e, {projC, k}] /. projC -> 0)/k! projCAverage[k, dim, scal[q, q]], \
{k, 0, 2 n, 2}]];\
\>", "Program",ExpressionUUID->"21c817c7-76f1-45a1-abde-8f9de2f6f789"],

Cell[TextData[{
 "The loop depends on p only through ",
 StyleBox["scal[p, p]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["scal[p, q]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["scal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is bilinear, so (p + q)",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " is already expanded, lesson 00, section 7). Write p = s e with e a unit \
vector at angle c = cos ",
 StyleBox["\[Theta]",
  FontFamily->"Noto Sans"],
 " to q: ",
 StyleBox["scal[p, p]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " s",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ", ",
 StyleBox["scal[p, q]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " s c. The s^{2n} coefficient is a polynomial in c, and averaging over the \
directions e uses ",
 StyleBox["\:27e8",
  FontFamily->"Noto Sans"],
 "c^{2k}",
 StyleBox["\:27e9",
  FontFamily->"Noto Sans"],
 " = (2k",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1)!!/(d(d+2)",
 StyleBox["\[CenterEllipsis]",
  FontFamily->"Noto Sans"],
 "(d+2k",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2)) times |q|^{2k}; odd powers average to zero."
}], "Text",ExpressionUUID->"bc93d5da-8001-4797-bc92-a38fb07bcf67"],

Cell[TextData[{
 StyleBox["Mathematica: Special functions and products",
  FontWeight->Bold],
 "\n",
 StyleBox["k!!",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the double factorial, ",
 StyleBox["Product[f, {j, a, b}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " a product, ",
 StyleBox["Pochhammer[a, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " = a(a+1)",
 StyleBox["\[CenterEllipsis]",
  FontFamily->"Noto Sans"],
 "(a+n",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1), ",
 StyleBox["Gamma[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 " function; ",
 StyleBox["FunctionExpand",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " rewrites special values in elementary form.",
 "\n\n",
 "These turn the direction average into a closed rational function of d, \
symbolic to the end (",
 StyleBox["Iterators that depend on each other",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 06)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " for ",
 StyleBox["Product",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "'s iterator)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"1ffef491-f299-4f86-a204-258965d857b5"],

Cell["{7!!, Pochhammer[d/2, 2], FunctionExpand[Gamma[5/2]]}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"60be5d87-7054-471b-93e7-b9c245880cd2"],

Cell["\<\
{FRGscalarMSR`Private`directionalAverage[scal[p, q]^2, 1, p, q, Dim], \
FRGscalarMSR`Private`directionalAverage[scal[p, q]^4, 2, p, q, Dim]}\
\>", "Input",ExpressionUUID->"07c72b3d-6f84-434b-944a-9029b50d75d4"],

Cell[TextData[{
 StyleBox["\:27e8",
  FontFamily->"Noto Sans"],
 "(p",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "q)",
 StyleBox["\.b2\:27e9",
  FontFamily->"Noto Sans"],
 " = p",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "/d gives q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "/d as the (p",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\.b9",
  FontFamily->"Noto Sans"],
 " coefficient; at order p",
 StyleBox["\:2074",
  FontFamily->"Noto Sans"],
 ", 3 q",
 StyleBox["\:2074",
  FontFamily->"Noto Sans"],
 "/(d(d+2))."
}], "Text",ExpressionUUID->"0326487b-64bc-4df6-8c67-619acd508201"],

Cell[TextData[{
 StyleBox["Why it's built this way: A direction average instead of a \
Laplacian",
  FontWeight->Bold],
 "\n\n",
 "The usual trick takes (",
 StyleBox["\[Del]\.b2",
  FontFamily->"Noto Sans"],
 "_p)",
 StyleBox["\:207f",
  FontFamily->"Noto Sans"],
 " at p = 0 and divides by its value on (p",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\:207f",
  FontFamily->"Noto Sans"],
 ". It needs explicit vectors or a hand-coded Laplacian on ",
 StyleBox["scal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " expressions, and the previous version of the library got it right only for \
n ",
 StyleBox["\[LessEqual]",
  FontFamily->"Noto Sans"],
 " 1. The direction average works with ",
 StyleBox["scal[p, p]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["scal[p, q]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " as two scalars, any n, with one table of ",
 StyleBox["\:27e8",
  FontFamily->"Noto Sans"],
 "c^{2k}",
 StyleBox["\:27e9",
  FontFamily->"Noto Sans"],
 ". The old operator is kept as a test-only reference (",
 StyleBox["tests/reference/OldProjection.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "), and the new one is required to agree with it on every existing integrand \
(",
 StyleBox["design/MOMENTUMPROJECTION.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"d96461a8-4573-48a5-b944-5dce3acdc4b4"],

Cell["4. Derivatives of \[CapitalDelta]", "Section",ExpressionUUID->"dfeb0fc8-6446-47f0-8d83-c07ae11a8294"],

Cell[TextData[{
 "Differentiating ",
 StyleBox["\[CapitalDelta][nu + wL, s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with respect to ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " produces the derivative of the inert function ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 ":"
}], "Text",ExpressionUUID->"54ee14d2-d538-4afb-866d-a7b40d852d48"],

Cell["D[\[CapitalDelta][nu + w, s], nu]", "Input",ExpressionUUID->"63b42db6-8b09-431e-b213-f5539b084407"],

Cell[TextData[{
 StyleBox["Mathematica: Derivative of several arguments",
  FontWeight->Bold],
 "\n",
 StyleBox["Derivative[i, j][f][x, y]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is ",
 StyleBox["\[PartialD]\:2071",
  FontFamily->"Noto Sans"],
 "_x ",
 StyleBox["\[PartialD]\:02b2",
  FontFamily->"Noto Sans"],
 "_y f; a pattern ",
 StyleBox["Derivative[i_, j_][\[CapitalDelta]][w_, s_]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " matches any such derivative.",
 "\n\n",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " has no definition, so ",
 StyleBox["D",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes its derivatives with ",
 StyleBox["Derivative",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["D and unknown functions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 04)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "). ",
 StyleBox["deltaCompletion",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a rule that replaces any derivative of ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " by the derivative of its polynomial form ",
 StyleBox["\[CapitalSigma]",
  FontFamily->"Noto Sans"],
 "_m c_m(s) (i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")^m, so derivatives come out in the atoms ",
 StyleBox["DeltaCoefficient[m][s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and their s-derivatives."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"a18bb766-82cd-4f4f-a811-b40d46cdb73f"],

Cell["\<\
(* Kernel/Projection.wl:17-19 *)
(* derivatives of Delta(w, s) = sum_m c_m(s) (I w)^m *)
deltaCompletion[deg_] := Derivative[i_, j_][\\[CapitalDelta]][w_, s_] :>
   (D[Sum[DeltaCoefficient[mm][xs] (I yw)^mm, {mm, 0, deg}], {yw, i}, {xs, \
j}] /. {yw -> w, xs -> s});\
\>", "Program",ExpressionUUID->"4766ac0a-95be-4865-ba00-37fef0bdc5e7"],

Cell["\<\
D[\[CapitalDelta][nu + w, s], nu] /. FRGscalarMSR`Private`deltaCompletion[1]\
\>", "Input",ExpressionUUID->"83dc4ffa-3804-4ccd-8c1e-60376d1b233c"],

Cell["5. Building the integrands, and the checks", "Section",ExpressionUUID->"427b942e-32e5-412e-b904-0faf43f1d005"],

Cell["\<\
(* Kernel/Projection.wl:92-124 *)
ProjectOnMonomials[loops_, symmetries_] := Block[{$FRGModule = \"Projection\"},
  Module[{t0 = AbsoluteTime[], v, prop, dim, deg, targets, lhsBad, byPair, \
res, nmax, nExplicit, checks = {}, warns = {}, stage, wq, eps},
   FRGAssert[\"Projection.pipeline\", NoneTrue[{loops, symmetries}, \
AssociationQ[#] && Lookup[#, \"Pipeline\", None] === \"LO\" &], \"LO\", \
\"this is a derivative-expansion stage; an LO ansatz (fn[...]) goes through \
BuildLOEquations (design/LOPIPELINE.md)\"];
   validateStage[loops, \"Loops\"]; validateStage[symmetries, \
\"Symmetries\"];
   v = loops[\"Vertices\"]; prop = loops[\"Propagator\"];
   FRGAssert[\"Projection.sameAnsatz\", v[\"Upstream\"] === \
symmetries[\"Upstream\"], {v[\"Upstream\"], symmetries[\"Upstream\"]},
    \"the loops and the symmetries were built from different ansatz \
stages\"];
   dim = symmetries[\"Dimension\"]; deg = prop[\"DeltaDegree\"]; wq = \
LoopVariables[loops];
   eps = Lookup[v[\"Ansatz\"], \"Epsilon\", False];
   If[eps, AppendTo[checks, assertCheck[\"Projection.epsilonDimension\", dim \
=== 2, dim, \"internal: eps (jac) needs the declared d = 2\", \"eps with d = \
2\"]]];
   $wedgeDropped = 0;
   targets = Select[symmetries[\"Classification\"], #Class =!= \"Structure\" \
&];
   nmax = Max[0, targets[[All, \"Momentum\"]]];

   (* the d-normalisation of the momentum projection, against an independent \
closed form (LHS cannot see it: review E2) *)
   If[nmax >= 1, checkNormalisation[nmax, dim];
    AppendTo[checks, assertCheck[\"Projection.normalisation\", True, Null, \"\
\",
      \"(p.q)^(2k) (p^2)^(n-k) -> <c^(2k)> q^(2k) = q^(2k) Gamma(k+1/2) \
Gamma(d/2)/(Sqrt[Pi] Gamma(k+d/2)), n <= \" <> ToString[nmax] <> \", d = \" \
<> ToString[dim]]]];
   If[nmax >= 2, AppendTo[warns, infoCheck[\"ASSUMPTION\", \
\"Projection.shapeSmoothness\",
      \"p^{2n} flows contain shape derivatives up to order 2n (here \" <> \
ToString[2 nmax] <> \"): any explicit shape substituted later must be C^\" <> \
ToString[2 nmax]]]];

   (* LHS check: the projection operator applied to Gamma_k (regulator off) \
reproduces the classified coefficient *)
   lhsBad = Select[targets, Expand[project[VertexValue[v, #Pair, {{nu, p}}], \
#Frequency, #Momentum, {nu, p}, {zz, zq}, dim, deg, eps] - #GammaK] =!= 0 &];
   AppendTo[checks, assertCheck[\"Projection.LHS\", lhsBad === {}, lhsBad,
     \"internal: the projection operator does not reproduce the Gamma_k \
coefficient (normalisation of the frequency or momentum projection)\",
     \"projection of Gamma_k = its coefficient, \" <> \
ToString[Length[targets]] <> \" monomials ((d/d(I nu))^m/m!, (p^2)^n \
coefficient; not the d-normalisation)\"]];

   byPair = GroupBy[targets, #Pair &];
   res = Join @@ KeyValueMap[Function[{pair, ms}, Module[{loop = \
LoopIntegrand[loops, pair, nu, p]},
        Function[r, With[{ig = project[loop, r[\"Frequency\"], \
r[\"Momentum\"], {nu, p}, wq, dim, deg, eps]},
           (* n >= 2: the directional average against explicit vectors (n <= \
1 is certified by the regression vs the old operator) *)
           If[r[\"Momentum\"] >= 2, checkExplicitVectors[loop, ig, \
r[\"Frequency\"], r[\"Momentum\"], {nu, p}, wq, dim, deg]];
           Append[r, \"Integrand\" -> ig]]] /@ ms]], byPair];\
\>", "Program",ExpressionUUID->"5e72b651-0a0f-481d-b6f0-4188fcd6ed7b"],

Cell[TextData[{
 "The integrands are computed per pair: ",
 StyleBox["GroupBy[targets, #Pair &]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["GroupBy and KeyValueMap",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") groups the monomials, and ",
 StyleBox["LoopIntegrand",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 07) is called once per pair, then projected once per monomial."
}], "Text",ExpressionUUID->"07987025-1def-463b-9939-572a16b445d9"],

Cell["\<\
Three checks guard the operator, each independent of the others:\
\>", "Text",ExpressionUUID->"442a7dd6-0a59-4b25-854e-1ed057c8f1ea"],

Cell[TextData[{
 StyleBox["`Projection.LHS`",
  FontWeight->Bold],
 ": the same ",
 StyleBox["project",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", applied to ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_k itself (regulator off), must give back each classified coefficient. It \
tests the frequency normalisation and the order in s; ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "_k depends on p only through p",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ", so it cannot see the d-normalisation (review E2)."
}], "Item",ExpressionUUID->"ba1982dc-f7aa-413e-bb79-dc27245be4f0"],

Cell[TextData[{
 StyleBox["`Projection.normalisation`",
  FontWeight->Bold],
 ": the projection of (p",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "q)^{2k} (p",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")^{n",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "k} against the closed form q^{2k} ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "(k+",
 StyleBox["\.bd",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "(d/2)/(",
 StyleBox["\[Sqrt]\[Pi]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "(k+d/2)), written with ",
 StyleBox["Gamma",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " instead of ",
 StyleBox["projCAverage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (review E17)."
}], "Item",ExpressionUUID->"0dc95e0e-3268-46a6-8b6d-11f86a7700d5"],

Cell[TextData[{
 StyleBox["`Projection.explicitVectors`",
  FontWeight->Bold],
 ", for n ",
 StyleBox["\[GreaterEqual]",
  FontFamily->"Noto Sans"],
 " 2: the result against (",
 StyleBox["\[Del]\.b2",
  FontFamily->"Noto Sans"],
 "_p)",
 StyleBox["\:207f",
  FontFamily->"Noto Sans"],
 "/N_n computed on explicit d-component vectors, at the declared d, or at d = \
1, ",
 StyleBox["\[Ellipsis]",
  FontFamily->"Noto Sans"],

  0.91, 0.95, 1.],ExpressionUUID->"a1f10e38-3d44-468d-8306-b3d667cf7572"],

Cell["\<\
{Nest[f, x, 3], FRGscalarMSR`Private`explicitProjection[scal[p, q]^2, 0, 1, \

Cell["2. The operator", "Section",ExpressionUUID->"7cd31455-7708-4990-b476-e38759b71788"],

Cell["\<\
(* Kernel/Projection.wl:82-90 *)
(* (d/d(I nu))^m / m! at nu = 0, and the (p^2)^n coefficient by \
directionalAverage *)
project[e0_, m_, n_, {nu_, p_}, {w_, q_}, dim_, deg_, eps_ : False] := \
Module[{e = e0},
   If[eps, e = dropWedge[e, m, n, {nu, p}, {w, q}]];
   If[m > 0, e = D[e, {nu, m}]];
   e = directionalAverage[e, n, p, q, dim] /. nu -> 0;
   e = e /. scal[q, q] -> LoopMomentumSquared /. deltaCompletion[deg];
   FRGAssert[\"Projection.complete\", FreeQ[e, q | p | nu | projS | projC | \
wedge | Derivative[__][scal] | Derivative[__][\\[CapitalDelta]]], e,
    \"internal: external variables, vectors or Delta derivatives left after \
the projection\"];
   e/(I^m m!)];\
\>", "Program",ExpressionUUID->"39c280a2-9631-451f-81aa-4651038d0885"],

Cell[TextData[{
 StyleBox["project",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " takes the integrand at general (",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ", p), differentiates m times in ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ", takes the p-projection, sets ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " = 0, renames q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " and completes the derivatives of ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " (section 4). ",
 StyleBox["eps_ : False",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is an optional argument with a default (",
 StyleBox["Patterns",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ")."
}], "Text",ExpressionUUID->"12698de4-1ed5-4e43-9728-192947a3afa8"],

Cell[TextData[{
 StyleBox["Mathematica: Repeated derivatives",
  FontWeight->Bold],
 "\n",
 StyleBox["D[e, {x, n}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the n-th derivative of e in x; ",
 StyleBox["D[e, {x, n}, {y, m}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " mixes variables.",
 "\n\n",
 StyleBox["D[e, {nu, m}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " followed by ",
 StyleBox["/I^m m!",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " 0 is the coefficient of (i",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 ")^m in the Taylor series. The same ",
 StyleBox["D[e, {projS, 2 n}]/(2 n)!",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " at s = 0 gives the s^{2n} coefficient in ",
 StyleBox["directionalAverage",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"4406ff1b-ae6b-4761-852e-0e7550573f5c"],

Cell["3. The momentum projection: a direction average", "Section",ExpressionUUID->"a57b4400-fb4e-4946-84f8-e784763b8b38"],

Cell["\<\
(* Kernel/Projection.wl:21-22 *)
(* <c^k> |q|^k, c = cosine between a random unit direction e and q in d \
dimensions (design/MOMENTUMPROJECTION.md M1) *)
projCAverage[k_, dim_, qq_] := If[OddQ[k], 0, qq^(k/2) (k - 1)!!/Product[dim \
+ 2 j, {j, 0, k/2 - 1}]];\
\>", "Program",ExpressionUUID->"2be4db07-fc4c-4a18-b61c-3482e17a9fcd"],

Cell["\<\
(* Kernel/Projection.wl:24-32 *)
(* M1: the (p^2)^n coefficient of f(p) is the direction average of the s^(2n) \
Taylor coefficient of f(p = s e). The loop holds p only
   in scal[p, p] = s^2 and scal[p, q] = s c (scal is bilinear: (p + q)^2 is \
already expanded); c^k averages to projCAverage *)
directionalAverage[e0_, n_, p_, q_, dim_] := Module[{e = e0 /. {scal[p, p] -> \
projS^2, scal[p, q] -> projS projC}, odd},
   If[n == 0, Return[e /. projS -> 0]];
   e = (D[e, {projS, 2 n}] /. projS -> 0)/(2 n)!;
   odd = Table[D[e, {projC, k}] /. projC -> 0, {k, 1, 2 n - 1, 2}];
   FRGAssert[\"Projection.noOddC\", ExactlyZeroQ[odd, \"Seeds\" -> {1}], \
Short[odd],
    \"internal invariant: a term odd in p.q survived at order s^(2n) \
(impossible by degree counting: c-degree is 2n - 2a)\"];
   Sum[(D[e, {projC, k}] /. projC -> 0)/k! projCAverage[k, dim, scal[q, q]], \
{k, 0, 2 n, 2}]];\
\>", "Program",ExpressionUUID->"947bdf9c-03dc-4360-af2b-9cb2fc5aa9a9"],

Cell[TextData[{
 "The loop depends on p only through ",
 StyleBox["scal[p, p]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["scal[p, q]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["scal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is bilinear, so (p + q)",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " is already expanded, lesson 00, section 7). Write p = s e with e a unit \
vector at angle c = cos ",
 StyleBox["\[Theta]",
  FontFamily->"Noto Sans"],
 " to q: ",
 StyleBox["scal[p, p]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " s",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ", ",
 StyleBox["scal[p, q]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " ",
 StyleBox["\[RightArrow]",
  FontFamily->"Noto Sans"],
 " s c. The s^{2n} coefficient is a polynomial in c, and averaging over the \
directions e uses ",
 StyleBox["\:27e8",
  FontFamily->"Noto Sans"],
 "c^{2k}",
 StyleBox["\:27e9",
  FontFamily->"Noto Sans"],
 " = (2k",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1)!!/(d(d+2)",
 StyleBox["\[CenterEllipsis]",
  FontFamily->"Noto Sans"],
 "(d+2k",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2)) times |q|^{2k}; odd powers average to zero."
}], "Text",ExpressionUUID->"4b0c65ef-8614-4d72-88ac-950a91ea0081"],

Cell[TextData[{
 StyleBox["Mathematica: Special functions and products",
  FontWeight->Bold],
 "\n",
 StyleBox["k!!",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the double factorial, ",
 StyleBox["Product[f, {j, a, b}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " a product, ",
 StyleBox["Pochhammer[a, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " = a(a+1)",
 StyleBox["\[CenterEllipsis]",
  FontFamily->"Noto Sans"],
 "(a+n",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1), ",
 StyleBox["Gamma[x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " the ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 " function; ",
 StyleBox["FunctionExpand",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " rewrites special values in elementary form.",
 "\n\n",
 "These turn the direction average into a closed rational function of d, \
symbolic to the end (",
 StyleBox["Iterators that depend on each other",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 06)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " for ",
 StyleBox["Product",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "'s iterator)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"8ccde178-d97f-42b5-9e71-8ec04958205e"],

Cell["{7!!, Pochhammer[d/2, 2], FunctionExpand[Gamma[5/2]]}", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"e48ee756-5e38-46ec-9da0-23c6b9395e22"],

Cell["\<\
{FRGscalarMSR`Private`directionalAverage[scal[p, q]^2, 1, p, q, Dim], \
FRGscalarMSR`Private`directionalAverage[scal[p, q]^4, 2, p, q, Dim]}\
\>", "Input",ExpressionUUID->"1592f465-1325-4361-be28-7c4267694b63"],

Cell[TextData[{
 StyleBox["\:27e8",
  FontFamily->"Noto Sans"],
 "(p",
 StyleBox["\[CenterDot]",
  FontFamily->"Noto Sans"],
 "q)",
 StyleBox["\.b2\:27e9",
  FontFamily->"Noto Sans"],
 " = p",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "/d gives q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 "/d as the (p",

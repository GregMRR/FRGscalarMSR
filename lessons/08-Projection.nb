 "-integrand per classified monomial (every class except Structure), as a \
function of ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " and q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " = ",
 StyleBox["LoopMomentumSquared",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"b85c4817-60de-407e-b2d7-5407db2fa99e"],


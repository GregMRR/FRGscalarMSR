Cell["ShowIntegrand[projected, nuk]", "Input",ExpressionUUID->"c1802826-dd7c-4372-96c8-4bd8cebbd6ca"],

Cell[TextData[{
 "It is a rational function of the atoms at q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " (written ",
 StyleBox["LoopMomentumSquared",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],

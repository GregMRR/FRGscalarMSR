Cell["Exercise: The p\:2074 direction average against the closed form", \
"Subsection",ExpressionUUID->"3cb30a47-4670-4c90-9817-7b7dc0f5c6b8"],

Cell[TextData[{
 "Check ",
 StyleBox["directionalAverage[scal[p, q]^4, 2, p, q, Dim]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " against q",
 StyleBox["\:2074",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "(5/2)",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "(d/2)/(",
 StyleBox["\[Sqrt]\[Pi]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "(2 + d/2))."
}], "Text",ExpressionUUID->"70440927-ea0a-48ad-98fe-48d723fe13f1"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"c1d513c7-a010-4eb3-a365-9ba2e234aece"],

Cell["\<\
Together[FunctionExpand[FRGscalarMSR`Private`directionalAverage[scal[p, q]^4, \
2, p, q, Dim] - scal[q, q]^2 Gamma[5/2] Gamma[Dim/2]/(Sqrt[Pi] Gamma[2 + \
Dim/2])]]\
\>", "Input",ExpressionUUID->"2a9b8978-d3b2-44fe-821a-584244107a7c"],

Cell[TextData[{
 "0: this is the k = 2 case of ",
 StyleBox["Projection.normalisation",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"27f22c8b-fc1b-4a5e-a938-376f027f457a"]
}, Closed]],

Cell["Exercise: Integrands of the protected monomials", "Subsection",ExpressionUUID->"c7ade898-a9ec-40e0-8109-6515021f0d6d"],

Cell[TextData[{
 "Which records of ",
 StyleBox["projected[\"Integrands\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " have a class whose flow must vanish? Are their integrands zero already? \
When does the vanishing get checked?"
}], "Text",ExpressionUUID->"2acb5fbf-9a4f-49cd-9e79-784dfe17f40a"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"ecb22674-2579-439f-b25f-bc44dcba2fab"],

Cell["\<\
{#Pair, #Frequency, #Momentum, #Class, LeafCount[#Integrand]} & /@ \
Select[projected[\"Integrands\"], MemberQ[{\"Protected\", \"Causality\", \
\"DeclaredNumeric\"}, #Class] &]\
\>", "Input",ExpressionUUID->"6f7a44c6-40ef-4b90-8ecb-be786d0dc0dc"],

Cell[TextData[{
 "Some are already 0 (LeafCount 1), most are not: the vanishing holds only \
after the frequency integral (and, for Ward identities, sometimes only after \
the q integral). ",
 StyleBox["CheckClosure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 10) tests it after the frequency integration."
}], "Text",ExpressionUUID->"554c7399-2ed3-42e9-bf61-3fffbe9d6e20"]
}, Closed]]
},

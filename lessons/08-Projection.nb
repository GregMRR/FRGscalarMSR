Cell["\<\
(* Kernel/Projection.wl:141-146 *)
ShowIntegrand[pr_Association, {a_, b_}, {m_, n_}] := Module[{r = \
SelectFirst[pr[\"Integrands\"], #Pair === {a, b} && #Frequency == m && \
#Momentum == n &]},
   If[MissingQ[r], Print[\"no such monomial (class Structure, or outside the \
truncation)\"],
    Print[\"w-integrand of (I nu)^\", m, \" (p^2)^\", n, \" in d_s Gamma2[\", \
a, \", \", b, \"] (\", r[\"Class\"], \", LeafCount \", \
LeafCount[r[\"Integrand\"]], \"):\"];
    Print[displayString[r[\"Integrand\"]]]]];
ShowIntegrand[pr_Association, coef_] := Module[{r = \
SelectFirst[pr[\"Integrands\"], Expand[#GammaK - coef] === 0 &]},
   If[MissingQ[r], Print[\"no monomial with Gamma_k coefficient \", coef], \
ShowIntegrand[pr, r[\"Pair\"], {r[\"Frequency\"], r[\"Momentum\"]}]]];\
\>", "Program",ExpressionUUID->"ef4cd5e6-569f-42f7-b8f8-0ab2e134910b"],


Cell[TextData[{
 "Check ",
 StyleBox["directionalAverage[scal[p, q]^4, 2, p, q, Dim]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " against q",
 StyleBox["\:2074",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "(5/2)",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "(d/2)/(",
 StyleBox["\[Sqrt]\[Pi]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "(2 + d/2))."
}], "Text",ExpressionUUID->"4ef9ac76-06c0-44e4-a24f-0748e2ea3040"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"5538c04b-0a68-443e-af21-dd56f68526e9"],

Cell["\<\
Together[FunctionExpand[FRGscalarMSR`Private`directionalAverage[scal[p, q]^4, \
2, p, q, Dim] - scal[q, q]^2 Gamma[5/2] Gamma[Dim/2]/(Sqrt[Pi] Gamma[2 + \
Dim/2])]]\
\>", "Input",ExpressionUUID->"d2832022-cb03-4096-9fff-868f185a50bf"],

Cell[TextData[{
 "0: this is the k = 2 case of ",
 StyleBox["Projection.normalisation",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"b0a71b65-89ce-4865-8171-a99cfcd8c3ca"]
}, Closed]],

Cell["Exercise: Integrands of the protected monomials", "Subsection",ExpressionUUID->"9c5183e7-0436-4af5-8576-6e230614a34a"],

Cell[TextData[{
 "Which records of ",
 StyleBox["projected[\"Integrands\"]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " have a class whose flow must vanish? Are their integrands zero already? \
When does the vanishing get checked?"
}], "Text",ExpressionUUID->"21f2b2bb-0abf-4f64-ae61-522b306a1df5"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"579a6ea0-1c53-49b8-8ddd-459e44887751"],

Cell["\<\
{#Pair, #Frequency, #Momentum, #Class, LeafCount[#Integrand]} & /@ \
Select[projected[\"Integrands\"], MemberQ[{\"Protected\", \"Causality\", \
\"DeclaredNumeric\"}, #Class] &]\
\>", "Input",ExpressionUUID->"1776d5b7-fb7c-4837-b1f3-fcdbde0e8197"],

Cell[TextData[{
 "Some are already 0 (LeafCount 1), most are not: the vanishing holds only \
after the frequency integral (and, for Ward identities, sometimes only after \
the q integral). ",
 StyleBox["CheckClosure",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 10) tests it after the frequency integration."
}], "Text",ExpressionUUID->"5b237c7d-d972-43c8-a256-300ddb7a4f6b"]
}, Closed]]
},

  0.91, 0.95, 1.],ExpressionUUID->"a1dd285a-3e00-427e-b67b-0889a67ca404"],

Cell["\<\
{Nest[f, x, 3], FRGscalarMSR`Private`explicitProjection[scal[p, q]^2, 0, 1, \

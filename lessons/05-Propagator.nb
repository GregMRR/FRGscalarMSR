  0.91, 0.95, 1.],ExpressionUUID->"73ee255e-eab7-44c8-855b-ddf321cf0938"],

Cell[TextData[{
 "Only the entries (a, b) with a before b in field order get atoms; the entry \
(b, a) is the same polynomial at ",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ", which is the factor ",
 StyleBox["I If[i <= j, 1, -1] ww",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". ",
 StyleBox["Propagator.atomForm",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " substitutes the values back and requires the result to equal ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2 + R exactly."
}], "Text",ExpressionUUID->"0018d065-62a6-4a04-b8c4-0346e794f9be"],

Cell[TextData[{
 StyleBox["Mathematica: Assigning to an association",
  FontWeight->Bold],
 "\n",
 StyleBox["assoc[key] = value",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " adds or replaces one entry of an association stored in a variable.",
 "\n\n",
 "Unlike ",
 StyleBox["Append",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Association",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "), this modifies the variable in place, like ",
 StyleBox["AppendTo",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for lists (",
 StyleBox["AppendTo",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 01)",

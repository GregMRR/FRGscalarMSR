Cell["\<\
{FullMatrix[propagator, w, s], PropagatorMatrix[propagator, w, s]}\
\>", "Input",ExpressionUUID->"bd3155e1-56d3-4971-9642-c0be2ab016ad"],

Cell[TextData[{
 StyleBox["GammaAtom[h, hbar, 0][s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stands for the coefficient of (i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\:2070",
  FontFamily->"Noto Sans"],
 " in (",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2 + R)_{h ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "} at q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " = s, that is ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],

}], "Text",ExpressionUUID->"3484fda9-fa3f-417c-ab5a-2dca0955de58"],

Cell["AtomRules[propagator]", "Input",ExpressionUUID->"52d86cae-5540-4189-9c16-af61cd0dd38d"],


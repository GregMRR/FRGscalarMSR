Cell[TextData[{
 StyleBox["Mathematica: Coefficient and Exponent",
  FontWeight->Bold],
 "\n",
 StyleBox["Coefficient[e, x, m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the coefficient of x^m in the polynomial e; ",
 StyleBox["Exponent[e, x]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " its degree in x.",
 "\n\n",
 StyleBox["Coefficient[e, ww, m] / I^m",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the coefficient of (i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")^m. For each entry and each power, the module either keeps a number (",
 StyleBox["NumericQ[c]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is True for exact or approximate numbers, like the 1 in front of i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ") or creates the atom ",
 StyleBox["GammaAtom[a, b, m]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and stores its value as a function of q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " (",
 StyleBox["Function and Evaluate",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 04)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") in the local association ",
 StyleBox["atomVals",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"da715710-ee83-4c1b-87a8-827332f99ff5"],

Cell["\<\
{Coefficient[3 + 2 x + 5 x^2, x, 2], Exponent[3 + 2 x + 5 x^2, x], \
NumericQ[3/4], NumericQ[nuk]}\
\>", "Input",

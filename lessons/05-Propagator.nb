}], "Text",ExpressionUUID->"fb803250-9993-4bf0-8c7e-a19aed458a96"],

Cell["\<\
{FullMatrix[propagator, w, s], PropagatorMatrix[propagator, w, s]}\
\>", "Input",ExpressionUUID->"77cf2b4a-d08c-459d-a7d3-1628cf708483"],

Cell[TextData[{
 StyleBox["GammaAtom[h, hbar, 0][s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stands for the coefficient of (i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\:2070",
  FontFamily->"Noto Sans"],
 " in (",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2 + R)_{h ",
 StyleBox["h\:0304",
  FontFamily->"Noto Sans"],
 "} at q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " = s, that is ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " s (1 + r_n(s/k",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")). ",
 StyleBox["\[CapitalDelta][w, s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " stands for ",

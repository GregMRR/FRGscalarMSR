}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"5a9b2a9f-f049-47b3-8ec7-ec4c5fbfeb43"],

Cell["3. The block structure and \[CapitalDelta]", "Section",ExpressionUUID->"cafcbc61-5eaf-4f1f-b6b4-3d98fe7e28a0"],

Cell["\<\
(* Kernel/Propagator.wl:56-69 *)
   (* block structure in the order (phi_1..phi_N | phibar_1..phibar_N) *)
   iphi = pos /@ phis; ibar = pos /@ bars;
   AppendTo[checks, assertCheck[\"Propagator.causalBlock\", \
Flatten[abs[[iphi, iphi]]] === ConstantArray[0, n^2], abs[[iphi, iphi]],
     \"the (phi, phi) block of Gamma2 + R must vanish (causality)\", \"(phi, \
phi) block = 0\"]];
   B[w_] := abs[[iphi, ibar]] /. ww -> w;              (* rows phi at w, \
columns phibar *)
   C = abs[[ibar, ibar]];                              (* noise block *)
   detB = Expand[Det[B[ww]]];
   deg = Exponent[detB, ww];
   AppendTo[checks, assertCheck[\"Propagator.deltaDegree\", 1 <= deg <= 2, deg,
     If[deg == 0, \"Delta(w) does not depend on w: the frequency integrals \
diverge (is a dt term missing?)\",
      \"deg_w Delta = \" <> ToString[deg] <> \" > 2: not supported in v1 \
(future extension, docs/STATUS.md)\"],
     \"deg_w Delta = \" <> ToString[deg]]];
   cs = Table[Expand[Coefficient[detB, ww, m] / I^m], {m, 0, 2}];
   FRGAssert[\"Propagator.deltaCoefficients\", Expand[Sum[cs[[m + 1]] (I \
ww)^m, {m, 0, 2}] - detB] === 0 && FreeQ[cs, ww], cs, \"internal\"];\
\>", "Program",ExpressionUUID->"c556697d-2507-4f2e-abc9-6a1c47a3ca3c"],

Cell[TextData[{
 StyleBox["Mathematica: Part with lists",
  FontWeight->Bold],
 "\n",
 StyleBox["m[[{1, 3}, {2}]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " extracts the rows 1, 3 and the column 2 of a matrix; the same form on the \
left of ",
 StyleBox["=",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " assigns a block.",
 "\n\n",
 StyleBox["abs[[iphi, ibar]]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the (",
 StyleBox["\[CurlyPhi]",
  FontFamily->"Noto Sans"],
 ", ",
 StyleBox["\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 ") block B: the rows at the positions of the physical fields, the columns at \
those of the response fields. ",
 StyleBox["Det",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the determinant. ",
 StyleBox["B[w_] := ... /. ww -> w",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a local function giving B at any frequency."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"6146a956-c42c-4ca1-afe9-d14c1b3853a2"],

Cell["\<\
mm = ConstantArray[0, {3, 3}]; mm[[{1, 3}, {1, 3}]] = {{1, 2}, {3, 4}}; {mm, \
mm[[{1, 3}, {3}]]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"0e8d8434-24ac-4841-a6b6-bdbf14607308"],

Cell[TextData[{
 StyleBox["Propagator.deltaDegree",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " requires 1 ",
 StyleBox["\[LessEqual]",
  FontFamily->"Noto Sans"],
 " deg_",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[LessEqual]",
  FontFamily->"Noto Sans"],
 " 2: degree 0 means there is no ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "t term and the frequency integrals diverge; degree 3 or more is beyond v1 (",
 StyleBox["docs/STATUS.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). With two scalars, deg ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " = 2 is the common case; KPZ has degree 1."
}], "Text",ExpressionUUID->"cdae90d7-dbf1-4b2a-a117-b09faa55102e"],

Cell["4. The inverse in closed form", "Section",ExpressionUUID->"9d4e7bc5-9848-424a-955a-ed726debb481"],

Cell["\<\
(* Kernel/Propagator.wl:71-84 *)
   (* G = M^-1 with M = [[0, B(w)], [B(-w)^T, C]] in the (phi | phibar) \
order:
      G_{phibar phi} = B(w)^-1, G_{phi phibar} = (B(-w)^T)^-1, G_{phi phi} = \
-(B(-w)^T)^-1 C B(w)^-1, G_{phibar phibar} = 0 *)
   Module[{binv, dinv, gpp},
    binv = adjugate[B[ww]]/\\[CapitalDelta][ww, ss];
    dinv = adjugate[Transpose[B[-ww]]]/\\[CapitalDelta][-ww, ss];
    gpp = -dinv . C . binv;
    G = ConstantArray[0, {nf, nf}];
    G[[iphi, iphi]] = Map[Together, gpp, {2}]; G[[iphi, ibar]] = dinv; \
G[[ibar, iphi]] = binv];
   ex = {\\[CapitalDelta][w_, ss] :> (detB /. ww -> w)};
   AppendTo[checks, assertCheck[\"Propagator.inverse\",
     ExactlyZeroQ[(G /. ex) . abs - IdentityMatrix[nf]],
     G, \"internal: G (Gamma2 + R) != 1\", \"G.(Gamma2 + R) = 1 exactly \
(random rationals for every atom, w, q^2)\"]];
   AppendTo[checks, assertCheck[\"Propagator.inverseRight\", ExactlyZeroQ[abs \
. (G /. ex) - IdentityMatrix[nf]], G, \"internal\", \"(Gamma2 + R).G = 1\"]];
   AppendTo[checks, assertCheck[\"Propagator.responseBlock\", \
Flatten[G[[ibar, ibar]]] === ConstantArray[0, n^2], G, \"internal\", \
\"G_{phibar phibar} = 0\"]];\
\>", "Program",ExpressionUUID->"6bf6159b-f7b7-4b74-aebc-5a90ede33451"],

Cell["\<\
(* Kernel/Propagator.wl:26 *)
adjugate[m_] := If[Length[m] == 1, {{1}}, Transpose[Table[(-1)^(i + j) \
Det[Drop[m, {i}, {j}]], {i, Length[m]}, {j, Length[m]}]]];\
\>", "Program",ExpressionUUID->"3834ed51-9cc7-474b-9679-c0f169dd11c9"],

Cell[TextData[{
 "The inverse of B is its adjugate divided by its determinant. The adjugate \
is computed from cofactors: ",
 StyleBox["Drop[m, {i}, {j}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " removes row i and column j, ",
 StyleBox["Det",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of what remains is the minor. Instead of the determinant itself, the \
formula uses the inert symbol ",
 StyleBox["\[CapitalDelta][w, s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (and ",
 StyleBox["\[CapitalDelta][-w, s]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for the advanced block), so G is written in atoms and ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " only."
}], "Text",ExpressionUUID->"58d44e33-094c-403f-9568-b5fea146887c"],

Cell[TextData[{
 StyleBox["Mathematica: Matrix algebra",
  FontWeight->Bold],
 "\n",
 StyleBox[".",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " multiplies matrices (and vectors); ",
 StyleBox["Transpose",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Det",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["IdentityMatrix[n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " work on nested lists.",
 "\n\n",
 "Matrices are lists of rows, nothing more: ",
 StyleBox["{{a, b}, {c, d}} . {{e, f}, {g, h}}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the matrix product. ",
 StyleBox["-dinv . C . binv",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is the correlation block ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "(B(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\:1d40",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\:207b\.b9",
  FontFamily->"Noto Sans"],
 " C B(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\:207b\.b9",
  FontFamily->"Noto Sans"],
 ", and ",
 StyleBox["Map[Together, gpp, {2}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["Map at a level",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 04)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ", ",
 StyleBox["Exact numbers",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ") puts each entry over a common denominator."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"38579928-921d-4ac5-a659-d988bba25628"],

Cell["\<\
{{{a, b}, {c, d}} . {{1, 0}, {0, 2}}, Det[{{a, b}, {c, d}}], Drop[{{a, b}, \
{c, d}}, {1}, {2}]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"a893bc2c-db07-4509-8d44-81bce73ca150"],

Cell[TextData[{
 StyleBox["Propagator.inverse",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["Propagator.inverseRight",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " multiply G by ",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "2 + R in both orders, with ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " replaced by its value, and require the identity matrix exactly (",
 StyleBox["Exact numbers",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " through ",
 StyleBox["ExactlyZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "): every atom, ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 " and q",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " gets a random rational."
}], "Text",ExpressionUUID->"b9d88176-b81e-4b12-8e8e-869ddbc3e294"],

Cell[TextData[{
 StyleBox["Why it's built this way: Use the structure, then check the result",
  
  FontWeight->Bold],
 "\n\n",
 "A generic symbolic ",
 StyleBox["Inverse",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of a 4",
 StyleBox["\[Times]",
  FontFamily->"Noto Sans"],
 "4 matrix of polynomials works, but produces a large expression with the \
determinant expanded everywhere and no visible structure. Using the MSR block \
form gives a short closed formula in which each block has a physical meaning \
and ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " appears explicitly, as needed by the frequency integration (lesson 09). \
Because the formula is written by hand, it is then checked against the \
definition of an inverse, in both orders, which costs a few rational \
evaluations."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"76b3215e-dd6e-4abf-9158-00eb7e46e3d2"],

Cell["5. Validity of the poles: an assumption, not a check", "Section",ExpressionUUID->"86a0cc79-1688-4a89-8714-924d22f79e17"],

Cell["\<\
(* Kernel/Propagator.wl:86-92 *)
   (* validity: roots of Delta in w in the upper half plane <=> roots u = I w \
of c0 + c1 u + c2 u^2 have negative real part *)
   {valid, explanation} = If[deg == 2,
     {{DeltaCoefficient[1][ss]/DeltaCoefficient[2][ss] > 0, \
DeltaCoefficient[0][ss]/DeltaCoefficient[2][ss] > 0},
      \"both roots of Delta(w) lie in the upper half w-plane (causal poles) \
iff c1/c2 > 0 and c0/c2 > 0: writing u = I w, a quadratic \\
c2 u^2 + c1 u + c0 has both roots with Re u < 0 exactly when its three \
coefficients have the same sign\"},
     {{DeltaCoefficient[0][ss]/DeltaCoefficient[1][ss] > 0}, \"the root of \
Delta(w) = c0 + c1 (I w) is w = I c0/c1: upper half plane iff c0/c1 > 0\"}];
   AppendTo[warns, infoCheck[\"ASSUMPTION\", \"Propagator.validity\", \
displayString[valid /. ss -> Symbol[\"FRGscalarMSR`Propagator`Private`s\"]] \
<> \" at every loop momentum q (not checked by the library: exported as \
causal_poles by ExportJulia)\"]];\
\>", "Program",ExpressionUUID->"7b0db565-cd15-442e-851a-28a77ae8613a"],

Cell[TextData[{
 "With u = i",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", a root of ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " in the upper half ",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 "-plane is a root u with negative real part. For degree 1, ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " = c0 + c1 u has its root at u = ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "c0/c1, so the condition is c0/c1 > 0; for degree 2 it is c1/c2 > 0 and \
c0/c2 > 0. The conditions are expressions like ",
 StyleBox["DeltaCoefficient[0][s]/DeltaCoefficient[1][s] > 0",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which stay unevaluated as long as their atoms have no values: they are \
data (",
 StyleBox["If and TrueQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 " explained why such an inequality cannot be decided)."
}], "Text",ExpressionUUID->"d412d6d7-5999-4fad-acff-bcef0b5a38da"],

Cell["ValidityConditions[propagator][s]", "Input",ExpressionUUID->"f2ec1c62-daf6-400f-b52a-9296c6179cd3"],

Cell[TextData[{
 StyleBox["Why it's built this way: Why an ASSUMPTION line instead of a check",
  FontWeight->Bold],
 "\n\n",
 "Whether the poles are causal depends on the values of the couplings at \
every q, which are only known while the flow is integrated numerically. The \
library cannot decide it, so it does not pretend to: the card shows an \
ASSUMPTION, Adimensional (lesson 14) rewrites the conditions in dimensionless \
form, and ExportJulia (lesson 15) writes them as ",
 StyleBox["causal_poles",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for FlowRG to check during integration (",
 StyleBox["design/CAUSALITY.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). An honest card distinguishes what was verified (PASS) from what was \
assumed."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"0f50cae9-c257-4b5c-93a1-d8485c58b718"],

Cell["6. The stage and its accessors", "Section",ExpressionUUID->"3a461c60-6340-49d4-af9a-01a2aa96de7e"],

Cell[BoxData[
 $CellContext`regionCells[
 "Kernel/Propagator.wl", "stage = stampStage[<", 
  "\"Stage\" -> \"Propagator\"", 
  "\"Checks\" -> checks, \"Warnings\" -> warns"]], "Input",ExpressionUUID->\
"15b92f71-1118-42f0-b446-16ad4b637723"],

Cell["\<\
(* Kernel/Propagator.wl:106-110 *)
PropagatorMatrix[p_Association, w_, s_] := p[\"G\"][w, s];
FullMatrix[p_Association, w_, s_] := p[\"M\"][w, s];
AtomRules[p_Association] := Normal[p[\"AtomValues\"]];
DeltaRules[p_Association] := {\\[CapitalDelta][w_, s_] :> p[\"Delta\"][w, s], \
DeltaCoefficient[m_][s_] :> p[\"DeltaCoefficients\"][s][[m + 1]]};
ValidityConditions[p_Association] := p[\"ValidityConditions\"];\
\>", "Program",ExpressionUUID->"46b2e8d6-79a9-4416-8b10-cc5f1a50f84f"],

Cell[TextData[{
 StyleBox["DeltaRules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns rules with patterns on the left, ",
 StyleBox["\[CapitalDelta][w_, s_] :> ...",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": one rule replaces ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Noto Sans"],
 " at every frequency and momentum where it occurs (",
 StyleBox["Rules and replacement",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 00)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 "). ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is a symbol whose name is a Greek letter (written ",
 StyleBox["\\[CapitalDelta]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " in the source file); Mathematica allows such names like any other."
}], "Text",ExpressionUUID->"5391e103-bbd5-4322-9f8f-ccd3580b986e"],

Cell["Exercises", "Section",ExpressionUUID->"a2f3cd36-693e-479f-a0ae-730e281ec1c2"],

Cell["Exercise: The correlation function", "Subsection",ExpressionUUID->"4851a0cd-755f-47d5-9493-ace15c6f8d40"],

Cell[TextData[{
 "From the result of section 1, write G_{hh}(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ", q) and check that it is 2D(1 + r_d) / (",
 StyleBox["\[Omega]\.b2",
  FontFamily->"Noto Sans"],
 " + ",
 StyleBox["\[Nu]\.b2",
  FontFamily->"Noto Sans"],
 " q",
 StyleBox["\:2074",
  FontFamily->"Noto Sans"],
 " (1 + r_n)",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")."
}], "Text",ExpressionUUID->"2097df75-3ebc-4735-8305-d9e39e605e51"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"a2802503-a311-4d31-a991-c50326f636e5"],

Cell["\<\
gExplicit = PropagatorMatrix[propagator, w, s] /. DeltaRules[propagator] /. \
AtomRules[propagator];
ExactlyZeroQ[gExplicit[[1, 1]] - 2 Dk (1 + rd[s/k^2])/(w^2 + nuk^2 s^2 (1 + \
rn[s/k^2])^2)]\
\>", "Input",ExpressionUUID->"12d63edf-3370-4a3c-b9c0-8d638d76d3d9"]
}, Closed]],

Cell["Exercise: Why G_{h\:0304h\:0304} = 0", "Subsection",ExpressionUUID->"95a48417-8112-41a9-96a5-bde2016b4206"],

Cell[TextData[{
 "Using the block form, explain why G_{",
 StyleBox["\[CurlyPhi]\:0304\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 "} always vanishes, and check it on ",
 StyleBox["propagator",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"690e2cbc-85cf-446d-9925-1d283af00743"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"d10dee3b-bf46-416c-b866-e0e01ee712d6"],

Cell[TextData[{
 "The inverse of [[0, B(",
 StyleBox["\[Omega]",
  FontFamily->"Noto Sans"],
 ")], [B(",
 StyleBox["\[Minus]\[Omega]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\:1d40",
  FontFamily->"Noto Sans"],
 ", C]] has a zero block where the original has C: multiplying out shows that \
the (",
 StyleBox["\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 ", ",
 StyleBox["\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 ") block of the inverse must be 0 for the product to be the identity. This \
is the statement that ",
 StyleBox["\:27e8\[CurlyPhi]\:0304",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[CurlyPhi]\:0304\:27e9",
  FontFamily->"Noto Sans"],
 " = 0 in MSR."
}], "Text",ExpressionUUID->"fc1c1409-1832-479c-9dcf-1b196694ee8f"],

Cell["PropagatorMatrix[propagator, w, s][[2, 2]]", "Input",ExpressionUUID->"a9fd75a0-bc2e-49f9-8b58-9017144c2f2d"]
}, Closed]],

Cell["Exercise: Mixing two ans\[ADoubleDot]tze", "Subsection",ExpressionUUID->"38a9feda-d664-40fe-8426-4d89c51db659"],

Cell[TextData[{
 "Build a second KPZ ansatz without the ",
 StyleBox["\[Lambda]",
  FontFamily->"Noto Sans"],
 " term, a regulator on it, and pass that regulator with the original ",
 StyleBox["vertices",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " to ",
 StyleBox["BuildPropagator",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Which check fails?"
}], "Text",ExpressionUUID->"c3c87e9e-8b3e-4aec-b9b6-e8318923e621"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"29f5707f-a5cb-4fc7-b4cb-f5fca6ed3172"],

Cell["\<\
ansatz2 = Block[{Print}, DefineAnsatz[kpzTheory, \"Density\" -> hbar (dt[h] - \
nuk lap[h]) - Dk hbar^2, \"Couplings\" -> {nuk, Dk}]];
regulator2 = Block[{Print}, DefineRegulator[ansatz2, {hbar, h} -> nuk q^2 \
rn[q^2/k^2], \"Shapes\" -> {rn}]];
showFailure[BuildPropagator[vertices, regulator2]]\
\>", "Input",ExpressionUUID->"77f35adf-5d0c-490e-a042-8345fe55260c"],

Cell[TextData[{
 StyleBox["Propagator.sameAnsatz",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": the two stages point to different Ansatz fingerprints, even though the \
propagators would happen to agree. A stage only accepts inputs with a common \
history."
}], "Text",ExpressionUUID->"04d6fb74-37ba-4e15-b2d3-f2bee17d308f"]
}, Closed]]
},

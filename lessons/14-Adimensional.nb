Cell["5. References: running or fixed", "Section",ExpressionUUID->"f57c66b0-7ac0-46b8-bd4a-551ac2bf9ad8"],

Cell["\<\
(* Kernel/Adimensional.wl:141-159 *)
   (* references: running (eta from the equation of ref or ref x amplitude) \
or fixed (eta given at run time) *)
   cand[r_] := Select[Range[Length[eqs]], With[{q = Together[combs[[#]]/r]},
        PolynomialQ[q, cps] && FreeQ[q /. Thread[dims[\"Dimensionless\"] -> \
1], Alternatives @@ cps] && Exponent[combs[[#]], r] == 1] &];
   kind = <||>; defEq = <||>;
   Do[Module[{c = cand[r], alone, mode = dims[\"ReferenceModes\"][r], eqSpec \
= dims[\"ReferenceEquations\"][r]},
      alone = Select[c, Expand[combs[[#]] - r] === 0 &];
      Which[
       alone =!= {},
       FRGAssert[\"Adimensional.referenceMode\", mode =!= \"Fixed\", r, \
\"this reference appears alone in an equation, so its eta is determined \
(Running); drop \\\"Mode\\\" -> \\\"Fixed\\\"\"];
       kind[r] = \"Running\"; defEq[r] = First[alone],
       c === {},
       FRGAssert[\"Adimensional.referenceEquation\", False, r, \"no equation \
has this reference alone or times dimensionless amplitudes: it cannot set an \
eta\"],
       mode === \"Running\",
       If[eqSpec =!= Automatic, c = Select[c, Expand[combs[[#]] - eqSpec] === \
0 &]];
       FRGAssert[\"Adimensional.referenceEquation\", Length[c] == 1, {r, \
combs[[cand[r]]]},
        \"several (or no) equations can define this eta: choose one with \
\\\"Equation\\\" -> comb in DeriveDimensions \\\"References\\\"\"];
       kind[r] = \"Running\"; defEq[r] = First[c],
       True, kind[r] = \"Fixed\"]], {r, refs}];
   running = Select[refs, kind[#] === \"Running\" &]; fixed = Select[refs, \
kind[#] === \"Fixed\" &];\
\>", "Program",ExpressionUUID->"d8472aca-002f-4900-8cde-fc5e6d408f9b"],

Cell[TextData[{
 "A reference that appears alone in an equation (KPZ: ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " and D) is ",
 StyleBox["running",
  FontWeight->Bold],
 ": its ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 " is read from that equation. A reference that appears only multiplied by \
dimensionless amplitudes (the shallow-water ",
 StyleBox["Dphik aDphik",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ") is ",
 StyleBox["fixed",
  FontWeight->Bold],
 ": its ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 " is a parameter given at run time, and its row in the ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 " system is a placeholder ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 " = 0, listed as ",
 StyleBox["MustFix",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for FlowRG's ",
 StyleBox["fixed_etas",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (",
 StyleBox["design/ADIMENSIONAL.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",ExpressionUUID->"f9e0e18f-b565-4ea9-a8ce-91a189631c4a"],

Cell[TextData[{
 StyleBox["Why it's built this way: Which part of the flow is integrated",
  FontWeight->Bold],
 "\n\n",
 "BetaL contains no momentum integral and BetaNL contains nothing but the \
integrand. Keeping them apart lets FlowRG evaluate the local part exactly and \
spend its quadrature only on the loop, and keeps the ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 " system in the form (M_L + ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 "M_NL) ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 " = b_L + ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 "b_NL that is solved after the integrals are done. The library could \
integrate nothing here: the shapes are still abstract (lesson 04), and the \
integrals depend on the state at which FlowRG evaluates them."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"95ed3979-e3f7-4d86-be23-c4a9766d8878"],

Cell["6. Causal poles in minimal form", "Section",ExpressionUUID->"dc9cc2ed-438d-4bfd-bda3-04b146966db4"],

Cell["\<\
(* Kernel/Adimensional.wl:73-86 *)
(* numeric coefficient of one term of an expanded polynomial *)
causalPolesCoefficient[t_] := Which[NumberQ[t], t, Head[t] === Times, Times \
@@ Select[List @@ t, NumberQ], True, 1];
(* exponent of aq in one term, outside function arguments: rn[aq^2] does not \
count *)
causalPolesAqExponent[t_, aq_] := Exponent[t /. (h_Symbol /; Context[h] =!= \
\"System`\")[___] :> 1, aq];
(* {content, minimal}: rest = content minimal, content = positive numeric \
content x aq^(smallest exponent) *)
causalPolesStrip[rest_, aq_] := Module[{e = Expand[rest], terms, num, m},
   If[e === 0, Return[{1, 0}]];
   terms = If[Head[e] === Plus, List @@ e, {e}];
   num = Abs[GCD @@ (causalPolesCoefficient /@ terms)];
   m = Min[causalPolesAqExponent[#, aq] & /@ terms];
   {num aq^m, Expand[e/(num aq^m)]}];
(* a product of a positive number and powers of the given symbols *)
causalPolesPositiveQ[s_, syms_] := AllTrue[If[Head[s] === Times, List @@ s, \
{s}],
   (NumberQ[#] && # > 0) || MatchQ[#, Alternatives @@ syms] || MatchQ[#, \
Power[Alternatives @@ syms, _]] &];\
\>", "Program",ExpressionUUID->"b3c78424-09db-45b7-916f-a83081946fe3"],

Cell[TextData[{
 "Each condition e > 0 is brought to p > 0 with p a polynomial (",
 StyleBox["NumeratorDenominator",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", then numerator ",
 StyleBox["\[Times]",
  FontFamily->"Noto Sans"],
 " denominator, or the numerator times the sign of a numeric denominator), \
the units are taken out (references, k and aq are positive: an ASSUMPTION \
line), and the positive numeric content and lowest power of aq are stripped (",
 StyleBox["GCD",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Abs",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["Sign",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). ",
 StyleBox["Adimensional.causalPolesMinimal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " checks exactly that original = stripped factor ",
 StyleBox["\[Times]",
  FontFamily->"Noto Sans"],
 " minimal (",
 StyleBox["design/CAUSALITY.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ")."
}], "Text",ExpressionUUID->"cf5306c5-4a42-4b6f-aaa3-8b79ab16250f"],

Cell["{NumeratorDenominator[(a + b)/c], GCD[6, 9, 12], Sign[-3]}", "Input",ExpressionUUID->"7b535da1-3d2a-4b5a-8855-19940a915dbd"],


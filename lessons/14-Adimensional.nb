 " (lesson 13) would be caught."
}], "Text",ExpressionUUID->"55b7345e-a06a-4cf1-bc0e-096930132099"],

Cell["\<\
(* Kernel/Adimensional.wl:162-187 *)
   (* Leibniz: d_s(comb) = sum_c (d comb/d c) d_s c, d_s ref = -eta ref, d_s \
c = 0 for NonRenormalised c; one loop symbol per equation *)
   loopSym = Array[loopOf, Length[eqs]];
   lhs = Function[comb, Expand[Total[(D[comb, #] dsC[#]) & /@ \
Variables[comb]] /. Join[(dsC[#] -> -etas[#] #) & /@ refs, (dsC[#] -> 0) & /@ \
nonren]]] /@ combs;
   unknowns = Union[Cases[lhs, _dsC, {0, Infinity}]];
   uEqs = Select[Range[Length[eqs]], ! FreeQ[lhs[[#]], dsC] &];
   bad = Complement[Range[Length[eqs]], uEqs, Values[defEq]];
   FRGAssert[\"Adimensional.unusedEquation\", bad === {}, combs[[bad]], \
\"these equations determine no coupling and no eta (check the references and \
NonRenormalised tags)\"];
   FRGAssert[\"Adimensional.leibnizSquare\", Length[uEqs] == \
Length[unknowns], {combs[[uEqs]], unknowns},
    \"the equations do not determine each flowing coupling exactly once \
(Leibniz system not square)\"];
   sol = If[unknowns === {}, <||>,
     mat = Table[Coefficient[lhs[[e]], u], {e, uEqs}, {u, unknowns}];
     FRGAssert[\"Adimensional.leibnizSolvable\", ! ExactlyZeroQ[Det[mat]], \
{combs[[uEqs]], unknowns}, \"the Leibniz system is singular\"];
     rhsVec = loopSym[[uEqs]] - (lhs[[uEqs]] /. _dsC -> 0);
     AssociationThread[(First /@ unknowns) -> Expand[LinearSolve[mat, \
rhsVec]]]];
   AppendTo[checks, assertCheck[\"Adimensional.leibniz\", True, Null, \"\", \
ToString[Length[unknowns]] <> \" flowing couplings solved from \" <>
       ToString[Length[uEqs]] <> \" equations: \" <> StringRiffle[ToString /@ \
Keys[sol], \", \"]]];

   (* state *)
   state = Replace[OptionValue[\"State\"], Automatic -> Select[cps, ! \
MemberQ[refs, #] &]];
   FRGAssert[\"Adimensional.state\", ListQ[state] && DuplicateFreeQ[state] && \
SubsetQ[Complement[cps, refs], state], state,
    \"\\\"State\\\" -> {couplings of the ansatz that are not references}\"];
   bad = Select[state, ! KeyExistsQ[sol, #] && ! MemberQ[nonren, #] &];
   FRGAssert[\"Adimensional.noBeta\", bad === {}, bad, \"these state \
couplings get no flow: no equation determines them and they are not \
NonRenormalised\"];
   bad = Complement[Keys[sol], state];
   FRGAssert[\"Adimensional.stateMissing\", bad === {}, bad, \"these \
couplings have a flow equation but are missing from \\\"State\\\"\"];
   dsOf[c_] := Lookup[sol, c, 0];\
\>", "Program",ExpressionUUID->"6736cc38-67ae-4a86-a56f-a1d57f0103bc"],


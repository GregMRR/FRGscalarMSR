Cell["{Variables[nuk Dk + lamk^2], Array[loopOf, 3]}", "Input",ExpressionUUID->"fa8f49d2-766c-44d2-adb0-2d3166a859cd"],

Cell["3. Proving homogeneity", "Section",ExpressionUUID->"cbd58425-a981-48b8-99f4-937ebdf8eca3"],

Cell["\<\
(* Kernel/Adimensional.wl:28-45 *)
(* ---------- homogeneity in the units (generalises HomVec/HomClean of \
AdimensionalFlowEQGenericRegLargeScale.nb) ----------
   hom[e] = {v, rest}: e = (product of units with exponent vector v) x rest, \
rest free of units. Every term of a sum must carry the
   same v; units may not appear in exponents or in function arguments. \
Exponents may depend on the symbolic dimension. *)
homVec[e_, unitIndex_Association, nb_] := Module[{zero = ConstantArray[0, \
nb], hv},
   hv[s_Symbol] := If[KeyExistsQ[unitIndex, s], {UnitVector[nb, \
unitIndex[s]], 1}, {zero, s}];
   hv[x_?NumericQ] := {zero, x};
   hv[x_Plus] := Module[{h = hv /@ List @@ x, v},
     v = h[[1, 1]];
     If[! AllTrue[h[[All, 1]], AllTrue[Expand[# - v], # === 0 &] &], \
Throw[{\"a sum mixes dimensions\", DeleteDuplicates[h[[All, 1]]], x}, homTag]];
     {v, Plus @@ h[[All, 2]]}];
   hv[x_Times] := Module[{h = hv /@ List @@ x}, {Expand[Total[h[[All, 1]]]], \
Times @@ h[[All, 2]]}];
   hv[Power[b_, n_]] := Module[{hb = hv[b], hn = hv[n]},
     If[hn[[1]] =!= zero, Throw[{\"a unit in an exponent\", Power[b, n]}, \
homTag]];
     {Expand[n hb[[1]]], hb[[2]]^n}];
   hv[f_[args___]] := Module[{h = hv /@ {args}},
     If[! AllTrue[h[[All, 1]], # === zero &], Throw[{\"a unit inside a \
function argument\", f[args]}, homTag]];
     {zero, f @@ h[[All, 2]]}];
   hv[e]];\
\>", "Program",ExpressionUUID->"7cfc0651-83c3-4c54-8436-c728591789ce"],

Cell["\<\
(* Kernel/Adimensional.wl:47-55 *)
(* dimension vector of e (units substituted); aborts with the reason if e is \
not homogeneous *)
dimensionVector[check_, e_, unitIndex_, nb_, what_] := Module[{r = \
Catch[homVec[e, unitIndex, nb], homTag]},
   FRGAssert[check, MatchQ[r, {_List, _}] && Length[r[[1]]] == nb, {what, r}, \
\"not homogeneous in the units k, references: \" <> ToString[First[r]]];
   r];
(* rest of e after asserting that its dimension is exactly v *)
homClean[check_, e_, v_, unitIndex_, nb_, what_] := Module[{r = \
dimensionVector[check, e, unitIndex, nb, what]},
   FRGAssert[check, AllTrue[Expand[r[[1]] - v], # === 0 &], {what, \"residual \
dimension\" -> Expand[r[[1]] - v]},
    \"the expression still depends on the units k, references (dimension \
mismatch)\"];
   r[[2]]];\
\>", "Program",ExpressionUUID->"c4f2d6de-6f93-4558-8ca2-e273e4b0a5e3"],

Cell[TextData[{
 StyleBox["homVec",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " walks an expression (",
 StyleBox["Several definitions of one function",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ", one rule per head) and returns ",
 StyleBox["{exponent vector, rest}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": the units it contains and what is left. Every term of a sum must carry \
the same vector; a unit may not appear in an exponent or inside a function \
argument (a shape argument must reduce to aq",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")."
}], "Text",ExpressionUUID->"9e3cf85a-fbad-4a1e-bab0-ab61e51633a3"],

Cell[TextData[{
 StyleBox["Mathematica: Catch and Throw",
  FontWeight->Bold],
 "\n",
 StyleBox["Throw[value, tag]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " jumps out of any depth of evaluation to the enclosing ",
 StyleBox["Catch[expr, tag]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which returns value.",
 "\n\n",
 "A recursive walk that finds a problem deep inside a sum has to stop and \
report it. ",
 StyleBox["Throw",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " does that without every level of the recursion checking a return value. ",
 StyleBox["dimensionVector",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " catches the reason with the tag ",
 StyleBox["homTag",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and turns it into a named check: the library's convention (lesson 00, \
section 3) is kept at the boundary, while the inner walk uses the cheaper \
mechanism."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"62a9f946-d949-4b1f-8ca6-95b41570417e"],

Cell["\<\
ui = <|k -> 1, nuk -> 2, Dk -> 3|>;
{Catch[Throw[\"jumped out\", myTag]; \"never reached\", myTag],
 FRGscalarMSR`Private`homVec[k^2 nuk x, ui, 3],
 Catch[FRGscalarMSR`Private`homVec[k + nuk, ui, 3], \
FRGscalarMSR`Private`homTag]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"419b6b81-b9d3-4b9b-be4a-13039f013fd0"],

Cell["\<\
(* Kernel/Adimensional.wl:57-69 *)
(* independent route (review E8): e must be unchanged when every unit is \
multiplied by a random factor. Units are random perfect
   powers so that every fractional power stays rational; d is set to each \
test dimension. *)
unitInvariantQ[e_, units_, dimSym_, ds_, seed_] := AllTrue[ds, Function[d, \
Module[{ed = e /. dimSym -> d, den, pt, lam, memo, atom, val, syms},
     den = LCM @@ Denominator[Cases[ed, Power[_, x_?NumericQ] :> x, {0, \
Infinity}] /. {} -> {1}];
     SeedRandom[seed + d];
     syms = Complement[Union[Cases[ed, s_Symbol /; Context[s] =!= \
\"System`\", {0, Infinity}, Heads -> False]], units];
     pt = Thread[syms -> RandomInteger[{2, 40}, \
Length[syms]]/RandomInteger[{41, 97}, Length[syms]]];
     lam = Thread[units -> (RandomInteger[{2, 7}, \
Length[units]]/RandomInteger[{2, 7}, Length[units]])^den];
     memo[x_] := memo[x] = RandomInteger[{2, 60}]/RandomInteger[{61, 97}];
     (* not Core's whole-atom rule (design/MOMENTUMPROJECTION.md step 0): \
enough here, AdimAtom[..] takes no argument and shapes are symbols *)
     atom = x : (Derivative[__][_Symbol][___] | (h_Symbol /; Context[h] =!= \
\"System`\")[___]) :> memo[x];
     val[u_] := Together[(ed /. Thread[units -> (u units)] /. pt /. \
Thread[units -> (Last /@ lam)] /. atom)];
     Together[val[1] - val[Last /@ lam]] === 0]]];\
\>", "Program",ExpressionUUID->"65d27780-266d-4a50-ac4c-e3395baad1c5"],

Cell["\<\
The independent route (review E8): every loop piece, before the units are \
stripped, is evaluated with every unit multiplied by a random factor, in d = \
2 and 3, and must not change. Structural homogeneity and numerical invariance \
are two different arguments for the same fact.\
\>", "Text",ExpressionUUID->"c06d8fac-3198-4001-85d8-ba3a301f8079"],

Cell["4. The \[Beta] functions and the \[Eta] system", "Section",ExpressionUUID->"95b89811-6aa9-479d-9bd4-36d58e2e41dd"],

Cell["\<\
(* Kernel/Adimensional.wl:222-243 *)
   (* a loop piece  alpha x Integral d^dq/(2 Pi)^d I(q) / [c]  as the \
integrand of Integral daq LoopMeasure: alpha k^d I(k aq)/[c] *)
   explicitPiece[alpha_, e_, v_, what_] := Module[{x = (alpha kk^dimSym \
eqs[[e]][\"Integrand\"]) /. toUnits},
     FRGAssert[\"Adimensional.unitInvariance\", unitInvariantQ[x, basis, \
dimSym, testDims, e], what,
      \"the loop integrand changes when the units are rescaled: it is not \
dimensionless (independent route)\"];
     homClean[\"Adimensional.homogeneous\", x, v, unitIndex, nb, what]];
   compactPiece[alpha_, e_, v_, what_] := Module[{x = (alpha kk^dimSym \
(eqs[[e]][\"Compact\"] /. equations[\"DsRRules\"] /. compactAtoms)) /. \
toUnits},
     homClean[\"Adimensional.homogeneousCompact\", x, v, unitIndex, nb, what]];

   (* beta functions: d_s chat = chat (-x + Sum y eta) + (d_s c)/[c], local \
part not integrated, loop part per Integral daq *)
   betaL = <||>; betaNL = <||>; betaNLExplicit = <||>;
   Do[Module[{ds = dsOf[c], v = vecs[c], hat = names[c], local, alphas},
      alphas = Coefficient[ds, #] & /@ loopSym;
      local = Expand[ds /. Thread[loopSym -> 0]];
      betaL[c] = Expand[hat linearPart[v, Values[etas]] + \
homClean[\"Adimensional.homogeneousLocal\", (local/form[c]) /. toUnits, \
ConstantArray[0, nb], unitIndex, nb, c]];
      betaNL[c] = Total[MapThread[If[#1 === 0 || \
eqs[[#2]][\"IdenticallyZero\"], 0, compactPiece[#1/form[c], #2, \
ConstantArray[0, nb], c]] &, {alphas, Range[Length[eqs]]}]];
      betaNLExplicit[c] = Total[MapThread[If[#1 === 0 || \
eqs[[#2]][\"IdenticallyZero\"], 0, explicitPiece[#1/form[c], #2, \
ConstantArray[0, nb], c]] &, {alphas, Range[Length[eqs]]}]]],
    {c, state}];
   AppendTo[checks, assertCheck[\"Adimensional.homogeneous\", True, Null, \"\",
     \"every beta free of k and the references: homogeneity of every sum \
(structural) and invariance under random unit rescaling (numerical, d = \" <>
      StringRiffle[ToString /@ testDims, \", \"] <> \")\"]];
   AppendTo[checks, assertCheck[\"Adimensional.linearNoMomentum\", \
FreeQ[Values[betaL], aq | qU | kk], Select[betaL, ! FreeQ[#, aq | qU | kk] \
&],
     \"internal: a linear part depends on the loop momentum\", \"linear parts \
free of aq (not integrated)\"]];\
\>", "Program",ExpressionUUID->"a9dd33ba-2e54-4d8a-abb4-96b64c4234db"],

Cell[TextData[{
 StyleBox["linearPart",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 13) gives the canonical part, ",
 StyleBox["\:0109",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "x + ",
 StyleBox["\[CapitalSigma]",
  FontFamily->"Noto Sans"],
 " y_j ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 "_j). The loop pieces become integrands of ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 "daq with k^d from the measure."
}], "Text",ExpressionUUID->"d58c5d6e-3922-413e-bdbc-1754a5c450bf"],

Cell["\<\
(* Kernel/Adimensional.wl:26 *)
LoopMeasure[d_, aq_] := 2 Pi^(d/2)/Gamma[d/2] aq^(d - 1)/(2 Pi)^d;\
\>", "Program",ExpressionUUID->"e97f92ac-de1c-47c9-8a39-0e55f3fe5f7b"],

Cell["{LoopMeasure[3, aq], LoopMeasure[Dim, aq]}", "Input",ExpressionUUID->"497f50d2-afde-4310-b924-623f83d1f7d3"],

Cell["\<\
(* Kernel/Adimensional.wl:245-256 *)
   (* eta system: running ref r: eta_r = -(loop of its equation)/r (amplitude \
counted as 1); fixed ref: placeholder row eta = 0 *)
   etaRows = Table[If[kind[r] === \"Running\", compactPiece[-1/r, defEq[r], \
ConstantArray[0, nb], \"eta\" <> dims[\"EtaNames\"][r]], None], {r, refs}];
   etaRowsExplicit = Table[If[kind[r] === \"Running\", explicitPiece[-1/r, \
defEq[r], ConstantArray[0, nb], \"eta\" <> dims[\"EtaNames\"][r]], 0], {r, \
refs}];
   {bNL, mNL} = Module[{rows = Replace[etaRows, None -> 0, {1}], ca},
     ca = Normal[CoefficientArrays[rows, Values[etas]]];
     FRGAssert[\"Adimensional.etaLinear\", Length[ca] == 2, rows, \"the eta \
system is not linear in the etas\"];
     {ca[[1]], -ca[[2]]}];
   {bNLx, mNLx} = Module[{ca = Normal[CoefficientArrays[etaRowsExplicit, \
Values[etas]]]}, {ca[[1]], -ca[[2]]}];
   mL = IdentityMatrix[Length[refs]]; bL = ConstantArray[0, Length[refs]];
   mustFix = dims[\"EtaNames\"] /@ fixed;
   AppendTo[checks, assertCheck[\"Adimensional.etaSystem\", True, Null, \"\",
     \"eta system: \" <> ToString[Length[running]] <> \" running row(s)\" <> \
If[fixed === {}, \"\", \", placeholder row(s) eta = 0 for \" <>\
\>", "Program",ExpressionUUID->"9fc257b8-58fd-47cd-a023-07f80e5a429c"],

Cell[TextData[{
 StyleBox["Mathematica: CoefficientArrays",
  FontWeight->Bold],
 "\n",
 StyleBox["CoefficientArrays[{p1, p2, ...}, {x1, x2, ...}]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes linear (or polynomial) equations as ",

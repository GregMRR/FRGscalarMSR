Cell["Exercise: The \[Eta] system with the Litim shape", "Subsection",ExpressionUUID->"ded493e8-3f03-4ba1-8e8f-76d25d5f5def"],

Cell[TextData[{
 "Substitute the Litim shape r(y) = 1/y ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " 1 into the first row of EtaMNL (valid for aq < 1). Which atoms simplify?"
}], "Text",ExpressionUUID->"b6cefc90-e4ea-4ffc-ac7e-43cf48036bdd"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"cd7242f6-e48b-42d9-96d6-713831f942a0"],

Cell["\<\
litim = {rn -> Function[y, 1/y - 1], rd -> Function[y, 1/y - 1]};
Together[adim[\"EtaMNL\"][[1]] /. adim[\"Atoms\"] /. litim]\
\>", "Input",ExpressionUUID->"812bf3c4-b5b9-41eb-9d4f-c0e35e96384f"],

Cell[TextData[{
 StyleBox["AdimAtom[h, hbar, 0, 0]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " = 1 + r_n(aq",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ") becomes 1/aq",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ", and ",
 StyleBox["AdimAtom[h, hbar, 0, 1]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " = 1 + r_n + aq",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 " r_n",
 StyleBox["\[Prime]",
  FontFamily->"Noto Sans"],
 " becomes 0: the Litim shape makes the second atom vanish for aq < 1."
}], "Text",ExpressionUUID->"1d6e38b7-86bb-4d87-8d46-e0d02f1f4e4f"]
}, Closed]],

Cell["Exercise: The dimensionless measure", "Subsection",ExpressionUUID->"5b785e3e-2c36-44b5-a27f-391e65777f64"],

Cell[TextData[{
 "Check that ",
 StyleBox["LoopMeasure[d, aq]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " integrates to the volume of the unit ball over (2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 ")^d: ",
 StyleBox["\[Integral]\:2080\.b9",
  FontFamily->"Noto Sans"],
 " LoopMeasure daq = V_d/(2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 ")^d with V_d = ",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 "^{d/2}/",
 StyleBox["\[CapitalGamma]",
  FontFamily->"Noto Sans"],
 "(d/2 + 1), for d = 3."
}], "Text",ExpressionUUID->"de4e67cb-d759-4456-83ee-0fd06005950a"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"855f4efa-1186-4a92-bb07-27daf4df7d1b"],

Cell["\<\
{Integrate[LoopMeasure[3, aq], {aq, 0, 1}], Pi^(3/2)/Gamma[5/2]/(2 Pi)^3}\
\>", "Input",ExpressionUUID->"a1df6cdf-74f8-4b18-8a73-f86222cea707"],

Cell[TextData[{
 "Both are 1/(6",
 StyleBox["\[Pi]\.b2",
  FontFamily->"Noto Sans"],
 ")."
}], "Text",ExpressionUUID->"56409195-411f-400a-b88d-e31f42b0766c"]
}, Closed]]
},

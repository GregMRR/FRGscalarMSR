Cell["Lesson 14 - Adimensional", "Title",ExpressionUUID->"5301ad27-c5cb-41c3-900b-7f97b53b55d1"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Turn the dimensionful equations ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s(comb) = ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 "d",
 StyleBox["\:1d48",
  FontFamily->"Noto Sans"],
 "q/(2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\:1d48",
  FontFamily->"Noto Sans"],
 " I(q) into dimensionless ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 " functions. Each state coupling c becomes ",
 StyleBox["\:0109",
  FontFamily->"Noto Sans"],
 " = c/[c], with"
}], "Text",ExpressionUUID->"41f7ebcc-5616-451b-a49e-ceb056f9ca50"],

Cell[TextData[{
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s ",
 StyleBox["\:0109",
  FontFamily->"Noto Sans"],
 " = BetaL + ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 "daq LoopMeasure(d, aq) BetaNL,  LoopMeasure = S_d aq^{d",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1}/(2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 ")^d,"
}], "Text",ExpressionUUID->"6d310109-5cae-430d-8596-b9c162aa38e0"],

Cell[TextData[{
 "where BetaL is the local part (canonical scaling and Leibniz terms, not \
integrated) and BetaNL the loop integrand in the dimensionless momentum aq = \
q/k. The reference couplings do not get a ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 ": their running gives a linear system for the anomalous dimensions ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 ". The module proves that nothing depends on k or on the references any more."
}], "Text",ExpressionUUID->"2a94ef0b-54d8-406b-b715-da5ea0aaea44"],


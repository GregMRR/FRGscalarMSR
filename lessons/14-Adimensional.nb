Cell[TextData[{
 "Substitute the Litim shape r(y) = 1/y ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " 1 into the first row of EtaMNL (valid for aq < 1). Which atoms simplify?"
}], "Text",ExpressionUUID->"7c6841f4-7021-47f4-b9df-9ff935b3f8d2"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"2bb8f290-9db6-4781-89f5-0c5f72aeb679"],

Cell["\<\
litim = {rn -> Function[y, 1/y - 1], rd -> Function[y, 1/y - 1]};
Together[adim[\"EtaMNL\"][[1]] /. adim[\"Atoms\"] /. litim]\
\>", "Input",ExpressionUUID->"77798ade-bf8e-4699-ae93-0bfabfb8ab07"],


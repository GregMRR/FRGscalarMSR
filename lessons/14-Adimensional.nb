Cell["Exercise: The \[Eta] system with the Litim shape", "Subsection",ExpressionUUID->"ea56acb3-fb93-42fe-8639-666a98ecd639"],

Cell[TextData[{
 "Substitute the Litim shape r(y) = 1/y ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " 1 into the first row of EtaMNL (valid for aq < 1). Which atoms simplify?"
}], "Text",ExpressionUUID->"830ba44c-3a0d-45e1-967c-f3f0e8fa30fc"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"5ae1229d-fca9-4d9d-a267-fb98ea41f43c"],

Cell["\<\
litim = {rn -> Function[y, 1/y - 1], rd -> Function[y, 1/y - 1]};
Together[adim[\"EtaMNL\"][[1]] /. adim[\"Atoms\"] /. litim]\
\>", "Input",ExpressionUUID->"8a8e8d9f-cff6-4bf6-9d40-e2cf1ab1e5ff"],

Cell[TextData[{
 StyleBox["AdimAtom[h, hbar, 0, 0]",
  FontFamily->"Source Code Pro",

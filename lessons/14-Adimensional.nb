 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"5442a443-9d7e-45cf-9d0e-df20bdcc2a97"],

Cell["Normal[CoefficientArrays[{a e1 + b e2 + c, d e1}, {e1, e2}]]", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],

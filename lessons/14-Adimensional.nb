Cell["2. Units out, by Leibniz", "Section",ExpressionUUID->"9349cdba-e085-4f0e-b698-24528f9f580b"],

Cell["\<\
(* Kernel/Adimensional.wl:92-123 *)
AdimensionalEquations[equations_, dims_, opts : OptionsPattern[]] := \
Block[{$FRGModule = \"Adimensional\"},
  Module[{t0 = AbsoluteTime[], checks = {}, warns = {}, ansatz, theory, \
fields, cps, refs, etas, names, vecs, basis, nb, unitIndex, kk, qU, aq,
    dimSym, nonren, regC, reg, eqs, combs, toUnits, form, gamma2Dim, kind, \
defEq, running, fixed, state, dsC, lhs, unknowns, uEqs, mat, rhsVec,
    sol, loopSym, dsOf, betaL, betaNL, betaNLExplicit, atomVals, atomVecs, \
adimAtoms, compactPiece, explicitPiece, etaRows, mL, mNL, bL, bNL,
    mustFix, stage, testDims, cand, bad, compactAtoms, etaRowsExplicit, mNLx, \
bNLx, causalRaw, causalOrig, causalStripped, causalMin,
    causalExpl, causalKeep},
   validateStage[equations, \"Equations\"]; validateStage[dims, \
\"Dimensions\"];
   FRGAssert[\"Adimensional.options\", MatchQ[{opts}, {(Rule | \
RuleDelayed)[\"State\", _] ...}], {opts}, \"only the option \\\"State\\\" is \
accepted\"];
   ansatz = AnsatzOf[equations];
   AppendTo[checks, assertCheck[\"Adimensional.sameAnsatz\", \
ansatz[\"Fingerprint\"] === dims[\"Ansatz\"][\"Fingerprint\"],
     {ansatz[\"Fingerprint\"], dims[\"Ansatz\"][\"Fingerprint\"]}, \"the \
dimensions were derived from another ansatz: \
DeriveDimensions[AnsatzOf[equations], ...]\",
     \"dimensions and equations from the same ansatz\"]];
   theory = ansatz[\"Theory\"]; fields = theory[\"Fields\"]; cps = \
ansatz[\"Couplings\"];
   refs = dims[\"References\"]; etas = dims[\"Etas\"]; names = \
dims[\"Names\"]; vecs = dims[\"Vectors\"]; basis = dims[\"Basis\"]; nb = \
Length[basis];
   kk = dims[\"Scale\"]; dimSym = dims[\"Dimension\"]; qU = \
equations[\"LoopMomentum\"]; aq = Symbol[\"Global`aq\"];
   FRGAssert[\"Adimensional.scale\", equations[\"Scale\"] === kk, {equations[\
\"Scale\"], kk}, \"the regulator scale and the \\\"Scale\\\" of \
DeriveDimensions differ\"];
   unitIndex = AssociationThread[basis -> Range[nb]];
   nonren = First /@ EmbeddedStage[equations, \
\"Symmetries\"][\"NonRenormalised\"];
   testDims = If[dimSym === 2, {2}, {2, 3}];

   AppendTo[checks, assertCheck[\"Adimensional.referencesFlow\", \
Intersection[refs, nonren] === {}, Intersection[refs, nonren],
     \"a NonRenormalised coupling cannot be a reference: choose another \
one\", \"no reference is NonRenormalised\"]];

   (* D4: d_s R may contain d_s of reference couplings only *)
   regC = Union[Cases[equations[\"DsRRules\"][[All, 2]], dsCoupling[c_] :> c, \
{0, Infinity}]];
   AppendTo[checks, assertCheck[\"Adimensional.regulatorReferences\", \
SubsetQ[refs, regC], Complement[regC, refs],
     \"regulator prefactors may contain reference couplings only (e.g. nk q^2 \
arnh, not nk (1 + Ak) q^2 arnh); lifting this is in docs/FUTURE.md\",
     \"regulator prefactors contain references only: \" <> \
StringRiffle[ToString /@ regC, \", \"]]];
   (* units: c -> chat [c] for non-references, q -> k aq, d_s ref -> -eta ref \
*)
   form[c_] := basisForm[vecs[c], basis];
   toUnits = Join[(# -> names[#] form[#]) & /@ Complement[cps, refs], {qU -> \
kk aq}, (dsCoupling[#] -> -etas[#] #) & /@ refs];
   gamma2Dim[{a_, b_}] := Expand[dimSym UnitVector[nb, 1] - dims[\"Time\"] - \
vecs[a] - vecs[b]];\
\>", "Program",ExpressionUUID->"d47379d7-c62a-4147-8ed9-041730dc6831"],

Cell[TextData[{
 "The substitution ",
 StyleBox["toUnits",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes each non-reference coupling as ",
 StyleBox["\:0109",
  FontFamily->"Noto Sans"],
 " times its dimension, q = k aq, and ",

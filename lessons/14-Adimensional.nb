Cell["Lesson 14 - Adimensional", "Title",ExpressionUUID->"3f3dea13-680d-4843-be77-fcb8617c2b8d"],

Cell[TextData[{
 StyleBox["Physics step.",
  FontWeight->Bold],
 " Turn the dimensionful equations ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s(comb) = ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 "d",
 StyleBox["\:1d48",
  FontFamily->"Noto Sans"],
 "q/(2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\:1d48",
  FontFamily->"Noto Sans"],
 " I(q) into dimensionless ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 " functions. Each state coupling c becomes ",
 StyleBox["\:0109",
  FontFamily->"Noto Sans"],
 " = c/[c], with"
}], "Text",ExpressionUUID->"df64aa47-7717-4e49-9a1d-4d05cb2d1142"],

Cell[TextData[{
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s ",
 StyleBox["\:0109",
  FontFamily->"Noto Sans"],
 " = BetaL + ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 "daq LoopMeasure(d, aq) BetaNL,  LoopMeasure = S_d aq^{d",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1}/(2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 ")^d,"
}], "Text",ExpressionUUID->"c66343e5-5f78-40e9-8baa-688863a42539"],

Cell[TextData[{
 "where BetaL is the local part (canonical scaling and Leibniz terms, not \
integrated) and BetaNL the loop integrand in the dimensionless momentum aq = \
q/k. The reference couplings do not get a ",
 StyleBox["\[Beta]",
  FontFamily->"Noto Sans"],
 ": their running gives a linear system for the anomalous dimensions ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 ". The module proves that nothing depends on k or on the references any more."
}], "Text",ExpressionUUID->"fa92de8a-62cc-42af-a71d-c6502ffe2fbf"],


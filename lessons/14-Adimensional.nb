 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"1b76e6c6-f0a2-469b-9430-07493ff4caa4"],

Cell["Normal[CoefficientArrays[{a e1 + b e2 + c, d e1}, {e1, e2}]]", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[

Cell["2. Units out, by Leibniz", "Section",ExpressionUUID->"61c7bb06-a93b-4358-bc24-d2b7dd0c8a7d"],

Cell["\<\
(* Kernel/Adimensional.wl:100-139 *)
AdimensionalEquations[equations_, dims_, opts : OptionsPattern[]] := \
Block[{$FRGModule = \"Adimensional\"},
  Module[{t0 = AbsoluteTime[], checks = {}, warns = {}, ansatz, theory, \
fields, cps, refs, etas, names, vecs, basis, nb, unitIndex, kk, qU, aq,
    dimSym, nonren, regC, reg, eqs, combs, toUnits, form, gamma2Dim, kind, \
defEq, running, fixed, state, dsC, lhs, unknowns, uEqs, mat, rhsVec,
    sol, loopSym, dsOf, betaL, betaNL, betaNLExplicit, atomVals, atomVecs, \
adimAtoms, compactPiece, explicitPiece, etaRows, mL, mNL, bL, bNL,
    mustFix, stage, testDims, cand, bad, compactAtoms, etaRowsExplicit, mNLx, \
bNLx, causalRaw, causalOrig, causalStripped, causalMin,
    causalExpl, causalKeep, fns, ap, cU, pU, fnUnits, unitsOf, applied, \
functional, isFn, measureOf, atZeroOf, adimApplied, adimArg,
    rels, elims, relInfo, relSubst, relDim, stateFull, userState, sub},
   validateStage[equations, \"Equations\"]; validateStage[dims, \
\"Dimensions\"];
   FRGAssert[\"Adimensional.options\", MatchQ[{opts}, {(Rule | \
RuleDelayed)[\"State\" | \"Related\", _] ...}], {opts}, \"only the options \\\
\"State\\\" and \\\"Related\\\" are accepted\"];
   ansatz = AnsatzOf[equations];
   AppendTo[checks, assertCheck[\"Adimensional.sameAnsatz\", \
ansatz[\"Fingerprint\"] === dims[\"Ansatz\"][\"Fingerprint\"],
     {ansatz[\"Fingerprint\"], dims[\"Ansatz\"][\"Fingerprint\"]}, \"the \
dimensions were derived from another ansatz: \
DeriveDimensions[AnsatzOf[equations], ...]\",
     \"dimensions and equations from the same ansatz\"]];
   theory = ansatz[\"Theory\"]; fields = theory[\"Fields\"]; fns = \
Lookup[ansatz, \"MomentumFunctions\", {}];
   cps = Join[ansatz[\"Couplings\"], fns];
   refs = dims[\"References\"]; etas = dims[\"Etas\"]; names = \
dims[\"Names\"]; vecs = dims[\"Vectors\"]; basis = dims[\"Basis\"]; nb = \
Length[basis];
   kk = dims[\"Scale\"]; dimSym = dims[\"Dimension\"]; qU = \
equations[\"LoopMomentum\"]; aq = Symbol[\"Global`aq\"]; ap = \
Symbol[\"Global`ap\"];
   pU = Lookup[equations, \"ExternalMomentum\", Symbol[\"Global`p\"]]; cU = \
Lookup[equations, \"Cosine\", Symbol[\"Global`c\"]];
   FRGAssert[\"Adimensional.scale\", equations[\"Scale\"] === kk, {equations[\
\"Scale\"], kk}, \"the regulator scale and the \\\"Scale\\\" of \
DeriveDimensions differ\"];
   unitIndex = AssociationThread[basis -> Range[nb]];
   nonren = First /@ EmbeddedStage[equations, \
\"Symmetries\"][\"NonRenormalised\"];
   testDims = If[dimSym === 2, {2}, {2, 3}];

   AppendTo[checks, assertCheck[\"Adimensional.referencesFlow\", \
Intersection[refs, nonren] === {}, Intersection[refs, nonren],
     \"a NonRenormalised coupling cannot be a reference: choose another \
one\", \"no reference is NonRenormalised\"]];

   (* D4: d_s R may contain d_s of reference couplings only *)
   regC = Union[Cases[equations[\"DsRRules\"][[All, 2]], dsCoupling[c_] :> c, \
{0, Infinity}]];
   AppendTo[checks, assertCheck[\"Adimensional.regulatorReferences\", \
SubsetQ[refs, regC], Complement[regC, refs],
     \"regulator prefactors may contain reference couplings only (e.g. nk q^2 \
arnh, not nk (1 + Ak) q^2 arnh); lifting this is in docs/FUTURE.md\",
     \"regulator prefactors contain references only: \" <> \
StringRiffle[ToString /@ regC, \", \"]]];
   (* units: c -> chat [c] for non-references, q -> k aq, d_s ref -> -eta ref \
*)
   form[c_] := basisForm[vecs[c], basis];
   toUnits = Join[(# -> names[#] form[#]) & /@ Complement[cps, refs, fns], \
{qU -> kk aq, pU -> kk ap}, (dsCoupling[#] -> -etas[#] #) & /@ refs];
   (* a momentum function F(x) of the momentum squared x -> [F] Fhat(x/k^2); \
a bare F (in a combination) is F(p^2) -> [F] Fhat(ap^2) *)
   adimArg[x_] := Expand[(x /. {qU -> kk aq, pU -> kk ap})/kk^2];
   fnUnits = Join[Flatten[{#[x_] :> form[#] names[#][adimArg[x]], \
Derivative[j_][#][x_] :> form[#] kk^(-2 j) \
Derivative[j][names[#]][adimArg[x]]} & /@ fns],
     (# -> form[#] names[#][ap^2]) & /@ fns];
   unitsOf[e_] := (e /. fnUnits) /. toUnits;
   gamma2Dim[{a_, b_}] := Expand[dimSym UnitVector[nb, 1] - dims[\"Time\"] - \
vecs[a] - vecs[b]];\
\>", "Program",ExpressionUUID->"6554dfe8-94e3-4a09-8bd7-38fe8ed09ec5"],

Cell[TextData[{
 "The substitution ",
 StyleBox["toUnits",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes each non-reference coupling as ",
 StyleBox["\:0109",
  FontFamily->"Noto Sans"],
 " times its dimension, q = k aq, and ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s ref = ",
 StyleBox["\[Minus]\[Eta]",
  FontFamily->"Noto Sans"],
 " ref. ",
 StyleBox["Adimensional.scale",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " compares the regulator's ",
 StyleBox["k",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with the ",
 StyleBox["\"Scale\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " of ",
 StyleBox["DeriveDimensions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": this is where a wrong default ",
 StyleBox["\"Scale\"",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 13) would be caught."
}], "Text",ExpressionUUID->"acad66c3-cbf8-45c6-9fc5-e5d2d3875857"],

Cell["\<\
(* Kernel/Adimensional.wl:178-229 *)
   (* Leibniz: d_s(comb) = sum_c (d comb/d c) d_s c, d_s ref = -eta ref, d_s \
c = 0 for NonRenormalised c; one loop symbol per equation *)
   loopSym = Array[loopOf, Length[eqs]];
   lhs = Function[comb, Expand[Total[(D[comb, #] dsC[#]) & /@ \
Variables[comb]] /. Join[(dsC[#] -> -etas[#] #) & /@ refs, (dsC[#] -> 0) & /@ \
nonren]]] /@ combs;
   unknowns = Union[Cases[lhs, _dsC, {0, Infinity}]];
   uEqs = Select[Range[Length[eqs]], ! FreeQ[lhs[[#]], dsC] &];
   bad = Complement[Range[Length[eqs]], uEqs, Values[defEq]];
   FRGAssert[\"Adimensional.unusedEquation\", bad === {}, combs[[bad]], \
\"these equations determine no coupling and no eta (check the references and \
NonRenormalised tags)\"];
   FRGAssert[\"Adimensional.leibnizSquare\", Length[uEqs] == \
Length[unknowns], {combs[[uEqs]], unknowns},
    \"the equations do not determine each flowing coupling exactly once \
(Leibniz system not square)\"];
   sol = If[unknowns === {}, <||>,
     mat = Table[Coefficient[lhs[[e]], u], {e, uEqs}, {u, unknowns}];
     FRGAssert[\"Adimensional.leibnizSolvable\", ! ExactlyZeroQ[Det[mat]], \
{combs[[uEqs]], unknowns}, \"the Leibniz system is singular\"];
     rhsVec = loopSym[[uEqs]] - (lhs[[uEqs]] /. _dsC -> 0);
     AssociationThread[(First /@ unknowns) -> Expand[LinearSolve[mat, \
rhsVec]]]];
   AppendTo[checks, assertCheck[\"Adimensional.leibniz\", True, Null, \"\", \
ToString[Length[unknowns]] <> \" flowing couplings solved from \" <>
       ToString[Length[uEqs]] <> \" equations: \" <> StringRiffle[ToString /@ \
Keys[sol], \", \"]]];

   (* Related (design/MOMENTUMFUNCTIONS.md D7): parsed here, imposed on the \
outputs at the end *)
   rels = OptionValue[\"Related\"];
   FRGAssert[\"Adimensional.relatedSyntax\", ListQ[rels] && AllTrue[rels, \
MatchQ[#, Related[_Symbol -> _, o___ /; MatchQ[{o}, {((\"AtDimension\" -> \
_Integer?Positive) | (\"Reason\" -> _String)) ...}] &&
         StringQ[Lookup[{o}, \"Reason\", None]]]] &], rels,
    \"\\\"Related\\\" -> {Related[FD -> Fnu, \\\"AtDimension\\\" -> 1, \
\\\"Reason\\\" -> \\\"time reversal (d = 1)\\\"]} (\\\"Reason\\\" required, \
\\\"AtDimension\\\" optional)\"];
   relInfo = Function[rr, Module[{e = rr[[1, 1]], rhs = rr[[1, 2]], kept, \
al},
       kept = Union[Cases[{rhs}, Alternatives @@ fns, {0, Infinity}]];
       al = If[Length[kept] == 1, Together[rhs/First[kept]], None];
       FRGAssert[\"Adimensional.relatedFunctions\", MemberQ[fns, e] && \
Length[kept] == 1 && First[kept] =!= e && NumericQ[al] && al =!= 0, rr,
        \"Related relates two momentum functions: Related[FD -> Fnu] or \
Related[FD -> 2 Fnu] (a nonzero number times the kept function)\"];
       <|\"Eliminated\" -> e, \"Kept\" -> First[kept], \"Factor\" -> al, \
\"AtDimension\" -> Lookup[Rest[List @@ rr], \"AtDimension\", None],
        \"Reason\" -> Lookup[Rest[List @@ rr], \"Reason\"]|>]] /@ rels;
   elims = relInfo[[All, \"Eliminated\"]];
   FRGAssert[\"Adimensional.relatedChain\", DuplicateFreeQ[elims] && ! \
IntersectingQ[elims, relInfo[[All, \"Kept\"]]], relInfo[[All, \
{\"Eliminated\", \"Kept\"}]],
    \"each function is eliminated at most once and an eliminated function is \
never kept by another relation (no chains or cycles)\"];
   relDim = DeleteDuplicates[DeleteCases[relInfo[[All, \"AtDimension\"]], \
None]];
   FRGAssert[\"Adimensional.relatedDimension\", Length[relDim] <= 1 && \
(relDim === {} || ! NumberQ[dimSym] || dimSym === First[relDim]) &&
      AllTrue[relInfo, AllTrue[Expand[vecs[#Eliminated] - vecs[#Kept]], # === \
0 &] &],
    {relDim, dimSym, relInfo[[All, {\"Eliminated\", \"Kept\"}]]},
    \"the two related functions must have the same dimension (so the factor \
is a pure number), and one AtDimension compatible with the Theory's dimension\
\"];

   (* state *)
   userState = OptionValue[\"State\"];
   FRGAssert[\"Adimensional.relatedState\", userState === Automatic || ! \
IntersectingQ[userState, elims], Intersection[Replace[userState, Automatic -> \
{}], elims],
    \"an eliminated function (Related) is not part of the state: drop it from \
\\\"State\\\"\"];
   state = Replace[userState, Automatic -> Select[cps, ! MemberQ[refs, #] && \
! MemberQ[elims, #] &]];
   FRGAssert[\"Adimensional.state\", ListQ[state] && DuplicateFreeQ[state] && \
SubsetQ[Complement[cps, refs], state], state,
    \"\\\"State\\\" -> {couplings of the ansatz that are not references}\"];
   (* the eliminated functions are computed too (for the Related check), then \
dropped *)
   stateFull = Join[state, elims];
   bad = Select[state, ! KeyExistsQ[sol, #] && ! MemberQ[nonren, #] &];
   FRGAssert[\"Adimensional.noBeta\", bad === {}, bad, \"these state \
couplings get no flow: no equation determines them and they are not \
NonRenormalised\"];
   bad = Complement[Keys[sol], stateFull];
   FRGAssert[\"Adimensional.stateMissing\", bad === {}, bad, \"these \
couplings have a flow equation but are missing from \\\"State\\\"\"];
   dsOf[c_] := Lookup[sol, c, 0];\
\>", "Program",ExpressionUUID->"bef66c12-2836-4a79-b2f3-b93aa00577bc"],

Cell[TextData[{
 "A flowing combination such as ",
 StyleBox["\[Nu]\[CenterDot]",
  FontFamily->"Noto Sans"],
 "A gives ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s(",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 "A) = A ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " + ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "sA: the equations are linear in the unknown ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "s c, and the system must be square and regular. ",
 StyleBox["Array[loopOf, n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " makes the placeholder symbols ",
 StyleBox["loopOf[1], ..., loopOf[n]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " for the loop integrals, so that the linear algebra runs on short symbols \
(lesson 05's abstract atoms, once more). ",
 StyleBox["Variables[poly]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " lists the variables of a polynomial."
}], "Text",ExpressionUUID->"d3842f1f-e850-457e-b081-df246a28d6a9"],

Cell["{Variables[nuk Dk + lamk^2], Array[loopOf, 3]}", "Input",ExpressionUUID->"2e7bb9ed-40a6-4c8d-a2d4-6a1149af3d7a"],

Cell["3. Proving homogeneity", "Section",ExpressionUUID->"c9d66fe3-7ecb-4dd9-9331-0a8e0570b8e1"],

Cell["\<\
(* Kernel/Adimensional.wl:36-53 *)
(* ---------- homogeneity in the units (generalises HomVec/HomClean of \
AdimensionalFlowEQGenericRegLargeScale.nb) ----------
   hom[e] = {v, rest}: e = (product of units with exponent vector v) x rest, \
rest free of units. Every term of a sum must carry the
   same v; units may not appear in exponents or in function arguments. \
Exponents may depend on the symbolic dimension. *)
homVec[e_, unitIndex_Association, nb_] := Module[{zero = ConstantArray[0, \
nb], hv},
   hv[s_Symbol] := If[KeyExistsQ[unitIndex, s], {UnitVector[nb, \
unitIndex[s]], 1}, {zero, s}];
   hv[x_?NumericQ] := {zero, x};
   hv[x_Plus] := Module[{h = hv /@ List @@ x, v},
     v = h[[1, 1]];
     If[! AllTrue[h[[All, 1]], AllTrue[Expand[# - v], # === 0 &] &], \
Throw[{\"a sum mixes dimensions\", DeleteDuplicates[h[[All, 1]]], x}, homTag]];
     {v, Plus @@ h[[All, 2]]}];
   hv[x_Times] := Module[{h = hv /@ List @@ x}, {Expand[Total[h[[All, 1]]]], \
Times @@ h[[All, 2]]}];
   hv[Power[b_, n_]] := Module[{hb = hv[b], hn = hv[n]},
     If[hn[[1]] =!= zero, Throw[{\"a unit in an exponent\", Power[b, n]}, \
homTag]];
     {Expand[n hb[[1]]], hb[[2]]^n}];
   hv[f_[args___]] := Module[{h = hv /@ {args}},
     If[! AllTrue[h[[All, 1]], # === zero &], Throw[{\"a unit inside a \
function argument\", f[args]}, homTag]];
     {zero, f @@ h[[All, 2]]}];
   hv[e]];\
\>", "Program",ExpressionUUID->"2055db34-27d9-4f32-8751-b90547c722c5"],

Cell["\<\
(* Kernel/Adimensional.wl:55-63 *)
(* dimension vector of e (units substituted); aborts with the reason if e is \
not homogeneous *)
dimensionVector[check_, e_, unitIndex_, nb_, what_] := Module[{r = \
Catch[homVec[e, unitIndex, nb], homTag]},
   FRGAssert[check, MatchQ[r, {_List, _}] && Length[r[[1]]] == nb, {what, r}, \
\"not homogeneous in the units k, references: \" <> ToString[First[r]]];
   r];
(* rest of e after asserting that its dimension is exactly v *)
homClean[check_, e_, v_, unitIndex_, nb_, what_] := Module[{r = \
dimensionVector[check, e, unitIndex, nb, what]},
   FRGAssert[check, AllTrue[Expand[r[[1]] - v], # === 0 &], {what, \"residual \
dimension\" -> Expand[r[[1]] - v]},
    \"the expression still depends on the units k, references (dimension \
mismatch)\"];
   r[[2]]];\
\>", "Program",ExpressionUUID->"3b6ac455-0342-4829-81fc-aa62c532c051"],

Cell[TextData[{
 StyleBox["homVec",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " walks an expression (",
 StyleBox["Several definitions of one function",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 StyleBox[" (Glossary, lesson 02)",
  FontSlant->Italic,
  FontColor->GrayLevel[0.4]],
 ", one rule per head) and returns ",
 StyleBox["{exponent vector, rest}",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": the units it contains and what is left. Every term of a sum must carry \
the same vector; a unit may not appear in an exponent or inside a function \
argument (a shape argument must reduce to aq",
 StyleBox["\.b2",
  FontFamily->"Noto Sans"],
 ")."
}], "Text",ExpressionUUID->"a701b274-ffa9-4632-a986-0984e1383afb"],

Cell[TextData[{
 StyleBox["Mathematica: Catch and Throw",
  FontWeight->Bold],
 "\n",
 StyleBox["Throw[value, tag]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " jumps out of any depth of evaluation to the enclosing ",
 StyleBox["Catch[expr, tag]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", which returns value.",
 "\n\n",
 "A recursive walk that finds a problem deep inside a sum has to stop and \
report it. ",
 StyleBox["Throw",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " does that without every level of the recursion checking a return value. ",
 StyleBox["dimensionVector",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " catches the reason with the tag ",
 StyleBox["homTag",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and turns it into a named check: the library's convention (lesson 00, \
section 3) is kept at the boundary, while the inner walk uses the cheaper \
mechanism."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"f967c2f9-ff2e-4259-b5d7-da317ecf0ad2"],

Cell["\<\
ui = <|k -> 1, nuk -> 2, Dk -> 3|>;
{Catch[Throw[\"jumped out\", myTag]; \"never reached\", myTag],
 FRGscalarMSR`Private`homVec[k^2 nuk x, ui, 3],
 Catch[FRGscalarMSR`Private`homVec[k + nuk, ui, 3], \
FRGscalarMSR`Private`homTag]}\
\>", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"bb7ff12f-73ed-4745-85cc-d28bf087a3e8"],

Cell["\<\
(* Kernel/Adimensional.wl:65-77 *)
(* independent route (review E8): e must be unchanged when every unit is \
multiplied by a random factor. Units are random perfect
   powers so that every fractional power stays rational; d is set to each \
test dimension. *)
unitInvariantQ[e_, units_, dimSym_, ds_, seed_] := AllTrue[ds, Function[d, \
Module[{ed = e /. dimSym -> d, den, pt, lam, memo, atom, val, syms},
     den = LCM @@ Denominator[Cases[ed, Power[_, x_?NumericQ] :> x, {0, \
Infinity}] /. {} -> {1}];
     SeedRandom[seed + d];
     syms = Complement[Union[Cases[ed, s_Symbol /; Context[s] =!= \
\"System`\", {0, Infinity}, Heads -> False]], units];
     pt = Thread[syms -> RandomInteger[{2, 40}, \
Length[syms]]/RandomInteger[{41, 97}, Length[syms]]];
     lam = Thread[units -> (RandomInteger[{2, 7}, \
Length[units]]/RandomInteger[{2, 7}, Length[units]])^den];
     memo[x_] := memo[x] = RandomInteger[{2, 60}]/RandomInteger[{61, 97}];
     (* not Core's whole-atom rule (design/MOMENTUMPROJECTION.md step 0): \
enough here, AdimAtom[..] takes no argument and shapes are symbols *)
     atom = x : (Derivative[__][_Symbol][___] | (h_Symbol /; Context[h] =!= \
\"System`\")[___]) :> memo[x];
     val[u_] := Together[(ed /. Thread[units -> (u units)] /. pt /. \
Thread[units -> (Last /@ lam)] /. atom)];
     Together[val[1] - val[Last /@ lam]] === 0]]];\
\>", "Program",ExpressionUUID->"ae3610d1-7dca-4cae-ae13-40e60fb816ad"],

Cell["\<\
The independent route (review E8): every loop piece, before the units are \
stripped, is evaluated with every unit multiplied by a random factor, in d = \
2 and 3, and must not change. Structural homogeneity and numerical invariance \
are two different arguments for the same fact.\
\>", "Text",ExpressionUUID->"c6570de6-6d8a-480a-adbe-a67a14d19c24"],

Cell["4. The \[Beta] functions and the \[Eta] system", "Section",ExpressionUUID->"bfb61a28-edd8-4427-a5ad-581f0fb6fc95"],

Cell["\<\
(* Kernel/Adimensional.wl:263-291 *)
   (* a loop piece  alpha x Integral d^dq/(2 Pi)^d I(q) / [c]  as the \
integrand of Integral daq LoopMeasure: alpha k^d I(k aq)/[c] *)
   (* the equation record (or its exact p -> 0 row, for an eta normalised on \
a function: C4) whose integrand a piece uses *)
   isFn[e_] := KeyExistsQ[eqs[[e]], \"Functional\"];
   atZeroOf[e_] := If[isFn[e], eqs[[e]][\"AtZero\"], eqs[[e]]];
   explicitPiece[alpha_, e_, v_, what_, zero_ : False] := Module[{x = \
unitsOf[alpha kk^dimSym If[zero, atZeroOf[e], eqs[[e]]][\"Integrand\"]]},
     FRGAssert[\"Adimensional.unitInvariance\", unitInvariantQ[x, basis, \
dimSym, testDims, e], what,
      \"the loop integrand changes when the units are rescaled: it is not \
dimensionless (independent route)\"];
     homClean[\"Adimensional.homogeneous\", x, v, unitIndex, nb, what]];
   (* applied atoms of the generic-p rows: ScaleAtom[a, b, m, j][x] -> [atom] \
AdimAtom[a, b, m, j][x/k^2], dsR[a, b][x] explicit *)
   adimApplied = {ScaleAtom[a_, b_, m_, j_][y_] :> \
basisForm[atomVecs[ScaleAtom[a, b, m, j]][[1]], basis] AdimAtom[a, b, m, \
j][adimArg[y]]};
   compactPiece[alpha_, e_, v_, what_, zero_ : False] := Module[{rec = \
If[zero, atZeroOf[e], eqs[[e]]], x},
     x = unitsOf[alpha kk^dimSym If[isFn[e] && ! zero, rec[\"Compact\"] /. \
dsRAtRules[reg] /. adimApplied, rec[\"Compact\"] /. equations[\"DsRRules\"] \
/. compactAtoms]];
     homClean[\"Adimensional.homogeneousCompact\", x, v, unitIndex, nb, what]];

   (* beta functions: d_s chat = chat (-x + Sum y eta) + (d_s c)/[c], local \
part not integrated, loop part per Integral daq *)
   betaL = <||>; betaNL = <||>; betaNLExplicit = <||>;
   Do[Module[{ds = dsOf[c], v = vecs[c], hat = names[c], local, alphas},
      alphas = Coefficient[ds, #] & /@ loopSym;
      local = Expand[ds /. Thread[loopSym -> 0]];
      betaL[c] = Expand[If[MemberQ[fns, c], hat[ap^2] linearPart[v, \
Values[etas]] + 2 ap^2 Derivative[1][hat][ap^2], hat linearPart[v, \
Values[etas]]] +
         homClean[\"Adimensional.homogeneousLocal\", unitsOf[local/form[c]], \
ConstantArray[0, nb], unitIndex, nb, c]];
      betaNL[c] = Total[MapThread[If[#1 === 0 || \
eqs[[#2]][\"IdenticallyZero\"], 0, compactPiece[#1/form[c], #2, \
ConstantArray[0, nb], c]] &, {alphas, Range[Length[eqs]]}]];
      betaNLExplicit[c] = Total[MapThread[If[#1 === 0 || \
eqs[[#2]][\"IdenticallyZero\"], 0, explicitPiece[#1/form[c], #2, \
ConstantArray[0, nb], c]] &, {alphas, Range[Length[eqs]]}]]],
    {c, stateFull}];
   AppendTo[checks, assertCheck[\"Adimensional.homogeneous\", True, Null, \"\",
     \"every beta free of k and the references: homogeneity of every sum \
(structural) and invariance under random unit rescaling (numerical, d = \" <>
      StringRiffle[ToString /@ testDims, \", \"] <> \")\"]];
   AppendTo[checks, assertCheck[\"Adimensional.linearNoMomentum\", \
FreeQ[Values[betaL], aq | qU | kk], Select[betaL, ! FreeQ[#, aq | qU | kk] \
&],
     \"internal: a linear part depends on the loop momentum\", \"linear parts \
free of aq (not integrated)\"]];\
\>", "Program",ExpressionUUID->"0c32e677-57e1-48c1-bd6c-de74fcfdaae8"],

Cell[TextData[{
 StyleBox["linearPart",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (lesson 13) gives the canonical part, ",
 StyleBox["\:0109",
  FontFamily->"Noto Sans"],
 "(",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "x + ",
 StyleBox["\[CapitalSigma]",
  FontFamily->"Noto Sans"],
 " y_j ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 "_j). The loop pieces become integrands of ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 "daq with k^d from the measure."
}], "Text",ExpressionUUID->"a4a80abc-10dc-4ca3-9bf7-2a39b22e8952"],

Cell["\<\
(* Kernel/Adimensional.wl:33 *)
LoopMeasure[d_, aq_] := 2 Pi^(d/2)/Gamma[d/2] aq^(d - 1)/(2 Pi)^d;\
\>", "Program",ExpressionUUID->"1fea3e37-d3fc-449a-88f1-7196649fa473"],

Cell["{LoopMeasure[3, aq], LoopMeasure[Dim, aq]}", "Input",ExpressionUUID->"1c1b0463-9c22-4590-b01f-faf15a2ea04d"],

Cell["\<\
(* Kernel/Adimensional.wl:294-308 *)
   (* eta system: running ref r: eta_r = -(loop of its equation)/r (amplitude \
counted as 1); fixed ref: placeholder row eta = 0 *)
   etaRows = Table[If[kind[r] === \"Running\", compactPiece[-1/r, defEq[r], \
ConstantArray[0, nb], \"eta\" <> dims[\"EtaNames\"][r], True], None], {r, \
refs}];
   etaRowsExplicit = Table[If[kind[r] === \"Running\", explicitPiece[-1/r, \
defEq[r], ConstantArray[0, nb], \"eta\" <> dims[\"EtaNames\"][r], True], 0], \
{r, refs}];
   {bNL, mNL} = Module[{rows = Replace[etaRows, None -> 0, {1}], ca},
     ca = Normal[CoefficientArrays[rows, Values[etas]]];
     (* every reference Fixed: the rows are all 0 and CoefficientArrays has \
no linear part *)
     If[Length[ca] == 1, ca = {ca[[1]], ConstantArray[0, {Length[refs], \
Length[refs]}]}];
     FRGAssert[\"Adimensional.etaLinear\", Length[ca] == 2, rows, \"the eta \
system is not linear in the etas\"];
     {ca[[1]], -ca[[2]]}];
   {bNLx, mNLx} = Module[{ca = Normal[CoefficientArrays[etaRowsExplicit, \
Values[etas]]]},
     If[Length[ca] == 1, ca = {ca[[1]], ConstantArray[0, {Length[refs], \
Length[refs]}]}]; {ca[[1]], -ca[[2]]}];
   mL = IdentityMatrix[Length[refs]]; bL = ConstantArray[0, Length[refs]];
   mustFix = dims[\"EtaNames\"] /@ fixed;
   AppendTo[checks, assertCheck[\"Adimensional.etaSystem\", True, Null, \"\",
     \"eta system: \" <> ToString[Length[running]] <> \" running row(s)\" <> \
If[fixed === {}, \"\", \", placeholder row(s) eta = 0 for \" <>\
\>", "Program",ExpressionUUID->"2bfa1412-eb2d-46e5-a68c-616e0fa1629c"],


 " with p = b + m.x + ...",
 "\n\n",
 "The ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 " rows are linear in the ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 "'s: ",
 StyleBox["CoefficientArrays",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " returns the constant vector and the matrix in one call (",
 StyleBox["Normal",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " turns its sparse arrays into lists). ",
 StyleBox["Length[ca] == 2",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " means \"nothing beyond linear\", the check ",
 StyleBox["Adimensional.etaLinear",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},

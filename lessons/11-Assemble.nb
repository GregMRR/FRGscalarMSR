Cell["4. Choosing a compact form", "Section",ExpressionUUID->"54b1e17d-f0e3-4316-9787-c89395f6e4bf"],

Cell["\<\
(* Kernel/Assemble.wl:47-48 *)
(* LeafCount with every atom ScaleAtom[..] and dsR[..] counted as one leaf, \
as the script's xE, dsNh *)
atomLeaves[e_] := LeafCount[e /. (ScaleAtom | dsR)[__] -> atomLeaf];\
\>", "Program",ExpressionUUID->"ef33e7b0-90f5-4c48-894d-ad5b7a38c1cc"],

Cell["\<\
(* Kernel/Assemble.wl:52-53 *)
collectNum[o_][num_] := Module[{ftl = FactorTermsList[num, o]}, (Times @@ \
Most[ftl]) Collect[Last[ftl], o, Factor]];
compactFrac[o_][r_] := collectNum[o][Numerator[r]]/Factor[Denominator[r]];\
\>", "Program",ExpressionUUID->"c0c8802b-e308-4381-9365-554ac160911c"],

Cell["\<\
(* Kernel/Assemble.wl:55-68 *)
(* candidates: per dsR coefficient or as one fraction, numerator content \
pulled out and nested-Collected over the atoms; small results
   also get a time-limited Simplify per dsR coefficient; the smallest \
explicit LeafCount wins and is checked exactly *)
compactify[a_, dsList_, orders_, explicit_] := Module[{tg, cands, best},
   If[a === 0, Return[{0, \"zero\"}]];
   tg = Together[a];
   cands = Join[
     Table[{\"perDs\" <> ToString[i], Collect[a, dsList, \
Collect[Numerator[#], orders[[i]], Factor]/Factor[Denominator[#]] &]}, {i, \
Length[orders]}],
     Table[{\"whole\" <> ToString[i], compactFrac[orders[[i]]][tg]}, {i, \
Length[orders]}]];
   best = First[SortBy[cands, LeafCount[explicit[#[[2]]]] &]];
   If[LeafCount[explicit[best[[2]]]] < 15000,
    AppendTo[cands, {\"perDsSimplify\", Collect[a, dsList, \
TimeConstrained[Simplify[#], 10, #] &]}];
    best = First[SortBy[cands, LeafCount[explicit[#[[2]]]] &]]];
   FRGAssert[\"Assemble.compactExact\", ExactlyZeroQ[best[[2]] - a], \
best[[1]], \"internal: compactify changed the expression\"];
   {best[[2]], best[[1]]}];\
\>", "Program",ExpressionUUID->"ee958ed7-9a0a-4802-8fd1-c8fd5966bb4a"],

Cell[TextData[{
 StyleBox["Mathematica: Collect and Factor",
  FontWeight->Bold],
 "\n",
 StyleBox["Collect[e, vars, f]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " groups e by powers of vars and applies f to each coefficient; ",
 StyleBox["Factor",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " factors a polynomial.",
 "\n\n",
 StyleBox["Collect[a, dsList, Together]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " writes the right-hand side as ",
 StyleBox["\[CapitalSigma]",
  FontFamily->"Noto Sans"],
 " (coefficient) ",
 StyleBox["\[Times]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["dsR[...]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " with each coefficient over a common denominator. ",
 StyleBox["compactify",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " tries several such forms (per ",
 StyleBox["dsR",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " coefficient or as one fraction, atoms collected in two orders) and keeps \
the one with the smallest explicit ",
 StyleBox["LeafCount",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"c3ad9d02-73f0-4f31-a8f3-13c40b923446"],


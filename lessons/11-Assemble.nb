Cell["2. Scale-stripped atoms", "Section",ExpressionUUID->"b512361c-01ad-4c5a-b148-e9a77e46e8fb"],

Cell["\<\
(* Kernel/Assemble.wl:24-30 *)
(* for an atom value v(s): {cscale, n, X} with v = cscale s^n X, cscale = \
number x couplings common to all terms *)
stripScale[v_, s_, cps_, shapes_] := Module[{val = Expand[v], terms, tm, num, \
ex},
   terms = If[Head[val] === Plus, List @@ val, {val}];
   tm = terms /. (Alternatives @@ shapes)[__] -> shapeMark /. \
Derivative[__][Alternatives @@ shapes][__] -> shapeMark;
   num = First[FactorTermsList[val]];
   ex = Table[Min[Exponent[#, x] & /@ tm], {x, Append[cps, s]}];
   {num Times @@ (cps^Most[ex]), Last[ex], Expand[val/(num Times @@ \
(cps^Most[ex]) s^Last[ex])]}];\
\>", "Program",ExpressionUUID->"ef59c2d7-1a7a-4ddb-aa4a-8f1523e00295"],

Cell["\<\
(* Kernel/Assemble.wl:32-45 *)
(* atom form of GammaAtom[a, b, m] and of its s-derivatives up to jmax: rules \
at s = LoopMomentumSquared, and atom values *)
atomSystem[prop_, cps_, shapes_, jmax_] := Module[{rules = {}, vals = <||>, \
forms = <||>},
   Do[Module[{cs, n, x, a, b, m, xj, f},
      {a, b, m} = List @@ g;
      {cs, n, x} = stripScale[prop[\"AtomValues\"][g][xs], xs, cps, shapes];
      Do[
       xj = If[j == 0, x, Expand[D[xs^n x, {xs, j}]]];
       f = If[Head[xj] === Plus, (vals[ScaleAtom[a, b, m, j]] = \
Function[Evaluate[xs], Evaluate[xj]]; ScaleAtom[a, b, m, j]), xj /. xs -> \
LoopMomentumSquared];
       f = If[j == 0, cs LoopMomentumSquared^n f, cs f];
       forms[{g, j}] = f;
       AppendTo[rules, If[j == 0, g[LoopMomentumSquared] -> f, \
Derivative[j][g][LoopMomentumSquared] -> f]],
       {j, 0, jmax}]],
    {g, prop[\"Atoms\"]}];
   {rules, vals, forms}];\
\>", "Program",ExpressionUUID->"4fa01895-d677-4570-aa5d-2c7c0406d6b3"],


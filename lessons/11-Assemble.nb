Cell[TextData[{
 StyleBox["Why it's built this way: Generate the atoms the hand calculation \
would use",
  FontWeight->Bold],
 "\n\n",
 "The original script had hand-written ",
 StyleBox["toAtoms",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "/",
 StyleBox["atomVals",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": names like xE = A + r and xE1 = A + r + y r",
 StyleBox["\[Prime]",
  FontFamily->"Noto Sans"],
 " chosen by a person for readability. Here the same atoms are derived from \
the propagator by one rule (strip the common scale, name what is left), so a \
new ansatz gets them for free and they cannot drift from the propagator they \
stand for (",
 StyleBox["Assemble.atomSync",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). In shallow water the rule reproduces the script's atoms exactly (",
 StyleBox["docs/MODULES.md",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", Assemble)."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"d9da0cba-9fcc-4ed5-b445-1fc0b253ec98"],

Cell["3. From the closure to the equations", "Section",ExpressionUUID->"8c0df9eb-6bc8-492d-891e-153b41c3ffc6"],

Cell["\<\
(* Kernel/Assemble.wl:87-122 *)
AssembleEquations[closure_] := Block[{$FRGModule = \"Assemble\"},
  Module[{t0 = AbsoluteTime[], prop, reg, k, qU, cps, shapes, raw, \
deltaRules, jmax, rules, vals, forms, atomVals, toQ, d0, d1, orders,
    eqs, checks = {}, warns = {}, stage, explicitAtoms, validity, dsrRules, \
bad, private, pU, cU, toQPC, gRules, genericVals, fns,
    assembleZero, assembleGeneric, rawZero},
   validateStage[closure, \"Closure\"];
   prop = closure[\"Integrated\"][\"Projection\"][\"Loops\"][\"Propagator\"];
   reg = closure[\"Integrated\"][\"Projection\"][\"Loops\"][\"Regulator\"];
   k = reg[\"Scale\"]; cps = reg[\"Couplings\"]; shapes = reg[\"Shapes\"];
   qU = Replace[reg[\"LoopMomentum\"], None -> Symbol[\"Global`q\"]];
   toQ = LoopMomentumSquared -> qU^2;

   (* Delta coefficients and their s-derivatives in GammaAtom atoms *)
   deltaRules = {DeltaCoefficient[m_][x_] :> \
prop[\"DeltaCoefficients\"][x][[m + 1]],
     Derivative[j_][DeltaCoefficient[m_]][x_] :> \
(D[prop[\"DeltaCoefficients\"][xs][[m + 1]], {xs, j}] /. xs -> x)};
   raw = (#RHS /. deltaRules) & /@ closure[\"Equations\"];
   rawZero = (Lookup[#, \"AtZeroRHS\", 0] /. deltaRules) & /@ \
closure[\"Equations\"];
   jmax = Max[0, Cases[{raw, rawZero}, Derivative[j_][_GammaAtom][_] :> j, \
Infinity]];
   (* generic-p rows: invariants -> (q, p, c), q the midpoint loop momentum \
*)
   pU = Symbol[\"Global`p\"]; cU = Symbol[\"Global`c\"];
   toQPC = {LoopMomentumSquared -> qU^2, ExternalMomentumSquared -> pU^2, \
MomentumProduct -> pU qU cU};
   fns = Lookup[closure[\"Integrated\"][\"Projection\"][\"Loops\"][\"Vertices\
\"][\"Ansatz\"], \"MomentumFunctions\", {}];

   (* scale-stripped atoms and the sync check: atom form = explicit value, \
for every atom and derivative *)
   {rules, vals, forms} = atomSystem[prop, cps, shapes, jmax];
   atomVals = KeyValueMap[#1 -> #2[qU^2] &, vals];
   bad = Select[Keys[forms], ! ExactlyZeroQ[(forms[#] /. toQ /. atomVals) - \
(D[prop[\"AtomValues\"][#[[1]]][xs], {xs, #[[2]]}] /. xs -> qU^2)] &];
   AppendTo[checks, assertCheck[\"Assemble.atomSync\", bad === {}, bad, \
\"internal: the scale-stripped atoms do not reproduce the propagator atoms\",
     ToString[Length[vals]] <> \" scale-stripped atoms; atom form = explicit \
value for \" <> ToString[Length[forms]] <> \" atoms and derivatives\"]];

   (* collection orders: derivative atoms first (they pair with a dsR), then \
the others in two orders *)
   d1 = Select[Keys[vals], Last[#] > 0 &]; d0 = Select[Keys[vals], Last[#] == \
0 &];
   orders = {Join[d1, Reverse[d0]], Join[d1, d0]};
   dsrRules = DsRRules[reg, qU^2];
   AppendTo[checks, assertCheck[\"Assemble.dsRLinear\", \
AllTrue[dsrRules[[All, 2]], PolynomialQ[#, Cases[#, _dsCoupling, {0, \
Infinity}]] &&
        Max[0, Exponent[#, Cases[#, _dsCoupling, {0, Infinity}]]] <= 1 &], \
dsrRules, \"internal: d_s R is not linear in the dsCoupling symbols\",
     \"d_s R linear in dsCoupling[c]\"]];\
\>", "Program",ExpressionUUID->"084cffed-61e0-478c-a5ff-a4116cb99ed6"],


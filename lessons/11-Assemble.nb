}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"856eec46-87f4-48f3-b02a-14593c23fce9"],

Cell["TimeConstrained[Pause[3]; \"finished\", 0.5, \"timed out\"]", "Input",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.3, 0.5, 0.85],
 Background->RGBColor[
  0.91, 0.95, 1.],ExpressionUUID->"eed6e1a4-14bd-4aaf-8f86-017f94a9b2cd"],

Cell[TextData[{
 StyleBox["Why it's built this way: The one place where Simplify is allowed",
  FontWeight->Bold],
 "\n\n",
 "CLAUDE.md forbids ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " on large expressions and as a zero test (lesson 00, section 5). Here it is \
used for presentation only, on small expressions, with a time limit, as one \
candidate among several, and the winner is checked exactly against the \
canonical form (",
 StyleBox["Assemble.compactExact",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", with ",
 StyleBox["ExactlyZeroQ",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "). If ",
 StyleBox["Simplify",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " is slow, or makes things worse, nothing is lost. This is how the library \
uses heuristics in general: never trusted, always checked, never needed for \
correctness."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->GrayLevel[0.55],
 Background->RGBColor[
  0.93, 0.93, 0.93],ExpressionUUID->"58b9922e-060e-439e-9ac7-ef82b38ae6be"],

Cell[TextData[{
 StyleBox["atomLeaves",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " counts each ",
 StyleBox["ScaleAtom",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["dsR",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " as a single leaf, so the compact ",
 StyleBox["LeafCount",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " on the card is comparable with the script's hand-made compact forms."
}], "Text",ExpressionUUID->"9c2736b9-a44a-4a6f-a5a8-88ceabb2e5bb"],

Cell["5. The explicit form and the final checks", "Section",ExpressionUUID->"6edff521-0d5a-4bbc-8220-c12648d2adee"],

Cell[TextData[{
 "The explicit integrand is ",
 StyleBox["cpt /. atomVals /. dsrRules",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ": atom values, then the derived ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "sR of lesson 04, substituted only now. ",
 StyleBox["Assemble.noIntermediates",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " requires that nothing internal survives: no ",
 StyleBox["GammaAtom",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["ScaleAtom",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["\[CapitalDelta]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["DeltaCoefficient",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["dsR",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", ",
 StyleBox["LoopMomentumSquared",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ", and no symbol from a ",
 StyleBox["Private",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " context (",
 StyleBox["StringContainsQ[Context[x], \"Private",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "\"]`)."
}], "Text",ExpressionUUID->"8e3d8a18-dc4e-47a8-a813-b12489a8ea88"],

Cell["\<\
(* Kernel/Assemble.wl:125-136 *)
   validity = prop[\"ValidityConditions\"][LoopMomentumSquared] /. deltaRules \
/. rules /. toQ;
   explicitAtoms = validity /. atomVals;
   AppendTo[warns, infoCheck[\"ASSUMPTION\", \"Assemble.validity\", \
displayString[validity] <> \" at every q (causal poles; not checked by the \
library: exported as causal_poles by ExportJulia)\"]];
   AppendTo[warns, infoCheck[\"INFO\", \"Assemble.contract\", \"Integrand: \
d^dq/(2 Pi)^d integrand of d_s(comb) in the couplings, dsCoupling[c] = k \
dc/dk (linear), \" <>
      \"shapes \" <> inputForm[shapes] <> \" of y = \" <> ToString[qU] <> \
\"^2/\" <> ToString[k] <> \"^2 with derivatives, \" <> \
If[closure[\"Symmetries\"][\"Dimension\"] === 2, \"d = 2 (declared)\", \
ToString[closure[\"Symmetries\"][\"Dimension\"]] <> \" symbolic\"]]];

   stage = stampStage[<|\"Stage\" -> \"Equations\", \"Pipeline\" -> \
\"DerivativeExpansion\", \"Upstream\" -> {closure[\"Fingerprint\"]},
      \"Closure\" -> closure, \"Equations\" -> eqs, \"Atoms\" -> \
Association[atomVals], \"AtomForms\" -> Association[KeyValueMap[#1 -> (#2 /. \
toQ) &, forms]],
      \"ValidityConditions\" -> <|\"Atoms\" -> validity, \"Explicit\" -> \
explicitAtoms|>, \"DsRRules\" -> dsrRules,
      \"LoopMomentum\" -> qU, \"Scale\" -> k, \"Shapes\" -> shapes, \
\"Couplings\" -> cps, \"Dimension\" -> \
closure[\"Symmetries\"][\"Dimension\"],
      \"Checks\" -> checks, \"Warnings\" -> warns, \"Timing\" -> \
AbsoluteTime[] - t0|>];
   PrintCard[stage];\
\>", "Program",ExpressionUUID->"e7ddafcb-7492-4cf5-b3db-d41dd26a559d"],

Cell[TextData[{
 "The stage records everything a reader of the equations needs: the atoms, \
the ",
 StyleBox["\[PartialD]",
  FontFamily->"Noto Sans"],
 "sR rules, the loop momentum and scale symbols, the shapes, the couplings, \
the dimension and the validity conditions."
}], "Text",ExpressionUUID->"68df4e81-0738-4894-99f0-ad2e2650f37c"],

Cell["\<\
(* Kernel/Assemble.wl:139 *)
EquationOf[e_Association, comb_] := SelectFirst[e[\"Equations\"], \
Expand[#Flowing - comb] === 0 &];\
\>", "Program",ExpressionUUID->"de9202aa-afcf-42e6-82e9-974937a9bce0"],

Cell["\<\
(* Kernel/Assemble.wl:141-149 *)
ShowEquation[e_Association, comb_] := Module[{r = EquationOf[e, comb], used},
   If[MissingQ[r], Print[\"no equation for \", comb, \"; equations: \", \
e[\"Equations\"][[All, \"Flowing\"]]]; Return[Null]];
   Print[\"d_s(\", displayString[comb], \") = Int d^dq/(2 Pi)^d of (\", \
r[\"CompactForm\"], \", LeafCount \", r[\"LeafCount\"][\"Compact\"], \", \
explicit \",
    r[\"LeafCount\"][\"Integrand\"], \"):\"];
   Print[\"  \", displayString[r[\"Compact\"]]];
   used = Union[Cases[r[\"Compact\"], _ScaleAtom, {0, Infinity}]];
   If[used =!= {}, Print[\"atoms:\"]; Scan[Print[\"  \", displayString[#], \" \
= \", displayString[e[\"Atoms\"][#]]] &, used]];
   Print[\"d_s R entries:\"]; Scan[Print[\"  \", displayString[#[[1]]], \" = \
\", displayString[#[[2]]]] &, Select[e[\"DsRRules\"], MemberQ[r[\"DsR\"], \
#[[1]]] &]];
   Print[\"valid where: \", \
displayString[e[\"ValidityConditions\"][\"Atoms\"]]]];\
\>", "Program",ExpressionUUID->"363b55f6-e817-4e43-bee5-5426278d7c3b"],

Cell["Exercises", "Section",ExpressionUUID->"b7209024-b2f1-4509-a3f4-e7fe298b66a4"],

Cell["Exercise: The size of the result", "Subsection",ExpressionUUID->"e52b61b9-0e11-4596-9cb0-8846224e3680"],

Cell[TextData[{
 "For both equations, print ",
 StyleBox["#LeafCount",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["#CompactForm",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " (which candidate won). How much smaller is the compact form than the \
explicit integrand?"
}], "Text",ExpressionUUID->"b6e5f4a4-f0cf-4b93-b75b-8ecd9778d438"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"e5ec143e-0c54-4846-9246-54e0bfc95c83"],

Cell["\<\
{#Flowing, #CompactForm, #LeafCount} & /@ equations[\"Equations\"]\
\>", "Input",ExpressionUUID->"19f12b96-6451-436d-9ac7-a5696370dd05"]
}, Closed]],

Cell["Exercise: Linearity in dsCoupling", "Subsection",ExpressionUUID->"a7631cb1-9eee-433d-900d-2974419426f1"],

Cell[TextData[{
 "The explicit integrand is linear in ",
 StyleBox["dsCoupling[nuk]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and ",
 StyleBox["dsCoupling[Dk]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 ". Extract the coefficient of ",
 StyleBox["dsCoupling[Dk]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " in the D equation."
}], "Text",ExpressionUUID->"c6707c63-d78b-4c16-aec9-29fcae82e718"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"f5cb4c03-88b5-4f2b-9570-14456a0793e2"],

Cell["\<\
Together[Coefficient[EquationOf[equations, Dk][\"Integrand\"], \
dsCoupling[Dk]]]\
\>", "Input",ExpressionUUID->"75f799cb-c3ed-423a-bddb-505c3b314037"],

Cell[TextData[{
 "Downstream, ",
 StyleBox["dsCoupling[Dk]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " becomes ",
 StyleBox["\[Minus]\[Eta]",
  FontFamily->"Noto Sans"],
 "_D D, and this coefficient multiplies ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 "_D in the linear system for the anomalous dimensions (lesson 14)."
}], "Text",ExpressionUUID->"e6196630-1247-4474-90b8-77be1b67fae6"]
}, Closed]],

Cell["Exercise: Canet's KPZ flow", "Subsection",ExpressionUUID->"b3f7b660-674b-4a37-8154-3a4c7d0c710a"],

Cell[TextData[{
 "With the Litim cutoff r(y) = (1/y ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " 1) ",
 StyleBox["\[Theta]",
  FontFamily->"Noto Sans"],
 "(1 ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " y) in both sectors, and ",
 StyleBox["\[Integral]",
  FontFamily->"Noto Sans"],
 "d",
 StyleBox["\:1d48",
  FontFamily->"Noto Sans"],
 "q/(2",
 StyleBox["\[Pi]",
  FontFamily->"Noto Sans"],
 ")",
 StyleBox["\:1d48",
  FontFamily->"Noto Sans"],
 " f = v_d k^d/2 ",
 StyleBox["\[Integral]\:2080\.b9",
  FontFamily->"Noto Sans"],
 " y^{d/2",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "1} f dy, integrate the ",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " and D equations, solve for ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 "_",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " and ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 "_D, and check that d ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " 2 ",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 " ",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 "_D + 3",
 StyleBox["\[Eta]",
  FontFamily->"Noto Sans"],
 "_",
 StyleBox["\[Nu]",
  FontFamily->"Noto Sans"],
 " equals the ratio of Canet's Eq. (20) (arXiv:2509.01472), with g = v_d k^{d",
 StyleBox["\[Minus]",
  FontFamily->"Noto Sans"],
 "2} ",
 StyleBox["\[Lambda]\.b2",
  FontFamily->"Noto Sans"],
 " D/",
 StyleBox["\[Nu]\.b3",
  FontFamily->"Noto Sans"],
 ". This is the test that fixes the loop normalisation of lesson 07."
}], "Text",ExpressionUUID->"a789b5a8-ad1f-47d7-ba13-7bb4a2761512"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"4bb80b17-1607-4cb0-b2c3-8876dca0fa49"],

Cell[TextData[{
 StyleBox["litimIntegral",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " replaces q by k",
 StyleBox["\[Sqrt]",
  FontFamily->"Noto Sans"],
 "y, inserts the Litim shape (valid for y < 1, where ",
 StyleBox["\[Theta]",
  FontFamily->"Noto Sans"],
 " = 1), and integrates each power of y from 0 to 1."
}], "Text",ExpressionUUID->"e01febe7-f8af-4390-b233-4ecf890db620"],

Cell["\<\
litim = {rn -> Function[y, 1/y - 1], rd -> Function[y, 1/y - 1]};
litimIntegral[f_] := Module[{gg = Expand[Together[f /. q -> k Sqrt[y] /. \
litim] y^(d/2 - 1)], terms},
  terms = If[Head[gg] === Plus, List @@ gg, {gg}];
  vd k^d/2 Total[(# /. y -> 1)/(Exponent[#, y] + 1) & /@ terms]];
flowOf[c_] := litimIntegral[EquationOf[equations, c][\"Integrand\"] /. Dim -> \
d];\
\>", "Input",ExpressionUUID->"8cd37fe8-0597-4788-a03e-846ba4765619"],

Cell["\<\
etas = First[Solve[{-etanu nuk == (flowOf[nuk] /. {dsCoupling[nuk] -> -etanu \
nuk, dsCoupling[Dk] -> -etaD Dk}),
     -etaD Dk == (flowOf[Dk] /. {dsCoupling[nuk] -> -etanu nuk, \
dsCoupling[Dk] -> -etaD Dk})}, {etanu, etaD}]];
bracket = Together[(d - 2 - etaD + 3 etanu) /. etas /. lamk -> Sqrt[g \
nuk^3/(vd k^(d - 2) Dk)]]\
\>", "Input",ExpressionUUID->"4c7efef3-f20a-4ac1-88c7-f716b7cbd3fa"],

Cell["\<\
canet = (2 d^6 + 4 d^5 - d^4 (7 g + 8) - 2 d^3 (3 g + 8) + d^2 g (3 g + 20) - \
d (g - 8) g - 2 g^2)/
   (2 d^5 + 8 d^4 + d^3 (8 - 3 g) - 2 d^2 g + d g (g + 8) - g^2);
Together[bracket - canet]\
\>", "Input",ExpressionUUID->"6ea7d42d-49e5-4cd1-a31b-067c42c14cd1"],

Cell[TextData[{
 "0, for every d and g. The same computation is ",
 StyleBox["tests/acceptance/KPZ.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 " and the last section of ",
 StyleBox["examples/KPZ.nb",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.6, 0.12, 0.1],
  Background->GrayLevel[0.92]],
 "."
}], "Text",ExpressionUUID->"e9c315ea-bc58-43f1-b24d-57c34c27c091"]
}, Closed]]
},
